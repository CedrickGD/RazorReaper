<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>RazorReaper</RootNamespace>
		<!-- Custom entry point (Platforms/Windows/Program.cs): routes the "-\-arkwatch"
		     login-watcher mode past XAML/MAUI entirely so it runs headless. -->
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<EnableDefaultCssItems>false</EnableDefaultCssItems>
		<Nullable>enable</Nullable>
		<!-- Services/Automation/DesktopDuplicator.cs calls the DXGI/D3D11 vtables through
		     function pointers; that is the whole use of unsafe in this project. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- Display name -->
		<ApplicationTitle>RazorReaper</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.razorreaper</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.5.2</ApplicationDisplayVersion>
		<ApplicationVersion>16</ApplicationVersion>
		<AssemblyVersion>1.5.2.0</AssemblyVersion>
		<FileVersion>1.5.2.0</FileVersion>
		<Version>1.5.2</Version>

		<!-- Windows App Icon -->
		<ApplicationIcon>Resources\AppIcon\rrlogo.ico</ApplicationIcon>

		<!-- Windows-specific settings -->
		<WindowsPackageType>None</WindowsPackageType>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

		<!-- Disable SourceLink -->
		<EnableSourceLink>false</EnableSourceLink>
		<EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
		<PackageIcon>RRlogo.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<!-- A stable build-number source for runtime telemetry. Unlike MAUI AppInfo metadata,
		     normal SDK assembly metadata is regenerated when project properties change. -->
		<AssemblyMetadata Include="RazorReaper.ApplicationVersion" Value="$(ApplicationVersion)" />
	</ItemGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\rrlogo.png" BaseSize="256,256" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="wwwroot\images\RRlogo.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.60" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.60" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
		<PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.8" />
		<PackageReference Include="System.Management" Version="10.0.8" />
		<PackageReference Include="Serilog" Version="4.3.1" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.8" />
		<!-- SkiaSharp decodes WEBP, HEIF/HEIC, AVIF, TIFF, ICO and other formats that
		     System.Drawing can't handle natively. We use it on the import path to
		     transcode anything non-native into a PNG the rest of the GDI+ pipeline
		     (thumbnails, preview, overlay) can render unchanged. -->
		<PackageReference Include="SkiaSharp" Version="3.119.0" />
		<PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.0" />
		<!-- BC3/BC1/BC7 texture encoding for the Sky Changer (Sky Injector). MIT-licensed,
		     replaces the hand-rolled numpy BC3 encoder in t1m's original Python script. -->
		<PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
		<!-- Discord Rich Presence (Lachee, MIT). Pure C# over Discord IPC named pipes —
		     no native deps. Powers the "Playing Razor Reaper" profile activity. -->
		<PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="RazorReaper.UnitTests" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="appsettings.local.json" Condition="Exists('appsettings.local.json')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- Built-in INI presets, embedded into the assembly so they ship as a
	     single file. IniPresetService loads them via Assembly.GetManifestResourceStream. -->
	<ItemGroup>
		<EmbeddedResource Include="Resources\Presets\*.ini">
			<LogicalName>RazorReaper.Presets.%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<!-- ============================================================
	     Self-contained RELEASE builds — no separate .NET install, no publish step
	     ============================================================
	     A normal Visual Studio "Build → Release" produces a fully self-contained app
	     (bundled .NET 10 runtime + Windows App SDK) directly in
	     bin\Release\net10.0-windows10.0.19041.0\win-x64\ — the exact folder the Inno
	     installer already packages — so there is NO separate `dotnet publish` step.
	     Debug builds stay framework-dependent and fast for everyday dev (F5 / dotnet run).

	     Notes:
	       * .NET 10 dropped version-specific RIDs (win10-x64) — use portable win-x64.
	       * SelfContained=true bundles the .NET runtime (the load-bearing flag that kills
	         the ".NET required" prompt); WindowsAppSDKSelfContained=true bundles WinUI 3.
	       * Do NOT enable PublishSingleFile / PublishTrimmed / PublishAot: all three
	         break MAUI Blazor Hybrid (BlazorWebView reflection) and SkiaSharp natives. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<PublishSingleFile>false</PublishSingleFile>
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

	<!-- ============================================================
	     Free the output folder before MSBuild writes RazorReaper.exe
	     ============================================================
	     The ARK link feature registers a Run entry that starts this app headless
	     ("-\-arkwatch", Platforms/Windows/ArkWatch.cs) at every Windows login, and that
	     watcher loops forever. On a dev machine the Run entry points at the build output
	     itself, so the invisible watcher holds RazorReaper.exe locked and the apphost copy
	     fails with MSB3027 / MSB3021 — with nothing on screen to explain why.

	     The script stops only headless watchers running from THIS output folder; a visible
	     instance is reported (RR0002) and left alone. Failures never break the build:
	     worst case the build hits the same MSB3027 it would have hit anyway.

	     Hooked before Clean as well, because Rebuild cleans before it builds and a locked
	     output would otherwise leave stale files behind with MSB3061. Running twice per
	     Rebuild is harmless — the second pass finds nothing to stop. -->
	<Target Name="StopStaleArkWatcher"
	        BeforeTargets="BeforeClean;PrepareForBuild"
	        Condition="'$(OS)' == 'Windows_NT' and Exists('$(TargetDir)')">
		<Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\build\kill-stale-watcher.ps1&quot; -TargetDir &quot;$(TargetDir.TrimEnd('\'))&quot;"
		      ContinueOnError="true"
		      StandardOutputImportance="normal" />
	</Target>

	<!-- MAUI 10's incremental manifest target does not track ApplicationDisplayVersion or
	     ApplicationVersion as inputs. Force the tiny generated manifest to be refreshed so
	     AppInfo metadata can never survive a version bump from an older bin/obj tree. -->
	<Target Name="InvalidateStaleMauiVersionManifest"
	        BeforeTargets="MauiGeneratePackageAppxManifest"
	        Condition="'$(_ResizetizerIsWindowsAppSdk)' == 'True'">
		<Delete Files="$(_MauiManifestStampFile);$(_MauiIntermediateManifest)Package.appxmanifest" />
	</Target>

	<Target Name="ValidateGeneratedMauiVersionManifest"
	        AfterTargets="MauiGeneratePackageAppxManifest"
	        Condition="'$(_ResizetizerIsWindowsAppSdk)' == 'True' and Exists('$(_MauiIntermediateManifest)Package.appxmanifest')">
		<XmlPeek
			Namespaces="&lt;Namespace Prefix='ns' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10'/&gt;"
			XmlInputPath="$(_MauiIntermediateManifest)Package.appxmanifest"
			Query="/ns:Package/ns:Identity/@Version">
			<Output TaskParameter="Result" ItemName="_RazorReaperGeneratedMauiVersion" />
		</XmlPeek>
		<Error
			Condition="'@(_RazorReaperGeneratedMauiVersion)' != '$(ApplicationDisplayVersion).$(ApplicationVersion)'"
			Text="Generated MAUI version '@(_RazorReaperGeneratedMauiVersion)' does not match '$(ApplicationDisplayVersion).$(ApplicationVersion)'. Delete bin/obj and rebuild." />
	</Target>

  <!-- Bundled ffmpeg for the Convert page. Condition, not a hard reference: the binary is
       gitignored (97 MB), so a fresh clone still builds and FfmpegProvider falls back to
       downloading it at runtime. When it is present it lands next to the exe and the Inno
       script picks it up with the rest of the output. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\Tools\ffmpeg.exe')">
    <None Include="Tools\ffmpeg.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ffmpeg.exe</Link>
    </None>
  </ItemGroup>

</Project>
