@using Microsoft.Extensions.Logging
@using RazorReaper.Services
@inject ISupportInboxService Inbox
@inject ILogger<SupportInboxLink> Logger
@implements IDisposable

<a href="/inbox" class="support-inbox-link" aria-label="@($"Support inbox, {Inbox.UnreadCount} unread replies")">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M4 4h16v12H8l-4 4V4Z" stroke-linejoin="round" />
        <path d="M8 8h8M8 12h5" stroke-linecap="round" />
    </svg>
    <span>Inbox</span>
    @if (Inbox.UnreadCount > 0)
    {
        <span class="support-unread" aria-live="polite">@(Inbox.UnreadCount > 99 ? "99+" : Inbox.UnreadCount.ToString())</span>
    }
</a>

@code {
    private readonly CancellationTokenSource _stop = new();
    protected override void OnInitialized()
    {
        Inbox.Changed += OnChanged;
        _ = PollAsync(_stop.Token);
    }
    // This loop is started with `_ = PollAsync(...)`, so nothing observes it: anything it lets
    // escape becomes an unobserved task exception (RR-E1003) every 20s for the session's life.
    private async Task PollAsync(CancellationToken token)
    {
        try
        {
            await Inbox.RefreshAsync(cancellationToken: token);
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(20));
            while (await timer.WaitForNextTickAsync(token)) await Inbox.RefreshAsync(cancellationToken: token);
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (Exception ex) { Logger.LogDebug(ex, "Support inbox poll stopped"); }
    }
    private void OnChanged() => this.DispatchRender(() => InvokeAsync(StateHasChanged), Logger);
    // Cancel but do not dispose: the poll above may still hold this token, and registering on a
    // disposed source throws — which is how a torn-down navbar took the poll loop with it.
    public void Dispose() { this.StopRenderDispatch(); Inbox.Changed -= OnChanged; _stop.Cancel(); }
}
