@* Read-only view of a system-wide hotkey, plus an accent link to where it's set.
   Feature pages use this instead of their own HotkeyField so a binding is only ever
   editable in one place (see Components/Pages/GlobalHotkeys.razor).
   Styled in wwwroot/css/shared/primitives.css. *@

@using RazorReaper.Services.Localization
@inject ILocalizer Localizer

<span class="hk-inline">
    @if (string.IsNullOrWhiteSpace(Value))
    {
        <span class="hk-inline-unset">@Localizer.T("hotkey.unset")</span>
    }
    else
    {
        <kbd class="hk-inline-combo @(Failed ? "hk-dead" : "")">@Value</kbd>
    }
    @if (Failed)
    {
        <HotkeyWarn Owner="@ConflictOwner" />
    }
    <a class="hk-inline-link" href="/hotkeys">@(LinkText ?? Localizer.T("hotkey.changelink"))</a>
</span>

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    /// <summary>The current binding, as the HotkeyField combo string.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>The link's wording. Null takes the general "Change in Global Hotkeys".</summary>
    [Parameter] public string? LinkText { get; set; }

    /// <summary>
    /// The combo is stored but was never registered, so pressing it does nothing. Passed in
    /// from the owner's live state — the warning has to come back after a restart, where the
    /// failed retry says nothing at all.
    /// </summary>
    [Parameter] public bool Failed { get; set; }

    /// <summary>
    /// The RazorReaper feature already holding the key, where there is one. Null keeps the
    /// "another program has it" wording, which is only honest when nothing here holds it.
    /// </summary>
    [Parameter] public string? ConflictOwner { get; set; }
}
