@using RazorReaper.Services
@using RazorReaper.Services.Elevation
@using RazorReaper.Services.Localization
@inject IElevationService Elevation
@inject INotificationService Notifications
@inject NavigationManager Navigation
@inject ILocalizer Localizer

@if (!Elevation.IsElevated)
{
    <div class="elevation-prompt">
        <svg class="elevation-prompt-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 2.5 4 5v4.2c0 3.4 2.4 6 6 7.3 3.6-1.3 6-3.9 6-7.3V5l-6-2.5Z" />
            <path d="M10 8v3.2" />
            <path d="M10 6.2h.01" />
        </svg>
        <div class="elevation-prompt-text">@(Message ?? Localizer.T("elevation.reason"))</div>
        <button class="btn btn-primary" @onclick="Relaunch" disabled="@_busy">
            @Localizer.T(_busy ? "elevation.restarting" : "elevation.restart")
        </button>
    </div>
}

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    /// <summary>
    /// Why this feature needs administrator rights (shown next to the button). Null asks for the
    /// general reason: a parameter default is baked in at compile time and would be English for
    /// the life of the process, so the fallback is resolved where it is rendered instead.
    /// </summary>
    [Parameter] public string? Message { get; set; }

    private bool _busy;

    private void Relaunch()
    {
        if (_busy) return;
        _busy = true;

        // Come back to whatever page we're on now after the elevated relaunch.
        var currentRoute = Navigation.ToBaseRelativePath(Navigation.Uri);

        // On success the process exits and this never returns; only failure/cancel comes back.
        if (!Elevation.RelaunchAsAdministrator(currentRoute, out var error))
        {
            _busy = false;
            Notifications.ShowWarning(error ?? Localizer.T("elevation.failed"));
        }
    }
}
