@using RazorReaper.Models
@using RazorReaper.Services
@using Microsoft.JSInterop
@inject INotificationService NotificationService
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="notification-container">
    @foreach (var notification in notifications)
    {
        @* The slot exists purely to animate the row's height. A toast that slides out while
           still occupying its full height makes the stack below snap upward the instant the
           row is dropped; collapsing the slot gives that reflow somewhere to go. *@
        <div class="notification-slot @(_leaving.Contains(notification.Id) ? "leaving" : "")" @key="notification.Id">
        @* The clip layer carries no padding or border of its own, so it can be squeezed to
           zero. The toast itself can't: its 14px padding and 1px border are part of its
           border box, and no min-height:0 takes a box below that — the row floored at 30px
           until this went in. *@
        <div class="notification-clip">
        <div class="notification notification-@notification.Type.ToString().ToLower()">
            <div class="notification-icon">
                @if (notification.Type == NotificationType.Success)
                {
                    <svg fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                }
                else if (notification.Type == NotificationType.Error)
                {
                    <svg fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                    </svg>
                }
                else if (notification.Type == NotificationType.Warning)
                {
                    <svg fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                }
                else
                {
                    <svg fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                    </svg>
                }
            </div>
            <div class="notification-content">
                <p>@notification.Message</p>
            </div>
            <button class="notification-close" @onclick="() => RemoveNotification(notification.Id)">
                <svg fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
            </button>

            @* Duration comes from the message, so the line always empties exactly when the
               toast goes. Only the update handoff opts in — see NotificationMessage. *@
            @if (notification.ShowCountdown)
            {
                <span class="notification-countdown" style="animation-duration: @(notification.DurationMs)ms"></span>
            }
        </div>
        </div>
        </div>
    }
</div>

@code {
    private const int MaxNotifications = 4;

    /// <summary>
    /// Must cover the whole exit in notifications.css: the 200ms slide-out, then the 140ms
    /// height collapse that starts once it finishes. Drop the row earlier and the stack
    /// still jumps, which is the thing the collapse exists to prevent.
    /// </summary>
    private const int LeaveAnimationMs = 340;

    private List<NotificationMessage> notifications = new();

    /// <summary>Ids currently playing their exit — still rendered, but on the way out.</summary>
    private readonly HashSet<string> _leaving = new(StringComparer.Ordinal);

    private CancellationTokenSource? _autoRemoveCts;

    protected override void OnInitialized()
    {
        _autoRemoveCts = new CancellationTokenSource();
        NotificationService.OnNotificationAdded += OnNotificationAddedSync;
        NotificationService.OnNotificationRemoved += OnNotificationRemovedSync;
    }

    private void OnNotificationAddedSync(NotificationMessage n) => _ = HandleNotificationAddedAsync(n);
    private void OnNotificationRemovedSync(string id) => _ = HandleNotificationRemovedAsync(id);

    private async Task HandleNotificationAddedAsync(NotificationMessage notification)
    {
        try
        {
            // Count only the live ones, and evict the oldest that isn't already exiting —
            // targeting a leaving toast would be a no-op and the stack would keep growing.
            var live = notifications.Where(n => !_leaving.Contains(n.Id)).ToList();
            if (live.Count >= MaxNotifications)
            {
                NotificationService.RemoveNotification(live[0].Id);
            }

            notifications.Add(notification);
            await InvokeAsync(StateHasChanged);
            await PlayNotificationSoundAsync();

            // Auto-remove after duration - run on background thread to avoid UI blocking
            _ = Task.Run(async () =>
            {
                try
                {
                    if (_autoRemoveCts != null && !_autoRemoveCts.Token.IsCancellationRequested)
                    {
                        await Task.Delay(notification.DurationMs, _autoRemoveCts.Token);

                        if (!_autoRemoveCts.Token.IsCancellationRequested)
                        {
                            await InvokeAsync(() => RemoveNotification(notification.Id));
                        }
                    }
                }
                catch (OperationCanceledException)
                {
                    // Component was disposed, ignore
                }
                catch (Exception ex)
                {
                    System.Diagnostics.Debug.WriteLine($"Notification auto-remove failed: {ex.Message}");
                }
            });
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[NotificationContainer] HandleNotificationAddedAsync failed: {ex}");
        }
    }

    private async Task HandleNotificationRemovedAsync(string id)
    {
        try
        {
            var notification = notifications.FirstOrDefault(n => n.Id == id);
            if (notification is null) return;

            // Already on its way out — the auto-remove timer and the close button can
            // both land on the same toast, and running the exit twice makes it flicker.
            if (!_leaving.Add(id)) return;

            // Render the exit, let it play, then actually drop the row.
            await InvokeAsync(StateHasChanged);
            await Task.Delay(LeaveAnimationMs, _autoRemoveCts?.Token ?? CancellationToken.None);

            notifications.Remove(notification);
            _leaving.Remove(id);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Disposed mid-exit; the whole container is going away anyway.
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[NotificationContainer] HandleNotificationRemovedAsync failed: {ex}");
        }
    }

    private void RemoveNotification(string id)
    {
        NotificationService.RemoveNotification(id);
    }

    private async Task PlayNotificationSoundAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("playNotificationSound");
        }
        catch (Exception ex)
        {
            // Sound playback failures should not bubble up.
            System.Diagnostics.Debug.WriteLine($"Notification sound failed: {ex.Message}");
        }
    }

    public void Dispose()
    {
        _autoRemoveCts?.Cancel();
        _autoRemoveCts?.Dispose();

        NotificationService.OnNotificationAdded -= OnNotificationAddedSync;
        NotificationService.OnNotificationRemoved -= OnNotificationRemovedSync;
    }
}
