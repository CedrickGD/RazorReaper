@inject IHostedMediaService HostedMedia
@using RazorReaper.Services
@using RazorReaper.Services.Localization
@inject ILocalizer Localizer

@if (resolvedSrc is not null)
{
    <img src="@resolvedSrc" @attributes="Attributes" />
}
else if (failed)
{
    <div class="hosted-media-placeholder hosted-media-failed" @attributes="Attributes">
        <span>@Localizer.T("media.image.failed")</span>
        <button type="button" class="hosted-media-retry" @onclick="RetryAsync">@Localizer.T("common.retry")</button>
    </div>
}
else
{
    <div class="hosted-media-placeholder" @attributes="Attributes">
        <span class="hosted-media-spinner"></span>
    </div>
}

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    /// <summary>Hosted media path relative to the CDN root, e.g. "images/building/wall-3-correct.jpg".</summary>
    [Parameter, EditorRequired] public string Src { get; set; } = string.Empty;

    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Attributes { get; set; }

    private string? resolvedSrc;
    private bool failed;
    private string? loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == Src)
        {
            return;
        }

        loadedFor = Src;
        await ResolveAsync();
    }

    private async Task RetryAsync()
    {
        failed = false;
        resolvedSrc = null;
        await ResolveAsync();
    }

    private async Task ResolveAsync()
    {
        var requested = Src;
        resolvedSrc = null;
        failed = false;

        var src = await HostedMedia.GetSrcAsync(requested);
        if (loadedFor != requested)
        {
            return; // Parameter changed while downloading; a newer resolve owns the state.
        }

        if (src is null)
        {
            failed = true;
        }
        else
        {
            resolvedSrc = src;
        }
    }
}
