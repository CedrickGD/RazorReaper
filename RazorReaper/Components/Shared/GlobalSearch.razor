@using RazorReaper.Navigation
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IPaletteCommandProvider CommandProvider
@implements IAsyncDisposable

@*
    Command palette (Ctrl+K)
    ------------------------
    Indexes three things, all flattened to PaletteItem:
      · Pages     — every route, from NavCatalog (shared with the sidebar).
      · Locations — maps, caves, bosses and drop areas, from DeepLinkIndex. Selecting one
                    navigates with query parameters so the target page opens preselected.
      · Commands  — actions wired straight to the app's services, run without navigating.

    The sidebar deliberately only shows pinned, recent and one open category, so this is
    the primary way to reach the long tail.
*@

@if (_isVisible)
{
    <div class="search-overlay" @onclick="Close">
        <div class="search-container" @onclick:stopPropagation>
            <div class="search-input-wrapper">
                <svg class="search-input-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="9" r="5.5" />
                    <path d="m13.5 13.5 3 3" />
                </svg>
                @* Only the input carries @onkeydown. Putting it on the overlay as well would
                   also catch the bubbled event and move the selection twice per press. *@
                <input @ref="_inputRef"
                       type="text"
                       class="search-input"
                       placeholder="Search pages, locations and commands..."
                       @bind-value="Query"
                       @bind-value:event="oninput"
                       @onkeydown="HandleKeyDown"
                       autocomplete="off"
                       spellcheck="false" />
                <kbd class="search-kbd">ESC</kbd>
            </div>

            @if (_flat.Count > 0)
            {
                <ul class="search-results" id="rr-search-results">
                    @{
                        var row = 0;
                    }
                    @foreach (var section in _sections)
                    {
                        <li class="search-section-label" aria-hidden="true">@section.Label</li>

                        @foreach (var item in section.Items)
                        {
                            var index = row++;
                            var status = item.Status?.Invoke();

                            <li class="search-result-item @(index == _selectedIndex ? "selected" : "")"
                                id="@RowId(index)"
                                @key="item.Id"
                                @onclick="() => ActivateAsync(item)"
                                @onmouseenter="() => Select(index)">
                                <div class="search-result-icon">
                                    @((MarkupString)item.IconSvg)
                                </div>
                                <div class="search-result-text">
                                    <span class="search-result-title">@item.Title</span>
                                    <span class="search-result-description">@item.Subtitle</span>
                                </div>
                                @if (!string.IsNullOrEmpty(status))
                                {
                                    <span class="search-result-status">@status</span>
                                }
                                <span class="search-result-category">@item.Category</span>
                            </li>
                        }
                    }
                </ul>

                <div class="search-footer">
                    <span class="search-footer-hints">
                        <kbd>↑</kbd><kbd>↓</kbd> navigate
                        <kbd>↵</kbd> @(SelectedItem?.Kind == PaletteKind.Command ? "run" : "open")
                        <kbd>esc</kbd> close
                    </span>
                    <span class="search-footer-count">@CountLabel</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_query))
            {
                <div class="search-empty">
                    <span>No results for "<strong>@_query</strong>"</span>
                </div>
            }
        </div>
    </div>
}

@code {
    /// <summary>Rows rendered at once. Anything beyond this is reported in the footer, never dropped silently.</summary>
    private const int MaxResults = 50;

    private bool _isVisible;
    private string _query = "";
    private int _selectedIndex;
    private int _totalMatches;
    private ElementReference _inputRef;
    private DotNetObjectReference<GlobalSearch>? _dotNetRef;

    /// <summary>Candidate pool, rebuilt on each open because commands carry live user data.</summary>
    private List<PaletteItem> _candidates = new();

    private List<PaletteSection> _sections = new();

    /// <summary>Display order of every rendered row — the index space <see cref="_selectedIndex"/> walks.</summary>
    private List<PaletteItem> _flat = new();

    private bool _scrollPending;

    private sealed record PaletteSection(string Label, List<PaletteItem> Items);

    /// <summary>
    /// Recomputes on assignment rather than in a getter. The previous version filtered inside
    /// a property getter that also reset the selected index — and because the render path reads
    /// that property, every re-render snapped the highlight back to the first row, which made
    /// the arrow keys look broken as soon as you typed anything.
    /// </summary>
    private string Query
    {
        get => _query;
        set
        {
            _query = value ?? "";
            Recompute(resetSelection: true);
        }
    }

    private PaletteItem? SelectedItem =>
        _selectedIndex >= 0 && _selectedIndex < _flat.Count ? _flat[_selectedIndex] : null;

    private string CountLabel => _totalMatches > _flat.Count
        ? $"{_flat.Count} of {_totalMatches}"
        : $"{_flat.Count} result{(_flat.Count == 1 ? "" : "s")}";

    private static string RowId(int index) => $"rr-search-row-{index}";

    // ---- Result building --------------------------------------------------

    private void Recompute(bool resetSelection)
    {
        var ranked = string.IsNullOrWhiteSpace(_query)
            ? BuildDefaultRanking()
            : PaletteSearch.Rank(_candidates, _query);

        _totalMatches = ranked.Count;
        if (ranked.Count > MaxResults) ranked = ranked.Take(MaxResults).ToList();

        _sections = string.IsNullOrWhiteSpace(_query)
            ? BuildDefaultSections(ranked)
            : GroupByKind(ranked);

        _flat = _sections.SelectMany(s => s.Items).ToList();

        if (resetSelection) _selectedIndex = 0;
        else _selectedIndex = Math.Clamp(_selectedIndex, 0, Math.Max(_flat.Count - 1, 0));
    }

    /// <summary>
    /// Sections follow first appearance in the ranked list, so whichever kind holds the best
    /// match leads — and ranking order is preserved inside each section.
    /// </summary>
    private static List<PaletteSection> GroupByKind(List<PaletteItem> ranked)
    {
        var sections = new List<PaletteSection>();

        foreach (var item in ranked)
        {
            var label = KindLabel(item.Kind);
            var section = sections.FirstOrDefault(s => s.Label == label);
            if (section is null)
            {
                section = new PaletteSection(label, new List<PaletteItem>());
                sections.Add(section);
            }
            section.Items.Add(item);
        }

        return sections;
    }

    private static string KindLabel(PaletteKind kind) => kind switch
    {
        PaletteKind.Page => "Pages",
        PaletteKind.DeepLink => "Locations",
        _ => "Commands"
    };

    // ---- Empty-query state ------------------------------------------------
    // Opening the palette used to dump all 40 pages in declaration order, which is a wall,
    // not a starting point. Now it offers where you've just been.

    private List<string> _recentRoutes = new();

    private List<PaletteItem> BuildDefaultRanking()
        => DefaultRecent().Concat(DefaultFallback()).ToList();

    private List<PaletteSection> BuildDefaultSections(List<PaletteItem> _)
    {
        var recent = DefaultRecent();
        return recent.Count > 0
            ? new List<PaletteSection> { new("Recent", recent) }
            : new List<PaletteSection> { new("Jump to", DefaultFallback()) };
    }

    private List<PaletteItem> DefaultRecent()
        => _recentRoutes
            .Select(NavCatalog.FindByRoute)
            .OfType<NavPage>()
            .Select(ToPaletteItem)
            .ToList();

    /// <summary>Shown on a first run, before anything has been visited.</summary>
    private static List<PaletteItem> DefaultFallback()
        => NavCatalog.Groups
            .First()
            .Pages
            .Select(ToPaletteItem)
            .ToList();

    private static PaletteItem ToPaletteItem(NavPage page) => new()
    {
        Kind = PaletteKind.Page,
        Id = $"page:{page.Route}",
        Title = page.Label,
        Subtitle = page.Description,
        Category = page.Category,
        IconSvg = page.IconSvg,
        Keywords = page.Keywords,
        Route = page.Route
    };

    // ---- Lifecycle --------------------------------------------------------

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerGlobalSearch", _dotNetRef);
        }

        if (!_isVisible) return;

        try
        {
            await _inputRef.FocusAsync();
        }
        catch
        {
            // Element may not be rendered yet.
        }

        if (_scrollPending)
        {
            _scrollPending = false;
            try
            {
                // Keyboard selection can walk past the visible window; without this the
                // highlight silently moves off-screen.
                await JS.InvokeVoidAsync("razorReaperSearch.scrollIntoView", RowId(_selectedIndex));
            }
            catch
            {
                // Non-critical.
            }
        }
    }

    [JSInvokable]
    public void ToggleSearch()
    {
        _isVisible = !_isVisible;
        if (_isVisible) _ = InvokeAsync(OpenAsync);
        else _ = InvokeAsync(StateHasChanged);
    }

    private async Task OpenAsync()
    {
        _query = "";
        _selectedIndex = 0;

        // Recents come from the same localStorage the sidebar writes on navigation.
        try
        {
            _recentRoutes = (await JS.InvokeAsync<string[]>("razorReaperNavbar.getRecent")).ToList();
        }
        catch
        {
            _recentRoutes = new List<string>();
        }

        _candidates = BuildCandidates();
        Recompute(resetSelection: true);
        StateHasChanged();
    }

    private List<PaletteItem> BuildCandidates()
    {
        var items = new List<PaletteItem>(NavCatalog.Pages.Count + DeepLinkIndex.Items.Count + 32);
        items.AddRange(NavCatalog.Pages.Select(ToPaletteItem));
        items.AddRange(DeepLinkIndex.Items);

        try
        {
            items.AddRange(CommandProvider.GetCommands());
        }
        catch
        {
            // A service that fails to resolve shouldn't take the whole palette down —
            // pages and locations still work.
        }

        return items;
    }

    private void Close()
    {
        _isVisible = false;
        _query = "";
        _selectedIndex = 0;
        _sections = new List<PaletteSection>();
        _flat = new List<PaletteItem>();
    }

    // ---- Keyboard ---------------------------------------------------------

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (_flat.Count == 0)
        {
            if (e.Key == "Escape") Close();
            return;
        }

        switch (e.Key)
        {
            case "Escape":
                Close();
                break;

            case "ArrowDown":
                Move(1);
                break;

            case "ArrowUp":
                Move(-1);
                break;

            case "Home":
                Select(0);
                break;

            case "End":
                Select(_flat.Count - 1);
                break;

            case "Enter":
                if (SelectedItem is { } selected) await ActivateAsync(selected);
                break;
        }
    }

    private void Move(int delta)
    {
        var count = _flat.Count;
        _selectedIndex = ((_selectedIndex + delta) % count + count) % count;
        _scrollPending = true;
    }

    private void Select(int index)
    {
        if (index < 0 || index >= _flat.Count) return;
        _selectedIndex = index;
    }

    // ---- Activation -------------------------------------------------------

    private async Task ActivateAsync(PaletteItem item)
    {
        if (item.Kind == PaletteKind.Command)
        {
            // Close first: a command can raise a notification or open an overlay, and the
            // palette shouldn't still be covering the screen when it does.
            Close();
            StateHasChanged();

            if (item.Invoke is not null)
            {
                try
                {
                    await item.Invoke();
                }
                catch (Exception ex)
                {
                    Serilog.Log.Warning(ex, "Palette command {Command} failed", item.Id);
                }
            }
            return;
        }

        if (string.IsNullOrWhiteSpace(item.Route)) return;

        Close();
        Navigation.NavigateTo(item.Route);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("unregisterGlobalSearch");
        }
        catch
        {
            // JS interop may fail during disposal.
        }
        _dotNetRef?.Dispose();
    }
}
