@using Microsoft.Extensions.Logging
@using RazorReaper.Services
@using RazorReaper.Services.Localization
@inject IJSRuntime JSRuntime
@inject IFontInstaller FontInstaller
@inject INotificationService NotificationService
@inject IActivityService ActivityService
@inject IUsageGateService UsageGate
@inject ILocalizer Localizer
@inject ILogger<FontSettingsCard> Logger
@implements IDisposable

@* Interface font card, moved off Home onto Settings — appearance belongs with the app
   settings, not the dashboard. Everything is self-contained: presets, the auto-install
   flow through IFontInstaller, and persistence via getFontSettings/updateFontSettings
   (wwwroot/index.html → localStorage). Styled by home-styles.css' font-* classes, which
   are global and don't care which page the card renders on. *@

<div class="content-card font-settings-card collapsible-card">
    <div class="font-settings-header">
        <div>
            <h3>@Localizer.T("settings.font.title")</h3>
            <p class="font-settings-subtitle">@Localizer.T("settings.font.description")</p>
        </div>
        <div class="collapsible-actions">
            <UsageChip Feature="@UsageFeatures.Fonts" />
            <div class="font-current">
                <span class="font-current-label">@Localizer.T("common.active")</span>
                <span class="font-current-value">@GetFontPresetName(selectedFontPresetId)</span>
            </div>
            <button type="button"
                    class="collapsible-toggle"
                    @onclick="ToggleOpen"
                    aria-expanded="@isOpen"
                    aria-controls="font-settings-content">
                <span class="collapsible-toggle-label">@(isOpen ? Localizer.T("common.collapse") : Localizer.T("common.expand"))</span>
                <svg class="collapsible-toggle-icon" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.25a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd" />
                </svg>
            </button>
        </div>
    </div>
    <div id="font-settings-content" class="collapsible-content" hidden="@(!isOpen)">
        <div class="font-preset-grid">
            @foreach (var preset in FontPresets)
            {
                var isActive = selectedFontPresetId == preset.Id;
                var statusLabel = GetFontPresetStatus(preset);
                <button class="font-preset-card @(isActive ? "active" : "")"
                        @onclick="@(() => SelectFontPresetAsync(preset))"
                        disabled="@IsFontPresetInstalling(preset)">
                    <div class="font-preset-top">
                        <span class="font-preset-name">@preset.Name</span>
                        <span class="font-preset-status">@statusLabel</span>
                    </div>
                    <div class="font-preset-description">@PresetDescription(preset.Id)</div>
                    @* A specimen line per language, not one translated sentence: what the card is
                       showing is letterforms, and a Latin pangram says nothing about the shapes a
                       Cyrillic or Chinese reader will actually see. *@
                    <div class="font-preset-preview" style="font-family: @preset.UiStack">
                        @Localizer.T("settings.font.preview")
                    </div>
                </button>
            }
        </div>
        <div class="font-manual-install">
            <div class="font-manual-title">@Localizer.T("settings.font.manual.title")</div>
            <ol class="font-manual-steps">
                <li>@Localizer.T("settings.font.manual.download")</li>
                <li>@Localizer.T("settings.font.manual.unzip")</li>
                @* The bolded word is Windows' own menu item, so it is a key of its own rather
                   than markup inside the sentence — the dictionaries carry no HTML. Its lead
                   and tail bring their own spacing. *@
                <li>@Localizer.T("settings.font.manual.install.lead")<strong>@Localizer.T("settings.font.manual.install.action")</strong>@Localizer.T("settings.font.manual.install.rest")</li>
                <li>@Localizer.T("settings.font.manual.return")</li>
            </ol>
            <div class="font-manual-links">
                @foreach (var preset in FontPresets)
                {
                    if (string.IsNullOrWhiteSpace(preset.DownloadUrl))
                    {
                        continue;
                    }

                    <button class="font-manual-link" @onclick="@(() => CopyFontDownloadLinkAsync(preset))" data-sound-skip="true">
                        <span class="font-manual-link-name">@preset.Name</span>
                        <span class="font-manual-link-url">@preset.DownloadUrl</span>
                    </button>
                }
            </div>
        </div>
        <div class="font-settings-note">@Localizer.T("settings.font.note")</div>
    </div>
</div>

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    private const string FontDefaultPresetId = "system";
    private const string DefaultUiStack = "\"Segoe UI Variable\", \"Segoe UI\", \"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif";
    private const string DefaultMonoStack = "\"Cascadia Code\", \"JetBrainsMono Nerd Font\", \"FiraCode Nerd Font\", Consolas, \"Courier New\", monospace";

    private bool isOpen;
    private bool _isSelectingPreset;
    private string selectedFontPresetId = FontDefaultPresetId;
    private readonly HashSet<string> installingFontPresets = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, bool> fontInstallStatus = new(StringComparer.OrdinalIgnoreCase);
    private bool _hasInitialized;
    private bool _isDisposed;

    /// <summary>
    /// The presets, by id. Names stay here — a typeface is called what it is called in every
    /// language — but the one-line descriptions do not: this list is built once, before anyone
    /// has picked a language, so anything in it would keep the English it was built with.
    /// </summary>
    private static readonly IReadOnlyList<FontPreset> FontPresets = new List<FontPreset>
    {
        new()
        {
            Id = "system",
            Name = "System UI",
            UiStack = DefaultUiStack,
            MonoStack = DefaultMonoStack
        },
        new()
        {
            Id = "space-grotesk",
            Name = "Space Grotesk",
            UiStack = $"\"Space Grotesk\", \"SpaceGrotesk\", {DefaultUiStack}",
            MonoStack = DefaultMonoStack,
            InstallerId = "space-grotesk",
            DownloadUrl = "https://fonts.google.com/specimen/Space+Grotesk"
        },
        new()
        {
            Id = "manrope",
            Name = "Manrope",
            UiStack = $"\"Manrope\", {DefaultUiStack}",
            MonoStack = DefaultMonoStack,
            InstallerId = "manrope",
            DownloadUrl = "https://fonts.google.com/specimen/Manrope"
        },
        new()
        {
            Id = "jetbrains-mono-nerd",
            Name = "JetBrains Mono Nerd",
            UiStack = "\"JetBrainsMono Nerd Font\", \"JetBrainsMono Nerd Font Mono\", \"JetBrains Mono\", \"Cascadia Code\", Consolas, \"Courier New\", monospace",
            MonoStack = "\"JetBrainsMono Nerd Font\", \"JetBrainsMono Nerd Font Mono\", \"JetBrains Mono\", \"Cascadia Code\", Consolas, \"Courier New\", monospace",
            InstallerId = "jetbrains-mono-nerd",
            DownloadUrl = "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.zip"
        },
        new()
        {
            Id = "fira-code-nerd",
            Name = "Fira Code Nerd",
            UiStack = "\"FiraCode Nerd Font\", \"FiraCode Nerd Font Mono\", \"Fira Code\", \"Cascadia Code\", Consolas, \"Courier New\", monospace",
            MonoStack = "\"FiraCode Nerd Font\", \"FiraCode Nerd Font Mono\", \"Fira Code\", \"Cascadia Code\", Consolas, \"Courier New\", monospace",
            InstallerId = "fira-code-nerd",
            DownloadUrl = "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/FiraCode.zip"
        }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // After-render, not OnInitialized: both loads go through JS interop, which is not
        // available before the first render in a BlazorWebView.
        if (!firstRender || _hasInitialized || _isDisposed)
            return;

        _hasInitialized = true;
        await LoadFontSettingsAsync();
        await RefreshFontInstallStatusAsync();
    }

    /// <summary>
    /// The install flow ends in InvokeAsync(StateHasChanged) from a background task; once
    /// the user has navigated away that render hits a disposed renderer, so it is gated.
    /// </summary>
    public void Dispose() => _isDisposed = true;

    private void ToggleOpen() => isOpen = !isOpen;

    private async Task LoadFontSettingsAsync()
    {
        try
        {
            var settings = await JSRuntime.InvokeAsync<FontSettings>("getFontSettings");
            var preset = ResolveFontPreset(settings?.PresetId);
            selectedFontPresetId = preset.Id;

            if (string.IsNullOrWhiteSpace(settings?.UiStack) || string.IsNullOrWhiteSpace(settings?.MonoStack))
            {
                await PersistFontSettingsAsync(preset);
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not load font settings");
        }
    }

    private async Task SelectFontPresetAsync(FontPreset preset)
    {
        if (selectedFontPresetId == preset.Id) return; // re-clicking the active preset is a no-op
        // Set synchronously before the first await: a double-click's second invocation runs
        // during the consume round-trip, when selectedFontPresetId is still stale — without
        // this flag it would burn a second quota use (the whole month, at a limit of 2).
        if (_isSelectingPreset) return;
        _isSelectingPreset = true;

        try
        {
            // The default (System UI) is always free — the way back never counts. Only switching
            // TO a non-default preset draws from the monthly quota.
            if (preset.Id != FontDefaultPresetId)
            {
                var gate = await UsageGate.TryConsumeAsync(UsageFeatures.Fonts);
                if (!gate.Allowed)
                {
                    NotificationService.ShowWarning(Localizer.T("settings.font.limit", gate.Limit));
                    return;
                }
            }

            selectedFontPresetId = preset.Id;
            await PersistFontSettingsAsync(preset);

            ActivityService.AddActivity(Localizer.T("settings.font.activity.set", preset.Name), "info");
            Logger.LogInformation("UI font preset selected: {PresetId}", preset.Id);

            _ = EnsureFontPresetInstalledAsync(preset);
        }
        finally
        {
            _isSelectingPreset = false;
        }
    }

    private async Task PersistFontSettingsAsync(FontPreset preset)
    {
        try
        {
            var settings = new FontSettings
            {
                PresetId = preset.Id,
                UiStack = preset.UiStack,
                MonoStack = preset.MonoStack
            };

            await JSRuntime.InvokeVoidAsync("updateFontSettings", settings);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not save font settings");
        }
    }

    private async Task EnsureFontPresetInstalledAsync(FontPreset preset)
    {
        if (string.IsNullOrWhiteSpace(preset.InstallerId))
        {
            fontInstallStatus[preset.Id] = true;
            return;
        }

        if (IsFontPresetInstalled(preset))
        {
            return;
        }

        if (!installingFontPresets.Add(preset.Id))
        {
            return;
        }

        // Started with `_ = EnsureFontPresetInstalledAsync(...)`, so neither this dispatch nor the
        // one in the finally below has an observer if the renderer goes away mid-install.
        this.DispatchRender(() => InvokeAsync(StateHasChanged), Logger);

        NotificationService.ShowInfo(Localizer.T("settings.font.toast.installing", preset.Name));

        try
        {
            await FontInstaller.EnsureFontInstalledAsync(preset.InstallerId);
            var installed = FontInstaller.IsFontInstalled(preset.InstallerId);
            fontInstallStatus[preset.Id] = installed;

            if (installed)
            {
                NotificationService.ShowSuccess(Localizer.T("settings.font.toast.installed", preset.Name));
                await PersistFontSettingsAsync(preset);
            }
            else
            {
                NotificationService.ShowWarning(Localizer.T("settings.font.toast.pending", preset.Name));
            }
        }
        catch (InvalidDataException ex)
        {
            Logger.LogError(ex, "Invalid font package for preset {PresetId}", preset.Id);
            NotificationService.ShowError(Localizer.T("settings.font.error.package"));
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogError(ex, "Font files could not be installed for preset {PresetId}", preset.Id);
            NotificationService.ShowError(Localizer.T("settings.font.error.inuse"));
        }
        catch (System.Net.Http.HttpRequestException ex)
        {
            Logger.LogError(ex, "Font download failed for preset {PresetId}", preset.Id);
            NotificationService.ShowError(Localizer.T("settings.font.error.download"));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error installing font preset {PresetId}", preset.Id);
            NotificationService.ShowError(Localizer.T("settings.font.error.install", ex.Message));
        }
        finally
        {
            installingFontPresets.Remove(preset.Id);
            this.DispatchRender(() => InvokeAsync(StateHasChanged), Logger);
        }
    }

    private async Task RefreshFontInstallStatusAsync()
    {
        try
        {
            foreach (var preset in FontPresets)
            {
                if (string.IsNullOrWhiteSpace(preset.InstallerId))
                {
                    fontInstallStatus[preset.Id] = true;
                    continue;
                }

                fontInstallStatus[preset.Id] = FontInstaller.IsFontInstalled(preset.InstallerId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not refresh font installation status");
        }

        if (!_isDisposed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool IsFontPresetInstalled(FontPreset preset)
    {
        if (string.IsNullOrWhiteSpace(preset.InstallerId))
        {
            return true;
        }

        return fontInstallStatus.TryGetValue(preset.Id, out var installed) && installed;
    }

    /// <summary>
    /// Spelled out one branch per id rather than composed from it. A key built by concatenation
    /// is a key no search finds and no test can see, and the dictionaries are checked for keys
    /// nothing renders.
    /// </summary>
    private string PresetDescription(string presetId) => presetId switch
    {
        "system" => Localizer.T("settings.font.preset.system.description"),
        "space-grotesk" => Localizer.T("settings.font.preset.space-grotesk.description"),
        "manrope" => Localizer.T("settings.font.preset.manrope.description"),
        "jetbrains-mono-nerd" => Localizer.T("settings.font.preset.jetbrains-mono-nerd.description"),
        "fira-code-nerd" => Localizer.T("settings.font.preset.fira-code-nerd.description"),
        _ => string.Empty
    };

    private string GetFontPresetStatus(FontPreset preset)
    {
        if (string.IsNullOrWhiteSpace(preset.InstallerId))
        {
            return Localizer.T("settings.font.status.system");
        }

        if (IsFontPresetInstalling(preset))
        {
            return Localizer.T("settings.font.status.installing");
        }

        return IsFontPresetInstalled(preset)
            ? Localizer.T("settings.font.status.installed")
            : Localizer.T("settings.font.status.autoinstall");
    }

    private string GetFontPresetName(string presetId)
    {
        return ResolveFontPreset(presetId).Name;
    }

    private bool IsFontPresetInstalling(FontPreset preset)
    {
        return installingFontPresets.Contains(preset.Id);
    }

    private async Task CopyFontDownloadLinkAsync(FontPreset preset)
    {
        if (string.IsNullOrWhiteSpace(preset.DownloadUrl))
        {
            return;
        }

        try
        {
            await Clipboard.Default.SetTextAsync(preset.DownloadUrl);
            NotificationService.ShowSuccess(Localizer.T("settings.font.toast.linkcopied", preset.Name));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error copying font download link for {PresetId}", preset.Id);
            NotificationService.ShowError(Localizer.T("settings.font.error.linkcopy"));
        }
    }

    private FontPreset ResolveFontPreset(string? presetId)
    {
        if (!string.IsNullOrWhiteSpace(presetId))
        {
            var match = FontPresets.FirstOrDefault(preset =>
                string.Equals(preset.Id, presetId, StringComparison.OrdinalIgnoreCase));
            if (match != null)
            {
                return match;
            }
        }

        return FontPresets[0];
    }

    private sealed class FontSettings
    {
        public string? PresetId { get; set; }
        public string? UiStack { get; set; }
        public string? MonoStack { get; set; }
    }

    private sealed class FontPreset
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string UiStack { get; set; } = "";
        public string MonoStack { get; set; } = "";
        public string? InstallerId { get; set; }
        public string? DownloadUrl { get; set; }
    }
}
