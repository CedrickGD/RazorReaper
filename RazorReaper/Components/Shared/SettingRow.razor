@* Shared settings row: title + optional description on the left, a control slot on the right.
   Put the control (Switch, HotkeyField, buttons, ...) in the child content.
   Disabled only dims the row visually — the nested control's own Disabled state
   still governs interactivity. Styled in wwwroot/css/shared/primitives.css. *@

<div class="setting-row @(Disabled ? "disabled" : "")">
    <div class="setting-row-info">
        <div class="setting-row-title">@Title</div>
        @if (!string.IsNullOrEmpty(Description))
        {
            <div class="setting-row-desc">@Description</div>
        }
    </div>
    <div class="setting-row-control">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
