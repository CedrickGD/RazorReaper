@using RazorReaper.Services
@inject IAccessGateService AccessGate
@implements IDisposable

@{
    var isBan = string.Equals(AccessGate.Mode, "ban", StringComparison.OrdinalIgnoreCase);
    var heading = isBan ? "Access permanently revoked" : "Access suspended";
}

<div class="access-blocked-overlay @(isBan ? "is-ban" : "is-suspend")">
    <div class="ab-card">
        <div class="ab-icon">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
        </div>

        <h1 class="ab-heading">@heading</h1>

        <p class="ab-text">
            Your access to RazorReaper on this machine has been @(isBan ? "revoked" : "temporarily suspended") by an administrator.
        </p>

        @if (!string.IsNullOrWhiteSpace(AccessGate.Reason))
        {
            <div class="ab-reason">
                <div class="ab-reason-label">Reason</div>
                <div class="ab-reason-text">@AccessGate.Reason</div>
            </div>
        }

        @if (!isBan && AccessGate.BannedUntil is not null)
        {
            <p class="ab-until">
                Access returns automatically on <strong>@AccessGate.BannedUntil.Value.ToString("f")</strong>.
            </p>
        }

        <div class="ab-actions">
            <button class="btn btn-secondary" @onclick="ReCheck" disabled="@_checking">
                @(_checking ? "Checking…" : "Re-check access")
            </button>
        </div>

        <p class="ab-footnote">
            Believe this is a mistake? Reach out in the RazorReaper Discord.
        </p>
    </div>
</div>

<style>
    .access-blocked-overlay {
        --gate-accent: var(--accent-orange);
        --gate-accent-rgb: var(--accent-orange-rgb);
        position: fixed;
        inset: 0;
        z-index: 2147483000;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(120% 120% at 50% 0%, rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.95));
        backdrop-filter: blur(14px);
        -webkit-app-region: drag;
        padding: var(--space-5);
    }

        .access-blocked-overlay.is-ban {
            --gate-accent: var(--accent-red);
            --gate-accent-rgb: var(--accent-red-rgb);
        }

    .ab-card {
        max-width: 460px;
        width: 100%;
        text-align: center;
        -webkit-app-region: no-drag;
        background: var(--background-card);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-card);
        padding: 40px 36px;
        box-shadow: 0 30px 90px rgba(0, 0, 0, 0.6);
    }

    .ab-icon {
        width: 66px;
        height: 66px;
        margin: 0 auto 22px;
        border-radius: var(--radius-panel);
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(var(--gate-accent-rgb), 0.10);
        color: var(--gate-accent);
    }

    .ab-heading {
        font-size: 1.4rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0 0 10px;
    }

    .ab-text {
        font-size: 0.9rem;
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 0 0 4px;
    }

    .ab-reason {
        margin: 18px 0 4px;
        padding: var(--space-3) var(--space-4);
        border-radius: var(--radius-control);
        background: var(--surface-inset);
        border: 1px solid rgba(var(--gate-accent-rgb), 0.20);
        text-align: left;
    }

    .ab-reason-label {
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--gate-accent);
        margin-bottom: 4px;
    }

    .ab-reason-text {
        font-size: 0.85rem;
        color: var(--text-primary);
        line-height: 1.5;
    }

    .ab-until {
        font-size: 0.82rem;
        color: var(--text-secondary);
        margin: 16px 0 0;
    }

        .ab-until strong {
            color: var(--text-primary);
            font-weight: 600;
        }

    .ab-actions {
        margin-top: 26px;
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .ab-footnote {
        font-size: 0.72rem;
        color: var(--text-secondary);
        margin: 20px 0 0;
        line-height: 1.5;
    }
</style>

@code {
    private bool _checking;

    protected override void OnInitialized()
    {
        AccessGate.OnAccessStateChanged += HandleChanged;
    }

    private async Task ReCheck()
    {
        if (_checking) return;
        _checking = true;
        try
        {
            await AccessGate.CheckNowAsync();
        }
        finally
        {
            _checking = false;
        }
    }

    private void HandleChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => AccessGate.OnAccessStateChanged -= HandleChanged;
}
