@* Custom color picker: a tinted swatch + hex input. Click the swatch to open a popover with a
   preset palette, a hue slider, a saturation/value square, and the native color dialog as a fallback.
   Backdrop closes on outside click. Two-way bind via @bind-Value (a #RRGGBB string).
   Popover is fixed-positioned with viewport-aware top/left computed on open via rrColorMeasurePop
   so it never overhangs other widgets or the window edge. *@
@using RazorReaper.Services.Localization
@inject IJSRuntime JS
@inject ILocalizer Localizer

<div class="rr-color @(_open ? "open" : "") @(_flipUp ? "flip-up" : "")">
    <button class="rr-color-swatch" type="button"
            style="background:@Value"
            @onclick="Toggle"
            @ref="_swatchEl"
            title="@Localizer.T("colorfield.pick")">
        <span class="rr-color-swatch-glow"></span>
    </button>
    <input type="text" class="rr-color-hex"
           value="@Value"
           @oninput="OnHexInput"
           spellcheck="false"
           maxlength="9" />

    @if (_open)
    {
        <div class="rr-color-backdrop" @onclick="Close"></div>
        <div class="rr-color-pop"
             @onclick:stopPropagation="true">
            <div class="rr-color-pop-presets">
                @foreach (var hex in Presets)
                {
                    <button type="button"
                            class="rr-color-pop-preset @(string.Equals(hex, Value, StringComparison.OrdinalIgnoreCase) ? "selected" : "")"
                            style="background:@hex"
                            title="@hex"
                            @onclick="@(() => Pick(hex))"></button>
                }
            </div>
            <div class="rr-color-pop-row">
                <input type="color" class="rr-color-pop-native"
                       value="@Value"
                       @onchange="OnNativeInput" />
                <input type="text" class="rr-color-pop-hex"
                       value="@Value"
                       @oninput="OnHexInput"
                       spellcheck="false"
                       maxlength="9" />
                <button type="button" class="rr-color-pop-close" @onclick="Close">@Localizer.T("colorfield.done")</button>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    [Parameter] public string Value { get; set; } = "#FFFFFF";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private bool _open;
    private bool _flipUp;
    private ElementReference _swatchEl;

    // Approximate popover height for the flip decision — matches the CSS .rr-color-pop
    // (presets row + native picker row + padding). Slightly oversized is safer than
    // undersized; flipping a touch early is preferable to overflowing the viewport.
    private const double PopHeight = 240;

    // Hand-picked tactical/aim-friendly palette + a few neutrals.
    private static readonly string[] Presets = new[]
    {
        "#FFFFFF", "#000000", "#FF1744", "#FF6E40",
        "#FFC400", "#FFEE00", "#00E676", "#00FF66",
        "#00FFFF", "#2979FF", "#8B5CF6", "#FF00FF",
    };

    private async Task Toggle()
    {
        if (_open)
        {
            _open = false;
            return;
        }
        try
        {
            _flipUp = await JS.InvokeAsync<bool>("rrColorMeasureFlip", _swatchEl, PopHeight);
        }
        catch
        {
            _flipUp = false;
        }
        _open = true;
    }
    private void Close() => _open = false;

    private async Task Pick(string hex)
    {
        Value = hex.ToUpperInvariant();
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task OnHexInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString()?.Trim();
        if (string.IsNullOrEmpty(raw)) return;
        if (!raw.StartsWith("#")) raw = "#" + raw;
        if (raw.Length != 7 && raw.Length != 9) return;
        // Only accept hex characters in the body.
        for (var i = 1; i < raw.Length; i++)
        {
            if (!Uri.IsHexDigit(raw[i])) return;
        }
        Value = raw.ToUpperInvariant();
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task OnNativeInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        if (string.IsNullOrEmpty(raw)) return;
        Value = raw.ToUpperInvariant();
        await ValueChanged.InvokeAsync(Value);
    }
}
