@using Microsoft.AspNetCore.Components.Routing
@using RazorReaper.Services
@inject ILicenseService LicenseService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<nav class="sidebar @(LicenseService.IsActivated ? "" : "locked-content")" data-sidebar @ref="_navRef">
    <div class="brand">
        <img class="brand-logo" src="images/RRlogo.png" alt="Razor Reaper logo" />
    </div>

    <div class="search-trigger" @onclick="OpenSearch" title="Search (Ctrl+K)">
        <svg class="search-trigger-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="9" r="5.5" />
            <path d="m13.5 13.5 3 3" />
        </svg>
        <span class="search-trigger-text">Search...</span>
        <kbd class="search-trigger-kbd">Ctrl K</kbd>
    </div>

    <div class="nav-content">
        @foreach (var group in NavGroups)
        {
            var isCollapsed = IsGroupCollapsed(group.Name);
            <div class="nav-group @(isCollapsed ? "collapsed" : "")" data-group="@group.Name">
                <button type="button"
                        class="nav-group-label"
                        @onclick="() => ToggleGroupAsync(group.Name)"
                        aria-expanded="@(!isCollapsed)">
                    <span class="nav-group-label-text">@group.Name</span>
                    <svg class="nav-group-chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m3.5 5 2.5 2.5L8.5 5" />
                    </svg>
                </button>

                <ul class="nav-menu">
                    @foreach (var item in group.Items)
                    {
                        <li class="nav-item">
                            @* No `title` here — we render a themed tooltip via JS in rail mode (see navbar.js / .rail-tooltip).
                               The native OS tooltip would compete with our custom one. The .nav-link-label span below
                               provides the source text. *@
                            <a href="@item.Href" class="nav-link @GetActiveClass(item.Href)">
                                <span class="nav-icon-wrap">
                                    @((MarkupString)item.IconSvg)
                                </span>
                                <span class="nav-link-label">@item.Label</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

    @* Drag-to-resize. The pointerdown listener is attached directly to the DOM
       node via JS after first render (see OnAfterRenderAsync below), bypassing
       Blazor's event indirection entirely — that turned out to be the difference
       between events firing and not firing under WebView2. *@
    <div class="sidebar-resize-handle"
         title="Drag to resize"
         @ref="_resizeHandleRef"></div>
</nav>

@code {
