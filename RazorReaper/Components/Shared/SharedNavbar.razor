    private ElementReference _resizeHandleRef;
    private DotNetObjectReference<SharedNavbar>? _dotNetRef;
    private HashSet<string> _collapsedGroups = new(StringComparer.Ordinal);
    private bool _initialStateLoaded;
    private bool _resizeHandleAttached;

