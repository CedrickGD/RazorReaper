    protected override void OnInitialized()
    {
        LicenseService.OnLicenseStateChanged += OnLicenseStateChangedHandler;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void OnLicenseStateChangedHandler()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("registerNavbar", _dotNetRef);
            }
            catch
            {
                // JS may not yet be ready in some hosting scenarios; non-fatal.
            }

            await LoadGroupStateAsync();
            await AutoExpandActiveGroupAsync();
        }

        if (!_resizeHandleAttached)
        {
            try
            {
                // Pass the DOM node to JS; razorReaperNavbar.attachResizeHandle will
                // bind a native pointerdown listener that starts the drag. We do this
                // here (vs. @onpointerdown) because Blazor's pointer event path was
                // not firing reliably for this element in WebView2.
                await JS.InvokeVoidAsync("razorReaperNavbar.attachResizeHandle", _resizeHandleRef);
                _resizeHandleAttached = true;
            }
            catch
            {
                // Will retry on the next render cycle.
            }
        }
    }

    private async Task LoadGroupStateAsync()
    {
        if (_initialStateLoaded) return;
        _initialStateLoaded = true;

        try
        {
            foreach (var group in NavGroups)
            {
                var collapsed = await JS.InvokeAsync<bool>("razorReaperNavbar.isGroupCollapsed", group.Name);
                if (collapsed)
                {
                    _collapsedGroups.Add(group.Name);
                }
            }
            StateHasChanged();
        }
        catch
        {
            // JS interop may fail in some hosting scenarios; default to all-expanded.
        }
    }

    private Task AutoExpandActiveGroupAsync()
    {
        var activeGroup = FindActiveGroup();
        if (activeGroup is null) return Task.CompletedTask;

        if (_collapsedGroups.Remove(activeGroup))
        {
            // Persist the auto-expansion so the user sees their explicit collapse honored
            // only until they navigate into that group.
            _ = JS.InvokeVoidAsync("razorReaperNavbar.setGroupCollapsed", activeGroup, false);
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    private string? FindActiveGroup()
    {
        var currentPath = NormalizedCurrentPath();
        foreach (var group in NavGroups)
        {
            foreach (var item in group.Items)
            {
                if (IsHrefActive(item.Href, currentPath))
                {
                    return group.Name;
                }
            }
        }
        return null;
    }

    private string NormalizedCurrentPath()
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        currentPath = currentPath.Split('?', '#')[0];
        return currentPath.Trim('/');
    }

    private bool IsGroupCollapsed(string name) => _collapsedGroups.Contains(name);

    private async Task ToggleGroupAsync(string name)
    {
        bool nowCollapsed;
        if (_collapsedGroups.Contains(name))
        {
            _collapsedGroups.Remove(name);
            nowCollapsed = false;
        }
        else
        {
            _collapsedGroups.Add(name);
            nowCollapsed = true;
        }

        try
        {
            await JS.InvokeVoidAsync("razorReaperNavbar.setGroupCollapsed", name, nowCollapsed);
        }
        catch
        {
            // Non-critical if persistence fails.
        }
    }

    [JSInvokable]
    public Task OnExternalCollapseToggle()
    {
        // Fires when navbar.js toggles collapsed state (Ctrl+B shortcut or drag past
        // the collapse threshold). The CSS handles the visual; we re-render so any
        // bindings driven by collapsed state get a chance to refresh.
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Bridge for the runtime test runner (wwwroot/_tests/test-runner.js).
    /// Writes a single line to %LOCALAPPDATA%\RazorReaper\Logs\test-results.log
    /// so JS-side test results survive across launches.
    /// </summary>
    [JSInvokable]
    public Task WriteDiagnostic(string message)
    {
        Serilog.Log.Information("WriteDiagnostic called from JS: {Message}", message);
        try
        {
            var dir = System.IO.Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
                "RazorReaper",
                "Logs");
            System.IO.Directory.CreateDirectory(dir);
            var path = System.IO.Path.Combine(dir, "test-results.log");
            var line = $"[{DateTime.Now:yyyy-MM-dd HH:mm:ss}] {message}{Environment.NewLine}";
            System.IO.File.AppendAllText(path, line);
        }
        catch (Exception ex)
        {
            Serilog.Log.Warning(ex, "WriteDiagnostic failed");
        }
        return Task.CompletedTask;
    }

    private async Task OpenSearch()
    {
        try
        {
            await JS.InvokeVoidAsync("triggerGlobalSearch");
        }
        catch
        {
            // Search palette JS not ready; ignore.
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await AutoExpandActiveGroupAsync();
            StateHasChanged();
        });
    }

    private string GetActiveClass(string href)
    {
        return IsHrefActive(href, NormalizedCurrentPath()) ? "active" : "";
    }

    private static bool IsHrefActive(string href, string normalizedCurrent)
    {
        var normalizedHref = href.Trim('/');

        if (string.IsNullOrEmpty(normalizedCurrent) && normalizedHref.Equals("home", StringComparison.OrdinalIgnoreCase))
            return true;

        if (string.Equals(normalizedCurrent, normalizedHref, StringComparison.OrdinalIgnoreCase))
            return true;

        if (normalizedCurrent.StartsWith(normalizedHref + "/", StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    }

    public async ValueTask DisposeAsync()
    {
        LicenseService.OnLicenseStateChanged -= OnLicenseStateChangedHandler;
        Navigation.LocationChanged -= HandleLocationChanged;

        try
        {
            await JS.InvokeVoidAsync("unregisterNavbar");
        }
        catch
        {
            // JS interop may fail during disposal.
        }

        _dotNetRef?.Dispose();
    }
}
