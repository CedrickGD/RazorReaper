@using Microsoft.AspNetCore.Components.Routing
@using RazorReaper.Navigation
@using RazorReaper.Services
@using RazorReaper.Services.Implementations
@inject ILicenseService LicenseService
@inject IUpdateService UpdateService
@inject IAppRunMode AppRunMode
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

@*
    Sidebar structure — icon rail + pinned panel
    -------------------------------------------
    Left: a thin rail of the seven category icons, always visible.
    Right: a panel listing the selected category's pages, always open.

    Clicking a rail icon swaps the panel. Nothing opens on hover, so there is no
    transient surface to chase with the pointer, and the panel fills the column
    height instead of leaving a void under a short list.

    There is deliberately no icon-only mode: the panel never collapses, so the
    sidebar always reads as labelled navigation.
*@

<nav class="sidebar @(LicenseService.IsActivated ? "" : "locked-content")" data-sidebar @ref="_navRef">

    @* Header and search span the FULL sidebar width, above the rail/panel split.
       Tucking the logo into the 54px rail and the search into the panel left three
       mismatched boxes stacked in the corner, and squeezed the search to "Se…".
       No wordmark — the title bar already says the name. *@
    <div class="nav-head">
        <img class="brand-logo" src="images/RRlogo.png" alt="Razor Reaper" />
    </div>

    <button type="button" class="search-trigger" @onclick="OpenSearch" title="Search pages, locations and commands (Ctrl+K)">
        <svg class="search-trigger-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="9" r="5.5" />
            <path d="m13.5 13.5 3 3" />
        </svg>
        <span class="search-trigger-text">Search</span>
        <kbd class="search-trigger-kbd">Ctrl K</kbd>
    </button>

    <div class="nav-split">

    <div class="nav-rail">
        <ul class="rail-items">
            @foreach (var group in NavCatalog.Groups)
            {
                var isSelected = group.Name == _selectedGroup;
                var holdsActive = GroupHoldsActivePage(group);

                <li @key="group.Name">
                    <button type="button"
                            class="rail-btn @(isSelected ? "selected" : "") @(holdsActive ? "has-active" : "")"
                            title="@group.Name"
                            aria-label="@group.Name"
                            aria-pressed="@isSelected"
                            @onclick="() => SelectGroup(group.Name)">
                        <span class="rail-icon">@((MarkupString)group.IconSvg)</span>
                    </button>
                </li>
            }
        </ul>
    </div>

    <div class="nav-panel">
        @* @key on the group name remounts the list when the category changes, which
           restarts the entry animation instead of silently swapping the text. *@
        <div class="panel-body" @key="_selectedGroup">
            <div class="panel-title">@_selectedGroup</div>
            <ul class="panel-list">
                @foreach (var entry in SelectedPages)
                {
                    <li @key="entry.Route">
                        <a href="@entry.Route" class="panel-link @GetActiveClass(entry.Route)">
                            <span class="nav-icon-wrap">@((MarkupString)entry.IconSvg)</span>
                            <span class="panel-label">@entry.Label</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>

    </div>

    @* Its own section at the foot, laid out like the status block in the admin panel:
       a rule, a dot + state on top, muted meta underneath. Parenthesise the version —
       "v@UpdateService..." parses as literal text, which is how it rendered wrong once. *@
    @if (LocalPreviewMarketingPolicy.ShouldShowSidebarStatus(AppRunMode))
    {
        <div class="nav-status">
            <div class="nav-status-line" title="@LicenseTooltip">
                <span class="nav-status-dot @LicenseDotClass"></span>
                <span class="nav-status-label">@LicenseLabel</span>
            </div>
            @if (LocalPreviewMarketingPolicy.ShouldShowVersion(AppRunMode))
            {
                <div class="nav-status-meta">@($"v{UpdateService.CurrentVersionLabel}")</div>
            }
        </div>
    }

    @* Drag-to-resize. The pointerdown listener is attached directly to the DOM
       node via JS after first render (see OnAfterRenderAsync below), bypassing
       Blazor's event indirection entirely — that turned out to be the difference
       between events firing and not firing under WebView2. *@
    <div class="sidebar-resize-handle" title="Drag to resize" @ref="_resizeHandleRef">
        <span class="resize-grip"></span>
    </div>
</nav>

@code {
    private ElementReference _navRef;
    private ElementReference _resizeHandleRef;
    private DotNetObjectReference<SharedNavbar>? _dotNetRef;
    private bool _resizeHandleAttached;

    /// <summary>Category whose pages the panel is showing.</summary>
    private string _selectedGroup = NavCatalog.Groups[0].Name;

    private IReadOnlyList<NavPage> SelectedPages =>
        NavCatalog.Groups.FirstOrDefault(g => g.Name == _selectedGroup)?.Pages
        ?? NavCatalog.Groups[0].Pages;

    protected override void OnInitialized()
    {
        LicenseService.OnLicenseStateChanged += OnLicenseStateChangedHandler;
        Navigation.LocationChanged += HandleLocationChanged;
        SyncPanelToCurrentPage();
    }

    private void OnLicenseStateChangedHandler() => InvokeAsync(StateHasChanged);

    // ---- Foot status ------------------------------------------------------
    // The one thing in the sidebar that changes on its own, so the one thing that
    // earns a colour.

    // Two states only. The plan name, expiry and countdown live in the Home
    // page's license widget; this is just the at-a-glance tier.
    private string LicenseLabel => LicenseService.IsPremium ? "Premium" : "Freemium";

    private string LicenseDotClass => LicenseService.IsPremium ? "premium" : "freemium";

    private string LicenseTooltip => LicenseService.IsPremium
        ? "Premium — see Home for plan and expiry"
        : "Freemium — see Home to activate a key";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("registerNavbar", _dotNetRef);
            }
            catch
            {
                // JS may not yet be ready in some hosting scenarios; non-fatal.
            }

            await RecordVisitAsync();
        }

        if (!_resizeHandleAttached)
        {
            try
            {
                // Pass the DOM node to JS; razorReaperNavbar.attachResizeHandle will
                // bind a native pointerdown listener that starts the drag. We do this
                // here (vs. @onpointerdown) because Blazor's pointer event path was
                // not firing reliably for this element in WebView2.
                await JS.InvokeVoidAsync("razorReaperNavbar.attachResizeHandle", _resizeHandleRef);
                _resizeHandleAttached = true;
            }
            catch
            {
                // Will retry on the next render cycle.
            }
        }
    }

    private void SelectGroup(string name) => _selectedGroup = name;

    /// <summary>
    /// Points the panel at whichever category owns the current page, so arriving from
    /// a link or the command palette leaves the panel showing where you actually are.
    /// Browsing another category by clicking the rail is left alone until you navigate.
    /// </summary>
    private void SyncPanelToCurrentPage()
    {
        var group = NavCatalog.FindGroupName(NormalizedCurrentPath());
        if (group is not null) _selectedGroup = group;
    }

    /// <summary>
    /// Records the page in the recents list. Nothing in the sidebar shows it — the command
    /// palette uses it to decide what to offer before you've typed anything.
    /// </summary>
    private async Task RecordVisitAsync()
    {
        // The root URL normalizes to "", and FindByRoute rejects an empty route outright, so
        // guarding before the fallback meant Home bailed out here on every visit and never
        // reached the palette's Recent list. Map onto the catalog key first, then guard.
        var route = NormalizedCurrentPath();
        if (route.Length == 0) route = "home";
        if (NavCatalog.FindByRoute(route) is null) return;

        try
        {
            await JS.InvokeVoidAsync("razorReaperNavbar.pushRecent", route);
        }
        catch
        {
            // Recents are a convenience; losing them is not worth surfacing.
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            SyncPanelToCurrentPage();
            await RecordVisitAsync();
            StateHasChanged();
        });
    }

    private async Task OpenSearch()
    {
        try
        {
            await JS.InvokeVoidAsync("triggerGlobalSearch");
        }
        catch
        {
            // Search palette JS not ready; ignore.
        }
    }

    // ---- Active-route helpers ---------------------------------------------

    private bool GroupHoldsActivePage(NavGroup group)
    {
        var current = NormalizedCurrentPath();
        return group.Pages.Any(p => IsHrefActive(p.Route, current));
    }

    private string NormalizedCurrentPath()
        => NavCatalog.Normalize(Navigation.ToBaseRelativePath(Navigation.Uri));

    private string GetActiveClass(string href)
        => IsHrefActive(href, NormalizedCurrentPath()) ? "active" : "";

    private static bool IsHrefActive(string href, string normalizedCurrent)
    {
        var normalizedHref = NavCatalog.Normalize(href);

        if (string.IsNullOrEmpty(normalizedCurrent) && normalizedHref.Equals("home", StringComparison.OrdinalIgnoreCase))
            return true;

        if (string.Equals(normalizedCurrent, normalizedHref, StringComparison.OrdinalIgnoreCase))
            return true;

        if (normalizedCurrent.StartsWith(normalizedHref + "/", StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    }

    // ---- JS callbacks -----------------------------------------------------

    /// <summary>
    /// Bridge for the runtime test runner (wwwroot/_tests/test-runner.js).
    /// Writes a single line to %LOCALAPPDATA%\RazorReaper\Logs\test-results.log
    /// so JS-side test results survive across launches.
    /// </summary>
    [JSInvokable]
    public Task WriteDiagnostic(string message)
    {
        Serilog.Log.Information("WriteDiagnostic called from JS: {Message}", message);
        try
        {
            var dir = System.IO.Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
                "RazorReaper",
                "Logs");
            System.IO.Directory.CreateDirectory(dir);
            var path = System.IO.Path.Combine(dir, "test-results.log");
            var line = $"[{DateTime.Now:yyyy-MM-dd HH:mm:ss}] {message}{Environment.NewLine}";
            System.IO.File.AppendAllText(path, line);
        }
        catch (Exception ex)
        {
            Serilog.Log.Warning(ex, "WriteDiagnostic failed");
        }
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        LicenseService.OnLicenseStateChanged -= OnLicenseStateChangedHandler;
        Navigation.LocationChanged -= HandleLocationChanged;

        try
        {
            await JS.InvokeVoidAsync("unregisterNavbar");
        }
        catch
        {
            // JS interop may fail during disposal.
        }

        _dotNetRef?.Dispose();
    }
}
