@inject IHostedMediaService HostedMedia
@using RazorReaper.Services

@if (resolvedSrc is not null)
{
    <video @attributes="Attributes">
        <source src="@resolvedSrc" type="@MimeType" />
    </video>
}
else if (failed)
{
    <div class="hosted-media-placeholder hosted-media-video" @attributes="Attributes">
        <span>Video unavailable</span>
        <button type="button" class="hosted-media-retry" @onclick="RetryAsync">Retry</button>
    </div>
}
else
{
    <div class="hosted-media-placeholder hosted-media-video" @attributes="Attributes">
        <span class="hosted-media-spinner"></span>
        <span class="hosted-media-note">
            @(progressPercent is { } percent ? $"Loading video… {percent}%" : "Loading video…")
        </span>
    </div>
}

@code {
    /// <summary>Hosted media path relative to the CDN root, e.g. "videos/raising.mp4".</summary>
    [Parameter, EditorRequired] public string Src { get; set; } = string.Empty;

    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Attributes { get; set; }

    private string? resolvedSrc;
    private bool failed;
    private int? progressPercent;
    private string? loadedFor;

    private string MimeType => Path.GetExtension(Src).ToLowerInvariant() switch
    {
        ".webm" => "video/webm",
        _ => "video/mp4",
    };

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == Src)
        {
            return;
        }

        loadedFor = Src;
        await ResolveAsync();
    }

    private async Task RetryAsync()
    {
        failed = false;
        resolvedSrc = null;
        await ResolveAsync();
    }

    private async Task ResolveAsync()
    {
        var requested = Src;
        resolvedSrc = null;
        failed = false;
        progressPercent = null;

        var progress = new Progress<double>(value =>
        {
            var percent = (int)(value * 100);
            if (percent != progressPercent)
            {
                progressPercent = percent;
                _ = InvokeAsync(StateHasChanged);
            }
        });

        var src = await HostedMedia.GetSrcAsync(requested, progress);
        if (loadedFor != requested)
        {
            return; // Parameter changed while downloading; a newer resolve owns the state.
        }

        progressPercent = null;
        if (src is null)
        {
            failed = true;
        }
        else
        {
            resolvedSrc = src;
        }
    }
}
