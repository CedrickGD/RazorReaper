@inject NavigationManager Navigation

<div class="diagnostics-send-control">
    <button type="button" class="@ButtonClass" @onclick="OpenReport">
        <span>@Label</span>
    </button>
</div>

@code {
    [Parameter, EditorRequired]
    public string SourceRoute { get; set; } = "unknown";

    [Parameter]
    public string Label { get; set; } = "Report an issue";

    [Parameter]
    public string ButtonClass { get; set; } = "btn btn-primary";

    private void OpenReport()
        => Navigation.NavigateTo($"/feedback?source={Uri.EscapeDataString(SourceRoute)}");
}
