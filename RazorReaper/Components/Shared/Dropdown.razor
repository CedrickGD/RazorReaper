@* Custom dropdown, replacing <select>.

   Why not a native select: on Windows the open option list is drawn by the OS outside the page,
   so no CSS reaches it — in a dark app you get a white system menu you cannot read. Only a
   div-based list can be themed.

   Where the list is drawn: in the browser's top layer, via popover. Every .content-card carries
   backdrop-filter, which makes the card a stacking context, so a list painted inside one is
   covered by the next card from that card's top edge down — the menu looked cut off at the
   bottom edge of its own card. The top layer sits above every stacking context, so no card,
   scroller or transform reaches it. wwwroot/js/dropdown-layer.js places it from the trigger's
   rectangle, flips it up when the room below is too tight and caps it to the window.

   Keyboard model matches GlobalSearch: Up/Down/Home/End move, Enter picks, Escape closes.
   Outside clicks and Escape are caught by the layer, which calls back into CloseFromLayer. *@
@using RazorReaper.Services.Localization
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILocalizer Localizer

<div class="rr-dd @(_open ? "open" : "")">
    <button type="button"
            class="rr-dd-trigger"
            @ref="_triggerEl"
            @onclick="Toggle"
            @onkeydown="OnKeyDown"
            disabled="@Disabled"
            aria-haspopup="listbox"
            aria-expanded="@_open.ToString().ToLowerInvariant()"
            title="@SelectedLabel">
        <span class="rr-dd-value">@SelectedLabel</span>
        <svg class="rr-dd-caret" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
            <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </button>

    @if (_open)
    {
        @* popover="manual": the list is promoted to the top layer but keeps its own dismissal,
           so a click on the trigger closes it instead of being eaten by a light dismiss and
           immediately reopening. *@
        <div class="rr-dd-pop" role="listbox" popover="manual" @ref="_popEl" @onclick:stopPropagation="true">
            @foreach (var (option, index) in Options.Select((o, i) => (o, i)))
            {
                <button type="button"
                        class="rr-dd-opt @(option.Value == Value ? "selected" : "") @(index == _active ? "active" : "")"
                        role="option"
                        aria-selected="@((option.Value == Value).ToString().ToLowerInvariant())"
                        @onclick="() => PickAsync(option.Value)"
                        @onmouseenter="() => _active = index">
                    <span class="rr-dd-opt-label">@option.Label</span>
                    @if (!string.IsNullOrEmpty(option.Hint))
                    {
                        <span class="rr-dd-opt-hint">@option.Hint</span>
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    public sealed record Option(string Value, string Label, string? Hint = null);

    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<Option> Options { get; set; } = Array.Empty<Option>();
    [Parameter] public bool Disabled { get; set; }
    /// <summary>What the trigger reads with nothing selected. Null takes the general one.</summary>
    [Parameter] public string? Placeholder { get; set; }

    private bool _open;
    private int _active;
    private ElementReference _triggerEl;
    private ElementReference _popEl;

    /// <summary>
    /// Whether the layer currently holds this dropdown. The list element is gone from the DOM
    /// by the time the closing render lands, so the layer is keyed by this id rather than by
    /// an ElementReference that could no longer be marshalled.
    /// </summary>
    private bool _layered;
    private readonly string _layerId = $"rr-dd-{Guid.NewGuid():N}";

    /// <summary>The cursor the layer was last asked to scroll to, so hovering does not ask again.</summary>
    private int _revealed = -1;
    private DotNetObjectReference<Dropdown>? _self;

    private string SelectedLabel =>
        Options.FirstOrDefault(o => o.Value == Value)?.Label
        ?? Placeholder
        ?? Localizer.T("dropdown.placeholder");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (_open && !_layered)
            {
                _layered = true;
                _revealed = _active;
                _self ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("rrDropdownLayer.open", _layerId, _popEl, _triggerEl, _self);
            }
            else if (_open && _active != _revealed)
            {
                // The keyboard cursor moved, and the list may have been capped to the window.
                _revealed = _active;
                await JS.InvokeVoidAsync("rrDropdownLayer.reveal", _layerId);
            }
            else if (!_open && _layered)
            {
                _layered = false;
                _revealed = -1;
                await JS.InvokeVoidAsync("rrDropdownLayer.close", _layerId);
            }
        }
        catch (JSDisconnectedException)
        {
            // The window is going away; there is no layer left to tidy.
        }
    }

    private void Toggle()
    {
        if (_open)
        {
            _open = false;
            return;
        }

        _active = Math.Max(0, Options.ToList().FindIndex(o => o.Value == Value));
        _open = true;
    }

    /// <summary>Outside click or Escape, reported by the layer.</summary>
    [JSInvokable]
    public Task CloseFromLayer()
    {
        if (!_open) return Task.CompletedTask;
        _open = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task PickAsync(string value)
    {
        _open = false;
        if (value == Value) return;
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!_open)
        {
            // Opening with the keyboard should land on the current value, which Toggle does.
            if (e.Key is "ArrowDown" or "ArrowUp" or "Enter" or " ") Toggle();
            return;
        }

        switch (e.Key)
        {
            case "ArrowDown":
                _active = Math.Min(Options.Count - 1, _active + 1);
                break;
            case "ArrowUp":
                _active = Math.Max(0, _active - 1);
                break;
            case "Home":
                _active = 0;
                break;
            case "End":
                _active = Options.Count - 1;
                break;
            case "Enter":
            case " ":
                if (_active >= 0 && _active < Options.Count) await PickAsync(Options[_active].Value);
                break;
            case "Escape":
                _open = false;
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_layered)
        {
            _layered = false;
            try
            {
                await JS.InvokeVoidAsync("rrDropdownLayer.close", _layerId);
            }
            catch (JSDisconnectedException)
            {
                // Shutting down: the layer is going with the window.
            }
        }

        _self?.Dispose();
        _self = null;
    }
}
