@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.Extensions.DependencyInjection
@using RazorReaper.Components.Shared
@using RazorReaper.Services
@using RazorReaper.Services.Implementations
@using RazorReaper.Services.Localization
@using RazorReaper.Services.Overlay
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject IAutoUpdateManager AutoUpdateManager
@inject INotificationService NotificationService
@inject IUpdateService UpdateService
@inject IDiscordPresenceService DiscordPresence
@inject ILicenseService LicenseService
@inject IAccessGateService AccessGate
@inject IAppearanceService Appearance
@inject ILocalizer Localizer
@inject IJSRuntime JS

<NotificationContainer />
<GlobalSearch />
<ImageLightbox />
@* Plays the full-window "Premium unlocked" moment. Lives here rather than on Home so it
   covers the whole app and fires wherever the activation happened. *@
<LicenseActivated />
@* Full-window license view (tier, key, expiry, activation), opened from the sidebar's
   tier line. Rendered here for the same reason: it has to cover the nav as well. *@
<LicenseOverlay />
@* Full-window "What's new & inbox" view (release notes, update action, latest support
   replies), opened from the sidebar's notification icon. Mounted here for the same reason. *@
<WhatsNewOverlay />

<div class="app-container">
    <SharedNavbar />

    <main class="main-content">
        @Body
    </main>

</div>

@* Full-screen access gate: covers the entire app (nav included) whenever this machine is
   suspended or banned. Rendered last so it sits on top; it fails open, so it only appears when
   the server has affirmatively reported a suspension. *@
@if (AccessGate.IsSuspended)
{
    <AccessBlocked />
}

@code {
    protected override async Task OnInitializedAsync()
    {
        ResolveHudAndSession();
        DetectVersionUpgrade();
        await ValidateLicenseAsync();

        // If we were just relaunched elevated, jump straight back to the page the user was on
        // instead of landing on Home.
        var elevation = Services.GetRequiredService<RazorReaper.Services.Elevation.IElevationService>();
        var returnRoute = elevation.ConsumePendingReturnRoute();
        if (!string.IsNullOrWhiteSpace(returnRoute))
        {
            Navigation.NavigateTo(returnRoute);
        }

        SubscribeAccess();
        SubscribeLanguage();
        ReflectPage(Navigation.ToBaseRelativePath(Navigation.Uri));
        SubscribeNavigation();
    }

    private IHudOverlayService? _hudOverlay;
    private bool _accessSubscribed;
    private bool _navigationSubscribed;
    private bool _languageSubscribed;

    private void ResolveHudAndSession()
    {
        _hudOverlay = Services.GetRequiredService<IHudOverlayService>();
        // Resolved only in normal mode so server auto-detection can run without a page open.
        _ = Services.GetRequiredService<ISessionHudService>();
    }

    private void DetectVersionUpgrade()
    {
        var previousVersion = AutoUpdateManager.DetectVersionUpgrade();
        if (previousVersion != null)
        {
            var current = UpdateService.CurrentVersionLabel;
            NotificationService.ShowSuccess($"Successfully updated to v{current}.");
        }
    }

    private async Task ValidateLicenseAsync()
    {
        _ = await LicenseService.ValidateLicenseAsync();
    }

    private void SubscribeAccess()
    {
        // Re-render the layout whenever the access gate flips so the full-screen block
        // appears/disappears live (a mid-session suspend, or an admin lift, both land here).
        AccessGate.OnAccessStateChanged += HandleAccessChanged;
        _accessSubscribed = true;
    }

    /// <summary>
    /// A language switch has to reach the whole window, not just the settings row that made it.
    /// Re-rendering the layout re-renders the sidebar, the overlays and the routed page it holds
    /// in one pass, which is why the subscription lives here and nowhere else.
    /// </summary>
    private void SubscribeLanguage()
    {
        Localizer.LanguageChanged += HandleLanguageChanged;
        _languageSubscribed = true;
    }

    private void HandleLanguageChanged() => this.DispatchRender(() => InvokeAsync(StateHasChanged));

    private void SubscribeNavigation()
    {
        Navigation.LocationChanged += OnLocationChanged;
        _navigationSubscribed = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Applied at the layout level so the scale covers every page, not just the
        // settings page that set it. Re-applied whenever it changes.
        Appearance.Changed += HandleAppearanceChanged;
        await ApplyAppearanceAsync();
    }

    private void HandleAppearanceChanged() => this.DispatchRender(() => InvokeAsync(ApplyAppearanceAsync));

    private async Task ApplyAppearanceAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("razorReaperTheme.apply", Appearance.UiScalePercent);
        }
        catch
        {
            // Cosmetic only — never block the layout on theming.
        }
    }

    private void HandleAccessChanged() => this.DispatchRender(() => InvokeAsync(StateHasChanged));

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => ReflectPage(Navigation.ToBaseRelativePath(e.Location));

    private void ReflectPage(string relativePath)
    {
        if (_hudOverlay is null)
        {
            return;
        }

        var label = DiscordPresence.ResolveToolLabel(relativePath);

        DiscordPresence.SetActivityForPath(relativePath);
        // The HUD tool module shows the current page (like Rich Presence) — far more useful
        // than "Idle" since the app is minimized while you're in the game.
        _hudOverlay.SetActiveTool(label);
    }

    public void Dispose()
    {
        this.StopRenderDispatch();
        if (_navigationSubscribed)
        {
            Navigation.LocationChanged -= OnLocationChanged;
        }

        if (_accessSubscribed)
        {
            AccessGate.OnAccessStateChanged -= HandleAccessChanged;
        }

        if (_languageSubscribed)
        {
            Localizer.LanguageChanged -= HandleLanguageChanged;
        }

        Appearance.Changed -= HandleAppearanceChanged;
    }
}
