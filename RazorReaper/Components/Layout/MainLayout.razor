@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using RazorReaper.Components.Shared
@using RazorReaper.Services
@inject NavigationManager Navigation
@inject IAutoUpdateManager AutoUpdateManager
@inject INotificationService NotificationService
@inject IUpdateService UpdateService
@inject IDiscordPresenceService DiscordPresence
@inject ILicenseService LicenseService

<NotificationContainer />
<GlobalSearch />
<ImageLightbox />

<div class="app-container">
    <SharedNavbar />

    <main class="main-content">
        @Body
    </main>

    <LicenseOverlay />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var previousVersion = AutoUpdateManager.DetectVersionUpgrade();
        if (previousVersion != null)
        {
            var current = UpdateService.CurrentVersionLabel;
            NotificationService.ShowSuccess($"Successfully updated to v{current}!");
        }

        var result = await LicenseService.ValidateLicenseAsync();
        if (!result.Success && result.Message != "No license key found.")
        {
            NotificationService.ShowError($"License check failed: {result.Message}");
        }

        // Reflect the current page in Discord Rich Presence, then keep it synced on navigation.
        DiscordPresence.SetActivityForPath(Navigation.ToBaseRelativePath(Navigation.Uri));
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => DiscordPresence.SetActivityForPath(Navigation.ToBaseRelativePath(e.Location));

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
