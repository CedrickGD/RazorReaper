@page "/desync"
@using RazorReaper.Services
@using RazorReaper.Services.Desync
@inject IDesyncService DesyncService
@implements IDisposable
@using RazorReaper.Services.Localization
@inject ILocalizer Localizer

<header class="page-header">
    <h1 class="page-title">@Localizer.T("nav.page.desync")</h1>
    <p class="page-subtitle">@Localizer.T("desync.subtitle")</p>
</header>

<div class="content-card">
    <StatusHeader State="@(DesyncService.IsActive ? "warning" : "off")"
                  Label="@Localizer.T(DesyncService.IsActive ? "common.active" : "desync.inactive")"
                  Description="@Localizer.T("desync.status.description")">
        <Actions>
            <UsageChip Feature="@UsageFeatures.Desync" />
            @if (!DesyncService.IsActive)
            {
                <button class="btn btn-primary" @onclick="StartAsync" disabled="@(!DesyncService.IsAdministrator)">@Localizer.T("desync.activate")</button>
            }
        </Actions>
    </StatusHeader>

    <ElevationPrompt Message="@Localizer.T("desync.elevation")" />

    @if (DesyncService.IsActive)
    {
        <div class="dsy-countdown">
            <div class="dsy-count-num">@DesyncService.RemainingSeconds<span class="dsy-count-unit">s</span></div>
            <div class="dsy-count-label">@Localizer.T("desync.countdown")</div>
            <div class="dsy-count-bar">
                <div class="dsy-count-fill" style="width: @(ProgressPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
            </div>
            <button class="btn btn-danger dsy-stop" @onclick="StopAsync">@Localizer.T("desync.stopnow")</button>
        </div>
    }
    else
    {
        <SettingRow Title="@Localizer.T("desync.duration.title")" Description="@Localizer.T("desync.duration.description")">
            <div class="dsy-duration">
                @foreach (var preset in Presets)
                {
                    <button class="dsy-preset @(_seconds == preset ? "active" : "")"
                            @onclick="() => _seconds = preset">@(preset)s</button>
                }
                <input class="dsy-num" type="number" min="5" max="600" value="@_seconds" @onchange="SetSeconds" />
            </div>
        </SettingRow>
    }
</div>

<div class="content-card">
    <div class="dsy-section-title">@Localizer.T("desync.how.title")</div>
    <ol class="dsy-steps">
        <li>@Localizer.T("desync.how.1")</li>
        <li>@Localizer.T("desync.how.2")</li>
        <li>@Localizer.T("desync.how.3")</li>
    </ol>

    <SettingRow Title="@Localizer.T("desync.ingame.title")" Description="@Localizer.T("desync.ingame.description")" />
    <SettingRow Title="@Localizer.T("desync.instant.title")" Description="@Localizer.T("desync.instant.description")" />

    <div class="dsy-note">@Localizer.T("desync.note")</div>
</div>

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    private static readonly int[] Presets = { 10, 30, 60, 120 };

    private int _seconds = 30;

    private double ProgressPercent
        => DesyncService.TotalSeconds > 0
            ? Math.Clamp(DesyncService.RemainingSeconds * 100.0 / DesyncService.TotalSeconds, 0, 100)
            : 0;

    protected override void OnInitialized() => DesyncService.Changed += OnChanged;

    private async Task StartAsync() => await DesyncService.ActivateAsync(_seconds);

    private async Task StopAsync() => await DesyncService.DeactivateAsync();

    private void SetSeconds(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) _seconds = Math.Clamp(v, 5, 600);
    }

    private void OnChanged()
    {
        // Marshal to the UI thread; swallowing here keeps a render race from becoming an unhandled crash.
        this.DispatchRender(() => InvokeAsync(StateHasChanged));
    }

    public void Dispose() { this.StopRenderDispatch(); DesyncService.Changed -= OnChanged; }
}
