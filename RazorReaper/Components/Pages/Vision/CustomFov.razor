@using System.Diagnostics
@using System.Globalization
@using System.IO
@using System.Text.RegularExpressions
@using RazorReaper.Services
@using RazorReaper.Utilities

@inject INotificationService NotificationService
@inject IActivityService ActivityService
@using RazorReaper.Services.Localization
@inject ILocalizer Localizer

<div class="vision-card-wrap wide">
    <div class="content-card">
        <div class="section-header-fov">
            <div class="icon-circle-fov">
                <svg fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2.5 10s3-4.5 7.5-4.5S17.5 10 17.5 10s-3 4.5-7.5 4.5S2.5 10 2.5 10Z" stroke="currentColor" stroke-width="1.5" fill="none" />
                    <circle cx="10" cy="10" r="2.2" />
                </svg>
            </div>
            <div>
                <h3>@Localizer.T("vision.tab.fov")</h3>
                <p class="vision-card-sub">@Localizer.T("vision.fov.subtitle")</p>
            </div>
        </div>

        <div class="vision-split">
            <div class="vision-split-left">
                <div class="vision-reference">
                    <HostedImg Src="images/vision/fov-crafting-station.webp"
                               alt="@Localizer.T("vision.fov.image.alt")"
                               onclick="rrZoom(this)" />
                </div>
            </div>

            <div class="vision-split-right">
                <div class="settings-status-card compact-card">
                    <div class="settings-display">
                        <div class="setting-item @(currentFov > 1.0 ? "enabled" : "disabled")">
                            <div class="setting-status-dot"></div>
                            <div class="setting-info">
                                <div class="setting-name">FOVMultiplier</div>
                                <div class="setting-value">@currentFov.ToString("F2", CultureInfo.InvariantCulture)</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="vision-fov-controls">
                    <div class="vision-fov-slider-row">
                        <input type="range"
                               min="1.0"
                               max="1.6"
                               step="0.05"
                               value="@pendingFov.ToString("F2", CultureInfo.InvariantCulture)"
                               @oninput="OnSliderInput"
                               class="vision-fov-slider" />
                        <input type="number"
                               min="1.0"
                               max="1.6"
                               step="0.01"
                               value="@pendingFov.ToString("F2", CultureInfo.InvariantCulture)"
                               @oninput="OnNumberInput"
                               class="vision-fov-number" />
                    </div>
                    <div class="vision-fov-scale">
                        <span>1.0</span>
                        <span>1.2</span>
                        <span>1.35 (vanilla max)</span>
                        <span>1.6</span>
                    </div>
                </div>

                <div class="fov-main-actions vision-fov-actions">
                    <button class="fov-btn-large enable"
                            @onclick="ApplyFov"
                            disabled="@(isBusy || Math.Abs(pendingFov - currentFov) < 0.001)">
                        <div class="btn-content-large">
                            <span class="btn-title">@Localizer.T("vision.fov.apply", pendingFov.ToString("F2", CultureInfo.InvariantCulture))</span>
                        </div>
                    </button>
                    <button class="fov-btn-large disable"
                            @onclick="ResetFov"
                            disabled="@(isBusy || Math.Abs(currentFov - 1.0) < 0.001)">
                        <div class="btn-content-large">
                            <span class="btn-title">@Localizer.T("vision.fov.reset")</span>
                        </div>
                    </button>
                </div>

                <div class="path-section">
                    <strong>@Localizer.T("vision.configpath")</strong>
                    <div class="path-display @(string.IsNullOrEmpty(gameUserSettingsPath) ? string.Empty : "clickable")"
                         @onclick="OpenGameSettingsFolder"
                         title="@Localizer.T(string.IsNullOrEmpty(gameUserSettingsPath) ? "vision.path.unavailable" : "home.sound.openfolder")">
                        @GetConfigPathDisplay()
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    private const string DefaultGameSettingsPath = @"ARK\ShooterGame\Saved\Config\WindowsNoEditor\GameUserSettings.ini";
    private const string BackupSuffix = ".rrfovbak";
    private const string SettingsSectionHeader = "[/Script/ShooterGame.ShooterGameUserSettings]";
    private const double MinFov = 1.0;
    private const double MaxFov = 1.6;
    private const double DefaultFov = 1.0;

    private string arkInstallPath = string.Empty;
    private string gameUserSettingsPath = string.Empty;

    private double currentFov = DefaultFov;
    private double pendingFov = DefaultFov;
    private bool isBusy;
    private bool sessionBackupTaken;

    protected override void OnInitialized()
    {
        CheckFileAndReadSettings();
    }

    private bool ResolveArkPath()
    {
        if (!string.IsNullOrEmpty(arkInstallPath) && Directory.Exists(arkInstallPath))
        {
            return true;
        }

        arkInstallPath = ArkUtilities.FindArkPath() ?? string.Empty;
        return !string.IsNullOrEmpty(arkInstallPath) && Directory.Exists(arkInstallPath);
    }

    private void CheckFileAndReadSettings()
    {
        try
        {
            if (!ResolveArkPath())
            {
                NotificationService.ShowError(Localizer.T("vision.toast.noark"));
                return;
            }

            gameUserSettingsPath = Path.Combine(arkInstallPath, "ShooterGame", "Saved", "Config", "WindowsNoEditor", "GameUserSettings.ini");
            if (!File.Exists(gameUserSettingsPath))
            {
                NotificationService.ShowWarning(Localizer.T("vision.toast.nosettings"));
                return;
            }

            ReadCurrentFov();
        }
        catch (Exception ex)
        {
            NotificationService.ShowError(Localizer.T("common.error", ex.Message));
        }
    }

    private void ReadCurrentFov()
    {
        try
        {
            if (!File.Exists(gameUserSettingsPath))
            {
                return;
            }

            var content = File.ReadAllText(gameUserSettingsPath);
            var match = Regex.Match(content, @"FOVMultiplier=([\d.]+)", RegexOptions.IgnoreCase);
            if (match.Success && double.TryParse(match.Groups[1].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed))
            {
                currentFov = Math.Clamp(parsed, MinFov, MaxFov);
                pendingFov = currentFov;
            }
            else
            {
                currentFov = DefaultFov;
                pendingFov = DefaultFov;
            }
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"CustomFov error reading FOVMultiplier: {ex.Message}");
        }
    }

    private void OnSliderInput(ChangeEventArgs e)
    {
        if (e.Value is string raw && double.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var v))
        {
            pendingFov = ClampFov(v);
        }
    }

    private void OnNumberInput(ChangeEventArgs e)
    {
        if (e.Value is string raw && double.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var v))
        {
            pendingFov = ClampFov(v);
        }
    }

    private static double ClampFov(double value) => Math.Clamp(Math.Round(value, 2), MinFov, MaxFov);

    private async Task ApplyFov()
    {
        if (isBusy)
        {
            return;
        }

        try
        {
            if (string.IsNullOrEmpty(gameUserSettingsPath))
            {
                CheckFileAndReadSettings();
            }

            if (!File.Exists(gameUserSettingsPath))
            {
                NotificationService.ShowError(Localizer.T("vision.toast.nofile"));
                return;
            }

            isBusy = true;
            var targetValue = pendingFov;

            var written = await Task.Run(() =>
            {
                if (!sessionBackupTaken)
                {
                    try
                    {
                        ArkUtilities.CopyToBackup(gameUserSettingsPath, gameUserSettingsPath + BackupSuffix, overwrite: true);
                        sessionBackupTaken = true;
                    }
                    catch (Exception ex)
                    {
                        Debug.WriteLine($"CustomFov backup failed: {ex.Message}");
                    }
                }

                var content = File.ReadAllText(gameUserSettingsPath);
                var formatted = $"FOVMultiplier={targetValue.ToString("F6", CultureInfo.InvariantCulture)}";

                if (Regex.IsMatch(content, @"FOVMultiplier=[\d.]+", RegexOptions.IgnoreCase))
                {
                    content = Regex.Replace(content, @"FOVMultiplier=[\d.]+", formatted, RegexOptions.IgnoreCase);
                }
                else if (content.Contains(SettingsSectionHeader, StringComparison.Ordinal))
                {
                    content = content.Replace(SettingsSectionHeader, $"{SettingsSectionHeader}\r\n{formatted}");
                }
                else
                {
                    this.DispatchRender(() => InvokeAsync(() => NotificationService.ShowWarning(Localizer.T("vision.toast.nosection"))));
                    return false;
                }

                ArkUtilities.WriteArkConfig(gameUserSettingsPath, () => File.WriteAllText(gameUserSettingsPath, content));
                return true;
            });

            if (!written)
            {
                return;
            }

            currentFov = targetValue;
            NotificationService.ShowSuccess(Localizer.T("vision.fov.toast.set", targetValue.ToString("F2", CultureInfo.InvariantCulture)));
            ActivityService.AddActivity(Localizer.T("vision.fov.activity.applied", targetValue.ToString("F2", CultureInfo.InvariantCulture)), "success", "vision.fov.activity.applied");
        }
        catch (Exception ex)
        {
            NotificationService.ShowError(Localizer.T("vision.fov.toast.failed", ex.Message));
        }
        finally
        {
            isBusy = false;
            StateHasChanged();
        }
    }

    private async Task ResetFov()
    {
        pendingFov = DefaultFov;
        await ApplyFov();
    }

    private void OpenGameSettingsFolder()
    {
        if (string.IsNullOrEmpty(gameUserSettingsPath))
        {
            NotificationService.ShowWarning(Localizer.T("vision.toast.nopath"));
            return;
        }

        OpenFolder(Path.GetDirectoryName(gameUserSettingsPath));
    }

    private void OpenFolder(string? path)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(path) || !Directory.Exists(path))
            {
                NotificationService.ShowError(Localizer.T("vision.toast.nofolder"));
                return;
            }

            Process.Start(new ProcessStartInfo
            {
                FileName = "explorer.exe",
                Arguments = $"\"{path}\"",
                UseShellExecute = true
            });

            ActivityService.AddActivity(Localizer.T("home.activity.openedfolder", path), "info", "home.activity.openedfolder");
        }
        catch (Exception ex)
        {
            NotificationService.ShowError(Localizer.T("home.paths.error.open", ex.Message));
        }
    }

    private string GetConfigPathDisplay()
    {
        return string.IsNullOrEmpty(gameUserSettingsPath) ? DefaultGameSettingsPath : gameUserSettingsPath;
    }
}
