@using System.Diagnostics
@using System.IO
@using System.Text.RegularExpressions
@using RazorReaper.Services
@using RazorReaper.Utilities
@inject INotificationService NotificationService
@inject IActivityService ActivityService
@using RazorReaper.Services.Localization
@inject ILocalizer Localizer

@{
    var isEnabled = bUseOldThirdPersonCameraTrace && bUseOldThirdPersonCameraOffset;
}
<div class="vision-card-wrap wide">
    <div class="content-card">
        <div class="section-header-fov">
            <div class="icon-circle-fov">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 7.5h3.5l1.7-2.2h7.6l1.7 2.2H21v11H3z" />
                    <circle cx="12" cy="13" r="3.6" />
                </svg>
            </div>
            <div>
                <h3>@Localizer.T("vision.tab.tek")</h3>
                <p class="vision-card-sub">@Localizer.T("vision.tek.subtitle")</p>
            </div>
        </div>

        <div class="vision-tek-hero @(isEnabled ? "is-on" : "is-off")">
            <div class="vision-tek-hero-state">
                <span class="vision-tek-state-badge">@Localizer.T(isEnabled ? "common.active" : "desync.inactive")</span>
                <div class="vision-tek-state-text">
                    <strong>@Localizer.T(isEnabled ? "vision.tek.state.on" : "vision.tek.state.off")</strong>
                    <span>@Localizer.T(isEnabled ? "vision.tek.state.on.text" : "vision.tek.state.off.text")</span>
                </div>
            </div>
            <button class="vision-tek-toggle @(isEnabled ? "is-off" : "is-on")"
                    @onclick="@(isEnabled ? (Func<Task>)DisableCameraTrace : EnableCameraTrace)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    @if (isEnabled)
                    {
                        <circle cx="12" cy="12" r="9" />
                        <line x1="9" y1="9" x2="15" y2="15" />
                        <line x1="15" y1="9" x2="9" y2="15" />
                    }
                    else
                    {
                        <circle cx="12" cy="12" r="9" />
                        <polyline points="8 12 11 15 16 9" />
                    }
                </svg>
                <span>@Localizer.T(isEnabled ? "vision.tek.disable" : "vision.tek.enable")</span>
            </button>
        </div>

        <div class="vision-tek-keys-label">@Localizer.T("vision.tek.keys")</div>
        <div class="vision-tek-keys">
            <div class="vision-tek-key @(bUseOldThirdPersonCameraTrace ? "on" : "off")">
                <div class="vision-tek-key-dot"></div>
                <div class="vision-tek-key-body">
                    <div class="vision-tek-key-name">bUseOldThirdPersonCameraTrace</div>
                    <div class="vision-tek-key-val">@(bUseOldThirdPersonCameraTrace ? "True" : "False")</div>
                </div>
            </div>
            <div class="vision-tek-key @(bUseOldThirdPersonCameraOffset ? "on" : "off")">
                <div class="vision-tek-key-dot"></div>
                <div class="vision-tek-key-body">
                    <div class="vision-tek-key-name">bUseOldThirdPersonCameraOffset</div>
                    <div class="vision-tek-key-val">@(bUseOldThirdPersonCameraOffset ? "True" : "False")</div>
                </div>
            </div>
        </div>

        <div class="path-section">
            <strong>@Localizer.T("vision.configpath")</strong>
            <div class="path-display @(string.IsNullOrEmpty(gameUserSettingsPath) ? string.Empty : "clickable")"
                 @onclick="OpenGameSettingsFolder"
                 title="@Localizer.T(string.IsNullOrEmpty(gameUserSettingsPath) ? "vision.path.unavailable" : "home.sound.openfolder")">
                @GetConfigPathDisplay()
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    private const string DefaultGameSettingsPath = @"ARK\ShooterGame\Saved\Config\WindowsNoEditor\GameUserSettings.ini";

    private string arkInstallPath = string.Empty;
    private string gameUserSettingsPath = string.Empty;

    private bool bUseOldThirdPersonCameraTrace;
    private bool bUseOldThirdPersonCameraOffset;

    protected override void OnInitialized()
    {
        CheckFileAndReadSettings();
    }

    private bool ResolveArkPath()
    {
        if (!string.IsNullOrEmpty(arkInstallPath) && Directory.Exists(arkInstallPath))
        {
            return true;
        }

        arkInstallPath = ArkUtilities.FindArkPath() ?? string.Empty;
        return !string.IsNullOrEmpty(arkInstallPath) && Directory.Exists(arkInstallPath);
    }

    private void CheckFileAndReadSettings()
    {
        try
        {
            if (!ResolveArkPath())
            {
                NotificationService.ShowError(Localizer.T("vision.toast.noark"));
                return;
            }

            gameUserSettingsPath = Path.Combine(arkInstallPath, "ShooterGame", "Saved", "Config", "WindowsNoEditor", "GameUserSettings.ini");
            if (!File.Exists(gameUserSettingsPath))
            {
                NotificationService.ShowWarning(Localizer.T("vision.toast.nosettings"));
                return;
            }

            ReadCurrentSettings();
        }
        catch (Exception ex)
        {
            NotificationService.ShowError(Localizer.T("common.error", ex.Message));
        }
    }

    private void ReadCurrentSettings()
    {
        try
        {
            if (!File.Exists(gameUserSettingsPath))
            {
                return;
            }

            var content = File.ReadAllText(gameUserSettingsPath);

            var traceMatch = Regex.Match(content, @"bUseOldThirdPersonCameraTrace=(\w+)", RegexOptions.IgnoreCase);
            if (traceMatch.Success)
            {
                bUseOldThirdPersonCameraTrace = traceMatch.Groups[1].Value.Equals("True", StringComparison.OrdinalIgnoreCase);
            }

            var offsetMatch = Regex.Match(content, @"bUseOldThirdPersonCameraOffset=(\w+)", RegexOptions.IgnoreCase);
            if (offsetMatch.Success)
            {
                bUseOldThirdPersonCameraOffset = offsetMatch.Groups[1].Value.Equals("True", StringComparison.OrdinalIgnoreCase);
            }
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"TekCamera error reading settings: {ex.Message}");
        }
    }

    private async Task EnableCameraTrace()
    {
        try
        {
            if (string.IsNullOrEmpty(gameUserSettingsPath))
            {
                CheckFileAndReadSettings();
            }

            await Task.Run(() =>
            {
                if (!File.Exists(gameUserSettingsPath))
                {
                    this.DispatchRender(() => InvokeAsync(() => NotificationService.ShowError(Localizer.T("vision.toast.nofile"))));
                    return;
                }

                var content = File.ReadAllText(gameUserSettingsPath);
                var modified = false;

                var tracePattern = @"bUseOldThirdPersonCameraTrace=\w+";
                if (Regex.IsMatch(content, tracePattern, RegexOptions.IgnoreCase))
                {
                    content = Regex.Replace(content, tracePattern, "bUseOldThirdPersonCameraTrace=True", RegexOptions.IgnoreCase);
                    modified = true;
                }
                else if (content.Contains("[/Script/ShooterGame.ShooterGameUserSettings]", StringComparison.Ordinal))
                {
                    content = content.Replace(
                        "[/Script/ShooterGame.ShooterGameUserSettings]",
                        "[/Script/ShooterGame.ShooterGameUserSettings]\r\nbUseOldThirdPersonCameraTrace=True");
                    modified = true;
                }

                var offsetPattern = @"bUseOldThirdPersonCameraOffset=\w+";
                if (Regex.IsMatch(content, offsetPattern, RegexOptions.IgnoreCase))
                {
                    content = Regex.Replace(content, offsetPattern, "bUseOldThirdPersonCameraOffset=True", RegexOptions.IgnoreCase);
                    modified = true;
                }
                else if (content.Contains("[/Script/ShooterGame.ShooterGameUserSettings]", StringComparison.Ordinal) &&
                         content.Contains("bUseOldThirdPersonCameraTrace=True", StringComparison.Ordinal) &&
                         !content.Contains("bUseOldThirdPersonCameraOffset", StringComparison.OrdinalIgnoreCase))
                {
                    content = content.Replace(
                        "bUseOldThirdPersonCameraTrace=True",
                        "bUseOldThirdPersonCameraTrace=True\r\nbUseOldThirdPersonCameraOffset=True");
                    modified = true;
                }

                if (!modified)
                {
                    this.DispatchRender(() => InvokeAsync(() => NotificationService.ShowWarning(Localizer.T("vision.toast.nosection"))));
                    return;
                }

                File.WriteAllText(gameUserSettingsPath, content);
                this.DispatchRender(() => InvokeAsync(() =>
                {
                    bUseOldThirdPersonCameraTrace = true;
                    bUseOldThirdPersonCameraOffset = true;
                    NotificationService.ShowSuccess(Localizer.T("vision.tek.toast.enabled"));
                    ActivityService.AddActivity(Localizer.T("vision.tek.toast.enabled"), "success");
                    StateHasChanged();
                }));
            });
        }
        catch (Exception ex)
        {
            NotificationService.ShowError(Localizer.T("common.error", ex.Message));
        }
    }

    private async Task DisableCameraTrace()
    {
        try
        {
            if (string.IsNullOrEmpty(gameUserSettingsPath))
            {
                CheckFileAndReadSettings();
            }

            await Task.Run(() =>
            {
                if (!File.Exists(gameUserSettingsPath))
                {
                    this.DispatchRender(() => InvokeAsync(() => NotificationService.ShowError(Localizer.T("vision.toast.nofile"))));
                    return;
                }

                var content = File.ReadAllText(gameUserSettingsPath);
                content = Regex.Replace(content, @"bUseOldThirdPersonCameraTrace=\w+", "bUseOldThirdPersonCameraTrace=False", RegexOptions.IgnoreCase);
                content = Regex.Replace(content, @"bUseOldThirdPersonCameraOffset=\w+", "bUseOldThirdPersonCameraOffset=False", RegexOptions.IgnoreCase);

                File.WriteAllText(gameUserSettingsPath, content);
                this.DispatchRender(() => InvokeAsync(() =>
                {
                    bUseOldThirdPersonCameraTrace = false;
                    bUseOldThirdPersonCameraOffset = false;
                    NotificationService.ShowWarning(Localizer.T("vision.tek.toast.disabled"));
                    ActivityService.AddActivity(Localizer.T("vision.tek.toast.disabled"), "warning");
                    StateHasChanged();
                }));
            });
        }
        catch (Exception ex)
        {
            NotificationService.ShowError(Localizer.T("common.error", ex.Message));
        }
    }

    private void OpenGameSettingsFolder()
    {
        if (string.IsNullOrEmpty(gameUserSettingsPath))
        {
            NotificationService.ShowWarning(Localizer.T("vision.toast.nopath"));
            return;
        }

        OpenFolder(Path.GetDirectoryName(gameUserSettingsPath));
    }

    private void OpenFolder(string? path)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(path) || !Directory.Exists(path))
            {
                NotificationService.ShowError(Localizer.T("vision.toast.nofolder"));
                return;
            }

            Process.Start(new ProcessStartInfo
            {
                FileName = "explorer.exe",
                Arguments = $"\"{path}\"",
                UseShellExecute = true
            });

            ActivityService.AddActivity(Localizer.T("home.activity.openedfolder", path), "info");
        }
        catch (Exception ex)
        {
            NotificationService.ShowError(Localizer.T("home.paths.error.open", ex.Message));
        }
    }

    private string GetConfigPathDisplay()
    {
        return string.IsNullOrEmpty(gameUserSettingsPath) ? DefaultGameSettingsPath : gameUserSettingsPath;
    }
}
