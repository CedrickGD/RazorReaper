@page "/settings"
@using RazorReaper.Services
@using RazorReaper.Services.Implementations
@using RazorReaper.Services.Localization
@using RazorReaper.Components.Shared
@inject IAppearanceService Appearance
@inject IDiscordPresenceService DiscordPresence
@inject IArkLinkService ArkLink
@inject INotificationService NotificationService
@inject GameBannerNotifier GameBanner
@inject ILocalizer Localizer
@inject IJSRuntime JS
@implements IDisposable

@*
    App settings. Anything that configures Razor Reaper itself lives here — appearance,
    audio and app behaviour. Per-feature options stay on their own pages, and every
    system-wide hotkey lives on Global Hotkeys rather than being scattered per page.
*@

<header class="page-header">
    <h1 class="page-title">@Localizer.T("settings.title")</h1>
    <p class="page-subtitle">@Localizer.T("settings.subtitle")</p>
</header>

<div class="settings-page">
    <section class="content-card">
        <SettingRow Title="@Localizer.T("settings.account.title")" Description="@Localizer.T("settings.account.description")">
            <a class="rr-pill-btn ghost sm" href="/account">@Localizer.T("settings.account.action")</a>
        </SettingRow>
    </section>

    @* ── Language ────────────────────────────────────────────────────────────
       A card of its own rather than a row inside Appearance: that card's "Reset"
       button undoes the interface scale, and a language sitting under it would read
       as something that button also throws away. Switching is live — MainLayout
       re-renders the window off the localizer's change event, no restart. *@
    <section class="content-card">
        <SettingRow Title="@Localizer.T("language.label")" Description="@Localizer.T("language.description")">
            <Dropdown Value="@Localizer.Language" ValueChanged="OnLanguageChanged" Options="LanguageOptions" />
        </SettingRow>
    </section>

    @* ── Appearance ──────────────────────────────────────────────────────── *@
    <section class="content-card">
        <div class="settings-section-head">
            <div>
                <h3>@Localizer.T("settings.appearance.title")</h3>
                <p class="settings-section-desc">@Localizer.T("settings.appearance.description")</p>
            </div>
            @if (!Appearance.IsDefault)
            {
                <button class="rr-pill-btn ghost sm" @onclick="ResetAppearanceAsync">@Localizer.T("common.reset")</button>
            }
        </div>

        <SettingRow Title="@Localizer.T("settings.scale.title")" Description="@Localizer.T("settings.scale.description")">
            <div class="settings-scale">
                @* step 1 + oninput: at step 5 the handle jumped between notches and the
                   page only re-scaled once you let go. *@
                <input type="range"
                       min="@AppearanceService.MinScalePercent"
                       max="@AppearanceService.MaxScalePercent"
                       step="1"
                       value="@Appearance.UiScalePercent"
                       @oninput="OnScaleChangedAsync" />
                <span class="settings-scale-value">@Appearance.UiScalePercent%</span>
            </div>
        </SettingRow>
    </section>

    @* Accent + font, moved off Home: they configure the app, not the dashboard. Both are
       self-contained shared components, so this page only places them. *@
    <AccentColorCard />
    <FontSettingsCard />

    @* ── App behaviour ───────────────────────────────────────────────────── *@
    <section class="content-card">
        <div class="settings-section-head">
            <div>
                <h3>@Localizer.T("settings.behaviour.title")</h3>
                <p class="settings-section-desc">@Localizer.T("settings.behaviour.description")</p>
            </div>
        </div>

        <SettingRow Title="@Localizer.T("settings.discord.title")"
                    Description="@Localizer.T("settings.discord.description")">
            <Switch Value="DiscordPresence.IsEnabled" ValueChanged="OnDiscordChanged" />
        </SettingRow>

        <SettingRow Title="@Localizer.T("settings.startwithark.title")"
                    Description="@Localizer.T("settings.startwithark.description")">
            <Switch Value="ArkLink.StartWithArk" ValueChanged="OnStartWithArkChanged" />
        </SettingRow>

        <SettingRow Title="@Localizer.T("settings.closewithark.title")"
                    Description="@Localizer.T("settings.closewithark.description")">
            <Switch Value="ArkLink.CloseWithArk" ValueChanged="OnCloseWithArkChanged" />
        </SettingRow>

        <SettingRow Title="@Localizer.T("settings.gamebanner.title")"
                    Description="@Localizer.T("settings.gamebanner.description")">
            <Switch Value="GameBanner.Enabled" ValueChanged="OnGameBannerChanged" />
        </SettingRow>

        <SettingRow Title="@Localizer.T("settings.updates.title")"
                    Description="@Localizer.T("settings.updates.description")">
            <span class="settings-static">@Localizer.T("common.automatic")</span>
        </SettingRow>
    </section>

    @* ── Pointers ────────────────────────────────────────────────────────── *@
    <section class="content-card">
        <div class="settings-section-head">
            <div>
                <h3>@Localizer.T("settings.elsewhere.title")</h3>
                <p class="settings-section-desc">@Localizer.T("settings.elsewhere.description")</p>
            </div>
        </div>

        <SettingRow Title="@Localizer.T("settings.hotkeys.title")" Description="@Localizer.T("settings.hotkeys.description")">
            <a class="rr-pill-btn ghost sm" href="/hotkeys">@Localizer.T("common.open")</a>
        </SettingRow>

        <SettingRow Title="@Localizer.T("settings.gamma.title")" Description="@Localizer.T("settings.gamma.description")">
            <a class="rr-pill-btn ghost sm" href="/gamma">@Localizer.T("common.open")</a>
        </SettingRow>
    </section>
</div>

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    /// <summary>
    /// Every language in its own script and spelling. Someone who ended up in the wrong one has
    /// to find their way back without reading the one they cannot.
    /// </summary>
    private static readonly IReadOnlyList<Dropdown.Option> LanguageOptions =
        AppLanguages.All.Select(l => new Dropdown.Option(l.Code, l.NativeName)).ToList();

    protected override void OnInitialized()
    {
        Appearance.Changed += OnAppearanceChanged;
        DiscordPresence.StateChanged += OnAppearanceChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ApplyAppearanceAsync();
        }
    }

    private void OnAppearanceChanged() => this.DispatchRender(() => InvokeAsync(StateHasChanged));

    // ---- Language ---------------------------------------------------------

    /// <summary>
    /// No re-render of our own: the localizer raises its change event, MainLayout answers it,
    /// and this page comes back with the rest of the window. One owner for the repaint.
    /// </summary>
    private void OnLanguageChanged(string code) => Localizer.SetLanguage(code);

    // ---- Appearance -------------------------------------------------------

    private async Task OnScaleChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var percent))
        {
            Appearance.SetUiScalePercent(percent);
            await ApplyAppearanceAsync();
        }
    }

    private async Task ResetAppearanceAsync()
    {
        Appearance.ResetToDefaults();
        try
        {
            await JS.InvokeVoidAsync("razorReaperTheme.reset");
        }
        catch
        {
            // Falls back to re-applying the (now default) values below.
        }
        await ApplyAppearanceAsync();
        NotificationService.ShowSuccess(Localizer.T("settings.appearance.reset.done"));
    }

    private async Task ApplyAppearanceAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("razorReaperTheme.apply",
                Appearance.UiScalePercent);
        }
        catch
        {
            // Theme script not ready; the value is persisted and applies on next launch.
        }
    }

    // ---- App behaviour ----------------------------------------------------

    private void OnDiscordChanged(bool enabled) => DiscordPresence.IsEnabled = enabled;

    private void OnStartWithArkChanged(bool enabled)
    {
        ArkLink.StartWithArk = enabled;
        StateHasChanged();
    }

    private void OnCloseWithArkChanged(bool enabled)
    {
        ArkLink.CloseWithArk = enabled;
        StateHasChanged();
    }

    private void OnGameBannerChanged(bool enabled)
    {
        GameBanner.Enabled = enabled;
        StateHasChanged();
    }

    public void Dispose()
    {
        this.StopRenderDispatch();
        Appearance.Changed -= OnAppearanceChanged;
        DiscordPresence.StateChanged -= OnAppearanceChanged;
    }
}
