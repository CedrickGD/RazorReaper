@page "/bosses"

<header class="page-header">
    <h1 class="page-title">Boss Tribute Guide</h1>
    <p class="page-subtitle">Bosses and mini-bosses sorted by map with entry requirements.</p>
</header>

<div class="bosses-layout">
    <section class="content-card bosses-intro">
        <div class="bosses-intro-header">
            <div class="bosses-intro-icon">
                <svg fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10 2a6 6 0 0 0-6 6c0 2.5 1.54 4.64 3.74 5.5.16.06.26.21.26.38V16a2 2 0 0 0 4 0v-2.12c0-.17.1-.32.26-.38A5.999 5.999 0 0 0 16 8a6 6 0 0 0-6-6z" />
                </svg>
            </div>
            <div>
                <h3>How to use this list</h3>
                <p>Expand each boss to see Gamma, Beta, and Alpha tribute requirements.</p>
            </div>
        </div>
        <div class="bosses-legend">
            <span class="boss-tier-pill tier-gamma">Gamma</span>
            <span class="boss-tier-pill tier-beta">Beta</span>
            <span class="boss-tier-pill tier-alpha">Alpha</span>
            <span class="bosses-legend-note">Some bosses use a single entry list instead of tiers.</span>
        </div>
    </section>

    @foreach (var map in maps)
    {
        <section class="content-card bosses-map-card">
            <div class="bosses-map-header">
                <div>
                    <h2>@map.Name</h2>
                    @if (!string.IsNullOrWhiteSpace(map.Note))
                    {
                        <p>@map.Note</p>
                    }
                </div>
                <span class="bosses-map-count">@map.Bosses.Count entries</span>
            </div>

            <div class="bosses-grid">
                @foreach (var boss in map.Bosses)
                {
                    <article class="boss-card">
                        <div class="boss-card-header">
                            <div>
                                <div class="boss-title-row">
                                    <h3>@boss.Name</h3>
                                    <span class="boss-type-pill">@boss.Type</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(boss.Arena))
                                {
                                    <div class="boss-arena">@boss.Arena</div>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(boss.Note))
                        {
                            <p class="boss-note">@boss.Note</p>
                        }

                        @if (boss.Tags.Count > 0)
                        {
                            <div class="boss-tags">
                                @foreach (var tag in boss.Tags)
                                {
                                    <span class="boss-tag">@tag</span>
                                }
                            </div>
                        }

                        <details class="boss-tier-details">
                            <summary>
                                <span>@(boss.Tiers.Count > 1 ? "Show tier requirements" : "Show entry requirements")</span>
                                <span class="boss-tier-summary">
                                    @(boss.Tiers.Count > 1 ? "Gamma / Beta / Alpha" : "Single list")
                                </span>
                                <svg class="boss-tier-chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 10.94l3.71-3.7a.75.75 0 1 1 1.06 1.06l-4.24 4.24a.75.75 0 0 1-1.06 0L5.21 8.27a.75.75 0 0 1 .02-1.06z" clip-rule="evenodd" />
                                </svg>
                            </summary>

                            <div class="boss-tier-grid">
                                @foreach (var tier in boss.Tiers)
                                {
                                    <div class="boss-tier-card @tier.CssClass">
                                        <div class="boss-tier-header">
                                            <span class="boss-tier-name">@tier.Name</span>
                                            @if (!string.IsNullOrWhiteSpace(tier.Level))
                                            {
                                                <span class="boss-tier-level">@tier.Level</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(tier.Note))
                                        {
                                            <div class="boss-tier-note">@tier.Note</div>
                                        }
                                        <ul class="boss-requirements">
                                            @foreach (var requirement in tier.Requirements)
                                            {
                                                <li>@requirement</li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </details>
                    </article>
                }
            </div>
        </section>
    }
</div>

