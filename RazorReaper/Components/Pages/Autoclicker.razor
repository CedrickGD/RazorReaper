@page "/autoclicker"
@using System.Runtime.InteropServices
@using System.Timers
@using System.Drawing
@using System.Diagnostics
@using System.Threading
@using Microsoft.Extensions.Logging
@using Microsoft.Maui.Storage
@using RazorReaper.Services
@using RazorReaper.Components.Shared
@using RazorReaper.Services.Automation
@inject IJSRuntime JSRuntime
@inject IActivityService ActivityService
@inject ILogger<Autoclicker> Logger
@inject IAutoClickerHotkeyBinder HotkeyBinder
@inject IAutoClickerRuntime Runtime
@implements IDisposable

<header class="page-header autoclicker-page-header">
    <h1 class="page-title">Auto Clicker</h1>
    <p class="page-subtitle">Advanced mouse automation tool</p>
</header>

@* Mirrors the INI Changer 3-column workspace: viewport-height grid,
   each card is `content-card ini-widget` with `ini-widget-header` (h3 + pill). *@
<PremiumLock RequiresPremium="true">
<div class="autoclicker-layout ini-layout crosshair-layout">

    @* ── LEFT: TIMING ──────────────────────────────────────────────────── *@
    <div class="content-card ini-widget ac-widget @(isRunning ? "is-running" : "")">
        <div class="ini-widget-header">
            <h3>
                <svg class="ac-widget-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="10" cy="11" r="6.5" />
                    <path d="M10 8v3.2l2 1.2" />
                    <path d="M8 3h4" />
                </svg>
                Timing
            </h3>
            <span class="ini-widget-pill @(isRunning ? "live" : "muted")">
                <span class="ini-launcher-stat-dot @(isRunning ? "live" : "muted")"></span>
                @(isRunning ? "Running" : "Idle")
            </span>
        </div>

        <div class="ini-widget-body">
            <div class="interval-row">
                <div class="interval-cell">
                    <input type="number" class="interval-input" min="0" max="99" @bind="hours" />
                    <span class="interval-tag">h</span>
                </div>
                <div class="interval-cell">
                    <input type="number" class="interval-input" min="0" max="59" @bind="minutes" />
                    <span class="interval-tag">m</span>
                </div>
                <div class="interval-cell">
                    <input type="number" class="interval-input" min="0" max="59" @bind="seconds" />
                    <span class="interval-tag">s</span>
                </div>
                <div class="interval-cell">
                    <input type="number" class="interval-input" min="0" max="999" @bind="milliseconds" />
                    <span class="interval-tag">ms</span>
                </div>
            </div>
            <div class="interval-row">
                <div class="interval-cell wide">
                    <input type="number" class="interval-input" min="1" max="500" @bind="clickHoldMs" />
                    <span class="interval-tag">hold (ms)</span>
                </div>
                <div class="interval-cell wide">
                    <input type="number" class="interval-input" min="0" max="60" @bind="preStartDelaySeconds" />
                    <span class="interval-tag">pre-delay (s)</span>
                </div>
            </div>

            <div class="field">
                <label class="field-label">Repeat</label>
                <div class="seg-control">
                    <button class="seg-btn @(repeatMode == RepeatMode.Infinite ? "active" : "")"
                            @onclick="() => repeatMode = RepeatMode.Infinite">Until stopped</button>
                    <button class="seg-btn @(repeatMode == RepeatMode.Count ? "active" : "")"
                            @onclick="() => repeatMode = RepeatMode.Count">Fixed count</button>
                </div>
            </div>
            @if (repeatMode == RepeatMode.Count)
            {
                <div class="interval-row">
                    <div class="interval-cell wide">
                        <input type="number" class="interval-input" min="1" max="999999" @bind="repeatCount" />
                        <span class="interval-tag">clicks</span>
                    </div>
                </div>
                <div class="progress-bar"><div class="progress-fill" style="width: @(GetProgressPercentage())%"></div></div>
            }

            <div class="ac-cps-line">
                <span class="ac-cps-num">@GetEstimatedCps()</span>
                <span class="ac-cps-unit">cps</span>
                <span class="ac-cps-sep">·</span>
                <span class="ac-cps-sub">@GetIntervalDisplay()</span>
            </div>
        </div>

        <div class="ac-cta-row">
            @* Shared Action button, not a bespoke gradient. ini-widget-cta is kept only for
               the flex sizing that makes it fill the row. *@
            <button class="rr-pill-btn ini-widget-cta @(isRunning ? "danger" : "primary")"
                    @onclick="ToggleClicking" disabled="@IsStartButtonDisabled()">
                <span class="ac-cta-label">@(isRunning ? "Stop" : "Start")</span>
                <kbd class="ac-cta-key">@hotkey</kbd>
            </button>
            <button class="rr-pill-btn ghost sm" @onclick="ResetStats">Reset</button>
        </div>
    </div>

    @* ── MIDDLE: CLICK ─────────────────────────────────────────────────── *@
    <div class="content-card ini-widget ac-widget">
        <div class="ini-widget-header">
            <h3>
                <svg class="ac-widget-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 3v3" />
                    <path d="M7 5h6" />
                    <path d="M10 8v8" />
                    <path d="M10 16c2.8 0 4.6-1.7 4.6-4.1 0-1.7-1-3-2.7-3.5" />
                    <path d="M10 16c-2.8 0-4.6-1.7-4.6-4.1 0-1.7 1-3 2.7-3.5" />
                </svg>
                Click
            </h3>
            <span class="ini-widget-pill">@mouseButton · @clickType</span>
        </div>

        <div class="ini-widget-body">
            <div class="field">
                <label class="field-label">Button</label>
                <div class="seg-control">
                    <button class="seg-btn @(mouseButton == MouseButton.Left ? "active" : "")"
                            @onclick="() => mouseButton = MouseButton.Left">Left</button>
                    <button class="seg-btn @(mouseButton == MouseButton.Middle ? "active" : "")"
                            @onclick="() => mouseButton = MouseButton.Middle">Middle</button>
                    <button class="seg-btn @(mouseButton == MouseButton.Right ? "active" : "")"
                            @onclick="() => mouseButton = MouseButton.Right">Right</button>
                </div>
            </div>
            <div class="field">
                <label class="field-label">Type</label>
                <div class="seg-control">
                    <button class="seg-btn @(clickType == ClickType.Single ? "active" : "")"
                            @onclick="() => clickType = ClickType.Single">Single</button>
                    <button class="seg-btn @(clickType == ClickType.Double ? "active" : "")"
                            @onclick="() => clickType = ClickType.Double">Double</button>
                </div>
            </div>
            <div class="field">
                <label class="field-label">Mode</label>
                <div class="seg-control">
                    <button class="seg-btn @(clickMode == ClickMode.Continuous ? "active" : "")"
                            @onclick="() => clickMode = ClickMode.Continuous">Continuous</button>
                    <button class="seg-btn @(clickMode == ClickMode.Burst ? "active" : "")"
                            @onclick="() => clickMode = ClickMode.Burst">Burst</button>
                </div>
            </div>
            @if (clickMode == ClickMode.Burst)
            {
                <div class="row-2">
                    <div class="field">
                        <label class="field-label">Clicks / burst</label>
                        <div class="interval-cell">
                            <input type="number" class="interval-input" min="1" max="1000" @bind="burstClickCount" />
                        </div>
                    </div>
                    <div class="field">
                        <label class="field-label">Pause</label>
                        <div class="interval-cell">
                            <input type="number" class="interval-input" min="0" max="300" @bind="burstPauseSeconds" />
                            <span class="interval-tag">s</span>
                        </div>
                    </div>
                </div>
            }
            <div class="ac-toggle-row">
                <Switch Value="@enableRandomization"
                        ValueChanged="@((bool v) => enableRandomization = v)"
                        Label="Randomize variance" />
            </div>
            @if (enableRandomization)
            {
                <div class="field">
                    <label class="field-label">Variance: <strong>±@randomVarianceMs ms</strong></label>
                    <input type="range" class="rr-slider" min="0" max="500" step="10" @bind="randomVarianceMs" />
                </div>
            }
        </div>
    </div>

    @* ── RIGHT: TARGET ─────────────────────────────────────────────────── *@
    <div class="content-card ini-widget ac-widget">
        <div class="ini-widget-header">
            <h3>
                <svg class="ac-widget-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="10" cy="10" r="6.2" />
                    <path d="M10 2v3" />
                    <path d="M10 15v3" />
                    <path d="M2 10h3" />
                    <path d="M15 10h3" />
                    <circle cx="10" cy="10" r="1.2" fill="currentColor" />
                </svg>
                Target
            </h3>
            <span class="ini-widget-pill">@positionMode</span>
        </div>

        <div class="ini-widget-body">
            <div class="field">
                <label class="field-label">Position</label>
                <div class="seg-control">
                    <button class="seg-btn @(positionMode == PositionMode.Current ? "active" : "")"
                            @onclick="() => positionMode = PositionMode.Current">Cursor</button>
                    <button class="seg-btn @(positionMode == PositionMode.Fixed ? "active" : "")"
                            @onclick="() => positionMode = PositionMode.Fixed">Fixed</button>
                    <button class="seg-btn @(positionMode == PositionMode.Multi ? "active" : "")"
                            @onclick="() => positionMode = PositionMode.Multi">Multi</button>
                </div>
            </div>
            @if (positionMode == PositionMode.Fixed)
            {
                <div class="row-2">
                    <div class="field">
                        <label class="field-label">X</label>
                        <div class="interval-cell">
                            <input type="number" class="interval-input" @bind="fixedX" />
                            <span class="interval-tag">px</span>
                        </div>
                    </div>
                    <div class="field">
                        <label class="field-label">Y</label>
                        <div class="interval-cell">
                            <input type="number" class="interval-input" @bind="fixedY" />
                            <span class="interval-tag">px</span>
                        </div>
                    </div>
                </div>
                <button class="rr-pill-btn ghost sm ac-pick @(pickingLocation ? "armed" : "")" @onclick="StartPickLocation" disabled="@IsPickingLocation()">
                    @(pickingLocation ? "Click anywhere…" : "Pick location")
                </button>
            }
            @if (positionMode == PositionMode.Multi)
            {
                <div class="positions-list">
                    @if (multiPositions.Count == 0)
                    {
                        <p class="muted-line">No positions yet.</p>
                    }
                    else
                    {
                        @foreach (var (pos, index) in multiPositions.Select((p, i) => (p, i)))
                        {
                            <div class="position-item">
                                <span class="position-number">@(index + 1)</span>
                                <span class="position-coords">@pos.X, @pos.Y</span>
                                <button class="rr-pill-btn ghost sm danger" @onclick="() => RemovePosition(index)">×</button>
                            </div>
                        }
                    }
                </div>
                <button class="rr-pill-btn ghost sm ac-pick @(pickingLocation ? "armed" : "")" @onclick="StartPickMultiLocation" disabled="@IsPickingLocation()">
                    @(pickingLocation ? "Click anywhere…" : "Add position")
                </button>
            }
            <p class="ac-cursor"><span class="ac-cursor-label">Cursor</span><span class="ac-cursor-val">@currentMouseX, @currentMouseY</span></p>

            <div class="field">
                <label class="field-label">Hotkey</label>
                <button class="hotkey-btn full-width @(recordingKey ? "recording" : "")"
                        @onclick="StartHotkeyRecording"
                        @onkeydown="CaptureHotkey"
                        @onkeydown:preventDefault="true"
                        tabindex="0">
                    @(recordingKey ? "Press a key…" : hotkey)
                </button>
            </div>
        </div>
    </div>

</div>
</PremiumLock>

@code {
    public enum MouseButton { Left, Middle, Right }
    public enum ClickType { Single, Double }
    public enum RepeatMode { Infinite, Count }
    public enum PositionMode { Current, Fixed, Multi }
    public enum ClickMode { Continuous, Burst }

    // Short summary line shown under the status title.
    private string StatusSubLine => isRunning
        ? $"{GetIntervalDisplay()} · {mouseButton} · {clickType}{(repeatMode == RepeatMode.Count ? $" · {clickCount}/{repeatCount}" : $" · {clickCount} clicks")}"
        : $"Press {hotkey} to start · {GetIntervalDisplay()}";

    private int hours = 0;
    private int minutes = 0;
    private int seconds = 1;
    private int milliseconds = 0;

    // OP Auto Clicker-compatible defaults: 5ms hold, no pre-start delay.
    private int clickHoldMs = 5;
    private int preStartDelaySeconds = 0;

    private MouseButton mouseButton = MouseButton.Left;
    private ClickType clickType = ClickType.Single;
    private RepeatMode repeatMode = RepeatMode.Infinite;
    private int repeatCount = 10;
    private PositionMode positionMode = PositionMode.Current;

    private int fixedX = 0;
    private int fixedY = 0;
    private int currentMouseX = 0;
    private int currentMouseY = 0;
    private bool pickingLocation = false;

    private bool enableRandomization = false;
    private int randomVarianceMs = 100;
    private Random random = new Random();

    // Multi-position
    private List<POINT> multiPositions = new List<POINT>();

    // Burst mode
    private ClickMode clickMode = ClickMode.Continuous;
    private int burstClickCount = 10;
    private int burstPauseSeconds = 2;

    // Running state, the counter and the next-click estimate all live in the runtime now, so the
    // page shows the same session whether it was started here or by the global hotkey.
    private bool isRunning => Runtime.IsRunning;
    private int clickCount => Runtime.ClickCount;
    private DateTime? nextClickTime => Runtime.NextClickTime;
    private System.Timers.Timer? mouseTrackingTimer;

    private string hotkey = "F6";
    private bool recordingKey = false;
    private int currentHotkeyCode = 0x75; // F6
    private bool hotkeyEnabled = true;

    private const string HOTKEY_STORAGE_KEY = "AutoclickerHotkey";
    private const string HOTKEY_CODE_STORAGE_KEY = "AutoclickerHotkeyCode";
    private bool _hasInitialized = false;

    [DllImport("user32.dll")]
    private static extern bool GetCursorPos(out POINT lpPoint);

    [DllImport("user32.dll")]
    private static extern bool SetCursorPos(int x, int y);

    [DllImport("user32.dll")]
    private static extern IntPtr GetForegroundWindow();

    [DllImport("user32.dll")]
    private static extern uint GetWindowThreadProcessId(IntPtr hWnd, out uint lpdwProcessId);

    [DllImport("kernel32.dll")]
    private static extern IntPtr GetConsoleWindow();

    [DllImport("user32.dll")]
    private static extern IntPtr SetWindowsHookEx(int idHook, LowLevelMouseProc lpfn, IntPtr hMod, uint dwThreadId);

    [DllImport("user32.dll")]
    [return: MarshalAs(UnmanagedType.Bool)]
    private static extern bool UnhookWindowsHookEx(IntPtr hhk);

    [DllImport("user32.dll")]
    private static extern IntPtr CallNextHookEx(IntPtr hhk, int nCode, IntPtr wParam, IntPtr lParam);

    [DllImport("kernel32.dll")]
    private static extern IntPtr GetModuleHandle(string lpModuleName);

    [DllImport("user32.dll", SetLastError = true)]
    private static extern uint SendInput(uint nInputs, INPUT[] pInputs, int cbSize);

    [DllImport("winmm.dll", EntryPoint = "timeBeginPeriod")]
    private static extern uint TimeBeginPeriod(uint uMilliseconds);

    [DllImport("winmm.dll", EntryPoint = "timeEndPeriod")]
    private static extern uint TimeEndPeriod(uint uMilliseconds);

    private delegate IntPtr LowLevelMouseProc(int nCode, IntPtr wParam, IntPtr lParam);

    private const int WH_MOUSE_LL = 14;
    private const int WM_LBUTTONDOWN = 0x0201;

    private IntPtr mouseHookID = IntPtr.Zero;
    private LowLevelMouseProc? mouseProc;

    [StructLayout(LayoutKind.Sequential)]
    public struct POINT
    {
        public int X;
        public int Y;
    }

    [StructLayout(LayoutKind.Sequential)]
    private struct MSLLHOOKSTRUCT
    {
        public POINT pt;
        public uint mouseData;
        public uint flags;
        public uint time;
        public IntPtr dwExtraInfo;
    }

    [StructLayout(LayoutKind.Sequential)]
    private struct INPUT
    {
        public uint type;
        public InputUnion u;
    }

    [StructLayout(LayoutKind.Explicit)]
    private struct InputUnion
    {
        [FieldOffset(0)]
        public MOUSEINPUT mi;
        [FieldOffset(0)]
        public KEYBDINPUT ki;
        [FieldOffset(0)]
        public HARDWAREINPUT hi;
    }

    [StructLayout(LayoutKind.Sequential)]
    private struct MOUSEINPUT
    {
        public int dx;
        public int dy;
        public uint mouseData;
        public uint dwFlags;
        public uint time;
        public IntPtr dwExtraInfo;
    }

    [StructLayout(LayoutKind.Sequential)]
    private struct KEYBDINPUT
    {
        public ushort wVk;
        public ushort wScan;
        public uint dwFlags;
        public uint time;
        public IntPtr dwExtraInfo;
    }

    [StructLayout(LayoutKind.Sequential)]
    private struct HARDWAREINPUT
    {
        public uint uMsg;
        public ushort wParamL;
        public ushort wParamH;
    }

    private const uint INPUT_MOUSE = 0;
    private const uint MOUSEEVENTF_LEFTDOWN = 0x0002;
    private const uint MOUSEEVENTF_LEFTUP = 0x0004;
    private const uint MOUSEEVENTF_RIGHTDOWN = 0x0008;
    private const uint MOUSEEVENTF_RIGHTUP = 0x0010;
    private const uint MOUSEEVENTF_MIDDLEDOWN = 0x0020;
    private const uint MOUSEEVENTF_MIDDLEUP = 0x0040;
    private const uint MOUSEEVENTF_ABSOLUTE = 0x8000;
    private const uint MOUSEEVENTF_MOVE = 0x0001;

    protected override Task OnInitializedAsync()
    {
        // Defer heavy setup until after the first render.
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hasInitialized)
            return;

        _hasInitialized = true;
        await InitializeAsync();
    }

    private async Task InitializeAsync()
    {
        // NOTE: timeBeginPeriod(1) is now raised in StartClicking and dropped in StopClicking.
        // Holding it page-wide affected the whole OS's timing — battery drain, other apps' timers
        // running hotter. Scope it to the actual clicking session.

        // Load persisted preferences (interval, hold, pre-delay, etc.)
        LoadSettings();

        // Load saved hotkey from localStorage
        await LoadSavedHotkey();

        mouseTrackingTimer = new System.Timers.Timer(100);
        mouseTrackingTimer.Elapsed += UpdateMousePosition;
        mouseTrackingTimer.Start();

        // The hotkey itself is owned by IAutoClickerHotkeyBinder for the lifetime of the app, so
        // this page only subscribes while it is on screen.
        HotkeyBinder.Toggled += HandleHotkeyToggled;
        Runtime.StateChanged += HandleRuntimeStateChanged;

        // Reflect whatever the runtime already holds — the session may have been started from
        // another page, and the settings outlive this component now.
        ApplyConfig(Runtime.Config);

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Mirrors a runtime config snapshot back into the editor fields.</summary>
    private void ApplyConfig(RazorReaper.Services.Automation.AutoClickerConfig c)
    {
        hours = c.Hours;
        minutes = c.Minutes;
        seconds = c.Seconds;
        milliseconds = c.Milliseconds;
        clickHoldMs = c.HoldMs;
        preStartDelaySeconds = c.PreStartDelaySeconds;
        repeatCount = c.RepeatCount;

        mouseButton = c.Button switch
        {
            RazorReaper.Services.Automation.MouseButton.Middle => MouseButton.Middle,
            RazorReaper.Services.Automation.MouseButton.Right => MouseButton.Right,
            _ => MouseButton.Left,
        };
        clickType = c.ClickType == RazorReaper.Services.Automation.AutoClickerClickType.Double
            ? ClickType.Double : ClickType.Single;
        repeatMode = c.RepeatMode == RazorReaper.Services.Automation.AutoClickerRepeatMode.Count
            ? RepeatMode.Count : RepeatMode.Infinite;
        positionMode = c.PositionMode switch
        {
            RazorReaper.Services.Automation.AutoClickerPositionMode.Fixed => PositionMode.Fixed,
            RazorReaper.Services.Automation.AutoClickerPositionMode.Multi => PositionMode.Multi,
            _ => PositionMode.Current,
        };
        fixedX = c.FixedX;
        fixedY = c.FixedY;
        multiPositions = c.MultiPositions.Select(p => new POINT { X = p.X, Y = p.Y }).ToList();
        clickMode = c.Mode == RazorReaper.Services.Automation.AutoClickerBurstMode.Burst
            ? ClickMode.Burst : ClickMode.Continuous;
        burstClickCount = c.BurstClickCount;
        burstPauseSeconds = c.BurstPauseSeconds;
        enableRandomization = c.Randomize;
        randomVarianceMs = c.RandomVarianceMs;
    }

    private void LoadSettings()
    {
        try
        {
            ApplyConfig(Runtime.Config);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Autoclicker LoadSettings failed");
        }
    }

    private void SaveSettings()
    {
        try
        {
            // Persistence moved into the runtime's config store, which saves every setting rather
            // than only the timing half — the hotkey can now start a session from anywhere, and it
            // has to use what the user actually chose.
            PushConfig();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Autoclicker SaveSettings failed");
        }
    }

    private async Task LoadSavedHotkey()
    {
        // One-off carry-over. The hotkey used to live in localStorage, which the hotkeys page
        // cannot reach, so anyone who already set one would otherwise silently be reset to F6.
        if (!AutoClickerHotkey.HasStoredValue)
        {
            try
            {
                var legacyName = await JSRuntime.InvokeAsync<string>("localStorage.getItem", HOTKEY_STORAGE_KEY);
                if (!string.IsNullOrWhiteSpace(legacyName)) AutoClickerHotkey.Set(legacyName);

                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", HOTKEY_STORAGE_KEY);
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", HOTKEY_CODE_STORAGE_KEY);
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Could not carry the old autoclicker hotkey over");
            }
        }

        hotkey = AutoClickerHotkey.Display;
        currentHotkeyCode = AutoClickerHotkey.Code;
    }

    private void SaveHotkey()
    {
        if (!AutoClickerHotkey.Set(hotkey)) AutoClickerHotkey.Reset();
    }

    private void UpdateMousePosition(object? sender, ElapsedEventArgs e)
    {
        if (GetCursorPos(out POINT point))
        {
            currentMouseX = point.X;
            currentMouseY = point.Y;
            InvokeAsync(StateHasChanged);
        }
    }

    private void HandleHotkeyToggled()
    {
        // Fired from the hotkey pump's thread pool callback — hop onto the renderer before
        // touching component state.
        _ = InvokeAsync(async () =>
        {
            if (recordingKey || !hotkeyEnabled) return;
            await ToggleClicking();
        });
    }

    private void StartHotkeyRecording()
    {
        recordingKey = true;
        hotkeyEnabled = false; // Disable hotkey monitoring while recording
        // Release the key at the OS level too, otherwise the keystroke being captured would be
        // swallowed by our own registration instead of reaching the capture field.
        HotkeyBinder.IsSuspended = true;
        StateHasChanged();
    }

    private async Task CaptureHotkey(KeyboardEventArgs e)
    {
        if (recordingKey)
        {
            recordingKey = false;

            // Use Code property for more reliable F-key detection
            var keyName = string.IsNullOrEmpty(e.Code) ? e.Key.ToUpper() : e.Code.ToUpper();

            // Handle special key names from browser Code property
            if (keyName.StartsWith("F") && int.TryParse(keyName.Substring(1), out int fnum) && fnum >= 1 && fnum <= 24)
            {
                keyName = $"F{fnum}";
            }
            else if (keyName.StartsWith("KEY"))
            {
                // Handle "KeyA", "KeyB" format from Code property
                keyName = keyName.Substring(3);
            }
            else if (keyName.StartsWith("DIGIT"))
            {
                // Handle "Digit0", "Digit1" format from Code property
                keyName = keyName.Substring(5);
            }
            else if (keyName == " ")
            {
                keyName = "SPACE";
            }
            else if (keyName.Length > 1)
            {
                // Handle other special keys
                keyName = keyName switch
                {
                    "ARROWUP" => "UP",
                    "ARROWDOWN" => "DOWN",
                    "ARROWLEFT" => "LEFT",
                    "ARROWRIGHT" => "RIGHT",
                    _ => keyName
                };
            }

            // Set rejects a name it cannot resolve, so an unusable capture falls back rather
            // than being stored and quietly breaking the hotkey.
            if (!AutoClickerHotkey.Set(keyName)) AutoClickerHotkey.Reset();

            hotkey = AutoClickerHotkey.Display;
            currentHotkeyCode = AutoClickerHotkey.Code;

            // Brief gate so the keypress that just bound the hotkey doesn't immediately trigger it.
            await Task.Delay(200);
            hotkeyEnabled = true;
            HotkeyBinder.IsSuspended = false;   // re-registers the newly chosen key

            StateHasChanged();
        }
    }


    private bool IsValidInterval()
    {
        return hours > 0 || minutes > 0 || seconds > 0 || milliseconds > 0;
    }

    private double GetTotalMilliseconds()
    {
        return (hours * 3600000) + (minutes * 60000) + (seconds * 1000) + milliseconds;
    }

    private string GetIntervalDisplay()
    {
        var parts = new List<string>();
        if (hours > 0) parts.Add($"{hours}h");
        if (minutes > 0) parts.Add($"{minutes}m");
        if (seconds > 0) parts.Add($"{seconds}s");
        if (milliseconds > 0) parts.Add($"{milliseconds}ms");
        return parts.Count > 0 ? string.Join(" ", parts) : "0ms";
    }

    /// <summary>Estimated clicks-per-second from the current interval. Forces
    /// invariant culture so the decimal separator is "." not "," regardless
    /// of the user's system locale.</summary>
    private string GetEstimatedCps()
    {
        var ms = GetTotalMilliseconds();
        if (ms < 1) return "—";
        var cps = 1000.0 / ms;
        string fmt = cps >= 100 ? "F0" : (cps >= 10 ? "F1" : "F2");
        return cps.ToString(fmt, System.Globalization.CultureInfo.InvariantCulture);
    }

    private double GetProgressPercentage()
    {
        if (repeatMode != RepeatMode.Count || repeatCount == 0) return 0;
        return Math.Min(100, (double)clickCount / repeatCount * 100);
    }

    private string GetNextClickTime()
    {
        if (!isRunning || nextClickTime == null) return "N/A";
        var remaining = nextClickTime.Value - DateTime.Now;
        return remaining.TotalMilliseconds > 0 ? $"{remaining.TotalMilliseconds:F0}ms" : "Now";
    }

    // ── Engine delegation ──────────────────────────────────────────────────────
    // The click loop itself lives in IAutoClickerRuntime (app-lifetime singleton) so a
    // system-wide hotkey can start and stop it with this page closed. Everything below just
    // translates the page's editor state into a config snapshot and drives that runtime.

    private RazorReaper.Services.Automation.AutoClickerConfig BuildConfig() => new()
    {
        Hours = hours,
        Minutes = minutes,
        Seconds = seconds,
        Milliseconds = milliseconds,
        HoldMs = clickHoldMs,
        PreStartDelaySeconds = preStartDelaySeconds,
        // Deliberately mapped rather than cast: this page orders the buttons Left/Middle/Right
        // while the shared input enum orders them Left/Right/Middle.
        Button = mouseButton switch
        {
            MouseButton.Middle => RazorReaper.Services.Automation.MouseButton.Middle,
            MouseButton.Right => RazorReaper.Services.Automation.MouseButton.Right,
            _ => RazorReaper.Services.Automation.MouseButton.Left,
        },
        ClickType = clickType == ClickType.Double
            ? RazorReaper.Services.Automation.AutoClickerClickType.Double
            : RazorReaper.Services.Automation.AutoClickerClickType.Single,
        RepeatMode = repeatMode == RepeatMode.Count
            ? RazorReaper.Services.Automation.AutoClickerRepeatMode.Count
            : RazorReaper.Services.Automation.AutoClickerRepeatMode.Infinite,
        RepeatCount = repeatCount,
        PositionMode = positionMode switch
        {
            PositionMode.Fixed => RazorReaper.Services.Automation.AutoClickerPositionMode.Fixed,
            PositionMode.Multi => RazorReaper.Services.Automation.AutoClickerPositionMode.Multi,
            _ => RazorReaper.Services.Automation.AutoClickerPositionMode.Current,
        },
        FixedX = fixedX,
        FixedY = fixedY,
        MultiPositions = multiPositions
            .Select(p => new RazorReaper.Services.Automation.AutoClickerPoint(p.X, p.Y))
            .ToList(),
        Mode = clickMode == ClickMode.Burst
            ? RazorReaper.Services.Automation.AutoClickerBurstMode.Burst
            : RazorReaper.Services.Automation.AutoClickerBurstMode.Continuous,
        BurstClickCount = burstClickCount,
        BurstPauseSeconds = burstPauseSeconds,
        Randomize = enableRandomization,
        RandomVarianceMs = randomVarianceMs,
    };

    /// <summary>Hands the current editor state to the runtime and persists it.</summary>
    private void PushConfig()
    {
        if (Runtime.IsRunning) return;   // the runtime ignores edits mid-session anyway
        Runtime.Configure(BuildConfig());
    }

    private async Task ToggleClicking()
    {
        if (!Runtime.IsRunning) PushConfig();
        await Runtime.ToggleAsync();
    }

    private async Task StartClicking()
    {
        PushConfig();
        await Runtime.StartAsync();
    }

    private void StopClicking() => Runtime.Stop();

    private void HandleRuntimeStateChanged() => _ = InvokeAsync(StateHasChanged);

    private DotNetObjectReference<Autoclicker>? _dotNetRef;

    private async Task StartPickLocation()
    {
        pickingLocation = true;
        StateHasChanged();

        _dotNetRef?.Dispose();
        _dotNetRef = DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("startLocationPicker", _dotNetRef);
    }

    [JSInvokable]
    public void StartGlobalLocationPicker()
    {
        // Start global mouse hook
        mouseProc = HookCallback;
        using (var curProcess = System.Diagnostics.Process.GetCurrentProcess())
        using (var curModule = curProcess.MainModule)
        {
            if (curModule != null)
            {
                mouseHookID = SetWindowsHookEx(WH_MOUSE_LL, mouseProc, GetModuleHandle(curModule.ModuleName ?? ""), 0);
            }
        }
    }

    private IntPtr HookCallback(int nCode, IntPtr wParam, IntPtr lParam)
    {
        if (nCode >= 0 && wParam == (IntPtr)WM_LBUTTONDOWN && pickingLocation)
        {
            var hookStruct = Marshal.PtrToStructure<MSLLHOOKSTRUCT>(lParam);

            // Unhook immediately
            if (mouseHookID != IntPtr.Zero)
            {
                UnhookWindowsHookEx(mouseHookID);
                mouseHookID = IntPtr.Zero;
            }

            // Set the picked location (these are absolute screen coordinates across all monitors)
            InvokeAsync(() =>
            {
                fixedX = hookStruct.pt.X;
                fixedY = hookStruct.pt.Y;
                pickingLocation = false;
                StateHasChanged();
            });

            // Don't pass the click through
            return (IntPtr)1;
        }

        return CallNextHookEx(mouseHookID, nCode, wParam, lParam);
    }

    [JSInvokable]
    public void SetPickedLocation(int x, int y)
    {
        // Only update if not cancelled (ESC pressed returns -1, -1)
        if (x >= 0 && y >= 0)
        {
            if (positionMode == PositionMode.Multi)
            {
                multiPositions.Add(new POINT { X = x, Y = y });
            }
            else
            {
                fixedX = x;
                fixedY = y;
            }
        }

        // Unhook if still active
        if (mouseHookID != IntPtr.Zero)
        {
            UnhookWindowsHookEx(mouseHookID);
            mouseHookID = IntPtr.Zero;
        }

        pickingLocation = false;
        InvokeAsync(StateHasChanged);
    }

    private void ResetStats()
    {
        // Stop clicking if running
        if (isRunning)
        {
            StopClicking();
        }

        // The counter and next-click estimate belong to the runtime; stopping already cleared
        // them, and a fresh StartAsync resets the count to zero.
        StateHasChanged();
    }

    // Multi-position methods
    private async Task StartPickMultiLocation()
    {
        pickingLocation = true;
        StateHasChanged();
        _dotNetRef?.Dispose();
        _dotNetRef = DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("startLocationPicker", _dotNetRef);
    }

    private void RemovePosition(int index)
    {
        if (index >= 0 && index < multiPositions.Count)
        {
            multiPositions.RemoveAt(index);
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        // Hand the editor state over before leaving, so a hotkey press from another page starts
        // with what is on screen right now.
        try { PushConfig(); } catch { /* never let teardown throw */ }

        // Deliberately does NOT stop the clicker. The session belongs to the runtime now, so
        // navigating away leaves it running — which is the whole point of a system-wide hotkey.
        mouseTrackingTimer?.Stop();
        mouseTrackingTimer?.Dispose();

        // Both the binding and the runtime outlive this page; just stop listening to them.
        HotkeyBinder.Toggled -= HandleHotkeyToggled;
        HotkeyBinder.IsSuspended = false;
        Runtime.StateChanged -= HandleRuntimeStateChanged;

        // Dispose JS interop reference
        _dotNetRef?.Dispose();

        // Cleanup mouse hook if active
        if (mouseHookID != IntPtr.Zero)
        {
            UnhookWindowsHookEx(mouseHookID);
            mouseHookID = IntPtr.Zero;
        }
    }

    // Helper methods for boolean attributes
    private bool IsStartButtonDisabled() => !IsValidInterval();
    private bool IsPickingLocation() => pickingLocation;
}
