    private bool IsValidInterval()
    {
        return hours > 0 || minutes > 0 || seconds > 0 || milliseconds > 0;
    }

    private double GetTotalMilliseconds()
    {
        return (hours * 3600000) + (minutes * 60000) + (seconds * 1000) + milliseconds;
    }

    private string GetIntervalDisplay()
    {
        var parts = new List<string>();
        if (hours > 0) parts.Add($"{hours}h");
        if (minutes > 0) parts.Add($"{minutes}m");
        if (seconds > 0) parts.Add($"{seconds}s");
        if (milliseconds > 0) parts.Add($"{milliseconds}ms");
        return parts.Count > 0 ? string.Join(" ", parts) : "0ms";
    }

    /// <summary>Estimated clicks-per-second from the current interval. Forces
    /// invariant culture so the decimal separator is "." not "," regardless
    /// of the user's system locale.</summary>
    private string GetEstimatedCps()
    {
        var ms = GetTotalMilliseconds();
        if (ms < 1) return "—";
        var cps = 1000.0 / ms;
        string fmt = cps >= 100 ? "F0" : (cps >= 10 ? "F1" : "F2");
        return cps.ToString(fmt, System.Globalization.CultureInfo.InvariantCulture);
    }

    private double GetProgressPercentage()
    {
        if (repeatMode != RepeatMode.Count || repeatCount == 0) return 0;
        return Math.Min(100, (double)clickCount / repeatCount * 100);
    }

    private string GetNextClickTime()
    {
        if (!isRunning || nextClickTime == null) return "N/A";
        var remaining = nextClickTime.Value - DateTime.Now;
        return remaining.TotalMilliseconds > 0 ? $"{remaining.TotalMilliseconds:F0}ms" : "Now";
    }

    private async Task ToggleClicking()
    {
        if (isRunning)
        {
            StopClicking();
        }
        else
        {
            await StartClicking();
        }
    }

    private async Task StartClicking()
    {
        if (!IsValidInterval()) return;

        isRunning = true;
        clickCount = 0;
        _ticksSinceUiYield = 0;

        // Per-session cancellation source — wakes Task.Delays immediately on Stop so the
        // click loop bails within ~1ms instead of waiting for the next hold/interval boundary.
        _clickCts?.Dispose();
        _clickCts = new CancellationTokenSource();

        // Raise system timer resolution to 1ms ONLY while clicking. Dropped on stop so the
        // OS goes back to normal power-friendly timing the moment the user is done.
        if (!_timerResolutionRaised)
        {
            try { TimeBeginPeriod(1); _timerResolutionRaised = true; }
            catch { /* old Windows: ignore */ }
        }

        // Persist current settings so they survive a restart.
        SaveSettings();

        // Pre-start delay (countdown) — interruptible via the per-session token.
        if (preStartDelaySeconds > 0)
        {
            try
            {
                await Task.Delay(preStartDelaySeconds * 1000, _clickCts.Token);
            }
            catch (OperationCanceledException)
            {
                return;
            }
            if (!isRunning) return;
        }

        var interval = GetTotalMilliseconds();

        // Use a custom timer approach for randomization
        if (enableRandomization)
        {
            // Start a background task that handles clicking with randomization
            _ = Task.Run(async () => await RandomizedClickLoop());
        }
        else
        {
            clickTimer = new System.Timers.Timer(interval);

            // Store the event handler so we can properly unsubscribe later.
            // Semaphore gate drops overlapping ticks instead of queuing — same pattern
            // OP Auto Clicker uses to stay sub-ms without thread storms.
            timerEventHandler = OnClickTimerElapsed;
            clickTimer.Elapsed += timerEventHandler;

            clickTimer.AutoReset = true;
            clickTimer.Start();

            nextClickTime = DateTime.Now.AddMilliseconds(interval);

            await PerformClick();
        }

        // Log activity
        ActivityService.AddActivity($"Autoclicker started ({GetIntervalDisplay()} interval)", "success");

        await InvokeAsync(StateHasChanged);
    }

    private async void OnClickTimerElapsed(object? sender, ElapsedEventArgs e)
    {
        // WaitAsync(0) returns false immediately if the previous tick hasn't finished;
        // dropping the tick is correct here — queuing would build up a backlog and crash.
        if (!await _clickGate.WaitAsync(0)) return;
        try
        {
            await PerformClick();
        }
        finally
        {
            _clickGate.Release();
        }
    }

    private async Task RandomizedClickLoop()
    {
        var sw = new Stopwatch();
        while (isRunning)
        {
            // Honor Count repeat mode the same way the timer path does.
            if (repeatMode == RepeatMode.Count && clickCount >= repeatCount)
            {
                await InvokeAsync(() => StopClicking());
                break;
            }

            sw.Restart();
            await PerformClick();

            if (!isRunning) break;

            var baseInterval = GetTotalMilliseconds();
            var variance = random.Next(-randomVarianceMs, randomVarianceMs + 1);
            var actualInterval = Math.Max(1, baseInterval + variance); // Floor 1 ms

            await InvokeAsync(() =>
            {
                nextClickTime = DateTime.Now.AddMilliseconds(actualInterval);
                StateHasChanged();
            });

            // Stopwatch-based self-correcting pacing: subtract actual click time from
            // the configured interval so we don't drift on long sessions.
            var elapsedMs = sw.ElapsedMilliseconds;
            var remaining = (int)Math.Max(0, actualInterval - elapsedMs);
            if (remaining > 0)
            {
                try { await Task.Delay(remaining, _clickCts?.Token ?? CancellationToken.None); }
                catch (OperationCanceledException) { break; }
            }
        }
    }

    private void StopClicking()
    {
        isRunning = false;
        nextClickTime = null;

        // Cancel the per-session token first — this wakes any in-flight Task.Delay
        // inside PerformClick / RandomizedClickLoop so they exit immediately instead of
        // waiting out the remaining hold-ms or interval. THIS is what makes stop feel instant.
        try { _clickCts?.Cancel(); } catch { }

        // Immediately stop and dispose timer
        if (clickTimer != null)
        {
            clickTimer.Stop();

            // Properly unsubscribe using the stored handler
            if (timerEventHandler != null)
            {
                clickTimer.Elapsed -= timerEventHandler;
                timerEventHandler = null;
            }

            clickTimer.Dispose();
            clickTimer = null;
        }

        // Drop the global 1ms timer resolution boost — the OS goes back to its default
        // (~15.6ms) so other apps and the system itself stop running their timers hot.
        if (_timerResolutionRaised)
        {
            try { TimeEndPeriod(1); } catch { }
            _timerResolutionRaised = false;
        }

        // Persist any setting changes the user made during the session.
        SaveSettings();

        // Log activity
        ActivityService.AddActivity($"Autoclicker stopped ({clickCount} clicks performed)", "info");

        StateHasChanged();
    }

    private async Task PerformClick()
    {
        // Double check if still running (instant stop)
        if (!isRunning) return;

        // Never click while RazorReaper's own window is focused. Otherwise the very first
        // synthetic click (Cursor mode) lands on the Start button and instantly toggles
        // Stop — the "it insta-stops when I press Start" bug. Clicks resume the moment the
        // user switches to their target window. Skipping a tick is cheap; the timer keeps
        // firing and the next tick clicks once the target app is focused.
        if (IsOwnWindowForeground()) return;

        // Check burst mode
        if (clickMode == ClickMode.Burst)
        {
            if (currentBurstCount >= burstClickCount)
            {
                // Pause between bursts — interruptible by Stop.
                currentBurstCount = 0;
                try { await Task.Delay(burstPauseSeconds * 1000, _clickCts?.Token ?? CancellationToken.None); }
                catch (OperationCanceledException) { return; }
                if (!isRunning) return;
            }
        }

        // Only check repeat count BEFORE performing the click to avoid premature stops
        if (repeatMode == RepeatMode.Count && clickCount >= repeatCount)
        {
            await InvokeAsync(() =>
            {
                StopClicking();
            });
            return;
        }

        // Run click on background thread to avoid UI blocking
        await Task.Run(async () =>
        {
            try
            {
                // Check again before performing click
                if (!isRunning) return;

                POINT currentPos = new POINT();
                GetCursorPos(out currentPos);

                int clickX = currentPos.X;
                int clickY = currentPos.Y;

                // Determine click position based on mode.
                // SetCursorPos is synchronous on Windows — no Task.Delay needed.
                // NOTE: we do NOT restore the cursor back to the user's original position
                // after each click. That restoration was what made the screen unusable —
                // at high CPS the cursor was flying back and forth between the user's hand
                // and the target. OP Auto Clicker / Crosshair X behavior is "cursor stays
                // at the click target until you move it yourself" which is much saner.
                if (positionMode == PositionMode.Fixed)
                {
                    clickX = fixedX;
                    clickY = fixedY;
                    SetCursorPos(clickX, clickY);
                }
                else if (positionMode == PositionMode.Multi && multiPositions.Count > 0)
                {
                    // Single-position mode: always use index 0, skip cycling.
                    int idx = multiPositions.Count == 1
                        ? 0
                        : currentPositionIndex;
                    var pos = multiPositions[idx];
                    clickX = pos.X;
                    clickY = pos.Y;
                    SetCursorPos(clickX, clickY);

                    if (multiPositions.Count > 1)
                    {
                        currentPositionIndex = (currentPositionIndex + 1) % multiPositions.Count;
                    }
                }

                // Check if still running before clicking
                if (!isRunning) return;

                var (downFlag, upFlag) = GetMouseEventFlags();

                // Use SendInput for proper system-wide clicks.
                // clickHoldMs is the down→up gap; default 5 ms matches OP Auto Clicker.
                int hold = Math.Max(1, clickHoldMs);
                var token = _clickCts?.Token ?? CancellationToken.None;

                SendMouseInput(downFlag);
                try { await Task.Delay(hold, token); } catch (OperationCanceledException) { return; }

                if (!isRunning) return;

                SendMouseInput(upFlag);

                if (clickType == ClickType.Double && isRunning)
                {
                    try { await Task.Delay(hold, token); } catch (OperationCanceledException) { return; }
                    if (!isRunning) return;
                    SendMouseInput(downFlag);
                    try { await Task.Delay(hold, token); } catch (OperationCanceledException) { return; }
                    if (!isRunning) return;
                    SendMouseInput(upFlag);
                }

                await InvokeAsync(() =>
                {
                    clickCount++;
                    currentBurstCount++;

                    if (isRunning && !enableRandomization)
                    {
                        nextClickTime = DateTime.Now.AddMilliseconds(GetTotalMilliseconds());
                    }

                    // Only stop if in Count mode AND reached target
                    if (isRunning && repeatMode == RepeatMode.Count && clickCount >= repeatCount)
                    {
                        StopClicking();
                    }

                    StateHasChanged();
                });

                // Yield to the UI thread periodically so 1000+ CPS doesn't freeze the page.
                if (++_ticksSinceUiYield >= 50)
                {
                    _ticksSinceUiYield = 0;
                    await Task.Yield();
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Autoclicker click loop error");
            }
        });
    }

    private void SendMouseInput(uint flag)
    {
        INPUT[] inputs = new INPUT[1];
        inputs[0].type = INPUT_MOUSE;
        inputs[0].u.mi.dx = 0;
        inputs[0].u.mi.dy = 0;
        inputs[0].u.mi.mouseData = 0;
        inputs[0].u.mi.dwFlags = flag;
        inputs[0].u.mi.time = 0;
        inputs[0].u.mi.dwExtraInfo = IntPtr.Zero;

        SendInput(1, inputs, Marshal.SizeOf(typeof(INPUT)));
    }

    private (uint downFlag, uint upFlag) GetMouseEventFlags()
    {
        return mouseButton switch
        {
            MouseButton.Left => (MOUSEEVENTF_LEFTDOWN, MOUSEEVENTF_LEFTUP),
            MouseButton.Right => (MOUSEEVENTF_RIGHTDOWN, MOUSEEVENTF_RIGHTUP),
            MouseButton.Middle => (MOUSEEVENTF_MIDDLEDOWN, MOUSEEVENTF_MIDDLEUP),
            _ => (MOUSEEVENTF_LEFTDOWN, MOUSEEVENTF_LEFTUP)
        };
    }

    // True when RazorReaper's own window is the foreground (active) window. Auto-clicks are
    // suppressed while this is true so the synthetic click can't hit our own Start button /
    // config UI — the user focuses their target app for clicks to land there.
    private bool IsOwnWindowForeground()
    {
        try
        {
            var fg = GetForegroundWindow();
            if (fg == IntPtr.Zero) return false;
            GetWindowThreadProcessId(fg, out uint pid);
            return pid == (uint)Environment.ProcessId;
        }
        catch
        {
            return false;
        }
    }

    private DotNetObjectReference<Autoclicker>? _dotNetRef;

    private async Task StartPickLocation()
    {
        pickingLocation = true;
        StateHasChanged();

        _dotNetRef?.Dispose();
        _dotNetRef = DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("startLocationPicker", _dotNetRef);
    }

    [JSInvokable]
    public void StartGlobalLocationPicker()
    {
        // Start global mouse hook
        mouseProc = HookCallback;
        using (var curProcess = System.Diagnostics.Process.GetCurrentProcess())
        using (var curModule = curProcess.MainModule)
        {
            if (curModule != null)
            {
                mouseHookID = SetWindowsHookEx(WH_MOUSE_LL, mouseProc, GetModuleHandle(curModule.ModuleName ?? ""), 0);
            }
        }
    }

    private IntPtr HookCallback(int nCode, IntPtr wParam, IntPtr lParam)
    {
        if (nCode >= 0 && wParam == (IntPtr)WM_LBUTTONDOWN && pickingLocation)
        {
            var hookStruct = Marshal.PtrToStructure<MSLLHOOKSTRUCT>(lParam);

            // Unhook immediately
            if (mouseHookID != IntPtr.Zero)
            {
                UnhookWindowsHookEx(mouseHookID);
                mouseHookID = IntPtr.Zero;
            }

            // Set the picked location (these are absolute screen coordinates across all monitors)
            InvokeAsync(() =>
            {
                fixedX = hookStruct.pt.X;
                fixedY = hookStruct.pt.Y;
                pickingLocation = false;
                StateHasChanged();
            });

            // Don't pass the click through
            return (IntPtr)1;
        }

        return CallNextHookEx(mouseHookID, nCode, wParam, lParam);
    }

    [JSInvokable]
    public void SetPickedLocation(int x, int y)
    {
        // Only update if not cancelled (ESC pressed returns -1, -1)
        if (x >= 0 && y >= 0)
        {
            if (positionMode == PositionMode.Multi)
            {
                multiPositions.Add(new POINT { X = x, Y = y });
            }
            else
            {
                fixedX = x;
                fixedY = y;
            }
        }

        // Unhook if still active
        if (mouseHookID != IntPtr.Zero)
        {
            UnhookWindowsHookEx(mouseHookID);
            mouseHookID = IntPtr.Zero;
        }

        pickingLocation = false;
        InvokeAsync(StateHasChanged);
    }

    private void ResetStats()
    {
        // Stop clicking if running
        if (isRunning)
        {
            StopClicking();
        }

        // Reset all stats
        clickCount = 0;
        nextClickTime = null;

        // Reset cooldown to allow immediate restart
        lastHotkeyPress = DateTime.MinValue;

        StateHasChanged();
    }

    // Multi-position methods
    private async Task StartPickMultiLocation()
    {
        pickingLocation = true;
        StateHasChanged();
        _dotNetRef?.Dispose();
        _dotNetRef = DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("startLocationPicker", _dotNetRef);
    }

    private void RemovePosition(int index)
    {
        if (index >= 0 && index < multiPositions.Count)
        {
            multiPositions.RemoveAt(index);
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        StopClicking();
        mouseTrackingTimer?.Stop();
        mouseTrackingTimer?.Dispose();

        // Cancel and dispose the hotkey monitoring task
        _hotkeyMonitorCts?.Cancel();
        _hotkeyMonitorCts?.Dispose();

        // Dispose JS interop reference
        _dotNetRef?.Dispose();

        // Release the click gate
        try { _clickGate.Dispose(); } catch { }

        // Dispose the per-session cancellation token.
        try { _clickCts?.Dispose(); } catch { }
        _clickCts = null;

        // Restore default Windows timer resolution if we raised it
        if (_timerResolutionRaised)
        {
            try { TimeEndPeriod(1); } catch { }
            _timerResolutionRaised = false;
        }

        // Cleanup mouse hook if active
        if (mouseHookID != IntPtr.Zero)
        {
            UnhookWindowsHookEx(mouseHookID);
            mouseHookID = IntPtr.Zero;
        }
    }

    // Helper methods for boolean attributes
    private bool IsStartButtonDisabled() => !IsValidInterval();
    private bool IsPickingLocation() => pickingLocation;
}
