@page "/autoclicker"
@using System.Runtime.InteropServices
@using System.Timers
@using System.Drawing
@using System.Diagnostics
@using System.Threading
@using Microsoft.Extensions.Logging
@using Microsoft.Maui.Storage
@using RazorReaper.Services
@using RazorReaper.Components.Shared
@inject IJSRuntime JSRuntime
@inject IActivityService ActivityService
@inject ILogger<Autoclicker> Logger
@implements IDisposable

<header class="page-header autoclicker-page-header">
    <h1 class="page-title">Auto Clicker</h1>
    <p class="page-subtitle">Advanced mouse automation tool</p>
</header>

@* Mirrors the INI Changer 3-column workspace: viewport-height grid,
   each card is `content-card ini-widget` with `ini-widget-header` (h3 + pill). *@
<div class="autoclicker-layout ini-layout crosshair-layout">

    @* ── LEFT: TIMING ──────────────────────────────────────────────────── *@
    <div class="content-card ini-widget ac-widget @(isRunning ? "is-running" : "")">
        <div class="ini-widget-header">
            <h3>
                <svg class="ac-widget-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="10" cy="11" r="6.5" />
                    <path d="M10 8v3.2l2 1.2" />
                    <path d="M8 3h4" />
                </svg>
                Timing
            </h3>
            <span class="ini-widget-pill @(isRunning ? "live" : "muted")">
                <span class="ini-launcher-stat-dot @(isRunning ? "live" : "muted")"></span>
                @(isRunning ? "Running" : "Idle")
            </span>
        </div>

        <div class="ini-widget-body">
            <div class="interval-row">
                <div class="interval-cell">
                    <input type="number" class="interval-input" min="0" max="99" @bind="hours" />
                    <span class="interval-tag">h</span>
                </div>
                <div class="interval-cell">
                    <input type="number" class="interval-input" min="0" max="59" @bind="minutes" />
                    <span class="interval-tag">m</span>
                </div>
                <div class="interval-cell">
                    <input type="number" class="interval-input" min="0" max="59" @bind="seconds" />
                    <span class="interval-tag">s</span>
                </div>
                <div class="interval-cell">
                    <input type="number" class="interval-input" min="0" max="999" @bind="milliseconds" />
                    <span class="interval-tag">ms</span>
                </div>
            </div>
            <div class="interval-row">
                <div class="interval-cell wide">
                    <input type="number" class="interval-input" min="1" max="500" @bind="clickHoldMs" />
                    <span class="interval-tag">hold (ms)</span>
                </div>
                <div class="interval-cell wide">
                    <input type="number" class="interval-input" min="0" max="60" @bind="preStartDelaySeconds" />
                    <span class="interval-tag">pre-delay (s)</span>
                </div>
            </div>

            <div class="field">
                <label class="field-label">Repeat</label>
                <div class="seg-control">
                    <button class="seg-btn @(repeatMode == RepeatMode.Infinite ? "active" : "")"
                            @onclick="() => repeatMode = RepeatMode.Infinite">Until stopped</button>
                    <button class="seg-btn @(repeatMode == RepeatMode.Count ? "active" : "")"
                            @onclick="() => repeatMode = RepeatMode.Count">Fixed count</button>
                </div>
            </div>
            @if (repeatMode == RepeatMode.Count)
            {
                <div class="interval-row">
                    <div class="interval-cell wide">
                        <input type="number" class="interval-input" min="1" max="999999" @bind="repeatCount" />
                        <span class="interval-tag">clicks</span>
                    </div>
                </div>
                <div class="progress-bar"><div class="progress-fill" style="width: @(GetProgressPercentage())%"></div></div>
            }

            <div class="ac-cps-line">
                <span class="ac-cps-num">@GetEstimatedCps()</span>
                <span class="ac-cps-unit">cps</span>
                <span class="ac-cps-sep">·</span>
                <span class="ac-cps-sub">@GetIntervalDisplay()</span>
            </div>
        </div>

        <div class="ac-cta-row">
            <button class="ini-widget-cta @(isRunning ? "danger" : "")"
                    @onclick="ToggleClicking" disabled="@IsStartButtonDisabled()">
                <span class="ac-cta-label">@(isRunning ? "Stop" : "Start")</span>
                <kbd class="ac-cta-key">@hotkey</kbd>
            </button>
            <button class="rr-pill-btn ghost sm" @onclick="ResetStats">Reset</button>
        </div>
    </div>

    @* ── MIDDLE: CLICK ─────────────────────────────────────────────────── *@
    <div class="content-card ini-widget ac-widget">
        <div class="ini-widget-header">
            <h3>
                <svg class="ac-widget-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 3v3" />
                    <path d="M7 5h6" />
                    <path d="M10 8v8" />
                    <path d="M10 16c2.8 0 4.6-1.7 4.6-4.1 0-1.7-1-3-2.7-3.5" />
                    <path d="M10 16c-2.8 0-4.6-1.7-4.6-4.1 0-1.7 1-3 2.7-3.5" />
                </svg>
                Click
            </h3>
            <span class="ini-widget-pill">@mouseButton · @clickType</span>
        </div>

        <div class="ini-widget-body">
            <div class="field">
                <label class="field-label">Button</label>
                <div class="seg-control">
                    <button class="seg-btn @(mouseButton == MouseButton.Left ? "active" : "")"
                            @onclick="() => mouseButton = MouseButton.Left">Left</button>
                    <button class="seg-btn @(mouseButton == MouseButton.Middle ? "active" : "")"
                            @onclick="() => mouseButton = MouseButton.Middle">Middle</button>
                    <button class="seg-btn @(mouseButton == MouseButton.Right ? "active" : "")"
                            @onclick="() => mouseButton = MouseButton.Right">Right</button>
                </div>
            </div>
            <div class="field">
                <label class="field-label">Type</label>
                <div class="seg-control">
                    <button class="seg-btn @(clickType == ClickType.Single ? "active" : "")"
                            @onclick="() => clickType = ClickType.Single">Single</button>
                    <button class="seg-btn @(clickType == ClickType.Double ? "active" : "")"
                            @onclick="() => clickType = ClickType.Double">Double</button>
                </div>
            </div>
            <div class="field">
                <label class="field-label">Mode</label>
                <div class="seg-control">
                    <button class="seg-btn @(clickMode == ClickMode.Continuous ? "active" : "")"
                            @onclick="() => clickMode = ClickMode.Continuous">Continuous</button>
                    <button class="seg-btn @(clickMode == ClickMode.Burst ? "active" : "")"
                            @onclick="() => clickMode = ClickMode.Burst">Burst</button>
                </div>
            </div>
            @if (clickMode == ClickMode.Burst)
            {
                <div class="row-2">
                    <div class="field">
                        <label class="field-label">Clicks / burst</label>
                        <div class="interval-cell">
                            <input type="number" class="interval-input" min="1" max="1000" @bind="burstClickCount" />
                        </div>
                    </div>
                    <div class="field">
                        <label class="field-label">Pause</label>
                        <div class="interval-cell">
                            <input type="number" class="interval-input" min="0" max="300" @bind="burstPauseSeconds" />
                            <span class="interval-tag">s</span>
                        </div>
                    </div>
                </div>
            }
            <div class="ac-toggle-row">
                <Switch Value="@enableRandomization"
                        ValueChanged="@((bool v) => enableRandomization = v)"
                        Label="Randomize variance" />
            </div>
            @if (enableRandomization)
            {
                <div class="field">
                    <label class="field-label">Variance: <strong>±@randomVarianceMs ms</strong></label>
                    <input type="range" class="rr-slider" min="0" max="500" step="10" @bind="randomVarianceMs" />
                </div>
            }
        </div>
    </div>

    @* ── RIGHT: TARGET ─────────────────────────────────────────────────── *@
    <div class="content-card ini-widget ac-widget">
        <div class="ini-widget-header">
            <h3>
                <svg class="ac-widget-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="10" cy="10" r="6.2" />
                    <path d="M10 2v3" />
                    <path d="M10 15v3" />
                    <path d="M2 10h3" />
                    <path d="M15 10h3" />
                    <circle cx="10" cy="10" r="1.2" fill="currentColor" />
                </svg>
                Target
            </h3>
            <span class="ini-widget-pill">@positionMode</span>
        </div>

        <div class="ini-widget-body">
            <div class="field">
                <label class="field-label">Position</label>
                <div class="seg-control">
                    <button class="seg-btn @(positionMode == PositionMode.Current ? "active" : "")"
                            @onclick="() => positionMode = PositionMode.Current">Cursor</button>
                    <button class="seg-btn @(positionMode == PositionMode.Fixed ? "active" : "")"
                            @onclick="() => positionMode = PositionMode.Fixed">Fixed</button>
                    <button class="seg-btn @(positionMode == PositionMode.Multi ? "active" : "")"
                            @onclick="() => positionMode = PositionMode.Multi">Multi</button>
                </div>
            </div>
            @if (positionMode == PositionMode.Fixed)
            {
                <div class="row-2">
                    <div class="field">
                        <label class="field-label">X</label>
                        <div class="interval-cell">
                            <input type="number" class="interval-input" @bind="fixedX" />
                            <span class="interval-tag">px</span>
                        </div>
                    </div>
                    <div class="field">
                        <label class="field-label">Y</label>
                        <div class="interval-cell">
                            <input type="number" class="interval-input" @bind="fixedY" />
                            <span class="interval-tag">px</span>
                        </div>
                    </div>
                </div>
                <button class="rr-pill-btn ghost sm ac-pick @(pickingLocation ? "armed" : "")" @onclick="StartPickLocation" disabled="@IsPickingLocation()">
                    @(pickingLocation ? "Click anywhere…" : "Pick location")
                </button>
            }
            @if (positionMode == PositionMode.Multi)
            {
                <div class="positions-list">
                    @if (multiPositions.Count == 0)
                    {
                        <p class="muted-line">No positions yet.</p>
                    }
                    else
                    {
                        @foreach (var (pos, index) in multiPositions.Select((p, i) => (p, i)))
                        {
                            <div class="position-item">
                                <span class="position-number">@(index + 1)</span>
                                <span class="position-coords">@pos.X, @pos.Y</span>
                                <button class="rr-pill-btn ghost sm danger" @onclick="() => RemovePosition(index)">×</button>
                            </div>
                        }
                    }
                </div>
                <button class="rr-pill-btn ghost sm ac-pick @(pickingLocation ? "armed" : "")" @onclick="StartPickMultiLocation" disabled="@IsPickingLocation()">
                    @(pickingLocation ? "Click anywhere…" : "Add position")
                </button>
            }
            <p class="ac-cursor"><span class="ac-cursor-label">Cursor</span><span class="ac-cursor-val">@currentMouseX, @currentMouseY</span></p>

            <div class="field">
                <label class="field-label">Hotkey</label>
                <button class="hotkey-btn full-width @(recordingKey ? "recording" : "")"
                        @onclick="StartHotkeyRecording"
                        @onkeydown="CaptureHotkey"
                        @onkeydown:preventDefault="true"
                        tabindex="0">
                    @(recordingKey ? "Press a key…" : hotkey)
                </button>
            </div>
        </div>
    </div>

</div>

@code {
    public enum MouseButton { Left, Middle, Right }
    public enum ClickType { Single, Double }
    public enum RepeatMode { Infinite, Count }
    public enum PositionMode { Current, Fixed, Multi }
    public enum ClickMode { Continuous, Burst }

    // Short summary line shown under the status title.
    private string StatusSubLine => isRunning
        ? $"{GetIntervalDisplay()} · {mouseButton} · {clickType}{(repeatMode == RepeatMode.Count ? $" · {clickCount}/{repeatCount}" : $" · {clickCount} clicks")}"
        : $"Press {hotkey} to start · {GetIntervalDisplay()}";

    private int hours = 0;
    private int minutes = 0;
    private int seconds = 1;
    private int milliseconds = 0;

    // OP Auto Clicker-compatible defaults: 5ms hold, no pre-start delay.
    private int clickHoldMs = 5;
    private int preStartDelaySeconds = 0;

    // Tight loop concurrency / pacing
    private readonly SemaphoreSlim _clickGate = new(1, 1);
    private int _ticksSinceUiYield;
    private bool _timerResolutionRaised;
    // Per-session cancellation — cancelled in StopClicking to interrupt in-flight Task.Delays.
    private CancellationTokenSource? _clickCts;

    private MouseButton mouseButton = MouseButton.Left;
    private ClickType clickType = ClickType.Single;
    private RepeatMode repeatMode = RepeatMode.Infinite;
    private int repeatCount = 10;
    private PositionMode positionMode = PositionMode.Current;

    private int fixedX = 0;
    private int fixedY = 0;
    private int currentMouseX = 0;
    private int currentMouseY = 0;
    private bool pickingLocation = false;

    private bool enableRandomization = false;
    private int randomVarianceMs = 100;
    private Random random = new Random();

    // Multi-position
    private List<POINT> multiPositions = new List<POINT>();
    private int currentPositionIndex = 0;

    // Burst mode
    private ClickMode clickMode = ClickMode.Continuous;
    private int burstClickCount = 10;
    private int burstPauseSeconds = 2;
    private int currentBurstCount = 0;

    private bool isRunning = false;
    private int clickCount = 0;
    private System.Timers.Timer? clickTimer;
    private System.Timers.Timer? mouseTrackingTimer;
    private DateTime? nextClickTime;
    private ElapsedEventHandler? timerEventHandler;

    private string hotkey = "F6";
    private bool recordingKey = false;
    private int currentHotkeyCode = 0x75; // F6
    private DateTime lastHotkeyPress = DateTime.MinValue;
    private bool hotkeyEnabled = true;

    private const string HOTKEY_STORAGE_KEY = "AutoclickerHotkey";
    private const string HOTKEY_CODE_STORAGE_KEY = "AutoclickerHotkeyCode";
    // Short debounce — long enough to avoid a single tap registering twice from the
    // 50ms poll loop, but short enough that the user can hit Start then Stop rapidly.
    private const int HOTKEY_COOLDOWN_MS = 250;

    private CancellationTokenSource? _hotkeyMonitorCts;
    private bool _hasInitialized = false;

    [DllImport("user32.dll")]
    private static extern bool GetCursorPos(out POINT lpPoint);

    [DllImport("user32.dll")]
    private static extern bool SetCursorPos(int x, int y);

    [DllImport("user32.dll")]
    private static extern short GetAsyncKeyState(int vKey);

    [DllImport("user32.dll")]
    private static extern IntPtr GetForegroundWindow();

    [DllImport("user32.dll")]
    private static extern uint GetWindowThreadProcessId(IntPtr hWnd, out uint lpdwProcessId);

    [DllImport("kernel32.dll")]
    private static extern IntPtr GetConsoleWindow();

    [DllImport("user32.dll")]
    private static extern IntPtr SetWindowsHookEx(int idHook, LowLevelMouseProc lpfn, IntPtr hMod, uint dwThreadId);

    [DllImport("user32.dll")]
    [return: MarshalAs(UnmanagedType.Bool)]
    private static extern bool UnhookWindowsHookEx(IntPtr hhk);

    [DllImport("user32.dll")]
    private static extern IntPtr CallNextHookEx(IntPtr hhk, int nCode, IntPtr wParam, IntPtr lParam);

    [DllImport("kernel32.dll")]
    private static extern IntPtr GetModuleHandle(string lpModuleName);

    [DllImport("user32.dll", SetLastError = true)]
    private static extern uint SendInput(uint nInputs, INPUT[] pInputs, int cbSize);

    [DllImport("winmm.dll", EntryPoint = "timeBeginPeriod")]
    private static extern uint TimeBeginPeriod(uint uMilliseconds);

    [DllImport("winmm.dll", EntryPoint = "timeEndPeriod")]
    private static extern uint TimeEndPeriod(uint uMilliseconds);

    private delegate IntPtr LowLevelMouseProc(int nCode, IntPtr wParam, IntPtr lParam);

    private const int WH_MOUSE_LL = 14;
    private const int WM_LBUTTONDOWN = 0x0201;

    private IntPtr mouseHookID = IntPtr.Zero;
    private LowLevelMouseProc? mouseProc;

    [StructLayout(LayoutKind.Sequential)]
    public struct POINT
    {
        public int X;
        public int Y;
    }

    [StructLayout(LayoutKind.Sequential)]
    private struct MSLLHOOKSTRUCT
    {
        public POINT pt;
        public uint mouseData;
        public uint flags;
        public uint time;
        public IntPtr dwExtraInfo;
    }

    [StructLayout(LayoutKind.Sequential)]
    private struct INPUT
    {
        public uint type;
        public InputUnion u;
    }

    [StructLayout(LayoutKind.Explicit)]
    private struct InputUnion
    {
        [FieldOffset(0)]
        public MOUSEINPUT mi;
        [FieldOffset(0)]
        public KEYBDINPUT ki;
        [FieldOffset(0)]
        public HARDWAREINPUT hi;
    }

    [StructLayout(LayoutKind.Sequential)]
    private struct MOUSEINPUT
    {
        public int dx;
        public int dy;
        public uint mouseData;
        public uint dwFlags;
        public uint time;
        public IntPtr dwExtraInfo;
    }

    [StructLayout(LayoutKind.Sequential)]
    private struct KEYBDINPUT
    {
        public ushort wVk;
        public ushort wScan;
        public uint dwFlags;
        public uint time;
        public IntPtr dwExtraInfo;
    }

    [StructLayout(LayoutKind.Sequential)]
    private struct HARDWAREINPUT
    {
        public uint uMsg;
        public ushort wParamL;
        public ushort wParamH;
    }

    private const uint INPUT_MOUSE = 0;
    private const uint MOUSEEVENTF_LEFTDOWN = 0x0002;
    private const uint MOUSEEVENTF_LEFTUP = 0x0004;
    private const uint MOUSEEVENTF_RIGHTDOWN = 0x0008;
    private const uint MOUSEEVENTF_RIGHTUP = 0x0010;
    private const uint MOUSEEVENTF_MIDDLEDOWN = 0x0020;
    private const uint MOUSEEVENTF_MIDDLEUP = 0x0040;
    private const uint MOUSEEVENTF_ABSOLUTE = 0x8000;
    private const uint MOUSEEVENTF_MOVE = 0x0001;

    protected override Task OnInitializedAsync()
    {
        // Defer heavy setup until after the first render.
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hasInitialized)
            return;

        _hasInitialized = true;
        await InitializeAsync();
    }

    private async Task InitializeAsync()
    {
        // NOTE: timeBeginPeriod(1) is now raised in StartClicking and dropped in StopClicking.
        // Holding it page-wide affected the whole OS's timing — battery drain, other apps' timers
        // running hotter. Scope it to the actual clicking session.

        // Load persisted preferences (interval, hold, pre-delay, etc.)
        LoadSettings();

        // Load saved hotkey from localStorage
        await LoadSavedHotkey();

        mouseTrackingTimer = new System.Timers.Timer(100);
        mouseTrackingTimer.Elapsed += UpdateMousePosition;
        mouseTrackingTimer.Start();

        _hotkeyMonitorCts = new CancellationTokenSource();
        _ = Task.Run(() => MonitorHotkey(_hotkeyMonitorCts.Token));

        await InvokeAsync(StateHasChanged);
    }

    private void LoadSettings()
    {
        try
        {
            hours = Preferences.Get("ac.hours", hours);
            minutes = Preferences.Get("ac.minutes", minutes);
            seconds = Preferences.Get("ac.seconds", seconds);
            milliseconds = Preferences.Get("ac.ms", milliseconds);
            clickHoldMs = Preferences.Get("ac.holdms", clickHoldMs);
            preStartDelaySeconds = Preferences.Get("ac.predelay", preStartDelaySeconds);
            repeatCount = Preferences.Get("ac.repeatcount", repeatCount);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Autoclicker LoadSettings failed");
        }
    }

    private void SaveSettings()
    {
        try
        {
            Preferences.Set("ac.hours", hours);
            Preferences.Set("ac.minutes", minutes);
            Preferences.Set("ac.seconds", seconds);
            Preferences.Set("ac.ms", milliseconds);
            Preferences.Set("ac.holdms", clickHoldMs);
            Preferences.Set("ac.predelay", preStartDelaySeconds);
            Preferences.Set("ac.repeatcount", repeatCount);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Autoclicker SaveSettings failed");
        }
    }

    private async Task LoadSavedHotkey()
    {
        try
        {
            var savedHotkey = await JSRuntime.InvokeAsync<string>("localStorage.getItem", HOTKEY_STORAGE_KEY);
            var savedCode = await JSRuntime.InvokeAsync<string>("localStorage.getItem", HOTKEY_CODE_STORAGE_KEY);

            if (!string.IsNullOrEmpty(savedHotkey) && !string.IsNullOrEmpty(savedCode) && int.TryParse(savedCode, out int code))
            {
                hotkey = savedHotkey;
                currentHotkeyCode = code;
            }
        }
        catch
        {
            // If loading fails, keep defaults
            hotkey = "F6";
            currentHotkeyCode = 0x75;
        }
    }

    private async Task SaveHotkey()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", HOTKEY_STORAGE_KEY, hotkey);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", HOTKEY_CODE_STORAGE_KEY, currentHotkeyCode.ToString());
        }
        catch
        {
            // Ignore save errors
        }
    }

    private void UpdateMousePosition(object? sender, ElapsedEventArgs e)
    {
        if (GetCursorPos(out POINT point))
        {
            currentMouseX = point.X;
            currentMouseY = point.Y;
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task MonitorHotkey(CancellationToken cancellationToken)
    {
        bool wasPressed = false;

        while (!cancellationToken.IsCancellationRequested)
        {
            try
            {
                // Don't check hotkey while recording or if disabled
                if (recordingKey || !hotkeyEnabled)
                {
                    wasPressed = false;
                    await Task.Delay(100, cancellationToken);
                    continue;
                }

                bool isPressed = (GetAsyncKeyState(currentHotkeyCode) & 0x8000) != 0;

                // Check cooldown - only trigger if 2 seconds have passed
                var timeSinceLastPress = DateTime.Now - lastHotkeyPress;

                if (isPressed && !wasPressed && timeSinceLastPress.TotalMilliseconds >= HOTKEY_COOLDOWN_MS)
                {
                    lastHotkeyPress = DateTime.Now;
                    await InvokeAsync(() => ToggleClicking());
                }

                wasPressed = isPressed;
                await Task.Delay(50, cancellationToken);
            }
            catch (OperationCanceledException)
            {
                // Task was cancelled, exit gracefully
                break;
            }
            catch
            {
                await Task.Delay(100, cancellationToken);
            }
        }
    }

    private void StartHotkeyRecording()
    {
        recordingKey = true;
        hotkeyEnabled = false; // Disable hotkey monitoring while recording
        StateHasChanged();
    }

    private async Task CaptureHotkey(KeyboardEventArgs e)
    {
        if (recordingKey)
        {
            recordingKey = false;

            // Use Code property for more reliable F-key detection
            var keyName = string.IsNullOrEmpty(e.Code) ? e.Key.ToUpper() : e.Code.ToUpper();

            // Handle special key names from browser Code property
            if (keyName.StartsWith("F") && int.TryParse(keyName.Substring(1), out int fnum) && fnum >= 1 && fnum <= 24)
            {
                keyName = $"F{fnum}";
            }
            else if (keyName.StartsWith("KEY"))
            {
                // Handle "KeyA", "KeyB" format from Code property
                keyName = keyName.Substring(3);
            }
            else if (keyName.StartsWith("DIGIT"))
            {
                // Handle "Digit0", "Digit1" format from Code property
                keyName = keyName.Substring(5);
            }
            else if (keyName == " ")
            {
                keyName = "SPACE";
            }
            else if (keyName.Length > 1)
            {
                // Handle other special keys
                keyName = keyName switch
                {
                    "ARROWUP" => "UP",
                    "ARROWDOWN" => "DOWN",
                    "ARROWLEFT" => "LEFT",
                    "ARROWRIGHT" => "RIGHT",
                    _ => keyName
                };
            }

            var keyCode = GetKeyCode(keyName);

            if (keyCode != 0)
            {
                hotkey = keyName;
                currentHotkeyCode = keyCode;
            }
            else
            {
                hotkey = "F6";
                currentHotkeyCode = 0x75;
            }

            // Save the hotkey to localStorage
            await SaveHotkey();

            // Set lastHotkeyPress to NOW to enforce cooldown period
            lastHotkeyPress = DateTime.Now;

            // Brief gate so the keypress that just bound the hotkey doesn't immediately trigger it.
            await Task.Delay(200);
            hotkeyEnabled = true;

            StateHasChanged();
        }
    }

    private int GetKeyCode(string keyName)
    {
        return keyName switch
        {
            // F Keys
            "F1" => 0x70,
            "F2" => 0x71,
            "F3" => 0x72,
            "F4" => 0x73,
            "F5" => 0x74,
