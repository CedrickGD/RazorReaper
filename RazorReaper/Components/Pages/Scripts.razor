    /// <summary>The line under "Last read": what was seen, and what the script made of it.</summary>
    private string FlakReadingHint(FlakScript f)
    {
        if (!f.IsRunning) return Localizer.T("scripts.flak.hint.notrunning");

        // Empty LastReading means no scan has happened yet — the loop only ticks while ARK
        // is the foreground window, which it never is while you sit on this page. Blaming
        // the calibration here sent people off recalibrating a region that was never read.
        if (string.IsNullOrEmpty(f.LastReading)) return Localizer.T("scripts.flak.hint.waiting");
        if (f.Lowest is not { } low) return Localizer.T("scripts.flak.hint.nonumber");

        // Absolute time, not "Ns ago": the counter only re-renders on a tick, and ticks
        // stop the moment you alt-tab here — a frozen live counter is a lie.
        // The separating space is in the join, not in the dictionary — a value whose leading
        // space is load bearing is a value the next person trims.
        var swapped = f.LastSwapUtc is { } t
            ? " " + Localizer.T("scripts.flak.hint.lastswap", t.ToLocalTime().ToString("HH:mm:ss"))
            : "";

        return Localizer.T(
            low <= f.DurabilityThreshold ? "scripts.flak.hint.swapping" : "scripts.flak.hint.nothing",
            low, f.DurabilityThreshold, swapped);
    }

