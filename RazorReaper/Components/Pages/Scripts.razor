    // A property, not a static field: a list built once keeps the language it was built in.
    private IReadOnlyList<Dropdown.Option> AntidoteModeOptions => new List<Dropdown.Option>
    {
        new(nameof(AutoAntidoteTriggerMode.IconAppears), Localizer.T("scripts.antidote.mode.appears")),
        new(nameof(AutoAntidoteTriggerMode.IconDisappears), Localizer.T("scripts.antidote.mode.disappears")),
        new(nameof(AutoAntidoteTriggerMode.TimerBelow), Localizer.T("scripts.antidote.mode.timer")),
