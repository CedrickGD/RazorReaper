@page "/scripts"
@using RazorReaper.Services
@using RazorReaper.Services.Automation
@using RazorReaper.Services.Automation.Scripts
@inject IEnumerable<AutomationScriptBase> AllScripts
@inject IAppRunMode AppRunMode
@implements IDisposable

@* The page claims the window height and scrolls inside its own panes, so nothing here
   has to be shrunk to fit and .main-content never grows past the bottom edge. *@
<div class="scripts-page">
<header class="page-header">
    <h1 class="page-title">Scripts</h1>
    <p class="page-subtitle">Premade automation that runs natively — no AutoHotkey or other external tools. External input only.</p>
</header>

<div class="scripts-layout">
    @* One column, not two. Paired up, the names had to be ellipsised and the card was a
       short block with a dead half-page under it; a single 16-row column is the height
       of the content area, so the page reads as two full-height panes. *@
    <aside class="scripts-list rr-scroll">
        <div class="scripts-list-head">
            <span>All scripts</span>
            <span class="scripts-list-count">@_scripts.Count(s => s.IsRunning) running</span>
        </div>
        @if (AppRunMode.IsLocalPreview)
        {
            @foreach (var name in PreviewScriptNames)
            {
                <button class="script-item @(name == PreviewSelectedScript ? "active" : "")"
                        @onclick="() => PreviewSelectedScript = name">
                    <span class="script-dot"></span>
                    <span class="script-item-name">@name</span>
                </button>
            }
        }
        else
        {
            @foreach (var script in _scripts)
            {
                <button class="script-item @(script == _selected ? "active" : "")" @onclick="() => _selected = script">
                    <span class="script-dot @(script.IsRunning ? "on" : "")"></span>
                    <span class="script-item-name">@script.DisplayName</span>
                </button>
            }
        }
    </aside>

    <section class="scripts-detail">
        @if (AppRunMode.IsLocalPreview)
        {
            <div class="scripts-detail-body">
                <div class="script-hero">
                    <StatusHeader State="off"
                                  Label="@PreviewSelectedScript"
                                  Description="@PreviewDescription">
                        <Actions>
                            <span class="usage-chip">Stopped · preview only</span>
                        </Actions>
                    </StatusHeader>
                </div>
                <div class="script-panels">
                    <div class="content-card script-settings">
                        <h3>Safe preview</h3>
                        <SettingRow Title="Run state" Description="Marketing preview never registers hotkeys or sends input.">
                            <span class="setting-value">Stopped</span>
                        </SettingRow>
                        <SettingRow Title="Start / Stop hotkey" Description="Configure a system-wide toggle in a normal app session.">
                            <span class="setting-value">Not assigned</span>
                        </SettingRow>
                    </div>
                </div>
            </div>
        }
        else if (_selected is not null)
        {
            @* @key on the selected script remounts the pane, which restarts the entry
               animation — otherwise picking a different script hard-cuts the whole
               detail. Same trick the sidebar panel uses.

               One key on one wrapper, not one per child: Blazor rejects two siblings
               carrying the same key, and when it does the whole subtree silently stops
               re-rendering — clicking a script did nothing at all. *@
            <div class="scripts-detail-body" @key="_selected">
            @* No .content-card here: StatusHeader already draws its own inset panel, so
               a card around it was a border inside a border and 28px of dead padding. *@
            <div class="script-hero">
                <StatusHeader State="@(_selected.IsRunning ? "online" : "off")"
                              Label="@_selected.DisplayName"
                              Description="@Describe(_selected)">
                    <Actions>
                        @if (!_selected.UsesVision)
                        {
                            <UsageChip Feature="@UsageFeatures.InputScripts" />
                        }
                        @if (_selected.IsRunning)
                        {
                            <button class="btn btn-danger" @onclick="() => _selected.Stop()">Stop</button>
                        }
                        else
                        {
                            <button class="btn btn-primary" @onclick="() => _selected.Start()">Start</button>
                        }
                    </Actions>
                </StatusHeader>
            </div>

            <div class="script-panels">
            <div class="content-card script-settings">
                <h3>Settings</h3>

                @if (_selected is YutyScript yuty)
                {
                    <SettingRow Title="Roar key" Description="Key pressed each interval. ARK exposes no binding for the Yuty roar, so set this one yourself.">
                        <input class="script-input" value="@yuty.RoarKey" @onchange="SetYutyKey" />
                    </SettingRow>
                    <SettingRow Title="Interval" Description="Milliseconds between roars.">
                        <input class="script-input" type="number" min="200" max="60000" value="@yuty.IntervalMs" @onchange="SetYutyInterval" />
                    </SettingRow>
                }
                else if (_selected is AutoWalkScript walk)
                {
                    <SettingRow Title="Movement" Description="Walk at normal speed, or hold sprint the whole time.">
                        <Dropdown Value="@(walk.Sprint ? "Sprint" : "Walk")" ValueChanged="SetWalkMode" Options="WalkModeOptions" />
                    </SettingRow>
                    <SettingRow Title="Forward key" Description="Held to move forward — prefilled from your ARK 'Move forward' binding.">
                        <input class="script-input" value="@walk.ForwardKey" @onchange="SetWalkKey" />
                    </SettingRow>
                    @if (walk.Sprint)
                    {
                        <SettingRow Title="Sprint key" Description="Held alongside forward — prefilled from your ARK 'Run' binding.">
                            <input class="script-input" value="@walk.SprintKey" @onchange="SetWalkSprintKey" />
                        </SettingRow>
                    }
                }
                else if (_selected is MammothScript mammoth)
                {
                    <SettingRow Title="Interval" Description="Milliseconds between drum cycles (left + right click).">
                        <input class="script-input" type="number" min="100" max="10000" value="@mammoth.IntervalMs" @onchange="SetMammothInterval" />
                    </SettingRow>
                }
                else if (_selected is AutoDownloadScript download)
                {
                    <SettingRow Title="Chat command" Description="Sent each cycle (opens chat, types, sends).">
                        <input class="script-input" value="@download.Command" @onchange="SetDownloadCommand" />
                    </SettingRow>
                    <SettingRow Title="Delay" Description="Milliseconds between sends.">
                        <input class="script-input" type="number" min="500" max="120000" value="@download.DelayMs" @onchange="SetDownloadDelay" />
                    </SettingRow>
                }
                else if (_selected is FastTpScript fasttp)
                {
                    <SettingRow Title="Destination" Description="Name typed into the teleport search field.">
                        <input class="script-input" value="@fasttp.Destination" @onchange="SetTpDestination" />
                    </SettingRow>
                    <SettingRow Title="Confirm with Enter" Description="Press Enter after typing to pick the first match.">
                        <Switch Value="fasttp.ConfirmWithEnter" ValueChanged="SetTpConfirm" />
                    </SettingRow>
                }
                else if (_selected is TakeAllScript takeall)
                {
                    <SettingRow Title="Click interval" Description="Milliseconds between scan + click attempts.">
                        <input class="script-input" type="number" min="20" max="2000" value="@takeall.ClickIntervalMs" @onchange="SetTakeAllInterval" />
                    </SettingRow>
                    <SettingRow Title="Match threshold" Description="Similarity % at which the button counts as visible.">
                        <input class="script-input" type="number" min="50" max="100" value="@takeall.MatchThresholdPercent" @onchange="SetTakeAllThreshold" />
                    </SettingRow>
                }
                else if (_selected is TekSaddleScript tek)
                {
                    <SettingRow Title="Match threshold" Description="Similarity % at which the buff counts as active.">
                        <input class="script-input" type="number" min="50" max="100" value="@tek.MatchThresholdPercent" @onchange="SetTekThreshold" />
                    </SettingRow>
                    <SettingRow Title="Click delay" Description="Milliseconds between spammed clicks (20 ≈ 50/s).">
                        <input class="script-input" type="number" min="5" max="500" value="@tek.ClickDelayMs" @onchange="SetTekDelay" />
                    </SettingRow>
                }
                else if (_selected is NoglinScript noglin)
                {
                    <SettingRow Title="Match threshold" Description="Similarity % at which the mind-control icon counts as visible.">
                        <input class="script-input" type="number" min="50" max="100" value="@noglin.MatchThresholdPercent" @onchange="SetNoglinThreshold" />
                    </SettingRow>
                    <SettingRow Title="Scan interval" Description="Milliseconds between scans.">
                        <input class="script-input" type="number" min="100" max="5000" value="@noglin.ScanIntervalMs" @onchange="SetNoglinScan" />
                    </SettingRow>
                    <SettingRow Title="Restore after" Description="Clean scans before FPS is restored.">
                        <input class="script-input" type="number" min="1" max="20" value="@noglin.RestoreAfterCleanScans" @onchange="SetNoglinCleanScans" />
                    </SettingRow>
                }
                else if (_selected is InvSizeScript invsize)
                {
                    <SettingRow Title="Pulse interval" Description="Milliseconds between Shift+right-click pulses.">
                        <input class="script-input" type="number" min="20" max="2000" value="@invsize.IntervalMs" @onchange="SetInvSizeInterval" />
                    </SettingRow>
                }
                else if (_selected is AntiAfkScript antiafk)
                {
                    <SettingRow Title="Inventory key" Description="Toggles your inventory — prefilled from your ARK 'Show my inventory' binding.">
                        <input class="script-input" value="@antiafk.InventoryKey" @onchange="SetAntiAfkKey" />
                    </SettingRow>
                    <SettingRow Title="Interval (seconds)" Description="Seconds between pulses.">
                        <input class="script-input" type="number" min="30" max="3600" value="@antiafk.IntervalSeconds" @onchange="SetAntiAfkInterval" />
                    </SettingRow>
                }
                else if (_selected is ExoSuitScript exo)
                {
                    <SettingRow Title="Access key" Description="Opens the container — prefilled from your ARK 'Access inventory' binding.">
                        <input class="script-input" value="@exo.AccessKey" @onchange="SetExoAccess" />
                    </SettingRow>
                    <SettingRow Title="Search filter" Description="Typed into the inventory search (default: exo).">
                        <input class="script-input" value="@exo.SearchTerm" @onchange="SetExoSearch" />
                    </SettingRow>
                    <SettingRow Title="Transfer key" Description="Moves the filtered items — prefilled from your ARK 'Transfer item' binding.">
                        <input class="script-input" value="@exo.TransferKey" @onchange="SetExoTransfer" />
                    </SettingRow>
                    <SettingRow Title="Transfer presses" Description="Presses per cycle.">
                        <input class="script-input" type="number" min="1" max="50" value="@exo.TransferPresses" @onchange="SetExoPresses" />
                    </SettingRow>
                    <SettingRow Title="Per-press delay" Description="Milliseconds between presses.">
                        <input class="script-input" type="number" min="10" max="2000" value="@exo.PerPressDelayMs" @onchange="SetExoPerPress" />
                    </SettingRow>
                    <SettingRow Title="Repeat delay" Description="Milliseconds between cycles.">
                        <input class="script-input" type="number" min="100" max="20000" value="@exo.RepeatDelayMs" @onchange="SetExoRepeat" />
                    </SettingRow>
                }
                else if (_selected is TurretManagerScript turret)
                {
                    <SettingRow Title="Match threshold" Description="Similarity % at which the turret inventory counts as open.">
                        <input class="script-input" type="number" min="50" max="100" value="@turret.MatchThresholdPercent" @onchange="SetTurretThreshold" />
                    </SettingRow>
                    <SettingRow Title="Transfer key" Description="Pushes ammo into the turret — prefilled from your ARK 'Transfer item' binding.">
                        <input class="script-input" value="@turret.TransferKey" @onchange="SetTurretKey" />
                    </SettingRow>
                    <SettingRow Title="Transfer presses" Description="Presses per detection.">
                        <input class="script-input" type="number" min="1" max="20" value="@turret.TransferPresses" @onchange="SetTurretPresses" />
                    </SettingRow>
                    <SettingRow Title="Scan interval" Description="Milliseconds between scans.">
                        <input class="script-input" type="number" min="100" max="5000" value="@turret.ScanIntervalMs" @onchange="SetTurretScan" />
                    </SettingRow>
                }
                else if (_selected is FlakScript flak)
                {
                    <SettingRow Title="Swap below" Description="Durability points left on a piece before it is replaced. An absolute number, so it means the same on any server multiplier.">
                        <input class="script-input" type="number" min="1" max="100000" value="@flak.DurabilityThreshold" @onchange="SetFlakThreshold" />
                    </SettingRow>

                    @* One key per row, because the helmet row has to pull the spare helmet. Rows
                       are top-to-bottom exactly as ARK draws them next to your character. *@
                    @for (var i = 0; i < FlakScript.MaxRows; i++)
                    {
                        var row = i;
                        var rowKey = flak.RowKeys[row];
                        <SettingRow Title="@($"Row {row + 1} hotbar key")"
                                    Description="@RowKeyHint(row, rowKey)">
                            <input class="script-input" value="@rowKey" @onchange="@(e => SetFlakRowKey(row, e))" />
                        </SettingRow>
                    }

                    <SettingRow Title="Scan interval" Description="Milliseconds between reads.">
                        <input class="script-input" type="number" min="500" max="10000" value="@flak.ScanIntervalMs" @onchange="SetFlakScan" />
                    </SettingRow>

                    @* The whole thing hangs on whether the numbers are read correctly, so the page
                       shows what it just read. Without this there is no way to tell a bad region
                       from a bad threshold from OCR that cannot see the digits at all. *@
                    <SettingRow Title="Last read" Description="@FlakReadingHint(flak)">
                        <span class="script-reading">@(string.IsNullOrEmpty(flak.LastReading) ? "—" : flak.LastReading)</span>
                    </SettingRow>
                }
                else if (_selected is DinoReadyScript dino)
                {
                    <SettingRow Title="Presses" Description="How many times to click the calibrated + button.">
                        <input class="script-input" type="number" min="1" max="200" value="@dino.Presses" @onchange="SetDinoPresses" />
                    </SettingRow>
                    <SettingRow Title="Click delay" Description="Milliseconds between clicks.">
                        <input class="script-input" type="number" min="20" max="1000" value="@dino.ClickDelayMs" @onchange="SetDinoDelay" />
                    </SettingRow>
                }
                else if (_selected is CraftingScript crafting)
                {
                    <SettingRow Title="Mode" Description="Watcher = you walk and open stations; Walk = the script walks the row.">
                        <Dropdown Value="@crafting.Mode.ToString()" ValueChanged="SetCraftMode" Options="CraftModeOptions" />
                    </SettingRow>
                    <SettingRow Title="Craft key" Description="Starts a craft in the open station — prefilled from your ARK 'Use' binding.">
                        <input class="script-input" value="@crafting.CraftKey" @onchange="SetCraftKey" />
                    </SettingRow>
                    <SettingRow Title="Access key" Description="Opens and closes the station — prefilled from your ARK 'Access inventory' binding.">
                        <input class="script-input" value="@crafting.AccessKey" @onchange="SetCraftAccess" />
                    </SettingRow>
                    <SettingRow Title="Craft presses" Description="Craft presses per station.">
                        <input class="script-input" type="number" min="1" max="20" value="@crafting.CraftPresses" @onchange="SetCraftPresses" />
                    </SettingRow>
                    <SettingRow Title="Ping compensation" Description="Extra ms added to every wait so lag can't desync the sequence.">
                        <input class="script-input" type="number" min="0" max="3000" value="@crafting.PingCompensationMs" @onchange="SetCraftPing" />
                    </SettingRow>
                    @if (crafting.Mode == CraftingMode.Watcher)
                    {
                        <SettingRow Title="Match threshold" Description="Similarity % at which the station inventory counts as open.">
                            <input class="script-input" type="number" min="50" max="100" value="@crafting.MatchThresholdPercent" @onchange="SetCraftThreshold" />
                        </SettingRow>
                        <SettingRow Title="Scan interval" Description="Milliseconds between scans.">
                            <input class="script-input" type="number" min="100" max="5000" value="@crafting.ScanIntervalMs" @onchange="SetCraftScan" />
                        </SettingRow>
                    }
                    else
                    {
                        <SettingRow Title="Forward key" Description="Held to walk between stations — prefilled from your ARK 'Move forward' binding.">
                            <input class="script-input" value="@crafting.ForwardKey" @onchange="SetCraftForward" />
                        </SettingRow>
                        <SettingRow Title="Walk time" Description="Milliseconds held forward between stations.">
                            <input class="script-input" type="number" min="100" max="10000" value="@crafting.WalkMs" @onchange="SetCraftWalkMs" />
                        </SettingRow>
                    }
                }

                @* Full width (see scripts-styles.css): squeezed into half, the combo and its
                   link wrapped onto a second line and dragged the whole grid row taller. *@
                <SettingRow Class="script-hotkey-row" Title="Start / Stop hotkey" Description="System-wide toggle — works even while ARK is focused.">
                    <HotkeyLink Value="@_selected.StartStopHotkey" />
                </SettingRow>
            </div>

            @if (_selected is ICalibratableScript cal)
            {
                <div class="content-card scripts-calibration">
                    <h3>Calibration</h3>
                    <SettingRow Title="@cal.RegionTitle" Description='@(cal.HasRegion ? cal.RegionSummary : "Not set for this resolution.")'>
                        <button class="btn btn-secondary" @onclick="CalibrateRegion" disabled="@_calibrating">Calibrate region</button>
                    </SettingRow>
                    @* OCR scripts read the region as text; offering them the snapshot/mask
                       workflow sent people off capturing references that changed nothing. *@
                    @if (cal.UsesReference)
                    {
                        <SettingRow Title="Reference snapshot" Description='@(cal.HasReference ? "Captured." : "Capture with the target visible on screen.")'>
                            <button class="btn btn-secondary" @onclick="CaptureReferenceSnapshot" disabled="@(!cal.HasRegion || _calibrating)">Capture reference</button>
                        </SettingRow>
                        @* Anything drawn over the live game world needs this or it never matches twice:
                           the world behind it moves and the comparison is over the whole region. *@
                        <SettingRow Title="Ignore background"
                                    Description='@(cal.MaskSummary is { Length: > 0 } m ? m : "Turn the camera so the background changes, keep the target on screen, then press.")'>
                            <button class="btn btn-secondary" @onclick="RefineReferenceMask" disabled="@(!cal.HasReference || _calibrating)">Ignore background</button>
                        </SettingRow>
                    }
                    @if (!string.IsNullOrEmpty(_calStatus))
                    {
                        <div class="setting-row-desc" style="margin-top: 0.5rem;">@_calStatus</div>
                    }
                </div>
            }
            </div>
            </div>
        }
    </section>
</div>
</div>

@code {
    private static readonly string[] PreviewScriptNames =
        ["Yuty", "Auto Walk", "Mammoth", "Auto Download", "Fast TP", "Armor Swap"];
    private string PreviewSelectedScript { get; set; } = "Yuty";
    private string PreviewDescription => PreviewSelectedScript switch
    {
        "Yuty" => "Keeps the Yutyrannus courage roar on an interval while mounted.",
        "Auto Walk" => "Holds the forward key while ARK remains the active window.",
        "Mammoth" => "Alternates drum inputs on a controlled interval.",
        "Auto Download" => "Repeats a configured chat command on an interval.",
        "Fast TP" => "Types a configured destination into the open teleport menu.",
        "Armor Swap" => "Monitors durability values and swaps configured hotbar pieces.",
        _ => "Native automation with an explicit stopped state.",
    };

    private readonly List<AutomationScriptBase> _scripts = new();
    private AutomationScriptBase? _selected;

    protected override void OnInitialized()
    {
        _scripts.AddRange(AllScripts);
        _selected = _scripts.FirstOrDefault();
        foreach (var s in _scripts) s.Changed += OnScriptChanged;
    }

    private static string Describe(AutomationScriptBase script) => script switch
    {
        YutyScript => "Spams the Yutyrannus courage roar on an interval while mounted.",
        AutoWalkScript => "Holds the forward key so you keep running hands-free (released when ARK loses focus).",
        MammothScript => "Alternates left/right clicks to keep the Mammoth war drum going AFK.",
        AstroScript => "One-shot: fires the Astrocetus downward-teleport sequence when you press Start.",
        AutoDownloadScript => "Repeats a chat command (default /download) on an interval.",
        FastTpScript => "With the teleport menu open, types a destination and confirms (one-shot).",
        TakeAllScript => "Clicks the container Take-All button whenever it's visible (calibrated region).",
        TekSaddleScript => "While the Tek Saddle buff is up and you hold left-click, spams extra clicks.",
        NoglinScript => "Detects the Noglin mind-control icon and drops FPS to 1 until it clears.",
        InvSizeScript => "Experimental: Shift+right-click spam to inflate inventory (needs your blueprint hotkeys; lag/loss risk).",
        AntiAfkScript => "Opens/closes inventory on an interval to avoid the idle kick.",
        ExoSuitScript => "Exo-Mek farming: opens inventory, filters \"exo\", spams transfer, repeats.",
        TurretManagerScript => "When a turret inventory is open, presses transfer to refill its ammo.",
        FlakScript => "Reads the durability numbers next to your armor and swaps in a fresh piece from the hotbar — flak, riot or tek, without opening anything.",
        DinoReadyScript => "Single-stat leveler: clicks a calibrated stat + button N times (one-shot).",
        CraftingScript => "Crafts at Fabricator/Chem Bench/Replicator — Watcher or Walk mode, with ping compensation.",
        _ => ""
    };

    private void SetYutyKey(ChangeEventArgs e)
    {
        if (_selected is YutyScript y)
        {
            y.RoarKey = e.Value?.ToString() ?? "C";
            y.SaveSettings();
        }
    }

    private void SetYutyInterval(ChangeEventArgs e)
    {
        if (_selected is YutyScript y && int.TryParse(e.Value?.ToString(), out var v))
        {
            y.IntervalMs = v;
            y.SaveSettings();
        }
    }

    private void SetWalkMode(string value)
    {
        if (_selected is AutoWalkScript w)
        {
            w.Sprint = string.Equals(value, "Sprint", StringComparison.OrdinalIgnoreCase);
            w.SaveSettings();
        }
    }

    private void SetWalkSprintKey(ChangeEventArgs e)
    {
        if (_selected is AutoWalkScript w)
        {
            w.SprintKey = e.Value?.ToString() ?? "LeftShift";
            w.SaveSettings();
        }
    }

    private void SetWalkKey(ChangeEventArgs e)
    {
        if (_selected is AutoWalkScript w)
        {
            w.ForwardKey = e.Value?.ToString() ?? "W";
            w.SaveSettings();
        }
    }

    private void SetMammothInterval(ChangeEventArgs e)
    {
        if (_selected is MammothScript m && int.TryParse(e.Value?.ToString(), out var v))
        {
            m.IntervalMs = v;
            m.SaveSettings();
        }
    }

    private void SetDownloadCommand(ChangeEventArgs e)
    {
        if (_selected is AutoDownloadScript d)
        {
            d.Command = e.Value?.ToString() ?? "/download";
            d.SaveSettings();
        }
    }

    private void SetDownloadDelay(ChangeEventArgs e)
    {
        if (_selected is AutoDownloadScript d && int.TryParse(e.Value?.ToString(), out var v))
        {
            d.DelayMs = v;
            d.SaveSettings();
        }
    }

    private void SetTpDestination(ChangeEventArgs e)
    {
        if (_selected is FastTpScript f)
        {
            f.Destination = e.Value?.ToString() ?? "";
            f.SaveSettings();
        }
    }

    private void SetTpConfirm(bool value)
    {
        if (_selected is FastTpScript f)
        {
            f.ConfirmWithEnter = value;
            f.SaveSettings();
        }
    }

    private void SetTakeAllInterval(ChangeEventArgs e)
    {
        if (_selected is TakeAllScript t && int.TryParse(e.Value?.ToString(), out var v))
        {
            t.ClickIntervalMs = v;
            t.SaveSettings();
        }
    }

    private void SetTakeAllThreshold(ChangeEventArgs e)
    {
        if (_selected is TakeAllScript t && double.TryParse(e.Value?.ToString(), out var v))
        {
            t.MatchThresholdPercent = v;
            t.SaveSettings();
        }
    }

    private void SetTekThreshold(ChangeEventArgs e)
    {
        if (_selected is TekSaddleScript t && double.TryParse(e.Value?.ToString(), out var v))
        {
            t.MatchThresholdPercent = v;
            t.SaveSettings();
        }
    }

    private void SetTekDelay(ChangeEventArgs e)
    {
        if (_selected is TekSaddleScript t && int.TryParse(e.Value?.ToString(), out var v))
        {
            t.ClickDelayMs = v;
            t.SaveSettings();
        }
    }

    private void SetNoglinThreshold(ChangeEventArgs e)
    {
        if (_selected is NoglinScript n && double.TryParse(e.Value?.ToString(), out var v))
        {
            n.MatchThresholdPercent = v;
            n.SaveSettings();
        }
    }

    private void SetNoglinScan(ChangeEventArgs e)
    {
        if (_selected is NoglinScript n && int.TryParse(e.Value?.ToString(), out var v))
        {
            n.ScanIntervalMs = v;
            n.SaveSettings();
        }
    }

    private void SetNoglinCleanScans(ChangeEventArgs e)
    {
        if (_selected is NoglinScript n && int.TryParse(e.Value?.ToString(), out var v))
        {
            n.RestoreAfterCleanScans = v;
            n.SaveSettings();
        }
    }

    private void SetInvSizeInterval(ChangeEventArgs e)
    {
        if (_selected is InvSizeScript i && int.TryParse(e.Value?.ToString(), out var v))
        {
            i.IntervalMs = v;
            i.SaveSettings();
        }
    }

    private void SetAntiAfkKey(ChangeEventArgs e)
    {
        if (_selected is AntiAfkScript a)
        {
            a.InventoryKey = e.Value?.ToString() ?? "I";
            a.SaveSettings();
        }
    }

    private void SetAntiAfkInterval(ChangeEventArgs e)
    {
        if (_selected is AntiAfkScript a && int.TryParse(e.Value?.ToString(), out var v))
        {
            a.IntervalSeconds = v;
            a.SaveSettings();
        }
    }

    private void SetExoAccess(ChangeEventArgs e) { if (_selected is ExoSuitScript x) { x.AccessKey = e.Value?.ToString() ?? "I"; x.SaveSettings(); } }
    private void SetExoSearch(ChangeEventArgs e) { if (_selected is ExoSuitScript x) { x.SearchTerm = e.Value?.ToString() ?? "exo"; x.SaveSettings(); } }
    private void SetExoTransfer(ChangeEventArgs e) { if (_selected is ExoSuitScript x) { x.TransferKey = e.Value?.ToString() ?? "T"; x.SaveSettings(); } }
    private void SetExoPresses(ChangeEventArgs e) { if (_selected is ExoSuitScript x && int.TryParse(e.Value?.ToString(), out var v)) { x.TransferPresses = v; x.SaveSettings(); } }
