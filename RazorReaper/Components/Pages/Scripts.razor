@page "/scripts"
@using Microsoft.Extensions.Logging
@using RazorReaper.Services
@using RazorReaper.Services.Automation
@using RazorReaper.Services.Automation.Scripts
@inject IEnumerable<AutomationScriptBase> AllScripts
@inject IGameIniService GameIni
@inject IForegroundGate Foreground
@inject IArkKeyBindingService ArkKeys
@inject INotificationService Notifications
@inject ILogger<Scripts> Logger
@implements IDisposable
@using RazorReaper.Services.Localization
@inject ILocalizer Localizer

@* The page claims the window height and scrolls inside its own panes, so nothing here
   has to be shrunk to fit and .main-content never grows past the bottom edge. *@
<div class="scripts-page">
<header class="page-header">
    <h1 class="page-title">@Localizer.T("nav.page.scripts")</h1>
    <p class="page-subtitle">@Localizer.T("scripts.subtitle")</p>
</header>

<div class="scripts-layout">
    @* One column, not two. Paired up, the names had to be ellipsised and the card was a
       short block with a dead half-page under it; a single 16-row column is the height
       of the content area, so the page reads as two full-height panes. *@
    <aside class="scripts-list rr-scroll">
        <div class="scripts-list-head">
            <span>@Localizer.T("scripts.list.all")</span>
            <span class="scripts-list-count">@Localizer.T("scripts.list.running", _scripts.Count(s => s.IsRunning))</span>
        </div>
        @foreach (var script in _scripts)
        {
            <button class="script-item @(script == _selected ? "active" : "")" @onclick="() => _selected = script">
                <span class="script-dot @(script.IsRunning ? "on" : "")"></span>
                <span class="script-item-name">@script.DisplayName</span>
                @* The short form here, the sentence in the title and in the hero below: a
                   16-row list has no space for "No action yet — ARK is not in the
                   foreground", and the list's job is to show which of the running ones has
                   gone quiet. *@
                @if (script.IsRunning)
                {
                    <span class="script-item-effect" title="@EffectLine(script)">@EffectShort(script)</span>
                }
            </button>
        }
    </aside>

    <section class="scripts-detail">
        @if (_selected is not null)
        {
            @* @key on the selected script remounts the pane, which restarts the entry
               animation — otherwise picking a different script hard-cuts the whole
               detail. Same trick the sidebar panel uses.

               One key on one wrapper, not one per child: Blazor rejects two siblings
               carrying the same key, and when it does the whole subtree silently stops
               re-rendering — clicking a script did nothing at all. *@
            <div class="scripts-detail-body" @key="_selected">
            @* No .content-card here: StatusHeader already draws its own inset panel, so
               a card around it was a border inside a border and 28px of dead padding. *@
            <div class="script-hero">
                <StatusHeader State="@(_selected.IsRunning ? "online" : "off")"
                              Label="@_selected.DisplayName"
                              Description="@Describe(_selected)">
                    <Actions>
                        @* Every script here is gated on ARK being the window in front, and until
                           now the page never said so: a script the gate was holding shut looked
                           exactly like a script that was running and doing nothing. The pill sits
                           beside Start because that is the moment the answer is needed. *@
                        <span class="scripts-ark-pill @ArkPillClass" title="@Localizer.T("scripts.ark.tooltip")">
                            <span class="scripts-ark-dot"></span>
                            @ArkStatusText
                        </span>
                        @* Sixteen tiles presented alike, five of them unable to tell a landed
                           step from a wasted keypress. The chip sits beside Start because that
                           is the moment the difference is worth knowing. *@
                        @if (_selected.IsExperimental)
                        {
                            <span class="scripts-exp-chip" title="@Localizer.T("scripts.experimental.note")">@Localizer.T("scripts.experimental")</span>
                        }
                        @if (!_selected.UsesVision)
                        {
                            <UsageChip Feature="@UsageFeatures.InputScripts" />
                        }
                        @if (_selected.IsRunning)
                        {
                            <button class="btn btn-danger" @onclick="() => _selected.Stop()">@Localizer.T("scripts.stop")</button>
                        }
                        else
                        {
                            <button class="btn btn-primary" @onclick="() => _selected.Start()">@Localizer.T("scripts.start")</button>
                        }
                    </Actions>
                </StatusHeader>
                @* "Running" was never the question — "is it doing anything?" was. This is the
                   line that answers it, and it only exists while there is a run to describe. *@
                @if (_selected.IsRunning)
                {
                    <div class="script-effect-line">@EffectLine(_selected)</div>
                }
                @* The one line behind the chip. A tooltip would have been the cheap way out, and
                   a caveat nobody hovers is a caveat nobody reads. *@
                @if (_selected.IsExperimental)
                {
                    <div class="script-effect-line script-experimental-line">@Localizer.T("scripts.experimental.note")</div>
                }
                @* Where the key defaults in the card below came from. Quiet and always present:
                   a script pressing the wrong key because the scan never ran looks exactly like
                   a script that works, and this is the only place that says which it is. *@
                <div class="script-effect-line script-keys-line">
                    <span>@ArkKeySourceText</span>
                    <button class="btn btn-secondary btn-small" @onclick="RescanArkKeys">@Localizer.T("scripts.keys.rescan")</button>
                </div>
            </div>

            <div class="script-panels">
            <div class="content-card script-settings">
                <h3>@Localizer.T("scripts.settings")</h3>

                @if (_selected is YutyScript yuty)
                {
                    <SettingRow Title="@Localizer.T("scripts.yuty.roarkey")" Description="@Localizer.T("scripts.yuty.roarkey.desc")">
                        <input class="script-input" value="@yuty.RoarKey" @onchange="SetYutyKey" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.field.interval")" Description="@Localizer.T("scripts.yuty.interval.desc")">
                        <input class="script-input" type="number" min="200" max="60000" value="@yuty.IntervalMs" @onchange="SetYutyInterval" />
                    </SettingRow>
                }
                else if (_selected is AutoWalkScript walk)
                {
                    <SettingRow Title="@Localizer.T("scripts.walk.movement")" Description="@Localizer.T("scripts.walk.movement.desc")">
                        <Dropdown Value="@(walk.Sprint ? "Sprint" : "Walk")" ValueChanged="SetWalkMode" Options="WalkModeOptions" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.field.forwardkey")" Description="@Localizer.T("scripts.walk.forwardkey.desc")">
                        <input class="script-input" value="@walk.ForwardKey" @onchange="SetWalkKey" />
                    </SettingRow>
                    @if (walk.Sprint)
                    {
                        <SettingRow Title="@Localizer.T("scripts.walk.sprintkey")" Description="@Localizer.T("scripts.walk.sprintkey.desc")">
                            <input class="script-input" value="@walk.SprintKey" @onchange="SetWalkSprintKey" />
                        </SettingRow>
                    }
                }
                else if (_selected is MammothScript mammoth)
                {
                    <SettingRow Title="@Localizer.T("scripts.field.interval")" Description="@Localizer.T("scripts.mammoth.interval.desc")">
                        <input class="script-input" type="number" min="100" max="10000" value="@mammoth.IntervalMs" @onchange="SetMammothInterval" />
                    </SettingRow>
                }
                else if (_selected is AutoDownloadScript download)
                {
                    <SettingRow Title="@Localizer.T("scripts.download.command")" Description="@Localizer.T("scripts.download.command.desc")">
                        <input class="script-input" value="@download.Command" @onchange="SetDownloadCommand" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.download.delay")" Description="@Localizer.T("scripts.download.delay.desc")">
                        <input class="script-input" type="number" min="500" max="120000" value="@download.DelayMs" @onchange="SetDownloadDelay" />
                    </SettingRow>
                }
                else if (_selected is FastTpScript fasttp)
                {
                    <SettingRow Title="@Localizer.T("scripts.fasttp.destination")" Description="@Localizer.T("scripts.fasttp.destination.desc")">
                        <input class="script-input" value="@fasttp.Destination" @onchange="SetTpDestination" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.fasttp.confirm")" Description="@Localizer.T("scripts.fasttp.confirm.desc")">
                        <Switch Value="fasttp.ConfirmWithEnter" ValueChanged="SetTpConfirm" />
                    </SettingRow>
                }
                else if (_selected is TakeAllScript takeall)
                {
                    <SettingRow Title="@Localizer.T("scripts.takeall.clickinterval")" Description="@Localizer.T("scripts.takeall.clickinterval.desc")">
                        <input class="script-input" type="number" min="20" max="2000" value="@takeall.ClickIntervalMs" @onchange="SetTakeAllInterval" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.field.matchthreshold")" Description="@Localizer.T("scripts.takeall.threshold.desc")">
                        <input class="script-input" type="number" min="50" max="100" value="@takeall.MatchThresholdPercent" @onchange="SetTakeAllThreshold" />
                    </SettingRow>
                }
                else if (_selected is TekSaddleScript tek)
                {
                    <SettingRow Title="@Localizer.T("scripts.field.matchthreshold")" Description="@Localizer.T("scripts.tek.threshold.desc")">
                        <input class="script-input" type="number" min="50" max="100" value="@tek.MatchThresholdPercent" @onchange="SetTekThreshold" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.field.clickdelay")" Description="@Localizer.T("scripts.tek.clickdelay.desc")">
                        <input class="script-input" type="number" min="5" max="500" value="@tek.ClickDelayMs" @onchange="SetTekDelay" />
                    </SettingRow>
                }
                else if (_selected is NoglinScript noglin)
                {
                    <SettingRow Title="@Localizer.T("scripts.field.matchthreshold")" Description="@Localizer.T("scripts.noglin.threshold.desc")">
                        <input class="script-input" type="number" min="50" max="100" value="@noglin.MatchThresholdPercent" @onchange="SetNoglinThreshold" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.field.scaninterval")" Description="@Localizer.T("scripts.desc.scaninterval")">
                        <input class="script-input" type="number" min="100" max="5000" value="@noglin.ScanIntervalMs" @onchange="SetNoglinScan" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.noglin.restore")" Description="@Localizer.T("scripts.noglin.restore.desc")">
                        <input class="script-input" type="number" min="1" max="20" value="@noglin.RestoreAfterCleanScans" @onchange="SetNoglinCleanScans" />
                    </SettingRow>
                }
                else if (_selected is InvSizeScript invsize)
                {
                    <SettingRow Title="@Localizer.T("scripts.invsize.pulse")" Description="@Localizer.T("scripts.invsize.pulse.desc")">
                        <input class="script-input" type="number" min="20" max="2000" value="@invsize.IntervalMs" @onchange="SetInvSizeInterval" />
                    </SettingRow>
                }
                else if (_selected is AntiAfkScript antiafk)
                {
                    <SettingRow Title="@Localizer.T("scripts.antiafk.invkey")" Description="@Localizer.T("scripts.antiafk.invkey.desc")">
                        <input class="script-input" value="@antiafk.InventoryKey" @onchange="SetAntiAfkKey" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.antiafk.interval")" Description="@Localizer.T("scripts.antiafk.interval.desc")">
                        <input class="script-input" type="number" min="30" max="3600" value="@antiafk.IntervalSeconds" @onchange="SetAntiAfkInterval" />
                    </SettingRow>
                }
                else if (_selected is TurretManagerScript turret)
                {
                    <SettingRow Title="@Localizer.T("scripts.field.matchthreshold")" Description="@Localizer.T("scripts.turret.threshold.desc")">
                        <input class="script-input" type="number" min="50" max="100" value="@turret.MatchThresholdPercent" @onchange="SetTurretThreshold" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.field.transferkey")" Description="@Localizer.T("scripts.turret.transferkey.desc")">
                        <input class="script-input" value="@turret.TransferKey" @onchange="SetTurretKey" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.turret.presses")" Description="@Localizer.T("scripts.turret.presses.desc")">
                        <input class="script-input" type="number" min="1" max="20" value="@turret.TransferPresses" @onchange="SetTurretPresses" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.field.scaninterval")" Description="@Localizer.T("scripts.desc.scaninterval")">
                        <input class="script-input" type="number" min="100" max="5000" value="@turret.ScanIntervalMs" @onchange="SetTurretScan" />
                    </SettingRow>
                }
                else if (_selected is TurretFillerScript tf)
                {
                    @* Said once, above the settings rather than beside one of them: nothing below
                       changes which stack a press moves — the cursor does, and it is the one thing
                       this page cannot set. *@
                    <div class="setting-row-desc" style="margin-bottom: 0.75rem;">@Localizer.T("scripts.turretfill.cursorwarning")</div>

                    <SettingRow Title="@Localizer.T("scripts.turretfill.mode")" Description="@Localizer.T("scripts.turretfill.mode.desc")">
                        <Dropdown Value="@tf.Mode.ToString()" ValueChanged="SetTurretFillMode" Options="TurretFillModeOptions" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.turretfill.amount")" Description="@Localizer.T("scripts.turretfill.amount.desc")">
                        <Dropdown Value="@tf.Amount.ToString()" ValueChanged="SetTurretFillAmount" Options="TurretFillAmountOptions" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.turretfill.presses")" Description="@Localizer.T("scripts.turretfill.presses.desc")">
                        <input class="script-input" type="number" min="1" max="20" value="@tf.PressesPerTurret" @onchange="SetTurretFillPresses" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.field.transferkey")" Description="@Localizer.T("scripts.turretfill.transferkey.desc")">
                        <input class="script-input" value="@tf.TransferKey" @onchange="SetTurretFillKey" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.turretfill.pressdelay")" Description="@Localizer.T("scripts.turretfill.pressdelay.desc")">
                        <input class="script-input" type="number" min="60" max="2000" value="@tf.PressDelayMs" @onchange="SetTurretFillDelay" />
                    </SettingRow>
                    @* The same sentence Turret Manager's threshold carries, because it is the same
                       question about the same rectangle. *@
                    <SettingRow Title="@Localizer.T("scripts.field.matchthreshold")" Description="@Localizer.T("scripts.turret.threshold.desc")">
                        <input class="script-input" type="number" min="50" max="100" value="@tf.MatchThresholdPercent" @onchange="SetTurretFillThreshold" />
                    </SettingRow>
                    @* Invariant out and invariant back in: this machine is de-DE, and a field
                       rendered as "0,20" is a field the control empties on the next repaint. *@
                    <SettingRow Title="@Localizer.T("scripts.turretfill.changethreshold")" Description="@Localizer.T("scripts.turretfill.changethreshold.desc")">
                        <input class="script-input" type="number" min="0.02" max="10" step="0.01"
                               value="@tf.ChangeThresholdPercent.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                               @onchange="SetTurretFillChange" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.turretfill.usefilter")" Description="@Localizer.T("scripts.turretfill.usefilter.desc")">
                        <Switch Value="tf.UseFilter" ValueChanged="SetTurretFillUseFilter" />
                    </SettingRow>
                    @if (tf.Filtering)
                    {
                        <SettingRow Title="@Localizer.T("scripts.turretfill.filtertext")" Description="@Localizer.T("scripts.turretfill.filtertext.desc")">
                            <input class="script-input" value="@tf.FilterText" @onchange="SetTurretFillText" />
                        </SettingRow>
                        <SettingRow Title="@Localizer.T("scripts.turretfill.settle")" Description="@Localizer.T("scripts.turretfill.settle.desc")">
                            <input class="script-input" type="number" min="100" max="2000" value="@tf.FilterSettleMs" @onchange="SetTurretFillSettle" />
                        </SettingRow>
                        @* Two points, and they stay here rather than on the calibration card
                           below: that card is about the rectangle, and these two are only asked
                           for while the filter is on — by the switch above or by the mode. The
                           countdown still lands in its status line, which is the one place this
                           page reports a capture. *@
                        <SettingRow Title="@Localizer.T("scripts.turretfill.point.search")" Description="@PointLine(tf, TurretFillerScript.SearchPointName)">
                            <button class="btn btn-secondary" @onclick="() => CaptureTurretFillPoint(TurretFillerScript.SearchPointName)" disabled="@_calibrating">@Localizer.T("scripts.turretfill.point.capture")</button>
                            <button class="btn btn-secondary" @onclick="() => tf.ClearPoint(TurretFillerScript.SearchPointName)" disabled="@_calibrating">@Localizer.T("scripts.turretfill.point.clear")</button>
                        </SettingRow>
                        <SettingRow Title="@Localizer.T("scripts.turretfill.point.slot")" Description="@PointLine(tf, TurretFillerScript.SlotPointName)">
                            <button class="btn btn-secondary" @onclick="() => CaptureTurretFillPoint(TurretFillerScript.SlotPointName)" disabled="@_calibrating">@Localizer.T("scripts.turretfill.point.capture")</button>
                            <button class="btn btn-secondary" @onclick="() => tf.ClearPoint(TurretFillerScript.SlotPointName)" disabled="@_calibrating">@Localizer.T("scripts.turretfill.point.clear")</button>
                        </SettingRow>
                    }
                }
                else if (_selected is FlakScript flak)
                {
                    <SettingRow Title="@Localizer.T("scripts.flak.swapbelow")" Description="@Localizer.T("scripts.flak.swapbelow.desc")">
                        <input class="script-input" type="number" min="1" max="100000" value="@flak.DurabilityThreshold" @onchange="SetFlakThreshold" />
                    </SettingRow>

                    @* One key per row, because the helmet row has to pull the spare helmet. Rows
                       are top-to-bottom exactly as ARK draws them next to your character. *@
                    @for (var i = 0; i < FlakScript.MaxRows; i++)
                    {
                        var row = i;
                        var rowKey = flak.RowKeys[row];
                        <SettingRow Title="@Localizer.T("scripts.flak.rowkey", row + 1)"
                                    Description="@RowKeyHint(row, rowKey)">
                            <input class="script-input" value="@rowKey" @onchange="@(e => SetFlakRowKey(row, e))" />
                        </SettingRow>
                    }

                    <SettingRow Title="@Localizer.T("scripts.field.scaninterval")" Description="@Localizer.T("scripts.flak.scan.desc")">
                        <input class="script-input" type="number" min="500" max="10000" value="@flak.ScanIntervalMs" @onchange="SetFlakScan" />
                    </SettingRow>

                    @* The whole thing hangs on whether the numbers are read correctly, so the page
                       shows what it just read. Without this there is no way to tell a bad region
                       from a bad threshold from OCR that cannot see the digits at all. *@
                    <SettingRow Title="@Localizer.T("scripts.flak.lastread")" Description="@FlakReadingHint(flak)">
                        <span class="script-reading">@(string.IsNullOrEmpty(flak.LastReading) ? "—" : flak.LastReading)</span>
                    </SettingRow>
                }
                else if (_selected is DinoReadyScript dino)
                {
                    <SettingRow Title="@Localizer.T("scripts.dino.presses")" Description="@Localizer.T("scripts.dino.presses.desc")">
                        <input class="script-input" type="number" min="1" max="200" value="@dino.Presses" @onchange="SetDinoPresses" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.field.clickdelay")" Description="@Localizer.T("scripts.dino.clickdelay.desc")">
                        <input class="script-input" type="number" min="20" max="1000" value="@dino.ClickDelayMs" @onchange="SetDinoDelay" />
                    </SettingRow>
                }
                else if (_selected is CraftingScript crafting)
                {
                    <SettingRow Title="@Localizer.T("scripts.craft.mode")" Description="@Localizer.T("scripts.craft.mode.desc")">
                        <Dropdown Value="@crafting.Mode.ToString()" ValueChanged="SetCraftMode" Options="CraftModeOptions" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.craft.craftkey")" Description="@Localizer.T("scripts.craft.craftkey.desc")">
                        <input class="script-input" value="@crafting.CraftKey" @onchange="SetCraftKey" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.craft.accesskey")" Description="@Localizer.T("scripts.craft.accesskey.desc")">
                        <input class="script-input" value="@crafting.AccessKey" @onchange="SetCraftAccess" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.craft.presses")" Description="@Localizer.T("scripts.craft.presses.desc")">
                        <input class="script-input" type="number" min="1" max="20" value="@crafting.CraftPresses" @onchange="SetCraftPresses" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.craft.ping")" Description="@Localizer.T("scripts.craft.ping.desc")">
                        <input class="script-input" type="number" min="0" max="3000" value="@crafting.PingCompensationMs" @onchange="SetCraftPing" />
                    </SettingRow>
                    @if (crafting.Mode == CraftingMode.Watcher)
                    {
                        <SettingRow Title="@Localizer.T("scripts.field.matchthreshold")" Description="@Localizer.T("scripts.craft.threshold.desc")">
                            <input class="script-input" type="number" min="50" max="100" value="@crafting.MatchThresholdPercent" @onchange="SetCraftThreshold" />
                        </SettingRow>
                        <SettingRow Title="@Localizer.T("scripts.field.scaninterval")" Description="@Localizer.T("scripts.desc.scaninterval")">
                            <input class="script-input" type="number" min="100" max="5000" value="@crafting.ScanIntervalMs" @onchange="SetCraftScan" />
                        </SettingRow>
                    }
                    else
                    {
                        <SettingRow Title="@Localizer.T("scripts.field.forwardkey")" Description="@Localizer.T("scripts.craft.forwardkey.desc")">
                            <input class="script-input" value="@crafting.ForwardKey" @onchange="SetCraftForward" />
                        </SettingRow>
                        <SettingRow Title="@Localizer.T("scripts.craft.walktime")" Description="@Localizer.T("scripts.craft.walktime.desc")">
                            <input class="script-input" type="number" min="100" max="10000" value="@crafting.WalkMs" @onchange="SetCraftWalkMs" />
                        </SettingRow>
                    }
                }
                else if (_selected is AutoAntidoteScript antidote)
                {
                    <SettingRow Title="@Localizer.T("scripts.antidote.trigger")" Description="@Localizer.T("scripts.antidote.trigger.desc")">
                        <Dropdown Value="@antidote.Service.Settings.Mode.ToString()" ValueChanged="SetAntidoteMode" Options="AntidoteModeOptions" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.antidote.burstkey")" Description="@Localizer.T("scripts.antidote.burstkey.desc")">
                        <input class="script-input" value="@antidote.Service.Settings.BurstKey" @onchange="SetAntidoteBurstKey" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.antidote.burstpresses")" Description="@Localizer.T("scripts.antidote.burstpresses.desc")">
                        <input class="script-input" type="number" min="1" max="20" value="@antidote.Service.Settings.BurstPresses" @onchange="SetAntidoteBurstPresses" />
                    </SettingRow>
                    @if (antidote.Service.Settings.Mode == AutoAntidoteTriggerMode.TimerBelow)
                    {
                        <SettingRow Title="@Localizer.T("scripts.antidote.timer")" Description="@Localizer.T("scripts.antidote.timer.desc")">
                            <input class="script-input" type="number" min="1" max="600" value="@antidote.Service.Settings.TimerThresholdSeconds" @onchange="SetAntidoteTimer" />
                        </SettingRow>
                    }
                    else
                    {
                        <SettingRow Title="@Localizer.T("scripts.field.matchthreshold")" Description="@Localizer.T("scripts.antidote.threshold.desc")">
                            <input class="script-input" type="number" min="50" max="100" value="@antidote.Service.Settings.MatchThresholdPercent" @onchange="SetAntidoteThreshold" />
                        </SettingRow>
                    }
                    <SettingRow Title="@Localizer.T("scripts.field.scaninterval")" Description="@Localizer.T("scripts.desc.scaninterval")">
                        <input class="script-input" type="number" min="100" max="10000" value="@antidote.Service.Settings.ScanIntervalMs" @onchange="SetAntidoteScan" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.antidote.cooldown")" Description="@Localizer.T("scripts.antidote.cooldown.desc")">
                        <input class="script-input" type="number" min="0" max="600" value="@antidote.Service.Settings.CooldownSeconds" @onchange="SetAntidoteCooldown" />
                    </SettingRow>
                    @* Without this you are guessing at the threshold: the number moves live while
                       the watcher scans, so you can read off what "present" and "absent" actually
                       score on your screen and set the cut-off between them. *@
                    <SettingRow Title="@Localizer.T("scripts.antidote.livematch")" Description="@Localizer.T("scripts.antidote.livematch.desc")">
                        <span class="setting-value">
                            @(antidote.Service.LastMatchPercent is { } pct ? $"{pct:0.#}%" : "—")
                            @Localizer.T("scripts.antidote.fired", antidote.Service.TriggerCount)
                        </span>
                    </SettingRow>
                }
                else if (_selected is FedSuitScript fed)
                {
                    <SettingRow Title="@Localizer.T("scripts.fed.openkey")" Description="@Localizer.T("scripts.fed.openkey.desc")">
                        <input class="script-input" value="@fed.Macro.Settings.OpenKey" @onchange="SetFedOpenKey" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.field.transferkey")" Description="@Localizer.T("scripts.fed.transferkey.desc")">
                        <input class="script-input" value="@fed.Macro.Settings.TransferKey" @onchange="SetFedTransferKey" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.fed.exitkey")" Description="@Localizer.T("scripts.fed.exitkey.desc")">
                        <input class="script-input" value="@fed.Macro.Settings.ExitKey" @onchange="SetFedExitKey" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.fed.runs")" Description="@Localizer.T("scripts.fed.runs.desc")">
                        <input class="script-input" type="number" min="0" max="9999" value="@fed.Macro.Settings.Runs" @onchange="SetFedRuns" />
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.fed.wait")" Description="@Localizer.T("scripts.fed.wait.desc")">
                        <input class="script-input" type="number" min="0" max="5000" value="@fed.Macro.Settings.WaitAfterOpenMs" @onchange="SetFedWait" />
                    </SettingRow>
                }

                @* Full width (see scripts-styles.css): squeezed into half, the combo and its
                   link wrapped onto a second line and dragged the whole grid row taller. *@
                <SettingRow Class="script-hotkey-row" Title="@Localizer.T("scripts.hotkey.title")" Description="@Localizer.T("scripts.hotkey.desc")">
                    <HotkeyLink Value="@_selected.StartStopHotkey" Failed="@_selected.HotkeyFailed" />
                </SettingRow>
            </div>

            @if (_selected is AutoAntidoteScript antidoteCal)
            {
                <div class="content-card scripts-calibration">
                    <h3>@Localizer.T("scripts.calibration")</h3>
                    <SettingRow Title="@Localizer.T("scripts.antidote.region")" Description="@RegionLine(antidoteCal.Service.CalibratedRegion)">
                        <button class="btn btn-secondary" @onclick="CalibrateAntidoteRegion" disabled="@_calibrating">@Localizer.T("scripts.calibrate")</button>
                    </SettingRow>
                    <SettingRow Title="@Localizer.T("scripts.reference.title")" Description='@Localizer.T(antidoteCal.Service.HasReference ? "scripts.reference.captured" : "scripts.reference.capture.icon")'>
                        <button class="btn btn-secondary" @onclick="CaptureAntidoteReference" disabled="@(!antidoteCal.Service.HasRegion || _calibrating)">@Localizer.T("scripts.capturereference")</button>
                    </SettingRow>
                    @if (!string.IsNullOrEmpty(_calStatus))
                    {
                        <div class="setting-row-desc" style="margin-top: 0.5rem;">@_calStatus</div>
                    }
                </div>
            }
            else if (_selected is ICalibratableScript cal)
            {
                <div class="content-card scripts-calibration">
                    <h3>@Localizer.T("scripts.calibration")</h3>
                    <SettingRow Title="@Localizer.T(cal.RegionTitleKey)" Description="@RegionLine(cal.CalibratedRegion)">
                        <button class="btn btn-secondary" @onclick="CalibrateRegion" disabled="@_calibrating">@Localizer.T("scripts.calibrate")</button>
                    </SettingRow>
                    @* OCR scripts read the region as text; offering them the snapshot/mask
                       workflow sent people off capturing references that changed nothing. *@
                    @if (cal.UsesReference)
                    {
                        <SettingRow Title="@Localizer.T("scripts.reference.title")" Description='@Localizer.T(cal.HasReference ? "scripts.reference.captured" : "scripts.reference.capture.target")'>
                            <button class="btn btn-secondary" @onclick="CaptureReferenceSnapshot" disabled="@(!cal.HasRegion || _calibrating)">@Localizer.T("scripts.capturereference")</button>
                        </SettingRow>
                        @* Anything drawn over the live game world needs this or it never matches twice:
                           the world behind it moves and the comparison is over the whole region. *@
                        <SettingRow Title="@Localizer.T("scripts.ignorebackground")"
                                    Description="@MaskLine(cal.MaskCoverage)">
                            <button class="btn btn-secondary" @onclick="RefineReferenceMask" disabled="@(!cal.HasReference || _calibrating)">@Localizer.T("scripts.ignorebackground")</button>
                        </SettingRow>
                        @* The number the threshold above is set against. Auto-Antidote has shown
                           it since it shipped and the other five were tuned blind: "90%" means
                           nothing until you can watch what the target scores when it is there and
                           when it is not. It moves on this page's own 1.5 s tick. *@
                        <SettingRow Title="@Localizer.T("scripts.cal.livematch")" Description="@Localizer.T("scripts.cal.livematch.desc")">
                            <span class="script-reading">@SimilarityValue(cal.CurrentSimilarityPercent)</span>
                        </SettingRow>
                        @* Which screen the snapshot belongs to. Without it a reference taken on
                           the second monitor and compared against the first reads as a script
                           that simply never fires — the numbers are all there and all nonsense. *@
                        @if (cal.HasReference)
                        {
                            <SettingRow Class="@(cal.Monitor is { Mismatch: true } ? "scripts-cal-mismatch" : null)"
                                        Title="@Localizer.T("scripts.cal.monitor.title")"
                                        Description="@MonitorLine(cal.Monitor)">
                                <span class="setting-value">@MonitorValue(cal.Monitor)</span>
                            </SettingRow>
                        }
                    }
                    @if (!string.IsNullOrEmpty(_calStatus))
                    {
                        <div class="setting-row-desc" style="margin-top: 0.5rem;">@_calStatus</div>
                    }
                </div>
            }
            </div>
            </div>
        }
    </section>
</div>
</div>

@code {
    /// <summary>
    /// Repaints the page when the language changes; why the cascade rather than a subscription
    /// of this page's own is explained in MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    private readonly List<AutomationScriptBase> _scripts = new();
    private AutomationScriptBase? _selected;

    /// <summary>Where ARK is, as far as a script is concerned. The three answers are different.</summary>
    private enum ArkPresence
    {
        /// <summary>No game process at all — nothing any script does can land anywhere.</summary>
        NotRunning,
        /// <summary>Running, but behind this window: the foreground gate is shut and ticks are skipped.</summary>
        Background,
        /// <summary>The game has focus. This is the only state in which a script actually acts.</summary>
        Foreground
    }

    private ArkPresence _ark = ArkPresence.NotRunning;
    private Timer? _arkTimer;

    /// <summary>
    /// 1.5 s. Fast enough that alt-tabbing back is reflected before the hand reaches Start, slow
    /// enough that the process lookup behind it costs nothing — and it only runs while this page
    /// is mounted, because <see cref="Dispose"/> takes the timer down with it.
    /// </summary>
    private static readonly TimeSpan ArkPollInterval = TimeSpan.FromSeconds(1.5);

    /// <summary>
    /// Resolved here rather than handed out as a key, because a key returned from a property is
    /// a key no grep can see — TranslatedSurfaceTests reads the literals out of <c>T(</c> call
    /// sites, and all three of these would have been declared dead. Read where the pill renders,
    /// so a language switch repaints it.
    /// </summary>
    private string ArkStatusText => _ark switch
    {
        ArkPresence.Foreground => Localizer.T("scripts.ark.foreground"),
        ArkPresence.Background => Localizer.T("scripts.ark.background"),
        _ => Localizer.T("scripts.ark.notrunning")
    };

    private string ArkPillClass => _ark switch
    {
        ArkPresence.Foreground => "live",
        ArkPresence.Background => "warn",
        _ => "off"
    };

    /// <summary>
    /// Which keys the scripts default to, and where they came from. Read where it renders, like
    /// the ARK pill above and for the same two reasons: a language switch has to repaint it, and
    /// the literals have to sit at a <c>T(</c> call site the localization scan can find.
    /// </summary>
    private string ArkKeySourceText
    {
        get
        {
            var status = ArkKeys.Status;
            if (!status.InputIniFound) return Localizer.T("scripts.keys.missing");
            return status.CustomBindingCount > 0
                ? Localizer.T("scripts.keys.custom", status.CustomBindingCount)
                : Localizer.T("scripts.keys.stock");
        }
    }

    /// <summary>
    /// Forced, not the cheap staleness check the script starts use: someone pressing Rescan has
    /// just changed something the timestamp may not have caught up with, and an unconditional
    /// re-read is what they asked for.
    /// </summary>
    private void RescanArkKeys()
    {
        try
        {
            ArkKeys.Refresh();
            Notifications.ShowInfo(Localizer.T("scripts.keys.rescanned"));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Rescanning the ARK key bindings failed");
        }
    }

    protected override void OnInitialized()
    {
        _scripts.AddRange(AllScripts);
        _selected = _scripts.FirstOrDefault();
        foreach (var s in _scripts) s.Changed += OnScriptChanged;

        ReadArkPresence();
        _arkTimer = new Timer(_ => ArkTick(), null, ArkPollInterval, ArkPollInterval);
    }

    // A TimerCallback has no caller to hand a fault to: on .NET 10 anything escaping here is
    // rethrown on the pool thread as an unhandled exception and takes the process down. Same
    // shape as Game.razor's status tick, for the same reason.
    private void ArkTick()
    {
        try
        {
            ArkTickCore();
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Scripts ARK status tick failed");
        }
    }

    private void ArkTickCore()
    {
        if (this.IsRenderStopped()) return;

        var before = _ark;
        ReadArkPresence();

        // Not conditional on the state having moved: a running script's "last action" line ages
        // between ticks, and a line that only refreshes when ARK changes windows would sit at
        // "2 s ago" for a minute.
        if (before != _ark || _scripts.Any(s => s.IsRunning))
            this.DispatchRender(() => InvokeAsync(StateHasChanged), Logger);
    }

    /// <summary>
    /// What a running script has actually done, in one sentence. Three answers, because
    /// "running" on its own was the lie: the gate can be shut, the scan can be finding nothing,
    /// and from the outside those look identical to each other and to a script that works.
    /// </summary>
    private string EffectLine(AutomationScriptBase script)
    {
        if (script.SinceLastEffect is { } since)
            return since.TotalSeconds < 60
                ? Localizer.T("scripts.effect.ago.seconds", (int)since.TotalSeconds)
                : Localizer.T("scripts.effect.ago.minutes", (int)since.TotalMinutes);

        // Nothing yet, so why not. The gate first: it is the one the user can fix in one
        // keystroke, and while it is shut the script has not even looked.
        if (_ark != ArkPresence.Foreground)
            return Localizer.T("scripts.effect.none.background");

        // Vision scripts are the ones that sit and watch for something to appear. An
        // input-only script with the gate open and nothing to show has yet to reach its
        // first interval.
        return Localizer.T(script.UsesVision ? "scripts.effect.none.match" : "scripts.effect.none");
    }

    /// <summary>The same thing in the width of a list row. The sentence rides along as a title.</summary>
    private string EffectShort(AutomationScriptBase script)
        => script.SinceLastEffect is { } since
            ? (since.TotalSeconds < 60
                ? Localizer.T("scripts.effect.short.seconds", (int)since.TotalSeconds)
                : Localizer.T("scripts.effect.short.minutes", (int)since.TotalMinutes))
            : "—";

    /// <summary>
    /// The process check first, then the gate. Foreground implies running, but only the process
    /// check tells "ARK was never started" apart from "ARK is behind this window" — and those two
    /// are fixed by completely different actions.
    /// </summary>
    private void ReadArkPresence()
    {
        if (!GameIni.IsArkRunning())
        {
            _ark = ArkPresence.NotRunning;
            return;
        }

        _ark = Foreground.IsGameForeground() ? ArkPresence.Foreground : ArkPresence.Background;
    }

    // Not static: the description is looked up where the header renders, so a switch re-words
    // it on the next repaint. The script's own DisplayName stays English — the community calls
    // them Yuty, Noglin and Fed Suit, and diagnostics report that same name.
    private string Describe(AutomationScriptBase script) => script switch
    {
        YutyScript => Localizer.T("scripts.desc.yuty"),
        AutoWalkScript => Localizer.T("scripts.desc.autowalk"),
        MammothScript => Localizer.T("scripts.desc.mammoth"),
        AstroScript => Localizer.T("scripts.desc.astro"),
        AutoDownloadScript => Localizer.T("scripts.desc.autodownload"),
        FastTpScript => Localizer.T("scripts.desc.fasttp"),
        TakeAllScript => Localizer.T("scripts.desc.takeall"),
        TekSaddleScript => Localizer.T("scripts.desc.teksaddle"),
        NoglinScript => Localizer.T("scripts.desc.noglin"),
        InvSizeScript => Localizer.T("scripts.desc.invsize"),
        AntiAfkScript => Localizer.T("scripts.desc.antiafk"),
        TurretManagerScript => Localizer.T("scripts.desc.turret"),
        TurretFillerScript => Localizer.T("scripts.desc.turretfill"),
        FlakScript => Localizer.T("scripts.desc.flak"),
        DinoReadyScript => Localizer.T("scripts.desc.dinoready"),
        CraftingScript => Localizer.T("scripts.desc.crafting"),
        AutoAntidoteScript => Localizer.T("scripts.desc.antidote"),
        FedSuitScript => Localizer.T("scripts.desc.fedsuit"),
        _ => ""
    };

    // The two calibration-card lines. A script has no localizer — it publishes the rectangle and
    // the two pixel counts, the same reason RegionTitleKey is a key — so the sentence is built
    // here, where a language switch repaints it. Both numbers are formatted invariantly, which is
    // what every other number in the app does: a region read as 1,920 in one language and 1 920
    // in the next is a region nobody can compare.
    private string RegionLine(System.Drawing.Rectangle? region)
        => region is { } r
            ? Localizer.T("scripts.region.summary", r.Width, r.Height, r.X, r.Y)
            : Localizer.T("scripts.region.notset");

    private string MaskLine((int Kept, int Total)? coverage)
        => coverage is { } c
            ? Localizer.T("scripts.mask.summary",
                c.Kept.ToString("N0", System.Globalization.CultureInfo.InvariantCulture),
                c.Total.ToString("N0", System.Globalization.CultureInfo.InvariantCulture))
            : Localizer.T("scripts.mask.hint");

    /// <summary>
    /// Which display the reference belongs to, in one line. Null is its own answer rather than a
    /// blank: an entry captured before the display was recorded is not a mismatch, and refusing
    /// to compare it would break a calibration that works.
    /// </summary>
    private string MonitorLine(CalibrationMonitorInfo? monitor)
    {
        if (monitor is null) return Localizer.T("scripts.cal.monitor.unknown");

        return monitor.Mismatch
            ? Localizer.T("scripts.cal.monitor.mismatch",
                monitor.StoredIndex, monitor.StoredResolution, monitor.CurrentIndex, monitor.CurrentResolution)
            : Localizer.T("scripts.cal.monitor.match", monitor.StoredIndex, monitor.StoredResolution);
    }

    /// <summary>The short form in the control column — the numbers, with the sentence beside them.</summary>
    private static string MonitorValue(CalibrationMonitorInfo? monitor)
        => monitor is null ? "—" : $"{monitor.StoredIndex} · {monitor.StoredResolution}";

    /// <summary>
    /// The live similarity, formatted the way Auto-Antidote's is. Invariant, like every other
    /// number on this page: a score read as 92.5 in one language and 92,5 in the next is a score
    /// nobody can compare against a threshold typed as 92.
    /// </summary>
    private static string SimilarityValue(double? percent)
        => percent is { } p ? p.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%" : "—";

    private void SetYutyKey(ChangeEventArgs e)
    {
        if (_selected is YutyScript y)
        {
            y.RoarKey = e.Value?.ToString() ?? "C";
            y.SaveSettings();
