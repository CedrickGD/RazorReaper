    /// <summary>The line under "Last read": what was seen, and what the script made of it.</summary>
    private static string FlakReadingHint(FlakScript f)
    {
        if (!f.IsRunning) return "Start the script to see what it reads.";

        // Empty LastReading means no scan has happened yet — the loop only ticks while ARK
        // is the foreground window, which it never is while you sit on this page. Blaming
        // the calibration here sent people off recalibrating a region that was never read.
        if (string.IsNullOrEmpty(f.LastReading)) return "Waiting for ARK to be in the foreground…";
        if (f.Lowest is not { } low) return "No number recognised — check the calibrated region.";

        // Absolute time, not "Ns ago": the counter only re-renders on a tick, and ticks
        // stop the moment you alt-tab here — a frozen live counter is a lie.
        var swapped = f.LastSwapUtc is { } t ? $" · last swap {t.ToLocalTime():HH:mm:ss}" : "";
        return low <= f.DurabilityThreshold
            ? $"Lowest {low} — at or below {f.DurabilityThreshold}, swapping{swapped}"
            : $"Lowest {low} — above {f.DurabilityThreshold}, nothing to do{swapped}";
    }

