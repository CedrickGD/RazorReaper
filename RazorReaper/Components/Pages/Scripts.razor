    /// <summary>Says outright when a typed key cannot be sent — the script skips those silently.</summary>
    private static string RowKeyHint(int row, string? key)
    {
        if (!string.IsNullOrWhiteSpace(key) && !FlakScript.IsUsableKey(key))
            return $"'{key}' is not a key that can be sent — use a single character like 8, or a name like F5.";

        return row == 0
            ? "Hotbar slot holding the spare for the top armor row. Leave a row empty to ignore it."
            : "Leave empty if you carry no spare for this row.";
    }
