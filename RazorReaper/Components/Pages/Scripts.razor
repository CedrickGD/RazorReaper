    private bool _calibrating;
    private string _calStatus = "";

    private async Task CalibrateRegion()
    {
        if (_selected is not ICalibratableScript cal) return;
        _calibrating = true;
        var progress = new Progress<RegionCaptureProgress>(p =>
        {
            _calStatus = Localizer.T("scripts.cal.progress.button", p.CornerIndex, p.SecondsRemaining);
            this.DispatchRender(() => InvokeAsync(StateHasChanged));
        });
        try { await cal.CalibrateRegionAsync(progress); }
        finally
        {
            _calibrating = false;
            _calStatus = "";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CaptureReferenceSnapshot()
    {
        if (_selected is ICalibratableScript cal) cal.CaptureReference();
    }

    private void RefineReferenceMask()
    {
        if (_selected is ICalibratableScript cal) cal.RefineReferenceMask();
    }

    // Scripts raise Changed from their own worker threads, where an `async void` fault has no
    // SynchronizationContext and is rethrown on the thread pool.
    private void OnScriptChanged() => this.DispatchRender(() => InvokeAsync(StateHasChanged));

    public void Dispose()
    {
        this.StopRenderDispatch();
        foreach (var s in _scripts) s.Changed -= OnScriptChanged;
    }
