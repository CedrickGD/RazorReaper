    private async Task CalibrateAntidoteRegion()
    {
        if (_selected is not AutoAntidoteScript a) return;

        _calibrating = true;
        _calStatus = Localizer.T("scripts.cal.hovercorners");
        StateHasChanged();
        try
        {
            var progress = new Progress<RegionCaptureProgress>(pr =>
            {
                _calStatus = Localizer.T("scripts.cal.progress", pr.CornerIndex, pr.SecondsRemaining);
                this.DispatchRender(() => InvokeAsync(StateHasChanged));
            });

            var ok = await a.Service.CaptureRegionAsync(progress);
            _calStatus = Localizer.T(ok ? "scripts.cal.captured" : "scripts.cal.cancelled");
        }
        finally
        {
            _calibrating = false;
            StateHasChanged();
        }
    }

    private void CaptureAntidoteReference()
    {
        if (_selected is not AutoAntidoteScript a) return;
        _calStatus = Localizer.T(a.Service.CaptureReference() ? "scripts.cal.ref.captured" : "scripts.cal.ref.failed");
    }

