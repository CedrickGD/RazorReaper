    // Fed Suit hands out a copy of its settings, so each edit mutates the copy and pushes the
    // whole thing back through UpdateSettings — which is also what re-validates the keys.
    private void ApplyFed(FedSuitScript f, Action<FedSuitSettings> edit)
    {
        var settings = f.Macro.Settings;
        edit(settings);
        f.Macro.UpdateSettings(settings);
    }

    private void SetFedOpenKey(ChangeEventArgs e)
    {
        if (_selected is FedSuitScript f) ApplyFed(f, s => s.OpenKey = e.Value?.ToString() ?? "F");
