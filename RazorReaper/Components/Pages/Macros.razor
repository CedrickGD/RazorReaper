@page "/macros"
@using System.Globalization
@using System.Linq
@using Microsoft.Extensions.Logging
@using Microsoft.Maui.Storage
@using RazorReaper.Services
@using RazorReaper.Services.Automation
@using RazorReaper.Components.Shared
@inject IInputRecorderService Recorder
@inject IMacroEngine MacroEngine
@inject IAutomationHotkeyService Hotkeys
@inject ICalibrationService Calibration
@inject IFastTransferMacro FastTransfer
@inject INotificationService NotificationService
@inject IActivityService ActivityService
@inject ILogger<Macros> Logger
@implements IDisposable

<header class="page-header">
    <h1 class="page-title">Macros</h1>
    <p class="page-subtitle">Record, replay and run premade input macros</p>
</header>

<div class="macros-layout">

    @* ── Macro Recorder ─────────────────────────────────────────────────── *@
    <section class="content-card mac-card">
        <div class="mac-card-head">
            <div class="mac-card-title">Macro Recorder</div>
            <span class="mac-badge">Input capture</span>
        </div>

        <StatusHeader State="@RecorderStateCss" Label="@RecorderLabel" Description="@RecorderDescription">
            <Actions>
                <button class="btn btn-secondary mac-btn"
                        @onclick="ToggleRecording"
                        disabled="@Recorder.IsReplaying">
                    @(Recorder.IsRecording ? "Stop recording" : "Record")
                </button>
                <button class="btn btn-secondary mac-btn"
                        @onclick="TogglePlayback"
                        disabled="@(Recorder.IsRecording || (!Recorder.IsReplaying && !HasCurrentRecording))">
                    @(Recorder.IsReplaying ? "Stop playback" : "Play")
                </button>
                <button class="btn btn-danger mac-btn"
                        @onclick="StopEverything"
                        disabled="@(!AnythingRunning)">
                    Stop
                </button>
            </Actions>
        </StatusHeader>

        <div class="mac-rows">
            <SettingRow Title="Record hotkey" Description="Starts or stops capturing your keyboard and mouse input.">
                <HotkeyField Value="@recordHotkey" ValueChanged="@((string v) => RebindRecordHotkey(v))" />
            </SettingRow>
            <SettingRow Title="Play hotkey" Description="Replays the current recording at the selected speed.">
                <HotkeyField Value="@playHotkey" ValueChanged="@((string v) => RebindPlayHotkey(v))" />
            </SettingRow>
            <SettingRow Title="Stop hotkey" Description="Hard-stops recording, playback and every running macro.">
                <HotkeyField Value="@stopHotkey" ValueChanged="@((string v) => RebindStopHotkey(v))" />
            </SettingRow>
        </div>

        <div class="mac-note">
            Macros stop with the stop hotkey (@(string.IsNullOrWhiteSpace(stopHotkey) ? "unset" : stopHotkey)) at any time, even while the game has focus.
        </div>
    </section>

    @* ── Saved Recordings ───────────────────────────────────────────────── *@
    <section class="content-card mac-card">
        <div class="mac-card-head">
            <div class="mac-card-title">Saved Recordings</div>
            <span class="mac-badge">@savedRecordings.Count saved</span>
        </div>

        <div class="mac-save-row">
            <input class="mac-input"
                   placeholder="Recording name"
                   spellcheck="false"
                   @bind="saveName"
                   @bind:event="oninput" />
            <button class="btn btn-secondary mac-btn"
                    @onclick="SaveCurrent"
                    disabled="@(!HasCurrentRecording)">
                Save current
            </button>
        </div>

        <SettingRow Title="Playback speed" Description="Timing scale applied when a recording is replayed.">
            <div class="mac-seg">
                <button class="mac-seg-btn @(playbackSpeed == 0.5 ? "active" : "")" @onclick="() => SetSpeed(0.5)">0.5x</button>
                <button class="mac-seg-btn @(playbackSpeed == 1.0 ? "active" : "")" @onclick="() => SetSpeed(1.0)">1x</button>
                <button class="mac-seg-btn @(playbackSpeed == 2.0 ? "active" : "")" @onclick="() => SetSpeed(2.0)">2x</button>
            </div>
        </SettingRow>

        <div class="mac-list">
            @if (savedRecordings.Count == 0)
            {
                <p class="mac-empty">No saved recordings yet.</p>
            }
            else
            {
                @foreach (var name in savedRecordings)
                {
                    <div class="mac-list-item @(LoadedName == name ? "loaded" : "")" @key="name">
                        <span class="mac-list-name">@name</span>
                        @if (LoadedName == name)
                        {
                            <span class="mac-badge">Loaded</span>
                        }
                        <div class="mac-list-actions">
                            <button class="btn btn-secondary mac-btn sm" @onclick="() => LoadRecording(name)">Load</button>
                            @if (pendingDelete == name)
                            {
                                <button class="btn btn-danger mac-btn sm" @onclick="() => ConfirmDelete(name)">Confirm</button>
                                <button class="btn btn-secondary mac-btn sm" @onclick="CancelDelete">Cancel</button>
                            }
                            else
                            {
                                <button class="btn btn-secondary mac-btn sm" @onclick="() => RequestDelete(name)">Delete</button>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </section>

    @* ── Fast Transfer ──────────────────────────────────────────────────── *@
    <section class="content-card mac-card mac-card-wide">
        <div class="mac-card-head">
            <div class="mac-card-title">Fast Transfer</div>
            <span class="mac-badge">Premade</span>
        </div>

        <StatusHeader State="@FtStateCss" Label="@FtLabel" Description="@FtDescription">
            <Actions>
                <button class="btn @(FtBusy ? "btn-danger" : "btn-secondary") mac-btn" @onclick="ToggleFastTransfer">
                    @(FtBusy ? "Stop" : "Start")
                </button>
            </Actions>
        </StatusHeader>

        <p class="mac-desc">Opens your inventory, clicks the calibrated Transfer All spot the set number of times, then closes the inventory again.</p>

        <div class="mac-rows two-col">
            <SettingRow Title="Inventory key" Description="Key that opens and closes your inventory in game.">
                <input class="mac-input key"
                       maxlength="1"
                       spellcheck="false"
                       value="@ftInventoryKey"
                       @onchange="OnInventoryKeyChanged" />
            </SettingRow>
            <SettingRow Title="Click count" Description="How many times the Transfer All spot is clicked.">
                <input type="number" class="mac-input num" min="1" max="50"
                       value="@ftClickCount"
                       @onchange="OnFtClickCountChanged" />
            </SettingRow>
            <SettingRow Title="Open delay" Description="Wait after opening the inventory before the first click, in milliseconds.">
                <input type="number" class="mac-input num" min="0" max="10000" step="50"
                       value="@ftOpenDelayMs"
                       @onchange="OnFtOpenDelayChanged" />
            </SettingRow>
            <SettingRow Title="Per-click delay" Description="Wait between consecutive clicks, in milliseconds.">
                <input type="number" class="mac-input num" min="0" max="5000" step="10"
                       value="@ftClickDelayMs"
                       @onchange="OnFtClickDelayChanged" />
            </SettingRow>
            <SettingRow Title="Toggle hotkey" Description="Starts or stops Fast Transfer from anywhere.">
                <HotkeyField Value="@ftHotkey" ValueChanged="@((string v) => RebindFtHotkey(v))" />
            </SettingRow>
            <SettingRow Title="Transfer All position" Description="Hover the in-game Transfer All button while the countdown runs to capture it.">
                @if (isCapturing)
                {
                    <span class="mac-countdown">@(captureCountdown > 0 ? $"Capturing in {captureCountdown}s…" : "Captured")</span>
                }
                else
                {
                    <span class="mac-cal @(FtCalibrated ? "" : "missing")">@FtCalibrationDisplay</span>
                }
                <button class="btn btn-secondary mac-btn"
                        @onclick="CaptureTransferPoint"
                        disabled="@(isCapturing || FtBusy)">
                    @(FtCalibrated ? "Recalibrate" : "Calibrate")
                </button>
            </SettingRow>
        </div>
    </section>

</div>

@code {
    private const string FtRunnerName = "fast-transfer";
    private const int CaptureCountdownSeconds = 3;
    private const int EventRefreshThrottleMs = 150;

    private enum HotkeySlot { Record, Play, Stop, FastTransfer }

    // ── Preferences-backed settings ("macros.*" / "macros.ft.*") ──────────────
    private string recordHotkey = "F8";
    private string playHotkey = "F9";
    private string stopHotkey = "F10";
    private double playbackSpeed = 1.0;
    private string ftInventoryKey = "F";
    private int ftClickCount = 3;
    private int ftOpenDelayMs = 500;
    private int ftClickDelayMs = 150;
    private string ftHotkey = "Alt + F";

    // ── UI state ──────────────────────────────────────────────────────────────
    private string saveName = "";
    private IReadOnlyList<string> savedRecordings = Array.Empty<string>();
    private string? pendingDelete;
    private bool isCapturing;
    private int captureCountdown;
    private IMacroRunner? ftRunner;
    private System.Timers.Timer? uiTimer;
    private long lastEventRefreshTick;
    private bool hasRegisteredHotkeys;

    // ── Cross-navigation state (services are singletons; hotkeys and the current
    //    recording must outlive this page instance, like the crosshair overlay) ──
    private static readonly object s_gate = new();
    private static InputRecording? s_currentRecording;
    private static string? s_loadedName;
    private static double s_playbackSpeed = 1.0;
    private static FastTransferSettings s_ftSettings = new();
    private static int s_recordRegId, s_playRegId, s_stopRegId, s_ftRegId;
    private static int s_recordVk, s_playVk, s_stopVk, s_ftVk; // exclusion VKs (0 for modified combos)
    private static Macros? s_active;

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        try
        {
            LoadSettings();
            lock (s_gate)
            {
                s_playbackSpeed = playbackSpeed;
                s_ftSettings = BuildFtSettings();
                s_active = this;
            }

            ftRunner = MacroEngine.GetRunner(FtRunnerName);
            Recorder.StateChanged += OnRecorderStateChanged;
            Recorder.EventCaptured += OnEventCaptured;
            ftRunner.StateChanged += OnFtStateChanged;
            ftRunner.StepStarted += OnFtStepStarted;

            savedRecordings = Recorder.ListRecordings();

            uiTimer = new System.Timers.Timer(500);
            uiTimer.Elapsed += OnUiTimer;
            uiTimer.AutoReset = true;
            uiTimer.Start();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Macros page initialization failed");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || hasRegisteredHotkeys) return;
        hasRegisteredHotkeys = true;
        try
        {
            var failures = await Task.Run(EnsureHotkeysRegistered);
            foreach (var combo in failures)
                NotificationService.ShowWarning($"Could not register hotkey '{combo}' — the combination may be in use by another app.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Macros hotkey registration failed");
        }
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        try
        {
            uiTimer?.Stop();
            uiTimer?.Dispose();
            uiTimer = null;

            Recorder.StateChanged -= OnRecorderStateChanged;
            Recorder.EventCaptured -= OnEventCaptured;
            if (ftRunner is not null)
            {
                ftRunner.StateChanged -= OnFtStateChanged;
                ftRunner.StepStarted -= OnFtStepStarted;
            }

            lock (s_gate)
            {
                if (ReferenceEquals(s_active, this)) s_active = null;
            }

            // Hotkeys stay registered on purpose: recordings and macros keep running when the
            // user navigates away, and the stop hotkey must keep working while they do.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Macros page dispose failed");
        }
    }

    // ── Status header state ───────────────────────────────────────────────────

    private string RecorderStateCss => Recorder.IsRecording ? "error" : Recorder.IsReplaying ? "online" : "off";

    private string RecorderLabel => Recorder.IsRecording ? "Recording" : Recorder.IsReplaying ? "Playing" : "Idle";

    private string RecorderDescription
    {
        get
        {
            if (Recorder.IsRecording)
                return $"{Recorder.CapturedEventCount} events · {FormatDuration(Recorder.RecordingElapsedMs)}";
            if (Recorder.IsReplaying)
            {
                lock (s_gate)
                {
                    var name = string.IsNullOrEmpty(s_currentRecording?.Name) ? "current recording" : $"'{s_currentRecording!.Name}'";
                    return $"Replaying {name} at {SpeedText(s_playbackSpeed)}";
                }
            }
            lock (s_gate)
            {
                if (s_currentRecording is { } rec && rec.Events.Count > 0)
                {
                    var name = string.IsNullOrEmpty(rec.Name) ? "Unsaved recording" : $"'{rec.Name}'";
                    return $"{name} ready · {rec.Events.Count} events";
                }
            }
            return $"Press {(string.IsNullOrWhiteSpace(recordHotkey) ? "Record" : recordHotkey)} to start capturing input";
        }
    }

    private bool FtBusy => ftRunner is { State: not MacroRunnerState.Idle };

    private string FtStateCss => ftRunner?.State switch
    {
        MacroRunnerState.Running => "online",
        MacroRunnerState.Stopping => "warning",
        _ => "off"
    };

    private string FtLabel => ftRunner?.State switch
    {
        MacroRunnerState.Running => "Running",
        MacroRunnerState.Stopping => "Stopping",
        _ => "Idle"
    };

    private string FtDescription
    {
        get
        {
            if (ftRunner is { State: MacroRunnerState.Running } runner)
                return $"Step {Math.Max(1, runner.CurrentStepIndex + 1)} of {runner.TotalSteps}";
            if (ftRunner is { State: MacroRunnerState.Stopping })
                return "Finishing the current step";
            if (!FtCalibrated)
                return "Calibrate the Transfer All position to enable";
            return $"Press {(string.IsNullOrWhiteSpace(ftHotkey) ? "Start" : ftHotkey)} to run";
        }
    }

    private bool FtCalibrated => FastTransfer.IsCalibrated;

    private string FtCalibrationDisplay
        => FastTransfer.TryGetTransferPoint(out var point)
            ? $"{point.X}, {point.Y} · {Calibration.CurrentResolutionKey}"
            : "Not calibrated";

    private bool HasCurrentRecording
    {
        get { lock (s_gate) { return s_currentRecording is { } rec && rec.Events.Count > 0; } }
    }

    private string? LoadedName
    {
        get { lock (s_gate) { return s_loadedName; } }
    }

    private bool AnythingRunning => Recorder.IsRecording || Recorder.IsReplaying || FtBusy;

    private static string SpeedText(double speed) => speed.ToString("0.#", CultureInfo.InvariantCulture) + "x";

    private static string FormatDuration(long ms)
    {
        var t = TimeSpan.FromMilliseconds(Math.Max(0, ms));
        return t.TotalHours >= 1 ? t.ToString(@"h\:mm\:ss") : t.ToString(@"m\:ss");
    }

    // ── Recorder actions (buttons share the hotkey code paths) ────────────────

    private void ToggleRecording() => OnRecordHotkey();

    private void TogglePlayback()
    {
        if (Recorder.IsReplaying)
        {
            Recorder.StopReplay();
            return;
        }
        OnPlayHotkey();
    }

    private void StopEverything() => OnStopHotkey();

    // NOTE: hotkey callbacks run on the thread pool and may outlive this page instance
    // (registrations are kept across navigation). They must only touch injected singletons
    // and the static state — UI refresh goes through the currently active page instance.
    private void OnRecordHotkey()
    {
        try
        {
            if (Recorder.IsReplaying)
            {
                NotificationService.ShowWarning("Stop playback before recording.");
                return;
            }

            if (Recorder.IsRecording)
            {
                var rec = Recorder.StopRecording();
                if (rec is not null)
                {
                    lock (s_gate)
                    {
                        s_currentRecording = rec;
                        s_loadedName = null;
                    }
                    NotificationService.ShowSuccess($"Recording stopped — {rec.Events.Count} events captured.");
                }
            }
            else
            {
                if (Recorder.StartRecording(GetControlKeyExclusions()))
                    NotificationService.ShowInfo("Recording started — press the record hotkey again to stop.");
                else
                    NotificationService.ShowError("Could not start recording.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Record toggle failed");
        }
        RefreshActivePage();
    }

    private void OnPlayHotkey()
    {
        try
        {
            if (Recorder.IsRecording)
            {
                NotificationService.ShowWarning("Stop recording before playback.");
                return;
            }
            if (Recorder.IsReplaying) return;

            InputRecording? rec;
            double speed;
            lock (s_gate)
            {
                rec = s_currentRecording;
                speed = s_playbackSpeed;
            }
            if (rec is null || rec.Events.Count == 0)
            {
                NotificationService.ShowWarning("Nothing to play — record or load a recording first.");
                return;
            }
            _ = RunReplayAsync(rec, speed);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Play hotkey failed");
        }
        RefreshActivePage();
    }

    private async Task RunReplayAsync(InputRecording rec, double speed)
    {
        try
        {
            var completed = await Recorder.ReplayAsync(rec, speed);
            if (completed) NotificationService.ShowSuccess("Playback finished.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Replay failed");
        }
        RefreshActivePage();
    }

    private void OnStopHotkey()
    {
        try
        {
            var stoppedSomething = false;

            if (Recorder.IsRecording)
            {
                var rec = Recorder.StopRecording();
                if (rec is not null)
                {
                    lock (s_gate)
                    {
                        s_currentRecording = rec;
                        s_loadedName = null;
                    }
                }
                stoppedSomething = true;
            }

            if (Recorder.IsReplaying)
            {
                Recorder.StopReplay();
                stoppedSomething = true;
            }

            if (MacroEngine.Runners.Any(r => r.State != MacroRunnerState.Idle))
            {
                MacroEngine.StopAll();
                stoppedSomething = true;
            }

            if (stoppedSomething)
                NotificationService.ShowInfo("All macros stopped.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Stop-all hotkey failed");
        }
        RefreshActivePage();
    }

    // ── Saved recordings ──────────────────────────────────────────────────────

    private async Task SaveCurrent()
    {
        try
        {
            InputRecording? rec;
            lock (s_gate) { rec = s_currentRecording; }
            if (rec is null || rec.Events.Count == 0)
            {
                NotificationService.ShowWarning("Record something first.");
                return;
            }

            var name = saveName.Trim();
            if (name.Length == 0)
            {
                NotificationService.ShowWarning("Enter a name for the recording.");
                return;
            }

            rec.Name = name;
            if (await Recorder.SaveRecordingAsync(rec))
            {
                NotificationService.ShowSuccess($"Recording '{rec.Name}' saved.");
                lock (s_gate)
                {
                    if (ReferenceEquals(s_currentRecording, rec)) s_loadedName = rec.Name;
                }
                saveName = "";
                savedRecordings = Recorder.ListRecordings();
            }
            else
            {
                NotificationService.ShowError("Could not save the recording.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Save recording failed");
            NotificationService.ShowError("Could not save the recording.");
        }
    }

    private async Task LoadRecording(string name)
    {
        try
        {
            pendingDelete = null;
            var rec = await Recorder.LoadRecordingAsync(name);
            if (rec is null || rec.Events.Count == 0)
            {
                NotificationService.ShowError($"Could not load '{name}'.");
                return;
            }
            lock (s_gate)
            {
                s_currentRecording = rec;
                s_loadedName = name;
            }
            NotificationService.ShowSuccess($"'{name}' loaded — {rec.Events.Count} events.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Load recording '{Name}' failed", name);
            NotificationService.ShowError($"Could not load '{name}'.");
        }
    }

    private void RequestDelete(string name) => pendingDelete = name;

    private void CancelDelete() => pendingDelete = null;

    private void ConfirmDelete(string name)
    {
        try
        {
            pendingDelete = null;
            if (Recorder.DeleteRecording(name))
            {
                NotificationService.ShowInfo($"'{name}' deleted.");
                lock (s_gate)
                {
                    if (s_loadedName == name) s_loadedName = null;
                }
                savedRecordings = Recorder.ListRecordings();
            }
            else
            {
                NotificationService.ShowError($"Could not delete '{name}'.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Delete recording '{Name}' failed", name);
            NotificationService.ShowError($"Could not delete '{name}'.");
        }
    }

    private void SetSpeed(double speed)
    {
        playbackSpeed = speed;
        lock (s_gate) { s_playbackSpeed = speed; }
        try
        {
            Preferences.Set("macros.speed", speed);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Macros save speed failed");
        }
    }

    // ── Fast Transfer ─────────────────────────────────────────────────────────

    private void OnFastTransferHotkey() => ToggleFastTransfer();

    private void ToggleFastTransfer()
    {
        try
        {
            var runner = MacroEngine.GetRunner(FtRunnerName);
            if (runner.State != MacroRunnerState.Idle)
            {
                runner.Stop();
                return;
            }

            if (Recorder.IsRecording || Recorder.IsReplaying)
            {
                NotificationService.ShowWarning("Stop the recorder before running Fast Transfer.");
                return;
            }

            FastTransferSettings settings;
            lock (s_gate) { settings = s_ftSettings; }

            var sequence = FastTransfer.Build(settings);
            if (sequence is null)
            {
                NotificationService.ShowWarning("Calibrate the Transfer All position first.");
                return;
            }
            _ = RunFastTransferAsync(runner, sequence);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fast Transfer toggle failed");
        }
        RefreshActivePage();
    }

    private async Task RunFastTransferAsync(IMacroRunner runner, MacroSequence sequence)
    {
        try
        {
            var completed = await runner.RunAsync(sequence);
            if (completed) NotificationService.ShowSuccess("Fast Transfer completed.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fast Transfer run failed");
        }
        RefreshActivePage();
    }

    private async Task CaptureTransferPoint()
    {
        if (isCapturing || Calibration.IsCapturing) return;
        if (Recorder.IsRecording)
        {
            NotificationService.ShowWarning("Stop recording before calibrating.");
            return;
        }

        isCapturing = true;
        captureCountdown = CaptureCountdownSeconds;
        StateHasChanged();
        try
        {
            var progress = new Progress<int>(s =>
            {
                captureCountdown = s;
                SafeRefresh();
            });
            // The calibration service reads the cursor when the countdown hits zero and
            // shows its own success/error toasts, so no extra notification is needed here.
            await Calibration.CapturePointAsync(FastTransfer.PointName, CaptureCountdownSeconds, progress);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Transfer All point capture failed");
            NotificationService.ShowError("Failed to capture the Transfer All position.");
        }
        finally
        {
            isCapturing = false;
            SafeRefresh();
        }
    }

    // ── Fast Transfer settings ────────────────────────────────────────────────

    private void OnInventoryKeyChanged(ChangeEventArgs e)
    {
        var text = (e.Value?.ToString() ?? "").Trim();
        if (text.Length == 0) return;
        var c = char.ToUpperInvariant(text[^1]);
        if (c is (>= 'A' and <= 'Z') or (>= '0' and <= '9'))
        {
            ftInventoryKey = c.ToString();
            SaveFtSettings();
        }
        else
        {
            NotificationService.ShowWarning("Use a letter or digit for the inventory key.");
        }
    }

    private void OnFtClickCountChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
        {
            ftClickCount = Math.Clamp(v, 1, 50);
            SaveFtSettings();
        }
    }

    private void OnFtOpenDelayChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
        {
            ftOpenDelayMs = Math.Clamp(v, 0, 10000);
            SaveFtSettings();
        }
    }

    private void OnFtClickDelayChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
        {
            ftClickDelayMs = Math.Clamp(v, 0, 5000);
            SaveFtSettings();
        }
    }

    private FastTransferSettings BuildFtSettings()
    {
        var vk = VkFromName(ftInventoryKey);
        return new FastTransferSettings
        {
            InventoryVirtualKey = vk > 0 ? vk : 0x46,
            ClickCount = ftClickCount,
            OpenDelayMs = ftOpenDelayMs,
            PerClickDelayMs = ftClickDelayMs
        };
    }

    // ── Hotkey registration ───────────────────────────────────────────────────

    private void RebindRecordHotkey(string value)
    {
        recordHotkey = ApplyBinding(HotkeySlot.Record, value, recordHotkey);
        SaveHotkeySettings();
    }

    private void RebindPlayHotkey(string value)
    {
        playHotkey = ApplyBinding(HotkeySlot.Play, value, playHotkey);
        SaveHotkeySettings();
    }

    private void RebindStopHotkey(string value)
    {
        stopHotkey = ApplyBinding(HotkeySlot.Stop, value, stopHotkey);
        SaveHotkeySettings();
    }

    private void RebindFtHotkey(string value)
    {
        ftHotkey = ApplyBinding(HotkeySlot.FastTransfer, value, ftHotkey);
        SaveFtSettings();
    }

    private string ApplyBinding(HotkeySlot slot, string requested, string current)
    {
        requested = requested?.Trim() ?? "";
        if (string.Equals(requested, current, StringComparison.OrdinalIgnoreCase)) return current;

        if (requested.Length == 0)
        {
            lock (s_gate) { UnregisterSlot(slot); }
            if (slot == HotkeySlot.Stop)
                NotificationService.ShowWarning("Stop hotkey cleared — running macros can only be stopped from this page now.");
            return "";
        }

        if (!TryParseHotkey(requested, out var vk, out var ctrl, out var alt, out var shift))
        {
            NotificationService.ShowWarning($"'{requested}' is not a supported hotkey.");
            return current;
        }

        bool registered;
        lock (s_gate)
        {
            UnregisterSlot(slot);
            registered = TryRegisterSlot(slot, vk, ctrl, alt, shift);
            if (!registered && TryParseHotkey(current, out var pvk, out var pctrl, out var palt, out var pshift))
                TryRegisterSlot(slot, pvk, pctrl, palt, pshift); // restore the previous binding
        }

        if (!registered)
        {
            NotificationService.ShowWarning($"Could not register '{requested}' — the combination may be in use by another app.");
            return current;
        }

        ActivityService.AddActivity($"Macro hotkey set to {requested}", "info");
        return requested;
    }

    private List<string> EnsureHotkeysRegistered()
    {
        var failures = new List<string>();
        lock (s_gate)
        {
            Ensure(HotkeySlot.Record, recordHotkey, s_recordRegId);
            Ensure(HotkeySlot.Play, playHotkey, s_playRegId);
            Ensure(HotkeySlot.Stop, stopHotkey, s_stopRegId);
            Ensure(HotkeySlot.FastTransfer, ftHotkey, s_ftRegId);
        }
        return failures;

        void Ensure(HotkeySlot slot, string combo, int existingId)
        {
            if (existingId != 0 || string.IsNullOrWhiteSpace(combo)) return;
            if (TryParseHotkey(combo, out var vk, out var ctrl, out var alt, out var shift)
                && TryRegisterSlot(slot, vk, ctrl, alt, shift))
                return;
            failures.Add(combo);
        }
    }

    /// <summary>Registers one slot; caller holds <see cref="s_gate"/>.</summary>
    private bool TryRegisterSlot(HotkeySlot slot, int vk, bool ctrl, bool alt, bool shift)
    {
        var id = Hotkeys.RegisterHotkey(vk, ctrl, alt, shift, CallbackFor(slot));
        if (id == 0) return false;

        // Only unmodified hotkeys are excluded from recordings: for combos like Alt + F the
        // plain key is still normal game input and must stay recordable.
        var exclusionVk = (ctrl || alt || shift) ? 0 : vk;
        switch (slot)
        {
            case HotkeySlot.Record: s_recordRegId = id; s_recordVk = exclusionVk; break;
            case HotkeySlot.Play: s_playRegId = id; s_playVk = exclusionVk; break;
            case HotkeySlot.Stop: s_stopRegId = id; s_stopVk = exclusionVk; break;
            default: s_ftRegId = id; s_ftVk = exclusionVk; break;
        }
        return true;
    }

    /// <summary>Unregisters one slot; caller holds <see cref="s_gate"/>.</summary>
    private void UnregisterSlot(HotkeySlot slot)
    {
        switch (slot)
        {
            case HotkeySlot.Record:
                if (s_recordRegId != 0) Hotkeys.UnregisterHotkey(s_recordRegId);
                s_recordRegId = 0; s_recordVk = 0;
                break;
            case HotkeySlot.Play:
                if (s_playRegId != 0) Hotkeys.UnregisterHotkey(s_playRegId);
                s_playRegId = 0; s_playVk = 0;
                break;
            case HotkeySlot.Stop:
                if (s_stopRegId != 0) Hotkeys.UnregisterHotkey(s_stopRegId);
                s_stopRegId = 0; s_stopVk = 0;
                break;
            default:
                if (s_ftRegId != 0) Hotkeys.UnregisterHotkey(s_ftRegId);
                s_ftRegId = 0; s_ftVk = 0;
                break;
        }
    }

    private Action CallbackFor(HotkeySlot slot) => slot switch
    {
        HotkeySlot.Record => OnRecordHotkey,
        HotkeySlot.Play => OnPlayHotkey,
        HotkeySlot.Stop => OnStopHotkey,
        _ => OnFastTransferHotkey
    };

    private static IReadOnlyCollection<int> GetControlKeyExclusions()
    {
        lock (s_gate)
        {
            var keys = new List<int>(4);
            if (s_recordVk > 0) keys.Add(s_recordVk);
            if (s_playVk > 0) keys.Add(s_playVk);
            if (s_stopVk > 0) keys.Add(s_stopVk);
            if (s_ftVk > 0) keys.Add(s_ftVk);
            return keys;
        }
    }

    // ── Hotkey parsing (HotkeyField emits "Ctrl + Alt + F8"-style combos) ─────

    private static bool TryParseHotkey(string combo, out int vk, out bool ctrl, out bool alt, out bool shift)
    {
        vk = 0;
        ctrl = alt = shift = false;
        if (string.IsNullOrWhiteSpace(combo)) return false;

        string? keyPart = null;
        foreach (var raw in combo.Split('+'))
        {
            var part = raw.Trim();
            if (part.Length == 0) return false;
            switch (part.ToUpperInvariant())
            {
                case "CTRL":
                case "CONTROL":
                    ctrl = true;
                    break;
                case "ALT":
                    alt = true;
                    break;
                case "SHIFT":
                    shift = true;
                    break;
                case "WIN":
                case "META":
                    return false; // Win-key combos are not supported by the hotkey service
                default:
                    if (keyPart is not null) return false;
                    keyPart = part;
                    break;
            }
        }

        if (keyPart is null) return false;
        vk = VkFromName(keyPart);
        return vk > 0;
    }

    private static int VkFromName(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return 0;
        var key = name.Trim().ToUpperInvariant();

        if (key.Length == 1)
        {
            var c = key[0];
            if (c is (>= 'A' and <= 'Z') or (>= '0' and <= '9')) return c;
            return c switch
            {
                ';' => 0xBA,
                '=' => 0xBB,
                ',' => 0xBC,
                '-' => 0xBD,
                '.' => 0xBE,
                '/' => 0xBF,
                '`' => 0xC0,
                '[' => 0xDB,
                '\\' => 0xDC,
                ']' => 0xDD,
                '\'' => 0xDE,
                _ => 0
            };
        }

        if (key[0] == 'F' && int.TryParse(key.AsSpan(1), out var f) && f is >= 1 and <= 24)
            return 0x70 + (f - 1);

        return key switch
        {
            "SPACE" => 0x20,
            "ENTER" => 0x0D,
            "TAB" => 0x09,
            "UP" => 0x26,
            "DOWN" => 0x28,
            "LEFT" => 0x25,
            "RIGHT" => 0x27,
            "HOME" => 0x24,
            "END" => 0x23,
            "PAGEUP" => 0x21,
            "PAGEDOWN" => 0x22,
            "INSERT" => 0x2D,
            "PAUSE" => 0x13,
            "CAPSLOCK" => 0x14,
            "NUMLOCK" => 0x90,
            "SCROLLLOCK" => 0x91,
            _ => 0
        };
    }

    // ── Settings persistence ──────────────────────────────────────────────────

    private void LoadSettings()
    {
        try
        {
            recordHotkey = Preferences.Get("macros.hotkey.record", recordHotkey);
            playHotkey = Preferences.Get("macros.hotkey.play", playHotkey);
            stopHotkey = Preferences.Get("macros.hotkey.stop", stopHotkey);
            playbackSpeed = Preferences.Get("macros.speed", playbackSpeed);
            ftInventoryKey = Preferences.Get("macros.ft.invkey", ftInventoryKey);
            ftClickCount = Preferences.Get("macros.ft.clicks", ftClickCount);
            ftOpenDelayMs = Preferences.Get("macros.ft.opendelay", ftOpenDelayMs);
            ftClickDelayMs = Preferences.Get("macros.ft.clickdelay", ftClickDelayMs);
            ftHotkey = Preferences.Get("macros.ft.hotkey", ftHotkey);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Macros LoadSettings failed");
        }
    }

    private void SaveHotkeySettings()
    {
        try
        {
            Preferences.Set("macros.hotkey.record", recordHotkey);
            Preferences.Set("macros.hotkey.play", playHotkey);
            Preferences.Set("macros.hotkey.stop", stopHotkey);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Macros SaveHotkeySettings failed");
        }
    }

    private void SaveFtSettings()
    {
        try
        {
            Preferences.Set("macros.ft.invkey", ftInventoryKey);
            Preferences.Set("macros.ft.clicks", ftClickCount);
            Preferences.Set("macros.ft.opendelay", ftOpenDelayMs);
            Preferences.Set("macros.ft.clickdelay", ftClickDelayMs);
            Preferences.Set("macros.ft.hotkey", ftHotkey);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Macros SaveFtSettings failed");
        }
        lock (s_gate) { s_ftSettings = BuildFtSettings(); }
    }

    // ── UI refresh plumbing ───────────────────────────────────────────────────

    private void OnRecorderStateChanged() => SafeRefresh();

    private void OnEventCaptured(int count)
    {
        var now = Environment.TickCount64;
        if (now - lastEventRefreshTick < EventRefreshThrottleMs) return;
        lastEventRefreshTick = now;
        SafeRefresh();
    }

    private void OnFtStateChanged(MacroRunnerState state) => SafeRefresh();

    private void OnFtStepStarted(int stepIndex, int loop) => SafeRefresh();

    private void OnUiTimer(object? sender, System.Timers.ElapsedEventArgs e)
    {
        if (!(Recorder.IsRecording || Recorder.IsReplaying || isCapturing || FtBusy)) return;
        SafeRefresh();
    }

    private void SafeRefresh()
    {
        try
        {
            _ = InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Component may be tearing down — a missed refresh is harmless.
        }
    }

    private static void RefreshActivePage()
    {
        Macros? page;
        lock (s_gate) { page = s_active; }
        if (page is null) return;
        try
        {
            _ = page.InvokeAsync(page.StateHasChanged);
        }
        catch
        {
            // The page may have been disposed between the lookup and the invoke.
        }
    }
}
