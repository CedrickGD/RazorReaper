@page "/account"
@using RazorReaper.Services
@using RazorReaper.Services.Implementations
@using Microsoft.AspNetCore.Components.Forms
@using RazorReaper.Services.Localization
@inject ICustomerAccountService Accounts
@inject INotificationService Notifications
@inject ILicenseService License
@inject IClientIdentityService Identity
@inject ILicenseOverlayService LicenseOverlay
@inject ILocalizer Localizer
@inject IJSRuntime JS
@implements IDisposable

<header class="page-header">
    <h1 class="page-title">@Localizer.T("account.title")</h1>
    <p class="page-subtitle">@Localizer.T("account.subtitle")</p>
</header>
<div class="account-page">
    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="account-notice" role="alert">@_error</p>
    }
    @if (_loading)
    {
        <section class="content-card"><p>@Localizer.T("account.loading")</p></section>
    }
    else if (Accounts.Profile is { } profile)
    {
        <section class="content-card account-profile-card">
            <div class="account-photo">
                @if (!string.IsNullOrEmpty(_avatar ?? profile.Avatar) && !_removeAvatar)
                {
                    <img src="@(_avatar ?? profile.Avatar)" alt="@Localizer.T("account.avatar.alt")" />
                }
                else { <span>@profile.DisplayName[..1].ToUpperInvariant()</span> }
            </div>
            <div class="account-profile-fields">
                <h3>@Localizer.T("account.profile.title")</h3>
                <p>@Localizer.T("account.profile.description")</p>
                <label for="account-name">@Localizer.T("account.displayname")</label>
                <input id="account-name" class="account-input" @bind="_name" maxlength="60" disabled="@_busy" />
                <div class="account-actions">
                    <label class="rr-pill-btn ghost account-file">@Localizer.T("account.choosepicture")<InputFile OnChange="ChooseAvatar" accept="image/png,image/jpeg,image/webp" disabled="@_busy" /></label>
                    <button class="rr-pill-btn ghost" @onclick="RemoveAvatar" disabled="@_busy">@Localizer.T("account.usediscordpicture")</button>
                    <button class="rr-pill-btn" @onclick="SaveProfile" disabled="@_busy">@(_busy ? Localizer.T("account.saving") : Localizer.T("account.saveprofile"))</button>
                </div>
                <p class="account-hint">@Localizer.T("account.picture.hint")</p>
            </div>
        </section>
        <section class="content-card">
            <h3>@Localizer.T("account.connected.title")</h3>
            <div class="account-row"><span>Discord</span><strong>@@@profile.DiscordUsername</strong><span>@Localizer.T("account.row.connected")</span></div>
            <div class="account-row"><span>@Localizer.T("account.row.installation")</span><strong>RazorReaper</strong><span>@Localizer.T("account.row.linked")</span></div>
            @* There is nothing to "manage": the overlay shows the licence and, on the free tier,
               takes a key. So the button says which of the two this click is, and the free tier
               gets the way to buy one next to it. *@
            <div class="account-row"><span>@Localizer.T("account.row.license")</span><strong>@(License.IsActivated ? Localizer.T("account.license.active") : Localizer.T("account.license.free"))</strong><span class="account-actions">@if (License.IsActivated)
                {
                    <button type="button" class="rr-pill-btn ghost sm" aria-haspopup="dialog" @onclick="OpenLicenseOverlay">@Localizer.T("account.viewlicense")</button>
                }
                else
                {
                    <button type="button" class="rr-pill-btn ghost sm" aria-haspopup="dialog" @onclick="OpenLicenseOverlay">@Localizer.T("account.redeemkey")</button>
                    <a class="rr-pill-btn ghost sm" href="@StoreLinks.Store" target="_blank" rel="noopener">@Localizer.T("account.buypremium")</a>
                }</span></div>
            <p class="account-hint">@Localizer.T("account.connected.hint")</p>
        </section>
        <section class="content-card">
            <h3>@Localizer.T("account.installations.title")</h3>
            @foreach (var device in Accounts.Devices)
            {
                <div class="account-row"><strong>@(device.InstallId == Identity.GetIdentity().InstallId ? Localizer.T("account.device.this") : Localizer.T("account.device.other"))</strong><span>@Localizer.T("account.device.version", device.AppVersion ?? Localizer.T("account.device.unknownversion"))</span><span>@(device.SignedIn == 1 ? Localizer.T("account.device.signedin") : Localizer.T("account.device.signedout"))</span></div>
            }
            @if (_confirmSignOut)
            {
                <div class="account-notice"><p>@Localizer.T("account.signout.confirm")</p><div class="account-actions"><button class="rr-pill-btn ghost" @onclick="() => _confirmSignOut = false" disabled="@_busy">@Localizer.T("account.signout.stay")</button><button class="rr-pill-btn" @onclick="SignOut" disabled="@_busy">@Localizer.T("account.signout")</button></div></div>
            }
            else { <button class="rr-pill-btn ghost" @onclick="() => _confirmSignOut = true" disabled="@_busy">@Localizer.T("account.signout")</button> }
        </section>
    }
    else
    {
        <section class="content-card account-signin">
            <div class="account-welcome">
                <img class="account-brand" src="images/RRlogo.png" alt="RazorReaper" />
                <h2>@Localizer.T("account.welcome.line1")<br />@Localizer.T("account.welcome.line2")</h2>
                <p>@Localizer.T("account.welcome.text")</p>
                <div class="account-actions"><button class="rr-pill-btn primary" @onclick="OpenSignIn" disabled="@_busy">@Localizer.T("account.create")</button><button class="rr-pill-btn" @onclick="OpenSignIn" disabled="@_busy">@Localizer.T("account.signin")</button></div>
            </div>
            <div class="account-benefits">
                <div><span aria-hidden="true">01</span><div><h3>@Localizer.T("account.benefit.1.title")</h3><p>@Localizer.T("account.benefit.1.text")</p></div></div>
                <div><span aria-hidden="true">02</span><div><h3>@Localizer.T("account.benefit.2.title")</h3><p>@Localizer.T("account.benefit.2.text")</p></div></div>
                <div><span aria-hidden="true">03</span><div><h3>@Localizer.T("account.benefit.3.title")</h3><p>@Localizer.T("account.benefit.3.text")</p></div></div>
            </div>
        </section>
    }
</div>

<dialog @ref="_dialog" class="account-auth-dialog" aria-labelledby="account-auth-title">
    <button class="account-dialog-close" aria-label="@Localizer.T("account.dialog.close")" @onclick="CancelSignIn" disabled="@_busy"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
    <div class="account-auth-brand"><img src="images/RRlogo.png" alt="RazorReaper" /><span aria-hidden="true">↔</span><strong>Discord</strong></div>
    <h2 id="account-auth-title">@(_candidate is null ? Localizer.T("account.dialog.title.connect") : Localizer.T("account.dialog.title.isthisyou"))</h2>
    @if (!string.IsNullOrEmpty(_error)) { <p class="account-notice" role="alert">@_error</p> }
            @if (_candidate is { } candidate)
            {
                @if (!string.IsNullOrEmpty(candidate.Avatar)) { <img class="account-candidate-photo" src="@candidate.Avatar" alt="@Localizer.T("account.dialog.avatar.alt")" /> }
                <h3>@candidate.DisplayName</h3><p>@@@candidate.DiscordUsername</p>
                <div class="account-actions"><button class="rr-pill-btn primary" @onclick="ConfirmSignIn" disabled="@_busy">@Localizer.T("account.dialog.continueas", candidate.DisplayName)</button><button class="rr-pill-btn ghost" @onclick="CancelSignIn" disabled="@_busy">@Localizer.T("common.cancel")</button></div>
            }
            else if (_login is { } login)
            {
                <p>@Localizer.T("account.dialog.codematch")</p>
                <strong class="account-code">@login.UserCode</strong>
                <p class="account-waiting"><i aria-hidden="true"></i>@Localizer.T("account.dialog.waiting")</p>
                <p>@Localizer.T("account.dialog.approve")</p>
                <div class="account-actions"><button class="rr-pill-btn" @onclick="ReopenBrowser">@Localizer.T("account.dialog.reopen")</button><button class="rr-pill-btn ghost" @onclick="CancelSignIn">@Localizer.T("common.cancel")</button></div>
            }
            else
            {
                <p>@Localizer.T("account.dialog.intro")</p>
                <ul class="account-permissions"><li>@Localizer.T("account.dialog.perm.1")</li><li>@Localizer.T("account.dialog.perm.2")</li><li>@Localizer.T("account.dialog.perm.3")</li></ul>
                <p class="account-hint">@Localizer.T("account.dialog.hint")</p>
                <div class="account-actions"><button class="rr-pill-btn primary" @onclick="BeginSignIn" disabled="@_busy">@(_busy ? Localizer.T("account.dialog.connecting") : Localizer.T("account.dialog.continue"))</button><button class="rr-pill-btn ghost" @onclick="CancelSignIn" disabled="@_busy">@Localizer.T("common.cancel")</button></div>
            }
</dialog>

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _poll;
    private CustomerAccountLogin? _login;
    private CustomerAccountProfile? _candidate;
    private ElementReference _dialog;
    private IJSObjectReference? _dialogModule;
    private DotNetObjectReference<Account>? _dialogOwner;
    private bool _authOpen;
    private string _name = "";
    private string? _avatar, _error;
    private bool _loading = true, _busy, _removeAvatar, _confirmSignOut;
    protected override async Task OnInitializedAsync()
    {
        await Execute(async () => { await Accounts.RefreshAsync(_lifetime.Token); LoadProfile(); });
        _loading = false;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_authOpen && _dialogModule is null) return;
        _dialogModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/account-dialog.js");
        _dialogOwner ??= DotNetObjectReference.Create(this);
        await _dialogModule.InvokeVoidAsync("setOpen", _dialog, _authOpen, _dialogOwner);
    }
    private void OpenSignIn() { _error = null; _authOpen = true; }
    // The license facts live in the full-window overlay MainLayout mounts — the same one the
    // sidebar tier button opens. Home has not carried the licence widget since da6e216, so the
    // link this button replaced landed on a page with nothing to manage.
    private void OpenLicenseOverlay() => LicenseOverlay.Open();
    [JSInvokable] public Task CloseAuthDialog() { if (!_busy) CancelSignIn(); return InvokeAsync(StateHasChanged); }
    private Task ReopenBrowser() => Execute(async () => { if (_login is not null) await Launcher.Default.OpenAsync(_login.VerificationUrl); });
    private void LoadProfile() { _name = Accounts.Profile?.DisplayName ?? ""; _avatar = null; _removeAvatar = false; }
    private async Task Execute(Func<Task> operation)
    {
        if (_busy) return;
        _busy = true; _error = null;
        try { await operation(); }
        catch (OperationCanceledException) { if (!_lifetime.IsCancellationRequested) _error = Localizer.T("account.error.timeout"); }
        catch (Exception ex) { _error = ex is InvalidOperationException ? ex.Message : Localizer.T("account.error.unreachable"); }
        finally { _busy = false; }
    }
    private Task BeginSignIn() => Execute(async () => {
        _login = await Accounts.BeginSignInAsync(_lifetime.Token);
        var launched = await Launcher.Default.OpenAsync(_login.VerificationUrl);
        if (!launched) { _login = null; throw new InvalidOperationException(Localizer.T("account.error.browser")); }
        // Cancel without disposing: the previous Poll may still hold this token, and a disposed
        // source turns its next Task.Delay into an ObjectDisposedException nobody observes.
        _poll?.Cancel();
        _poll = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _ = Poll(_login, _poll.Token);
    });
    private async Task Poll(CustomerAccountLogin login, CancellationToken ct)
    {
        var deadline = DateTimeOffset.UtcNow.AddSeconds(login.ExpiresIn);
        try
        {
            while (DateTimeOffset.UtcNow < deadline)
            {
                await Task.Delay(3000, ct);
                var candidate = await Accounts.PollSignInAsync(login.RequestId, ct);
                if (candidate is null) continue;
                await InvokeAsync(() => { _candidate = candidate; StateHasChanged(); });
                return;
            }
            await InvokeAsync(() => { _login = null; _error = Localizer.T("account.error.expired"); StateHasChanged(); });
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        // This loop is started with `_ = Poll(...)`, so the handler itself must not be able to
        // fault — an awaited dispatch here is exactly the teardown case that would.
        catch (ObjectDisposedException) { }
        catch (Exception ex)
        {
            var message = ex is InvalidOperationException ? ex.Message : Localizer.T("account.error.interrupted");
            this.DispatchRender(() => InvokeAsync(() => { _login = null; _error = message; StateHasChanged(); }));
        }
    }
    private void CancelSignIn() { _poll?.Cancel(); _candidate = null; _login = null; _authOpen = false; }
    private Task ConfirmSignIn() => Execute(async () => {
        if (_login is null) return;
        await Accounts.ConfirmSignInAsync(_login.RequestId, _lifetime.Token);
        CancelSignIn(); LoadProfile(); Notifications.ShowSuccess(Localizer.T("account.connected.toast"));
    });
    private Task ChooseAvatar(InputFileChangeEventArgs args) => Execute(async () => {
        await using var stream = args.File.OpenReadStream(8 * 1024 * 1024, _lifetime.Token);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory, _lifetime.Token);
        _avatar = await Task.Run(() => AccountAvatar.Create(memory.ToArray()), _lifetime.Token);
        _removeAvatar = false;
    });
    private void RemoveAvatar() { _avatar = null; _removeAvatar = true; }
    private Task SaveProfile() => Execute(async () => {
        // CDN URLs are never sent back as custom uploads; null restores the verified Discord picture.
        var avatar = _removeAvatar ? null : _avatar ?? (Accounts.Profile?.Avatar?.StartsWith("data:image/", StringComparison.Ordinal) == true ? Accounts.Profile.Avatar : null);
        await Accounts.SaveProfileAsync(_name, avatar, _lifetime.Token);
        LoadProfile(); Notifications.ShowSuccess(Localizer.T("account.saved.toast"));
    });
    private Task SignOut() => Execute(async () => { await Accounts.SignOutAsync(_lifetime.Token); _confirmSignOut = false; });
    public void Dispose()
    {
        this.StopRenderDispatch();
        // Cancel but do not dispose — Poll may still be holding both tokens.
        _lifetime.Cancel(); _poll?.Cancel();
        _dialogOwner?.Dispose();
        // Tearing down a JS module reference throws JSDisconnectedException once the WebView has
        // gone, and a discarded ValueTask carries that straight to the finalizer.
        if (_dialogModule is not null) _ = DisposeDialogModuleAsync(_dialogModule);
        _dialogModule = null;
    }

    // Catches everything, so the discard above cannot become an unobserved fault.
    private static async Task DisposeDialogModuleAsync(IJSObjectReference module)
    {
        try { await module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (Exception ex) { Serilog.Log.Debug(ex, "Account dialog module disposal failed"); }
    }
}
