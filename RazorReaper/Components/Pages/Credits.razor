</div>

@code {
    private void OpenDiscordServer()
    {
        try { Process.Start(new ProcessStartInfo { FileName = "http://discord.gg/TZJm7Rg53d", UseShellExecute = true }); } catch { }
    }

    private void OpenDiscordProfile()
    {
        try { Process.Start(new ProcessStartInfo { FileName = "https://discord.com", UseShellExecute = true }); } catch { }
    }

    private void OpenYouTube()
    {
        try { Process.Start(new ProcessStartInfo { FileName = "https://youtube.com/@ISG_3332", UseShellExecute = true }); } catch { }
    }

    private void OpenGitHub()
    {
        try { Process.Start(new ProcessStartInfo { FileName = "https://github.com/lappen123test", UseShellExecute = true }); } catch { }
    }
}
