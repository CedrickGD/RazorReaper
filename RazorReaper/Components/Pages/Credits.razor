@page "/credits"
@using System.Diagnostics
@using Microsoft.Extensions.Logging
@using RazorReaper.Services
@inject INotificationService NotificationService
@inject ILogger<Credits> Logger

<header class="page-header">
    <h1 class="page-title">Credits</h1>
    <p class="page-subtitle">Developer, community, and tools behind RazorReaper.</p>
</header>

<div class="credits-page">

    @* ── Developer ── *@
    <section class="content-card credits-section cr-dev-card">
        <div class="cr-dev-row">
            <div class="cr-avatar">
                <svg viewBox="0 0 120 120" fill="none" stroke-width="5" style="stroke: var(--accent-purple)">
                    <circle cx="60" cy="60" r="57" />
                    <circle cx="60" cy="45" r="16" />
                    <path d="M33 95c0-15 12-24 27-24s27 9 27 24" stroke-linecap="round" />
                </svg>
            </div>
            <div class="cr-dev-info">
                <h2 class="cr-dev-name">itssomeguy.</h2>
                <span class="cr-dev-role">ARK: Survival Evolved Tools Developer</span>
            </div>
        </div>
        <div class="cr-links-row">
            <button class="cr-link-btn discord" @onclick="OpenDiscordProfile">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419-.0002 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9554 2.4189-2.1568 2.4189Z"/></svg>
                <span>itssomeguy.</span>
            </button>
            <button class="cr-link-btn youtube" @onclick="OpenYouTube">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                <span>YouTube</span>
            </button>
        </div>
    </section>

    @* ── Community / Feedback ── *@
    <section class="content-card credits-section cr-community-card">
        <div class="cr-community-inner">
            <div class="cr-community-text">
                <h3>Community & Support</h3>
                <p>Describe the problem in your in-app report. System and feature context is attached automatically when you send it. Discord remains available for community chat.</p>
            </div>
            <SendDiagnosticsButton SourceRoute="credits" />
            <button class="cr-discord-join" @onclick="OpenDiscordServer">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419-.0002 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9554 2.4189-2.1568 2.4189Z"/></svg>
                Join RazorReaper Discord
            </button>
        </div>
    </section>

    @* ── Technologies ── *@
    <section class="content-card credits-section">
        <h3 class="cr-section-label">Built With</h3>
        <div class="cr-tech-row">
            <a href="https://dotnet.microsoft.com/en-us/apps/aspnet/web-apps/blazor" target="_blank" class="cr-tech">C# Blazor</a>
            <a href="https://dotnet.microsoft.com/en-us/apps/aspnet" target="_blank" class="cr-tech">ASP.NET Core</a>
            <a href="https://developer.mozilla.org/en-US/docs/Web/JavaScript" target="_blank" class="cr-tech">JavaScript</a>
            <a href="https://developer.mozilla.org/en-US/docs/Web/HTML" target="_blank" class="cr-tech">HTML5</a>
            <a href="https://developer.mozilla.org/en-US/docs/Web/CSS" target="_blank" class="cr-tech">CSS3</a>
        </div>
    </section>

    @* ── Help ── *@
    <section class="content-card credits-section cr-help-card">
        <h3 class="cr-section-label">Need Help?</h3>
        <p class="cr-help-text">Found a bug or need assistance? In-app diagnostics give support the details needed to investigate; use Discord for follow-up conversation.</p>
        <div class="cr-help-tags">
            <span class="cr-tag">Discord: itssomeguy.</span>
            <span class="cr-tag">In-App Feedback</span>
            <span class="cr-tag">Bug Reports</span>
        </div>
    </section>

</div>

@code {
    private void OpenDiscordServer() => OpenExternalUrl("http://discord.gg/TZJm7Rg53d", "Discord server");
    private void OpenDiscordProfile() => OpenExternalUrl("https://discord.com", "Discord");
    private void OpenYouTube() => OpenExternalUrl("https://youtube.com/@ISG_3332", "YouTube");

    private void OpenExternalUrl(string url, string label)
    {
        try
        {
            using var _ = Process.Start(new ProcessStartInfo { FileName = url, UseShellExecute = true });
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to open external URL '{Label}': {Url}", label, url);
            NotificationService.ShowError($"Could not open {label}. Check your default browser settings.");
        }
    }
}
