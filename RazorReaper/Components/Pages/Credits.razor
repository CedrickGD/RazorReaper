    @* ── Help ── *@
    <section class="cr-card cr-help-card">
        <h3 class="cr-section-label">Need Help?</h3>
        <p class="cr-help-text">Found a bug or need assistance? Reach out on Discord or open an issue on GitHub.</p>
        <div class="cr-help-tags">
            <span class="cr-tag">Discord: itssomeguy.</span>
            <span class="cr-tag">GitHub Issues</span>
            <span class="cr-tag">Bug Reports</span>
