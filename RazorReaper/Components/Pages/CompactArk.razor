@page "/compact-ark"
@using Microsoft.Extensions.Logging
@using Microsoft.Maui.Storage
@using RazorReaper.Services
@using RazorReaper.Components.Shared
@implements IDisposable
@inject ICompactArkService CompactArkService
@inject INotificationService NotificationService
@inject IActivityService ActivityService
@inject ILogger<CompactArk> Logger
@using RazorReaper.Services.Localization
@inject ILocalizer Localizer

<header class="page-header">
    <h1 class="page-title">@Localizer.T("nav.page.compact-ark")</h1>
    <p class="page-subtitle">@Localizer.T("compact.subtitle")</p>
</header>

<div class="compact-ark-page">

    <div class="content-card">
        <StatusHeader State="@StatusState" Label="@StatusLabel" Description="@StatusDescription">
            <Actions>
                <button class="btn btn-secondary" @onclick="RunAnalysisAsync" disabled="@(isAnalyzing || IsBusy)">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="compact-ark-btn-icon">
                        <path d="M16.5 10a6.5 6.5 0 1 1-1.9-4.6" />
                        <path d="M16.5 2.5v3h-3" />
                    </svg>
                    @Localizer.T(isAnalyzing ? "compact.analyzing" : "compact.analyze")
                </button>
            </Actions>
        </StatusHeader>

        @if (isAnalyzing)
        {
            <div class="compact-ark-scan-note">
                @Localizer.T("compact.scanning", filesScanned.ToString("N0"), FormatBytes(scannedLogicalBytes))
            </div>
        }

        <div class="compact-ark-stats">
            <div class="compact-ark-stat">
                <div class="compact-ark-stat-label">@Localizer.T("compact.stat.logical")</div>
                <div class="compact-ark-stat-value">@(HasStats ? FormatBytes(logicalBytes) : "—")</div>
                <div class="compact-ark-stat-sub">@Localizer.T("compact.stat.logical.sub")</div>
            </div>
            <div class="compact-ark-stat">
                <div class="compact-ark-stat-label">@Localizer.T("compact.stat.ondisk")</div>
                <div class="compact-ark-stat-value">@(HasStats ? FormatBytes(onDiskBytes) : "—")</div>
                <div class="compact-ark-stat-sub">@Localizer.T("compact.stat.ondisk.sub")</div>
            </div>
            <div class="compact-ark-stat accent">
                <div class="compact-ark-stat-label">@Localizer.T("compact.stat.saved")</div>
                <div class="compact-ark-stat-value">@(HasStats ? FormatBytes(SavedBytes) : "—")</div>
                <div class="compact-ark-stat-sub">@(HasStats ? Localizer.T("compact.stat.saved.sub", SavedPercent.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)) : Localizer.T("compact.stat.saved.sub.none"))</div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(lastAnalyzedLabel) && !isAnalyzing)
        {
            <div class="compact-ark-analyzed-note">@Localizer.T("compact.lastanalyzed", lastAnalyzedLabel)</div>
        }
    </div>

    <div class="content-card">
        <h3>@Localizer.T("compact.actions")</h3>

        <div class="compact-ark-actions">
            <SettingRow Title="@Localizer.T("compact.compress.title")"
                        Description="@Localizer.T("compact.compress.description")"
                        Disabled="@(!CanStart)">
                <button class="btn btn-primary" @onclick="() => RequestOperation(true)" disabled="@(!CanStart)">
                    @Localizer.T("compact.button.compress")
                </button>
            </SettingRow>

            <SettingRow Title="@Localizer.T("compact.uncompress.title")"
                        Description="@Localizer.T("compact.uncompress.description")"
                        Disabled="@(!CanStart)">
                <button class="btn btn-secondary" @onclick="() => RequestOperation(false)" disabled="@(!CanStart)">
                    @Localizer.T("compact.button.uncompress")
                </button>
            </SettingRow>
        </div>

        @if (pendingCompress != null)
        {
            <div class="compact-ark-confirm">
                <div class="compact-ark-confirm-text">
                    @if (pendingCompress == true)
                    {
                        <strong>@Localizer.T("compact.confirm.compress")</strong>
                        <span>
                            @Localizer.T("compact.confirm.compress.text", totalFiles.ToString("N0"), FormatBytes(logicalBytes))
                        </span>
                    }
                    else
                    {
                        <strong>@Localizer.T("compact.confirm.uncompress")</strong>
                        <span>
                            @Localizer.T("compact.confirm.uncompress.text", totalFiles.ToString("N0"), FormatBytes(logicalBytes))
                        </span>
                    }
                </div>
                <div class="compact-ark-confirm-buttons">
                    <button class="btn btn-primary" @onclick="ConfirmOperationAsync">@Localizer.T("compact.start")</button>
                    <button class="btn btn-secondary" @onclick="CancelConfirm">@Localizer.T("common.cancel")</button>
                </div>
            </div>
        }

        @if (IsBusy)
        {
            <div class="compact-ark-progress">
                <div class="compact-ark-progress-head">
                    <span class="compact-ark-progress-label">
                        @Localizer.T(activeOperation == "compress" ? "compact.progress.compressing" : "compact.progress.uncompressing")
                        @Localizer.T("compact.progress.files", opFilesDone.ToString("N0"), opTotalFiles.ToString("N0"))
                    </span>
                    <span class="compact-ark-progress-percent">@($"{ProgressPercent:0}")%</span>
                </div>
                <div class="compact-ark-progress-bar">
                    <div class="compact-ark-progress-fill" style="width: @ProgressPercentCss%"></div>
                </div>
                @if (!string.IsNullOrEmpty(opCurrentFile))
                {
                    <div class="compact-ark-current-file" title="@opCurrentFile">@opCurrentFile</div>
                }
                <div class="compact-ark-progress-actions">
                    <button class="btn btn-danger" @onclick="CancelOperation" disabled="@cancelRequested">
                        @Localizer.T(cancelRequested ? "compact.cancelling" : "common.cancel")
                    </button>
                </div>
            </div>
        }
    </div>

    <div class="content-card compact-ark-warning-card">
        <div class="compact-ark-warning-header">
            <div class="compact-ark-warning-icon">
                <svg viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.721-1.36 3.486 0l5.58 9.92c.75 1.334-.214 2.98-1.743 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
            </div>
            <h3>@Localizer.T("compact.before.title")</h3>
        </div>
        <ul class="compact-ark-warning-list">
            <li>@Localizer.T("compact.before.1")</li>
            <li>@Localizer.T("compact.before.2")</li>
        </ul>
    </div>

</div>

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    private const string PrefLogical = "compactark.logical";
    private const string PrefOnDisk = "compactark.ondisk";
    private const string PrefFiles = "compactark.files";
    private const string PrefState = "compactark.state";
    private const string PrefAnalyzedAt = "compactark.analyzedat";

    private CompactArkAnalysis? analysis;
    private bool isAnalyzing;
    private bool autoAnalysisStarted;

    // Persisted / last-known stats shown in the stats card.
    private long logicalBytes;
    private long onDiskBytes;
    private int totalFiles;
    private CompactArkState state = CompactArkState.Unknown;
    private string? installPath;
    private string? lastAnalyzedLabel;

    // Live analysis progress.
    private int filesScanned;
    private long scannedLogicalBytes;

    // Operation state. activeOperation: null | "compress" | "uncompress".
    private string? activeOperation;
    private bool? pendingCompress;
    private bool cancelRequested;
    private int opFilesDone;
    private int opTotalFiles;
    private string? opCurrentFile;

    private CancellationTokenSource? analysisCts;
    private CancellationTokenSource? operationCts;

    private bool IsBusy => activeOperation != null;
    private bool HasStats => logicalBytes > 0;
    private long SavedBytes => Math.Max(0, logicalBytes - onDiskBytes);
    private double SavedPercent => logicalBytes > 0 ? (1.0 - (double)onDiskBytes / logicalBytes) * 100.0 : 0;
    private double ProgressPercent => opTotalFiles > 0 ? Math.Min(100.0, opFilesDone * 100.0 / opTotalFiles) : 0;

    // Invariant culture so the inline CSS width never gets a decimal comma.
    private string ProgressPercentCss =>
        ProgressPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private bool CanStart =>
        !isAnalyzing
        && !IsBusy
        && pendingCompress == null
        && analysis is { InstallFound: true, IsNtfs: true, IsGameRunning: false };

    private string StatusState
    {
        get
        {
            if (IsBusy || isAnalyzing) return "warning";
            if (analysis == null) return state == CompactArkState.Compacted ? "online" : "off";
            if (!analysis.InstallFound || !analysis.IsNtfs) return "error";
            if (analysis.IsGameRunning) return "warning";
            return state switch
            {
                CompactArkState.Compacted => "online",
                CompactArkState.PartiallyCompacted => "warning",
                _ => "off"
            };
        }
    }

    private string StatusLabel
    {
        get
        {
            if (activeOperation == "compress") return Localizer.T("compact.progress.compressing");
            if (activeOperation == "uncompress") return Localizer.T("compact.progress.uncompressing");
            if (isAnalyzing) return Localizer.T("compact.status.analyzing");
            if (analysis != null && !analysis.InstallFound) return Localizer.T("compact.status.notfound");
            if (analysis != null && !analysis.IsNtfs) return Localizer.T("compact.status.notntfs", analysis.DriveFormat ?? Localizer.T("common.unknown"));
            if (analysis is { IsGameRunning: true }) return Localizer.T("compact.status.running");
            return state switch
            {
                CompactArkState.Compacted => Localizer.T("compact.state.compacted"),
                CompactArkState.PartiallyCompacted => Localizer.T("compact.state.partial"),
                CompactArkState.NotCompacted => Localizer.T("compact.state.not"),
                _ => Localizer.T("common.unknown")
            };
        }
    }

    private string StatusDescription
    {
        get
        {
            if (analysis != null && !analysis.InstallFound)
                return Localizer.T("compact.description.notfound");
            if (analysis != null && !analysis.IsNtfs)
                return Localizer.T("compact.description.notntfs");
            if (analysis is { IsGameRunning: true })
                return Localizer.T("compact.description.running");
            return installPath ?? Localizer.T("compact.description.idle");
        }
    }

    protected override void OnInitialized()
    {
        LoadPersistedStats();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !autoAnalysisStarted)
        {
            autoAnalysisStarted = true;
            await RunAnalysisAsync();
        }
    }

    private void LoadPersistedStats()
    {
        try
        {
            logicalBytes = Preferences.Get(PrefLogical, 0L);
            onDiskBytes = Preferences.Get(PrefOnDisk, 0L);
            totalFiles = Preferences.Get(PrefFiles, 0);
            state = (CompactArkState)Preferences.Get(PrefState, (int)CompactArkState.Unknown);
            lastAnalyzedLabel = Preferences.Get(PrefAnalyzedAt, string.Empty);
            if (string.IsNullOrWhiteSpace(lastAnalyzedLabel))
            {
                lastAnalyzedLabel = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load persisted Compact ARK stats");
        }
    }

    private void PersistStats()
    {
        try
        {
            lastAnalyzedLabel = DateTime.Now.ToString("yyyy-MM-dd HH:mm");
            Preferences.Set(PrefLogical, logicalBytes);
            Preferences.Set(PrefOnDisk, onDiskBytes);
            Preferences.Set(PrefFiles, totalFiles);
            Preferences.Set(PrefState, (int)state);
            Preferences.Set(PrefAnalyzedAt, lastAnalyzedLabel);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to persist Compact ARK stats");
        }
    }

    private async Task RunAnalysisAsync()
    {
        if (isAnalyzing || IsBusy)
        {
            return;
        }

        isAnalyzing = true;
        pendingCompress = null;
        filesScanned = 0;
        scannedLogicalBytes = 0;
        analysisCts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            var progress = new Progress<CompactArkAnalyzeProgress>(p =>
            {
                filesScanned = p.FilesScanned;
                scannedLogicalBytes = p.LogicalBytes;
                this.DispatchRender(() => InvokeAsync(StateHasChanged), Logger);
            });

            var result = await CompactArkService.AnalyzeAsync(progress, analysisCts.Token);

            analysis = result;
            installPath = result.InstallPath;

            if (!result.InstallFound)
            {
                NotificationService.ShowError(Localizer.T("compact.toast.notfound"));
            }
            else
            {
                logicalBytes = result.LogicalBytes;
                onDiskBytes = result.OnDiskBytes;
                totalFiles = result.TotalFiles;
                state = result.State;
                PersistStats();

                if (!result.IsNtfs)
                {
                    NotificationService.ShowWarning(Localizer.T(
                        "compact.toast.notntfs",
                        result.DriveFormat ?? Localizer.T("compact.toast.notntfs.unknown")));
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Page navigated away or analysis cancelled — nothing to report.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Compact ARK analysis failed");
            NotificationService.ShowError(Localizer.T("compact.toast.analysisfailed", ex.Message));
        }
        finally
        {
            isAnalyzing = false;
            analysisCts?.Dispose();
            analysisCts = null;
            StateHasChanged();
        }
    }

    private void RequestOperation(bool compress)
    {
        if (!CanStart)
        {
            return;
        }

        pendingCompress = compress;
    }

    private void CancelConfirm()
    {
        pendingCompress = null;
    }

    private async Task ConfirmOperationAsync()
    {
        if (pendingCompress is not bool compress || IsBusy)
        {
            return;
        }

        pendingCompress = null;

        if (CompactArkService.IsArkRunning())
        {
            NotificationService.ShowError(Localizer.T("compact.toast.running"));
            return;
        }

        activeOperation = compress ? "compress" : "uncompress";
        cancelRequested = false;
        opFilesDone = 0;
        opTotalFiles = totalFiles;
        opCurrentFile = null;
        operationCts = new CancellationTokenSource();
        StateHasChanged();

        bool reanalyze = false;

        try
        {
            var progress = new Progress<CompactArkOperationProgress>(p =>
            {
                opFilesDone = p.FilesProcessed;
                opTotalFiles = p.TotalFiles;
                opCurrentFile = p.CurrentFile;
                this.DispatchRender(() => InvokeAsync(StateHasChanged), Logger);
            });

            var result = compress
                ? await CompactArkService.CompressAsync(progress, operationCts.Token)
                : await CompactArkService.UncompressAsync(progress, operationCts.Token);

            if (result.Cancelled)
            {
                NotificationService.ShowWarning(Localizer.T(
                    compress ? "compact.toast.cancelled.compress" : "compact.toast.cancelled.uncompress"));
                ActivityService.AddActivity(
                    Localizer.T(compress ? "compact.activity.cancelled.compress" : "compact.activity.cancelled.uncompress"),
                    "warning");
                reanalyze = true;
            }
            else if (!result.Success)
            {
                NotificationService.ShowError(result.ErrorMessage ?? Localizer.T("compact.toast.failed"));
                ActivityService.AddActivity(Localizer.T("compact.activity.failed"), "warning");
            }
            else
            {
                logicalBytes = result.LogicalBytes;
                onDiskBytes = result.OnDiskBytesAfter;
                state = compress ? CompactArkState.Compacted : CompactArkState.NotCompacted;
                if (analysis != null)
                {
                    analysis = analysis with
                    {
                        LogicalBytes = result.LogicalBytes,
                        OnDiskBytes = result.OnDiskBytesAfter,
                        State = state,
                        IsGameRunning = CompactArkService.IsArkRunning()
                    };
                }
                PersistStats();

                if (compress)
                {
                    var saved = Math.Max(0, result.LogicalBytes - result.OnDiskBytesAfter);
                    NotificationService.ShowSuccess(Localizer.T("compact.toast.compressed", FormatBytes(saved)));
                    ActivityService.AddActivity(Localizer.T("compact.activity.compressed", FormatBytes(saved)), "success");
                }
                else
                {
                    NotificationService.ShowSuccess(Localizer.T("compact.toast.uncompressed"));
                    ActivityService.AddActivity(Localizer.T("compact.activity.uncompressed"), "success");
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Compact ARK operation failed unexpectedly");
            NotificationService.ShowError(Localizer.T("compact.toast.operationfailed", ex.Message));
        }
        finally
        {
            activeOperation = null;
            cancelRequested = false;
            operationCts?.Dispose();
            operationCts = null;
            StateHasChanged();
        }

        if (reanalyze)
        {
            await RunAnalysisAsync();
        }
    }

    private void CancelOperation()
    {
        if (operationCts == null || cancelRequested)
        {
            return;
        }

        cancelRequested = true;
        try
        {
            operationCts.Cancel();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to signal cancellation for compact operation");
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 0)
        {
            return "—";
        }

        string[] units = { "B", "KB", "MB", "GB", "TB" };
        double value = bytes;
        int unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }

        return value >= 100 ? $"{value:N0} {units[unit]}" : $"{value:N1} {units[unit]}";
    }

    public void Dispose()
    {
        this.StopRenderDispatch();
        try
        {
            analysisCts?.Cancel();
        }
        catch { /* page teardown must never throw */ }

        try
        {
            operationCts?.Cancel();
        }
        catch { /* page teardown must never throw */ }
    }
}
