@page "/inbox"
@using RazorReaper.Services
@inject ISupportInboxService Inbox
@implements IDisposable

<header class="page-header">
    <h1 class="page-title">Inbox</h1>
    <p class="page-subtitle">Private answers from support, linked to your reports.</p>
</header>
<div class="support-inbox-actions"><a href="/feedback" class="btn btn-secondary">Report an issue</a></div>
@if (Inbox.Error is not null)
{
    <p role="status" class="feedback-note">@Inbox.Error</p>
}
@if (!Inbox.HasLoaded && Inbox.Error is null)
{
    <p>Loading your inbox…</p>
}
else if (Inbox.HasLoaded && Inbox.Replies.Count == 0)
{
    <div class="content-card"><h3>No replies yet</h3><p>Your replies will appear here automatically. The bell beside your tier in the sidebar shows a dot when support answers.</p></div>
}
<div class="support-replies">
@foreach (var reply in Inbox.Replies)
{
    <article @key="reply.Id" class="content-card support-reply @(reply.ReadAt is null ? "is-unread" : "")">
        <button type="button" class="support-reply-heading" aria-expanded="@_opened.Contains(reply.Id)" @onclick="() => OpenAsync(reply)">
            <span><strong>Support replied</strong><span class="support-reply-meta">@reply.ReportId · @reply.CreatedAt.ToLocalTime().ToString("g")</span></span>
            @if (reply.ReadAt is null) { <span class="support-unread">New</span> }
            <span aria-hidden="true">@(_opened.Contains(reply.Id) ? "−" : "+")</span>
        </button>
        @if (_opened.Contains(reply.Id))
        {
            <div class="support-reply-content">
                <p class="support-answer">@reply.Message</p>
                <div class="support-original"><strong>Your report</strong><p>@reply.OriginalMessage</p></div>
            </div>
        }
    </article>
}
</div>
@if (Inbox.NextBefore is not null)
{
    <button class="btn btn-secondary" disabled="@_loadingOlder" @onclick="LoadOlderAsync">Earlier replies</button>
}

@code {
    private readonly HashSet<long> _opened = [];
    private bool _loadingOlder;
    private long? _appliedOpen;

    /// <summary>/inbox?open=ID expands that reply and marks it read — the What's new view's per-reply links land here.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "open")]
    public long? Open { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Inbox.Changed += OnChanged;
        await Inbox.RefreshAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        // Only a *changed* query value opens a reply, so a reply folded by hand stays folded
        // across unrelated parameter updates.
        if (Open == _appliedOpen) return;
        _appliedOpen = Open;
        _pendingOpen = Open;
        await OpenPendingAsync();
    }
    // The reply may not be in the list yet when the page lands (the refresh above yields to a
    // poll already in flight), so the request waits for the next change that brings it.
    private long? _pendingOpen;
    private async Task OpenPendingAsync()
    {
        if (_pendingOpen is not long id) return;
        var reply = Inbox.Replies.FirstOrDefault(r => r.Id == id);
        if (reply is null) return;
        _pendingOpen = null;
        if (!_opened.Add(id)) return;
        if (reply.ReadAt is null) await Inbox.MarkReadAsync(id);
    }
    private void OnChanged() => this.DispatchRender(() => InvokeAsync(HandleChangedAsync));
    private async Task HandleChangedAsync()
    {
        await OpenPendingAsync();
        StateHasChanged();
    }
    private async Task OpenAsync(SupportReply reply)
    {
        if (!_opened.Add(reply.Id)) { _opened.Remove(reply.Id); return; }
        if (reply.ReadAt is null) await Inbox.MarkReadAsync(reply.Id);
    }
    private async Task LoadOlderAsync()
    {
        _loadingOlder = true;
        try { await Inbox.RefreshAsync(older: true); }
        finally { _loadingOlder = false; }
    }
    public void Dispose() { this.StopRenderDispatch(); Inbox.Changed -= OnChanged; }
}
