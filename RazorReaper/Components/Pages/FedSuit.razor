@page "/fed-suit"
@using Microsoft.Extensions.Logging
@using RazorReaper.Services
@using RazorReaper.Services.Automation
@inject IFedSuitMacro Macro
@inject ICalibrationService Calibration
@inject INotificationService Notifications
@inject ILogger<FedSuit> Logger
@implements IDisposable

<header class="page-header">
    <h1 class="page-title">Fed Suit</h1>
    <p class="page-subtitle">Automated transmitter slot transfers for the Federation Suit grind</p>
</header>

<div class="fedsuit-page">

    <StatusHeader State="@(Macro.IsRunning ? "online" : "off")"
                  Label="@(Macro.IsRunning ? "Running" : "Stopped")"
                  Description="@StatusDescription">
        <Actions>
            <button class="btn btn-primary" @onclick="StartMacro" disabled="@Macro.IsRunning">Start</button>
            <button class="btn btn-danger" @onclick="StopMacro" disabled="@(!Macro.IsRunning)">Stop</button>
        </Actions>
    </StatusHeader>

    @if (!Macro.StartHotkeyRegistered || !Macro.StopHotkeyRegistered)
    {
        <p class="fs-hotkey-warning">A hotkey could not be registered — the combination may already be in use by another application.</p>
    }

    <div class="fs-info-card">
        Each cycle focuses ARK, opens the transmitter, waits, presses the transfer key the configured number of times, exits, then repeats until stopped.
    </div>

    @* Settings and Calibration side by side — stacked they pushed this page 731px past
       the fold on a normal window. *@
    <div class="fs-card-grid">

    <section class="content-card fs-card fs-card-settings">
        <div class="fs-card-header">
            <h3>Settings</h3>
            <button class="btn btn-secondary fs-sm-btn" @onclick="ResetDefaults" disabled="@Macro.IsRunning">Reset defaults</button>
        </div>
        <div class="fs-rows">
            <SettingRow Title="Open Transmitter key" Description="Key that opens the transmitter in game.">
                <HotkeyField @bind-Value="openKey" @bind-Value:after="PushSettings" />
            </SettingRow>
            <SettingRow Title="Exit Transmitter key" Description="Key that closes the transmitter UI.">
                <HotkeyField @bind-Value="exitKey" @bind-Value:after="PushSettings" />
            </SettingRow>
            <SettingRow Title="Transfer key" Description="Key pressed repeatedly to transfer items.">
                <HotkeyField @bind-Value="transferKey" @bind-Value:after="PushSettings" />
            </SettingRow>
            <SettingRow Title="Key presses per cycle" Description="Transfer presses each cycle before exiting.">
                <input type="number" class="fs-num" min="1" max="500" @bind="pressesPerCycle" @bind:after="PushSettings" />
            </SettingRow>
            <SettingRow Title="Delay between presses" Description="Milliseconds between transfer presses.">
                <input type="number" class="fs-num" min="0" max="10000" @bind="pressDelayMs" @bind:after="PushSettings" />
            </SettingRow>
            <SettingRow Title="Wait after opening" Description="Milliseconds to wait for the transmitter UI to load.">
                <input type="number" class="fs-num" min="0" max="30000" @bind="waitAfterOpenMs" @bind:after="PushSettings" />
            </SettingRow>
            <SettingRow Title="Delay before repeating" Description="Milliseconds between cycles.">
                <input type="number" class="fs-num" min="0" max="60000" @bind="repeatDelayMs" @bind:after="PushSettings" />
            </SettingRow>
            <SettingRow Title="Start hotkey" Description="System-wide hotkey that starts the loop, even while ARK has focus.">
                <HotkeyLink Value="@startHotkey" />
            </SettingRow>
            <SettingRow Title="Stop hotkey" Description="System-wide hotkey that hard-stops the loop, even while ARK has focus.">
                <HotkeyLink Value="@stopHotkey" />
            </SettingRow>
        </div>
    </section>

    <section class="content-card fs-card">
        <div class="fs-card-header">
            <h3>Calibration</h3>
            <span class="fs-badge">@Calibration.CurrentResolutionKey</span>
        </div>
        <div class="fs-rows">
            <SettingRow Title="Position of first slot" Description="Hover the first transmitter slot while the countdown runs; the position is saved per resolution.">
                <span class="fs-badge @(hasSlotPoint ? "set" : "")">@slotPointDisplay</span>
                @if (hasSlotPoint)
                {
                    <button class="btn btn-secondary fs-sm-btn" @onclick="ClearSlotPoint" disabled="@capturing">Clear</button>
                }
                <button class="btn btn-secondary fs-sm-btn" @onclick="CaptureSlotPoint" disabled="@capturing">
                    @(capturing ? $"Capturing… {captureCountdown}" : (hasSlotPoint ? "Recapture" : "Capture"))
                </button>
            </SettingRow>
            <SettingRow Title="Click first slot after opening" Description="Clicks the calibrated slot once the transmitter is open.">
                <Switch @bind-Value="clickFirstSlot" @bind-Value:after="PushSettings" />
            </SettingRow>
        </div>
    </section>

    </div>

</div>

@code {
    private string openKey = "F";
    private string exitKey = "Esc";
    private string transferKey = "T";
    private int pressesPerCycle = 20;
    private int pressDelayMs = 50;
    private int waitAfterOpenMs = 700;
    private int repeatDelayMs = 500;
    private string startHotkey = "F5";
    private string stopHotkey = "F6";
    private bool clickFirstSlot;

    private bool capturing;
    private int captureCountdown;
    private bool hasSlotPoint;
    private string slotPointDisplay = "Not set";

    private string StatusDescription => Macro.IsRunning
        ? $"Cycle {Math.Max(1, Macro.CurrentCycle)} · {Macro.CyclesCompleted} completed · press {stopHotkey} to stop"
        : (Macro.LastRunSummary is { Length: > 0 } summary
            ? $"Press {startHotkey} to start · last run: {summary}"
            : $"Press {startHotkey} or click Start");

    protected override void OnInitialized()
    {
        PullFromService();
        RefreshSlotPoint();
        Macro.Changed += OnMacroChanged;
    }

    public void Dispose()
    {
        // The macro is a singleton and keeps running after navigation — only detach the UI.
        Macro.Changed -= OnMacroChanged;
    }

    private void OnMacroChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void PullFromService()
    {
        var s = Macro.Settings;
        openKey = s.OpenKey;
        exitKey = s.ExitKey;
        transferKey = s.TransferKey;
        pressesPerCycle = s.PressesPerCycle;
        pressDelayMs = s.PressDelayMs;
        waitAfterOpenMs = s.WaitAfterOpenMs;
        repeatDelayMs = s.RepeatDelayMs;
        startHotkey = s.StartHotkey;
        stopHotkey = s.StopHotkey;
        clickFirstSlot = s.ClickFirstSlot;
    }

    private void PushSettings()
    {
        try
        {
            Macro.UpdateSettings(new FedSuitSettings
            {
                OpenKey = KeyOnly(openKey),
                ExitKey = KeyOnly(exitKey),
                TransferKey = KeyOnly(transferKey),
                PressesPerCycle = pressesPerCycle,
                PressDelayMs = pressDelayMs,
                WaitAfterOpenMs = waitAfterOpenMs,
                RepeatDelayMs = repeatDelayMs,
                StartHotkey = startHotkey,
                StopHotkey = stopHotkey,
                ClickFirstSlot = clickFirstSlot
            });
            // Reflect service-side validation (clamps, invalid keys reverted to defaults).
            PullFromService();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fed-Suit settings update failed");
            Notifications.ShowError("Failed to save Fed-Suit settings.");
        }
    }

    // Game keys are plain keys — strip any modifiers the capture field picked up.
    private static string KeyOnly(string value)
    {
        var parts = (value ?? "").Split('+', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length > 0 ? parts[^1] : "";
    }

    private void ResetDefaults()
    {
        try
        {
            Macro.UpdateSettings(new FedSuitSettings());
            PullFromService();
            Notifications.ShowInfo("Fed-Suit settings reset to defaults.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fed-Suit settings reset failed");
            Notifications.ShowError("Failed to reset Fed-Suit settings.");
        }
    }

    private void StartMacro()
    {
        // The service handles messaging (toast on start, error toasts for invalid keys).
        Macro.Start();
    }

    private void StopMacro()
    {
        Macro.Stop();
    }

    private async Task CaptureSlotPoint()
    {
        if (capturing || Calibration.IsCapturing) return;

        capturing = true;
        captureCountdown = 3;
        StateHasChanged();
        try
        {
            var progress = new Progress<int>(s =>
            {
                captureCountdown = s;
                _ = InvokeAsync(StateHasChanged);
            });
            await Calibration.CapturePointAsync(FedSuitMacro.FirstSlotPointName, 3, progress);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fed-Suit slot calibration failed");
            Notifications.ShowError("Failed to capture the first slot position.");
        }
        finally
        {
            capturing = false;
            RefreshSlotPoint();
            StateHasChanged();
        }
    }

    private void ClearSlotPoint()
    {
        try
        {
            if (Calibration.DeletePoint(FedSuitMacro.FirstSlotPointName))
            {
                Notifications.ShowInfo("First slot position cleared.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fed-Suit slot calibration clear failed");
            Notifications.ShowError("Failed to clear the first slot position.");
        }
        RefreshSlotPoint();
    }

    private void RefreshSlotPoint()
    {
        try
        {
            hasSlotPoint = Calibration.TryGetPoint(FedSuitMacro.FirstSlotPointName, out var p);
            slotPointDisplay = hasSlotPoint ? $"{p.X}, {p.Y}" : "Not set";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to read Fed-Suit calibration point");
            hasSlotPoint = false;
            slotPointDisplay = "Not set";
        }
    }
}
