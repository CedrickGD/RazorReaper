@page "/server-specific"

<header class="page-header server-specific-header">
    <div class="server-specific-header-content">
        <div class="server-specific-logo-wrap">
            <img class="server-specific-logo" src="/images/mesa-logo.png" alt="Mesa server logo" />
        </div>
        <div>
            <h1 class="page-title">Map Mods</h1>
            <p class="page-subtitle">Mesa Ark' server map mods with custom coordinates and landmarks.</p>
        </div>
    </div>
    <div class="server-specific-header-stats">
        <div class="server-specific-stat">
            <span class="server-specific-stat-label">Maps</span>
            <span class="server-specific-stat-value">@MapCount</span>
        </div>
        <div class="server-specific-stat">
            <span class="server-specific-stat-label">Spots</span>
            <span class="server-specific-stat-value">@TotalSpotCount</span>
        </div>
    </div>
</header>

<div class="server-specific-layout">
    <section class="server-specific-category">
        <div class="server-specific-category-body">
            @foreach (var map in maps)
            {
                <details class="server-specific-map-card" open>
                    <summary class="server-specific-map-header">
                        <div class="server-specific-map-heading">
                            <h2>@map.Name</h2>
                            @if (!string.IsNullOrWhiteSpace(map.Note))
                            {
                                <p>@map.Note</p>
                            }
                        </div>
                        <div class="server-specific-map-meta">
                            <span class="server-specific-map-count">@map.Spots.Count spots</span>
                            <span class="server-specific-map-toggle" aria-hidden="true"></span>
                        </div>
                    </summary>

                    <div class="server-specific-grid">
                        @foreach (var spot in map.Spots)
                        {
                            <article class="server-specific-spot">
                                <div class="server-specific-spot-header">
                                    <h3>@spot.Name</h3>
                                    @if (!string.IsNullOrWhiteSpace(spot.Type))
                                    {
                                        <span class="server-specific-spot-type">@spot.Type</span>
                                    }
                                </div>
                                <div class="server-specific-coordinates">
                                    <span class="server-specific-coordinate-label">Lat</span>
                                    <span class="server-specific-coordinate-value">@spot.Latitude</span>
                                    <span class="server-specific-coordinate-divider">/</span>
                                    <span class="server-specific-coordinate-label">Lon</span>
                                    <span class="server-specific-coordinate-value">@spot.Longitude</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(spot.Note))
                                {
                                    <p class="server-specific-spot-note">@spot.Note</p>
                                }
                            </article>
                        }
                    </div>
                </details>
            }
        </div>
    </section>
</div>

