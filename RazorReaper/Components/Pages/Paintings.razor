@page "/paintings"
@using System.Diagnostics
@using RazorReaper.Services
@inject INotificationService NotificationService
@inject IActivityService ActivityService


        <header class="page-header">
            <h1 class="page-title">Paintings</h1>
            <p class="page-subtitle">Manage your ingame paintings</p>
        </header>

        <div style="display: grid; grid-template-columns: 320px 1fr; gap: 2rem; height: calc(100vh - 200px);">

            <div class="content-card" style="height: fit-content;">
                <h3 class="mb-3 text-white">Folder Management</h3>

                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <button class="btn btn-primary" @onclick="OpenMyPaintingsFolder" style="width: 100%; justify-content: flex-start;">
                        <svg style="width: 16px; height: 16px; margin-right: 0.75rem;" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
                        </svg>
                        Open MyPaintings Folder
                    </button>

                    <button class="btn btn-secondary" @onclick="CreateMyPaintingsFolder" style="width: 100%; justify-content: flex-start;">
                        <svg style="width: 16px; height: 16px; margin-right: 0.75rem;" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M5 4a3 3 0 00-3 3v6a3 3 0 003 3h10a3 3 0 003-3V7a3 3 0 00-3-3H9L7 2H5zM8 8a1 1 0 011-1h2a1 1 0 110 2h-2a1 1 0 01-1-1zm1 4a1 1 0 100 2h2a1 1 0 100-2H9z" clip-rule="evenodd" />
                        </svg>
                        Create MyPaintings Folder
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(arkPath))
                {
                    <div class="paintings-stats-card">
                        <div class="stats-icon">
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div class="stats-content">
                            <div class="stats-value">@fileCount</div>
                            <div class="stats-label">Canvas Files</div>
                        </div>
                    </div>
                }
            </div>

            <div style="display: flex; flex-direction: column; gap: 1.5rem; height: 100%;">

                <div class="content-card">
                    <h3 class="mb-3 text-white">Get Canvas - Templates By ArkTested</h3>

                    <div style="display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: center;">
                        <div>
                            <p style="color: var(--text-secondary); margin-bottom: 1rem; line-height: 1.6;">
                                Organized collection of ARK-themed paintings and canvas images.
                                Includes labeled icons for dinos, items, structures, and more.
                                Helps players customize storage, signs, and base visuals.
                            </p>

                            <div style="display: flex; gap: 1rem; margin-bottom: 1rem;">
                                <div class="feature-tag">📄 Templates</div>
                                <div class="feature-tag">📂 Sorted Categories</div>
                                <div class="feature-tag">🔖 Label Ready</div>
                            </div>
                        </div>

                        <div style="text-align: center;">
                            <div class="icon-circle white">
                                <svg style="width: 40px; height: 40px; color: var(--background-dark);" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd" />
                                </svg>
                            </div>
                        </div>
                    </div>

                    <div style="display: flex; gap: 1rem;">
                        <button class="btn btn-primary" @onclick="OpenCanvasWebsite">
                            <svg style="width: 16px; height: 16px; margin-right: 0.5rem;" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
                            </svg>
                            Download Canvas Here
                        </button>
                    </div>
                </div>

                <div class="content-card" style="flex: 1;">
                    <h3 class="mb-3 text-white">ARK Canvas Maker Tool</h3>

                    <div style="display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: center; margin-bottom: 2rem;">
                        <div>
                            <p style="color: var(--text-secondary); margin-bottom: 1rem; line-height: 1.6;">
                                Specialized tool for creating custom canvas paintings in ARK: Survival Evolved.
                                Convert your artwork into the proper format for in-game canvas items.
                            </p>

                            <div style="display: flex; gap: 1rem; margin-bottom: 1rem;">
                                <div class="feature-tag">⚒️ ARK Specific</div>
                                <div class="feature-tag">🎮 Game Integration</div>
                                <div class="feature-tag">📐 Format Conversion</div>
                            </div>
                        </div>

                        <div style="text-align: center;">
                            <div class="icon-circle dark">
                                <svg style="width: 40px; height: 40px; color: white;" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h3a1 1 0 011 1v3a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 13a1 1 0 011-1h3a1 1 0 011 1v3a1 1 0 01-1 1H4a1 1 0 01-1-1v-3zM12 4a1 1 0 011-1h3a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1V4zM12 13a1 1 0 011-1h3a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-3z" clip-rule="evenodd" />
                                </svg>
                            </div>
                        </div>
                    </div>

                    <div style="display: flex; gap: 1rem; margin-bottom: 2rem;">
                        <button class="btn btn-primary" @onclick="OpenArkCanvasMaker" style="flex: 1;">
                            <svg style="width: 16px; height: 16px; margin-right: 0.5rem;" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
                            </svg>
                            Download ARK Canvas Maker
                        </button>

                        <button class="btn btn-secondary" @onclick="ShowArkCanvasInfo">
                            <svg style="width: 16px; height: 16px; margin-right: 0.5rem;" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                            </svg>
                            How to Use
                        </button>
                    </div>

                    @if (showArkInfo)
                    {
                        <div class="canvas-guide">
                            <h4 style="color: var(--text-primary); margin-bottom: 1rem; font-weight: 600;">ARK Canvas Setup Guide</h4>
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem;">
                                <div class="guide-step">
                                    <div class="guide-step-icon">
                                        <svg fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                                        </svg>
                                    </div>
                                    <div class="guide-step-body">
                                        <h5 class="guide-step-label">Step 1: Prepare</h5>
                                        <p class="guide-step-text">Create your artwork in any image editor. Recommended size: 256x256 pixels.</p>
                                    </div>
                                </div>
                                <div class="guide-step">
                                    <div class="guide-step-icon">
                                        <svg fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
                                        </svg>
                                    </div>
                                    <div class="guide-step-body">
                                        <h5 class="guide-step-label">Step 2: Convert</h5>
                                        <p class="guide-step-text">Use ARK Canvas Maker to convert your image to ARK's canvas format (.arkpnt).</p>
                                    </div>
                                </div>
                                <div class="guide-step">
                                    <div class="guide-step-icon">
                                        <svg fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM6.293 6.707a1 1 0 010-1.414l3-3a1 1 0 011.414 0l3 3a1 1 0 01-1.414 1.414L11 5.414V13a1 1 0 11-2 0V5.414L7.707 6.707a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                                        </svg>
                                    </div>
                                    <div class="guide-step-body">
                                        <h5 class="guide-step-label">Step 3: Import</h5>
                                        <p class="guide-step-text">Place the converted file in your ARK game directory and import in-game.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>


<style>
    .feature-tag {
        background: var(--background-hover);
        color: var(--text-primary);
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        border: 1px solid var(--border-color);
        transition: all 0.3s ease;
    }

        .feature-tag:hover {
            background: var(--background-card);
            border-color: var(--text-primary);
        }

        .feature-tag.orange {
            background: rgba(245, 158, 11, 0.1);
            color: var(--accent-orange);
            border-color: rgba(245, 158, 11, 0.3);
        }

    .icon-circle {
        width: 80px;
        height: 80px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
    }

        .icon-circle.white {
            background: linear-gradient(135deg, #ffffff, #f3f4f6);
        }

        .icon-circle.dark {
            background: linear-gradient(135deg, var(--background-hover), var(--border-color));
            border: 1px solid var(--text-primary);
        }

    /* Status messages removed - using global notification system */

    .paintings-stats-card {
        margin-top: 1.5rem;
        padding: 1rem;
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(139, 92, 246, 0.08));
        border: 1px solid rgba(139, 92, 246, 0.3);
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        transition: all 0.3s ease;
    }

    .paintings-stats-card:hover {
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(139, 92, 246, 0.12));
        border-color: var(--accent-purple);
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(139, 92, 246, 0.3);
    }

    .stats-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: rgba(139, 92, 246, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .stats-icon svg {
        width: 18px;
        height: 18px;
        color: var(--accent-purple);
    }

    .stats-content {
        flex: 1;
    }

    .stats-value {
        font-size: 1.25rem;
        font-weight: 700;
        background: var(--gradient-purple);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1;
        margin-bottom: 0.25rem;
    }

    .stats-label {
        color: var(--text-secondary);
        font-size: 0.8rem;
        font-weight: 600;
    }

    .canvas-guide {
        background: var(--background-dark);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 1.5rem;
    }

    .guide-step {
        background: var(--background-dark);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 1rem;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease;
    }

        .guide-step:hover {
            background: var(--background-hover);
            border-color: var(--text-primary);
            transform: translateY(-2px);
        }

    .guide-step-icon {
        width: 28px;
        height: 28px;
        min-width: 28px;
        border-radius: 8px;
        background: rgba(139, 92, 246, 0.15);
        border: 1px solid rgba(139, 92, 246, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .guide-step-icon svg {
            width: 14px;
            height: 14px;
            color: var(--accent-purple);
        }

    .guide-step-body {
        flex: 1;
        min-width: 0;
    }

    .guide-step-label {
        color: var(--text-primary);
        font-size: 0.9rem;
        font-weight: 600;
        margin: 0 0 0.35rem 0;
    }

    .guide-step-text {
        color: var(--text-secondary);
        font-size: 0.85rem;
        line-height: 1.5;
        margin: 0;
    }

    .text-orange {
        color: var(--accent-orange);
    }
</style>

@code {
    private bool folderExists = false;
    private string folderPath = "";
    private string arkPath = "";
    private int fileCount = 0;
    private bool showArkInfo = false;

    protected override Task OnInitializedAsync()
    {
        CheckFolderStatus();
        return Task.CompletedTask;
    }

    private void OpenMyPaintingsFolder()
    {
        try
        {
            string? arkBasePath = ArkUtilities.FindArkPath();

            if (arkBasePath == null)
            {
                NotificationService.ShowError("ARK installation not found. Please install ARK or check your installation.");
                return;
            }

            folderPath = Path.Combine(arkBasePath, "ShooterGame", "Saved", "MyPaintings");
            arkPath = arkBasePath;

            if (!Directory.Exists(arkPath))
            {
                NotificationService.ShowError("ARK: Survival Evolved not found in Steam directory. Please verify your ARK installation.");
                return;
            }

            if (!Directory.Exists(folderPath))
            {
                NotificationService.ShowWarning("MyPaintings folder doesn't exist. Create it first or ensure ARK has been launched at least once.");
                folderExists = false;
                StateHasChanged();
                return;
            }

            folderExists = true;
            CountFiles();

            Process.Start(new ProcessStartInfo
            {
                FileName = "explorer.exe",
                Arguments = folderPath,
                UseShellExecute = true
            });

            NotificationService.ShowSuccess("Opened MyPaintings folder successfully!");
            ActivityService.AddActivity("Opened MyPaintings folder", "success");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Error opening folder: {ex.Message}");
        }
    }

    private void CreateMyPaintingsFolder()
    {
        try
        {
            string? arkBasePath = ArkUtilities.FindArkPath();
            if (arkBasePath == null)
            {
                NotificationService.ShowError("ARK installation not found. Cannot create MyPaintings folder.");
                return;
            }

            arkPath = arkBasePath;
            folderPath = Path.Combine(arkBasePath, "ShooterGame", "Saved", "MyPaintings");

            string arkExePath = Path.Combine(arkBasePath, "ShooterGame", "Binaries", "Win64", "ShooterGame.exe");
            if (!File.Exists(arkExePath))
            {
                NotificationService.ShowError("ShooterGame.exe not found. Is ARK properly installed?");
                return;
            }

            string savedPath = Path.Combine(arkBasePath, "ShooterGame", "Saved");
            if (!Directory.Exists(savedPath))
            {
                Directory.CreateDirectory(savedPath);
            }

            if (Directory.Exists(folderPath))
            {
                NotificationService.ShowWarning("MyPaintings folder already exists!");
                folderExists = true;
                CountFiles();
            }
            else
            {
                Directory.CreateDirectory(folderPath);
                NotificationService.ShowSuccess("MyPaintings folder created successfully!");
                ActivityService.AddActivity("MyPaintings folder created", "success");
                folderExists = true;
                fileCount = 0;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Error creating folder: {ex.Message}");
        }
    }

    private void CheckFolderStatus()
    {
        try
        {
            string? arkBasePath = ArkUtilities.FindArkPath();

            if (arkBasePath != null)
            {
                arkPath = arkBasePath;
                folderPath = Path.Combine(arkPath, "ShooterGame", "Saved", "MyPaintings");

                folderExists = Directory.Exists(folderPath);

                if (folderExists)
                {
                    CountFiles();
                }
                else
                {
                    fileCount = 0;
                }
            }
            else
            {
                folderExists = false;
                fileCount = 0;
                folderPath = "";
                arkPath = "";
            }
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Paintings folder check failed: {ex.Message}");
            folderExists = false;
            fileCount = 0;
            folderPath = "";
            arkPath = "";
        }
    }

    private void CountFiles()
    {
        try
        {
            if (folderExists && Directory.Exists(folderPath))
            {
                string[] files = Directory.GetFiles(folderPath, "*", SearchOption.AllDirectories);
                fileCount = files.Length;
            }
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Paintings file count failed: {ex.Message}");
            fileCount = 0;
        }
    }

    private void OpenCanvasWebsite()
    {
        try
        {
            string canvasUrl = "https://arktested.com/paintings";
            Process.Start(new ProcessStartInfo
            {
                FileName = canvasUrl,
                UseShellExecute = true
            });
            NotificationService.ShowSuccess("Opening Canvas download page...");
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Error opening website: {ex.Message}");
        }
    }

    private void OpenArkCanvasMaker()
    {
        try
        {
            string arkCanvasUrl = "https://github.com/CedrickGD/editor-download";
            Process.Start(new ProcessStartInfo
            {
                FileName = arkCanvasUrl,
                UseShellExecute = true
            });
            NotificationService.ShowSuccess("Opening ARK Canvas Maker download page...");
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Error opening ARK Canvas Maker: {ex.Message}");
        }
    }

    private void ShowArkCanvasInfo()
    {
        showArkInfo = !showArkInfo;
    }
}
