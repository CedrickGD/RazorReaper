@page "/game"
@using System.Diagnostics
@using System.Runtime.InteropServices
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Options
@using Microsoft.Maui.ApplicationModel.DataTransfer
@using RazorReaper.Services
@using RazorReaper.Configuration

@inject IProcessService ProcessService
@inject IOptions<AppConfiguration> Configuration
@inject ILogger<Game> Logger
@inject INotificationService NotificationService
@inject IActivityService ActivityService

@implements IAsyncDisposable

<div class="game-page-container">
    <header class="page-header">
        <h1 class="page-title">Game Management</h1>
        <p class="page-subtitle">Control and monitor ARK: Survival Evolved.</p>
    </header>

    <div class="game-hero-grid">
        <section class="content-card game-panel game-status-card">
            <div class="game-card-header">
                <div>
                    <h3>Game Status</h3>
                    <p class="game-card-subtitle">Live process detection for ARK.</p>
                </div>
                <span class="game-status-pill @(isGameRunning ? "online" : "offline")">
                    @(isGameRunning ? "Online" : "Offline")
                </span>
            </div>
            <div class="game-status">
                <div class="status-dot @(isGameRunning ? "online" : "offline")"></div>
                <div class="status-info">
                    <div class="status-title">ARK: Survival Evolved</div>
                    <div class="status-text">@(isGameRunning ? "Running" : "Not Running")</div>
                </div>
            </div>
            <div class="game-kv-grid">
                <div class="game-kv">
                    <span class="game-kv-label">Process</span>
                    <span class="game-kv-value">@Configuration.Value.Ark.GameProcessName</span>
                </div>
                <div class="game-kv">
                    <span class="game-kv-label">Launch</span>
                    <span class="game-kv-value">Steam AppId 346110</span>
                </div>
            </div>
        </section>

        <section class="content-card game-panel game-actions-card">
            <div class="game-card-header">
                <div>
                    <h3>Quick Actions</h3>
                    <p class="game-card-subtitle">Launch and send in-game commands.</p>
                </div>
            </div>
            <div class="game-actions">
                <button class="game-action-btn tone-launch" @onclick="LaunchGame" disabled="@isGameRunning">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="5 3 19 12 5 21 5 3" />
                    </svg>
                    <span>Launch Game</span>
                </button>

                <button class="game-action-btn tone-close" @onclick="CloseGame" disabled="@IsGameNotRunning()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                        <line x1="9" y1="9" x2="15" y2="15" />
                        <line x1="15" y1="9" x2="9" y2="15" />
                    </svg>
                    <span>Close Game</span>
                </button>

                <button class="game-action-btn tone-reconnect" @onclick="ExecuteReconnect" disabled="@IsGameNotRunning()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9c2.35 0 4.48.9 6.07 2.38" />
                        <polyline points="21 4 21 12 13 12" />
                    </svg>
                    <span>Reconnect</span>
                </button>

                <button class="game-action-btn tone-disconnect" @onclick="ExecuteDisconnect" disabled="@IsGameNotRunning()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18.36 6.64a9 9 0 1 1-12.73 0" />
                        <line x1="12" y1="2" x2="12" y2="12" />
                    </svg>
                    <span>Disconnect</span>
                </button>

                <button class="game-action-btn tone-clean" @onclick="ExecuteCleanVision" disabled="@IsGameNotRunning()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                    <span>Clean Vision</span>
                </button>

                <button class="game-action-btn tone-debug" @onclick="ExecuteDebugStructures" disabled="@IsGameNotRunning()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <span>Debug Structures</span>
                </button>
            </div>
        </section>
    </div>

    <div class="game-details-grid">
        <section class="content-card game-panel game-info-card">
            <div class="game-card-header">
                <div>
                    <h3>Command Reference</h3>
                    <p class="game-card-subtitle">What each action does in-game.</p>
                </div>
            </div>
            <ul class="game-info-list">
                <li class="game-info-item">
                    <div class="game-info-title">Reconnect</div>
                    <div class="game-info-text">Rejoins the last server session using the reconnect console command.</div>
                </li>
                <li class="game-info-item">
                    <div class="game-info-title">Disconnect</div>
                    <div class="game-info-text">Leaves the current server session using the disconnect command.</div>
                </li>
                <li class="game-info-item">
                    <div class="game-info-title">Clean Vision</div>
                    <div class="game-info-text">Applies a visibility command stack to reduce foliage and lower detail effects.</div>
                </li>
                <li class="game-info-item">
                    <div class="game-info-title">Debug Structures</div>
                    <div class="game-info-text">Runs the debugstructures command for structure debugging.</div>
                </li>
            </ul>
        </section>

        <section class="content-card game-panel game-info-card">
            <div class="game-card-header">
                <div>
                    <h3>Usage Tips</h3>
                    <p class="game-card-subtitle">Small things that prevent misfires.</p>
                </div>
            </div>
            <ul class="game-info-list">
                <li class="game-info-item">
                    <div class="game-info-title">Focus the game</div>
                    <div class="game-info-text">If a command does not fire, click into ARK once and try again.</div>
                </li>
                <li class="game-info-item">
                    <div class="game-info-title">Reconnect timing</div>
                    <div class="game-info-text">Use reconnect after timeouts or server restarts.</div>
                </li>
                <li class="game-info-item">
                    <div class="game-info-title">Clean exit</div>
                    <div class="game-info-text">Disconnect before closing when you want a clean exit.</div>
                </li>
            </ul>
        </section>

        <section class="content-card game-panel game-info-card">
            <div class="game-card-header">
                <div>
                    <h3>Safety Notes</h3>
                    <p class="game-card-subtitle">Keep your session stable.</p>
                </div>
            </div>
            <ul class="game-info-list">
                <li class="game-info-item">
                    <div class="game-info-title">Close Game</div>
                    <div class="game-info-text">Force stops the process and can lose unsaved progress.</div>
                </li>
                <li class="game-info-item">
                    <div class="game-info-title">Steam required</div>
                    <div class="game-info-text">Launching ARK uses Steam. Keep it running.</div>
                </li>
                <li class="game-info-item">
                    <div class="game-info-title">Commands</div>
                    <div class="game-info-text">Actions only work while ARK is running.</div>
                </li>
            </ul>
        </section>
    </div>
</div>

@code {
    private const int SW_RESTORE = 9;
    private const uint KEYEVENTF_KEYUP = 0x0002;
    private const uint VK_TAB = 0x09;
    private const uint VK_RETURN = 0x0D;
    private const uint VK_CONTROL = 0x11;
    private const uint VK_V = 0x56;
    private const string CleanVisionCommand = "foliage.DensityScale 0 | grass.DensityScale 0 | r.SkeletalMeshLODBias 10000 | r.DetailMode 0 | r.RefractionQuality 0 |  r.SSR 0 | r.SceneColorFormat 0 | r.DetailMode 0 | r.TranslucencyVolumeBlur 0  | r.GroundClutterQuality 0 | r.SSR.Quality 0 | r.SSS.Scale 0| r.SSS.SampleSet 0 | r.HFShadowQuality 0 | r.PostProcessAAQuality 0 | r.MSAA.CompositingSampleCount 0 | r.SkeletalMeshLODBias 1000 | r.ViewDistanceScale -7 | r.LightFunctionQuality 0 | r.ShadowQuality 0 | r.Shadow.CSM.MaxCascades 0 | r.Shadow.CSM.MaxFarCascades 0 | r.Shadow.AllowForegroundShadows 0 | r.Shadow.MaxResolution 0 | r.Shadow.RadiusThreshold 0 | r.Shadow.DistanceScale 0 | r.Shadow.CSM.TransitionScale 0 | r.DistanceFieldShadowing 0 | r.DistanceFieldShadowRaytraceDistance 0 | r.DistanceFieldAO 0 | r.oneframethreadlag 0 | r.MotionBlurQuality 0 | r.AmbientOcclusionSampleSetQuality 0 | r.AmbientOcclusionLevels 0 | r.AmbientOcclusionRadiusScale 0 | r.AmbientOcclusionFadeoutExponent 0 |r.AmbientOcclusion32BitPrecision 0 | r.DepthOfFieldQuality 0 | r.RenderTargetPoolMin 0 | r.LensFlareQuality 0 | r.SceneColorFringeQuality 0 | r.EyeAdaptationQuality 0 | r.BloomQuality 0 | r.FastBlurThreshold 0 | r.UpsampleQuality 0 | r.TonemapperQuality 0 | r.LightShaftQuality 0 | r.ScreenSpaceReflections 0 | r.Streaming.MipBias 100000 | r.MaxAnisotropy 8 | r.Streaming.PoolSize 0 | r.RefractionQuality 0 | r.SSR.Quality 0 | r.SceneColorFormat 0 | r.DetailMode 0 | r.TranslucencyVolumeBlur 0 | r.SSS.Scale 0 | r.SSS.SampleSet 0 | grass.enable 0 | r.ContactShadows 0 | r.DynamicGlobalIlluminationMethod 2 | r.Nanite.MaxPixelsPerEdge 4 | r.Shadow.CSM.MaxCascades 0 | r.ShadowQuality 0 | r.VolumetricCloud 0 | r.volumetricfog 0 | r.Water.SingleLayer.Reflection 0 | r.LandscapeLODBias 100000 | r.ParticleLODBias 10000 | r.MaterialQualityLevel 0 | r.TrueSkyQuality 0 | r.atmosphere 0 | r.lightshafts 0 | r.mapmaplodbias 9 |";

    [DllImport("user32.dll")]
    private static extern bool SetForegroundWindow(IntPtr hWnd);
    [DllImport("user32.dll")]
    private static extern bool ShowWindow(IntPtr hWnd, int nCmdShow);
    [DllImport("user32.dll")]
    private static extern void keybd_event(byte bVk, byte bScan, uint dwFlags, UIntPtr dwExtraInfo);
    [DllImport("user32.dll")]
    private static extern IntPtr GetForegroundWindow();

    private bool isGameRunning = false;
    private Timer? statusTimer;

    // Helper method for boolean attributes
    private bool IsGameNotRunning() => !isGameRunning;

    protected override void OnInitialized()
    {
        CheckGameStatus();

        // Check game status every 10 seconds to reduce CPU usage
        statusTimer = new Timer(async _ =>
        {
            CheckGameStatus();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(10));
    }

    private void CheckGameStatus()
    {
        try
        {
            var processName = Configuration.Value.Ark.GameProcessName;
            isGameRunning = ProcessService.IsProcessRunning(processName);
            Logger.LogDebug("Game status checked: {IsRunning}", isGameRunning);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error checking game status");
            isGameRunning = false;
        }
    }

    private async Task ExecuteReconnect()
    {
        await ExecuteGameCommand("reconnect");
    }

    private async Task ExecuteDisconnect()
    {
        await ExecuteGameCommand("disconnect");
    }

    private async Task ExecuteDebugStructures()
    {
        await ExecuteGameCommand("debugstructures", displayName: "Debug Structures");
    }

    private async Task ExecuteCleanVision()
    {
        await ExecuteGameCommand(CleanVisionCommand, useClipboard: true, displayName: "Clean Vision");
    }

    private async Task ExecuteGameCommand(string command, bool useClipboard = false, string? displayName = null)
    {
        try
        {
            Logger.LogInformation("Executing game command: {Command}", command);
            var commandLabel = displayName ?? command;
            var processName = Configuration.Value.Ark.GameProcessName;
            Process[] processes = ProcessService.GetProcessesByName(processName);
            try
            {
                if (processes.Length > 0)
                {
                    IntPtr gameWindowHandle = processes[0].MainWindowHandle;

                    ShowWindow(gameWindowHandle, SW_RESTORE);
                    await Task.Delay(100);
                    SetForegroundWindow(gameWindowHandle);
                    await Task.Delay(500);

                    keybd_event((byte)VK_TAB, 0, 0, UIntPtr.Zero);
                    await Task.Delay(50);
                    keybd_event((byte)VK_TAB, 0, KEYEVENTF_KEYUP, UIntPtr.Zero);
                    await Task.Delay(300);

                    if (useClipboard)
                    {
                        var pasted = await PasteCommandAsync(command);
                        if (!pasted)
                        {
                            NotificationService.ShowError($"Failed to paste '{commandLabel}'. Try again.");
                            StateHasChanged();
                            return;
                        }
                    }
                    else
                    {
                        await TypeCommandAsync(command);
                    }

                    await Task.Delay(200);

                    keybd_event((byte)VK_RETURN, 0, 0, UIntPtr.Zero);
                    await Task.Delay(50);
                    keybd_event((byte)VK_RETURN, 0, KEYEVENTF_KEYUP, UIntPtr.Zero);

                    NotificationService.ShowSuccess($"Command '{commandLabel}' executed successfully");
                    ActivityService.AddActivity($"Game command executed: {commandLabel}", "success");
                }
                else
                {
                    NotificationService.ShowWarning("ARK: Survival Evolved is not running!");
                }
            }
            finally
            {
                // Dispose all process objects to prevent handle leaks
                foreach (var process in processes)
                {
                    process?.Dispose();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error executing game command: {Command}", command);
            NotificationService.ShowError($"Error executing command: {ex.Message}");
        }

        StateHasChanged();
    }

    private void SendChar(char c)
    {
        byte vk = (byte)char.ToUpperInvariant(c);
        keybd_event(vk, 0, 0, UIntPtr.Zero);
        keybd_event(vk, 0, KEYEVENTF_KEYUP, UIntPtr.Zero);
    }

    private async Task TypeCommandAsync(string command)
    {
        foreach (char c in command.ToLowerInvariant())
        {
            SendChar(c);
            await Task.Delay(25);
        }
    }

    private async Task<bool> PasteCommandAsync(string command)
    {
        string? previousText = null;
        try
        {
            try
            {
                previousText = await Clipboard.Default.GetTextAsync();
            }
            catch
            {
                previousText = null;
            }

            await Clipboard.Default.SetTextAsync(command);
            await Task.Delay(50);

            SendPasteShortcut();
            await Task.Delay(120);

            if (!string.IsNullOrEmpty(previousText))
            {
                try
                {
                    await Clipboard.Default.SetTextAsync(previousText);
                }
                catch
                {
                    // Ignore clipboard restore failures.
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error pasting game command");

            if (!string.IsNullOrEmpty(previousText))
            {
                try
                {
                    await Clipboard.Default.SetTextAsync(previousText);
                }
                catch
                {
                    // Ignore clipboard restore failures.
                }
            }

            return false;
        }
    }

    private void SendPasteShortcut()
    {
        keybd_event((byte)VK_CONTROL, 0, 0, UIntPtr.Zero);
        keybd_event((byte)VK_V, 0, 0, UIntPtr.Zero);
        keybd_event((byte)VK_V, 0, KEYEVENTF_KEYUP, UIntPtr.Zero);
        keybd_event((byte)VK_CONTROL, 0, KEYEVENTF_KEYUP, UIntPtr.Zero);
    }

    private async Task LaunchGame()
    {
        try
        {
            Logger.LogInformation("Launching ARK via Steam");
            ProcessService.Start("steam://rungameid/346110");
            NotificationService.ShowSuccess("Launching ARK: Survival Evolved via Steam...");

            await Task.Delay(5000);
            CheckGameStatus();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error launching game");
            NotificationService.ShowError($"Error launching game: {ex.Message}");
        }

        StateHasChanged();
    }

    private Task CloseGame()
    {
        try
        {
            Logger.LogInformation("Closing ARK");
            var processName = Configuration.Value.Ark.GameProcessName;
            Process[] processes = ProcessService.GetProcessesByName(processName);
            try
            {
                foreach (var process in processes)
                {
                    ProcessService.Kill(process);
                    process.WaitForExit(5000);
                }

                CheckGameStatus();
                NotificationService.ShowSuccess("ARK: Survival Evolved closed successfully");
                ActivityService.AddActivity("ARK: Survival Evolved closed", "warning");
            }
            finally
            {
                // Dispose all process objects to prevent handle leaks
                foreach (var process in processes)
                {
                    process?.Dispose();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error closing game");
            NotificationService.ShowError($"Error closing game: {ex.Message}");
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (statusTimer != null)
        {
            await statusTimer.DisposeAsync();
        }
    }
}
