    // Cave rows keep the original difficulty colours; spots without a difficulty get a neutral dot.
    private static string DotClass(MergedSpot s)
        => s.Difficulty is not null ? DiffClass(s.Difficulty.Value) : "diff-none";

    private static string RowSub(MergedSpot s)
    {
        if (s.Difficulty is not null) return s.Artifact ?? "No artifact";
        return !string.IsNullOrEmpty(s.Note) ? s.Note! : s.Type;
    }

    private static string DiffClass(CaveDifficulty difficulty) => difficulty switch
    {
        CaveDifficulty.Easy => "diff-easy",
        CaveDifficulty.Medium => "diff-medium",
        _ => "diff-hard"
    };

    private static string FormatCoord(double value)
        => value.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);

    private async Task CopyTeleport(MergedSpot spot)
    {
        if (string.IsNullOrEmpty(spot.SetPlayerPos)) return;
        try
        {
            await Clipboard.Default.SetTextAsync(spot.SetPlayerPos);
            NotificationService.ShowSuccess("Teleport command copied.");
            ActivityService.AddActivity($"Copied teleport: {spot.Name}", "info");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to copy teleport command");
            NotificationService.ShowError("Failed to copy the command.");
        }
    }

    // ── Per-spot preview image / GIF ──

    private string? SpotImage(string map, string name)
        => customStore != null
           && customStore.SpotImages.TryGetValue($"{map}|{name}", out var url)
           && !string.IsNullOrEmpty(url)
            ? url
            : null;

    private async Task AttachImage(MergedSpot spot, InputFileChangeEventArgs e)
    {
        if (customStore == null || e.File is null) return;

        const long maxBytes = 8 * 1024 * 1024;
        if (e.File.Size > maxBytes)
        {
            NotificationService.ShowError("Image must be under 8 MB.");
            return;
        }

        try
        {
            using var stream = e.File.OpenReadStream(maxBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            var mime = string.IsNullOrWhiteSpace(e.File.ContentType) ? "image/png" : e.File.ContentType;
            customStore.SpotImages[$"{spot.Map}|{spot.Name}"] = $"data:{mime};base64,{base64}";
            await CustomDataService.SaveAsync(customStore);
            NotificationService.ShowSuccess("Preview image added.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to attach spot image");
            NotificationService.ShowError("Failed to add the image.");
        }
    }

    private async Task RemoveImage(MergedSpot spot)
    {
        if (customStore == null) return;
        if (customStore.SpotImages.Remove($"{spot.Map}|{spot.Name}"))
        {
            await CustomDataService.SaveAsync(customStore);
            NotificationService.ShowSuccess("Preview image removed.");
        }
    }

