    private List<CustomSpot> GetMesaExtraSpots(string mapName)
    {
        if (customStore?.MesaExtraSpots == null) return new();
        return customStore.MesaExtraSpots.TryGetValue(mapName, out var list) ? list : new();
    }

    private void OpenAddMesaSpot(string mapName)
    {
        formSpotName = "";
        formSpotLat = "";
        formSpotLon = "";
        formSpotType = "Cave";
        formSpotNote = "";
        mesaMapTarget = mapName;
        targetSpot = null;
        modalTitle = "Add Spot";
        modalMode = ModalMode.AddMesaSpot;
        modalOpen = true;
    }

    private void OpenEditMesaSpot(string mapName, CustomSpot spot)
    {
        formSpotName = spot.Name;
        formSpotLat = spot.Latitude;
        formSpotLon = spot.Longitude;
        formSpotType = spot.Type;
        formSpotNote = spot.Note;
        mesaMapTarget = mapName;
        targetSpot = spot;
        modalTitle = "Edit Spot";
        modalMode = ModalMode.EditMesaSpot;
        modalOpen = true;
    }

    private async Task SaveMesaSpot()
    {
        if (customStore == null || mesaMapTarget == null || string.IsNullOrWhiteSpace(formSpotName)) return;

        if (!customStore.MesaExtraSpots.ContainsKey(mesaMapTarget))
            customStore.MesaExtraSpots[mesaMapTarget] = new();

        var list = customStore.MesaExtraSpots[mesaMapTarget];

        if (modalMode == ModalMode.AddMesaSpot)
        {
            var spot = new CustomSpot
            {
                Name = formSpotName.Trim(),
                Latitude = formSpotLat.Trim(),
                Longitude = formSpotLon.Trim(),
                Type = formSpotType,
                Note = formSpotNote.Trim()
            };
            list.Add(spot);
            customStore.MesaExtraSpots[mesaMapTarget] = list.OrderBy(s => s.Name).ToList();
            NotificationService.ShowSuccess($"Spot \"{spot.Name}\" added to {mesaMapTarget}.");
        }
        else if (targetSpot != null)
        {
            targetSpot.Name = formSpotName.Trim();
            targetSpot.Latitude = formSpotLat.Trim();
            targetSpot.Longitude = formSpotLon.Trim();
            targetSpot.Type = formSpotType;
            targetSpot.Note = formSpotNote.Trim();
            customStore.MesaExtraSpots[mesaMapTarget] = list.OrderBy(s => s.Name).ToList();
            NotificationService.ShowSuccess("Spot updated.");
        }

        await CustomDataService.SaveAsync(customStore);
        CloseModal();
    }

    private void ConfirmDeleteMesaSpot(string mapName, CustomSpot spot)
    {
        confirmMessage = $"Delete spot \"{spot.Name}\"?";
        deleteAction = async () =>
        {
            if (customStore?.MesaExtraSpots.TryGetValue(mapName, out var list) == true)
            {
                list.Remove(spot);
                await CustomDataService.SaveAsync(customStore);
            }
            NotificationService.ShowSuccess($"Spot \"{spot.Name}\" deleted.");
            StateHasChanged();
        };
        modalTitle = "Confirm Delete";
        modalMode = ModalMode.ConfirmDelete;
        modalOpen = true;
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Length >= 2 ? name[..2].ToUpper() : name.ToUpper();
    }

