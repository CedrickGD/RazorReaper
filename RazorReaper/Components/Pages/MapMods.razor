@page "/map-mods"
@using RazorReaper.Models
@using RazorReaper.Services
@inject ICustomServerDataService CustomDataService
@inject INotificationService NotificationService

<header class="page-header map-mods-header">
    <div class="map-mods-header-content">
        <div class="map-mods-logo-wrap">
            <img class="map-mods-logo" src="/images/mesa-logo.png" alt="Mesa server logo" />
        </div>
        <div>
            <h1 class="page-title">Map Mods</h1>
            <p class="page-subtitle">Mesa Ark' server map mods with custom coordinates and landmarks.</p>
        </div>
    </div>
    <div class="map-mods-header-stats">
        <div class="map-mods-stat">
            <span class="map-mods-stat-label">Maps</span>
            <span class="map-mods-stat-value">@MapCount</span>
        </div>
        <div class="map-mods-stat">
            <span class="map-mods-stat-label">Spots</span>
            <span class="map-mods-stat-value">@TotalSpotCount</span>
        </div>
    </div>
</header>

<div class="map-mods-layout">
    <section class="map-mods-category">
        <div class="map-mods-category-body">
            @foreach (var map in maps)
            {
                <details class="map-mods-map-card" open>
                    <summary class="map-mods-map-header">
                        <div class="map-mods-map-heading">
                            <h2>@map.Name</h2>
                            @if (!string.IsNullOrWhiteSpace(map.Note))
                            {
                                <p>@map.Note</p>
                            }
                        </div>
                        <div class="map-mods-map-meta">
                            <span class="map-mods-map-count">@(map.Spots.Count + GetMesaExtraSpots(map.Name).Count) spots</span>
                            <button class="cs-icon-btn small" @onclick="() => OpenAddMesaSpot(map.Name)" @onclick:stopPropagation="true" title="Add spot">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </button>
                            <span class="map-mods-map-toggle" aria-hidden="true"></span>
                        </div>
                    </summary>

                    <div class="map-mods-grid">
                        @foreach (var spot in map.Spots)
                        {
                            <article class="map-mods-spot">
                                <div class="map-mods-spot-header">
                                    <h3>@spot.Name</h3>
                                    @if (!string.IsNullOrWhiteSpace(spot.Type))
                                    {
                                        <span class="map-mods-spot-type">@spot.Type</span>
                                    }
                                </div>
                                <div class="map-mods-coordinates">
                                    <span class="map-mods-coordinate-label">Lat</span>
                                    <span class="map-mods-coordinate-value">@spot.Latitude</span>
                                    <span class="map-mods-coordinate-divider">/</span>
                                    <span class="map-mods-coordinate-label">Lon</span>
                                    <span class="map-mods-coordinate-value">@spot.Longitude</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(spot.Note))
                                {
                                    <p class="map-mods-spot-note">@spot.Note</p>
                                }
                            </article>
                        }
                        @foreach (var extra in GetMesaExtraSpots(map.Name))
                        {
                            <article class="map-mods-spot">
                                <div class="map-mods-spot-header">
                                    <h3>@extra.Name</h3>
                                    <div class="cs-spot-actions">
                                        @if (!string.IsNullOrWhiteSpace(extra.Type))
                                        {
                                            <span class="map-mods-spot-type">@extra.Type</span>
                                        }
                                        <button class="cs-icon-btn tiny" @onclick="() => OpenEditMesaSpot(map.Name, extra)" title="Edit">
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                        </button>
                                        <button class="cs-icon-btn tiny danger" @onclick="() => ConfirmDeleteMesaSpot(map.Name, extra)" title="Delete">
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                        </button>
                                    </div>
                                </div>
                                <div class="map-mods-coordinates">
                                    <span class="map-mods-coordinate-label">Lat</span>
                                    <span class="map-mods-coordinate-value">@extra.Latitude</span>
                                    <span class="map-mods-coordinate-divider">/</span>
                                    <span class="map-mods-coordinate-label">Lon</span>
                                    <span class="map-mods-coordinate-value">@extra.Longitude</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(extra.Note))
                                {
                                    <p class="map-mods-spot-note">@extra.Note</p>
                                }
                            </article>
                        }
                    </div>
                </details>
            }
        </div>
    </section>
</div>

@* ═══════════════════════════════════════════════════════════════════════ *@
@* ══ YOUR SERVERS — fully user-managed section below the Mesa block ══ *@
@* ═══════════════════════════════════════════════════════════════════════ *@

<div class="cs-section">
    <div class="cs-section-header">
        <div class="cs-section-title-area">
            <h2 class="cs-section-title">Your Servers</h2>
            <p class="cs-section-subtitle">Add your own servers, maps, and base spots.</p>
        </div>
        <button class="btn btn-primary cs-add-server-btn" @onclick="OpenAddServer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add Server
        </button>
    </div>

    @if (customStore != null && customStore.Servers.Count > 0)
    {
        @foreach (var server in customStore.Servers)
        {
            <div class="cs-server-block">
                <div class="cs-server-header">
                    <div class="cs-server-header-left">
                        <div class="cs-server-logo-wrap">
                            @if (!string.IsNullOrWhiteSpace(server.LogoDataUrl))
                            {
                                <img class="cs-server-logo-img" src="@server.LogoDataUrl" alt="@server.Name logo" />
                            }
                            else
                            {
                                <span class="cs-server-logo-initials">@GetInitials(server.Name)</span>
                            }
                        </div>
                        <div>
                            <h3 class="cs-server-name">@server.Name</h3>
                            <span class="cs-server-stats">@server.Maps.Count maps &middot; @server.Maps.Sum(m => m.Spots.Count) spots</span>
                        </div>
                    </div>
                    <div class="cs-server-actions">
                        <button class="cs-icon-btn" @onclick="() => OpenAddMap(server)" title="Add map">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        </button>
                        <button class="cs-icon-btn" @onclick="() => OpenEditServer(server)" title="Edit server">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        </button>
                        <button class="cs-icon-btn danger" @onclick="() => ConfirmDeleteServer(server)" title="Delete server">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        </button>
                    </div>
                </div>

                <div class="cs-maps-body">
                    @foreach (var map in server.Maps)
                    {
                        <details class="map-mods-map-card" open>
                            <summary class="map-mods-map-header">
                                <div class="map-mods-map-heading">
                                    <h2>@map.Name</h2>
                                    @if (!string.IsNullOrWhiteSpace(map.Note))
                                    {
                                        <p>@map.Note</p>
                                    }
                                </div>
                                <div class="map-mods-map-meta">
                                    <span class="map-mods-map-count">@map.Spots.Count spots</span>
                                    <button class="cs-icon-btn small" @onclick="() => OpenAddSpot(server, map)" @onclick:stopPropagation="true" title="Add spot">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                    </button>
                                    <button class="cs-icon-btn small" @onclick="() => OpenEditMap(server, map)" @onclick:stopPropagation="true" title="Edit map">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                    </button>
                                    <button class="cs-icon-btn small danger" @onclick="() => ConfirmDeleteMap(server, map)" @onclick:stopPropagation="true" title="Delete map">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                    </button>
                                    <span class="map-mods-map-toggle" aria-hidden="true"></span>
                                </div>
                            </summary>

                            <div class="map-mods-grid">
                                @foreach (var spot in map.Spots)
                                {
                                    <article class="map-mods-spot">
                                        <div class="map-mods-spot-header">
                                            <h3>@spot.Name</h3>
                                            <div class="cs-spot-actions">
                                                @if (!string.IsNullOrWhiteSpace(spot.Type))
                                                {
                                                    <span class="map-mods-spot-type">@spot.Type</span>
                                                }
                                                <button class="cs-icon-btn tiny" @onclick="() => OpenEditSpot(server, map, spot)" title="Edit">
                                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                                </button>
                                                <button class="cs-icon-btn tiny danger" @onclick="() => ConfirmDeleteSpot(server, map, spot)" title="Delete">
                                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="map-mods-coordinates">
                                            <span class="map-mods-coordinate-label">Lat</span>
                                            <span class="map-mods-coordinate-value">@spot.Latitude</span>
                                            <span class="map-mods-coordinate-divider">/</span>
                                            <span class="map-mods-coordinate-label">Lon</span>
                                            <span class="map-mods-coordinate-value">@spot.Longitude</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(spot.Note))
                                        {
                                            <p class="map-mods-spot-note">@spot.Note</p>
                                        }
                                    </article>
                                }
                            </div>
                        </details>
                    }

                    @if (server.Maps.Count == 0)
                    {
                        <p class="cs-empty-hint">No maps yet — add one to get started.</p>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="cs-empty-state">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" opacity="0.3"><path d="M12 22s8-6 8-12A8 8 0 0 0 4 10c0 6 8 12 8 12Z"/><circle cx="12" cy="10" r="3"/></svg>
            <p>No custom servers yet. Click <strong>Add Server</strong> to create one.</p>
        </div>
    }
</div>

@* ── Modal overlay ── *@
@if (modalOpen)
{
    <div class="cs-modal-overlay" @onclick="CloseModal">
        <div class="cs-modal" @onclick:stopPropagation="true">
            <div class="cs-modal-header">
                <h3>@modalTitle</h3>
                <button class="cs-icon-btn" @onclick="CloseModal">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>

            @switch (modalMode)
            {
                case ModalMode.AddServer:
                case ModalMode.EditServer:
                    <div class="cs-modal-body">
                        <div class="cs-form-group">
                            <label>Server Name</label>
                            <input type="text" @bind="formServerName" placeholder="e.g. INX, Nitrado, MyCluster" />
                        </div>
                        <div class="cs-form-group">
                            <label>Server Logo (optional)</label>
                            <div class="cs-logo-upload-area">
                                @if (!string.IsNullOrWhiteSpace(formServerLogo))
                                {
                                    <div class="cs-logo-preview-wrap">
                                        <img class="cs-logo-preview" src="@formServerLogo" alt="Preview" />
                                        <button class="cs-icon-btn tiny danger" @onclick="ClearLogo" title="Remove">
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <label class="cs-logo-dropzone">
                                        <InputFile OnChange="HandleLogoUpload" accept="image/png,image/jpeg,image/webp,image/gif" />
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                        <span>Upload image</span>
                                    </label>
                                }
                                <p class="cs-logo-hint">PNG, JPG, WebP &middot; max 2 MB. Leave empty for auto initials.</p>
                            </div>
                        </div>
                    </div>
                    <div class="cs-modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                        <button class="btn btn-primary" @onclick="SaveServer">Save</button>
                    </div>
                    break;

                case ModalMode.AddMap:
                case ModalMode.EditMap:
                    <div class="cs-modal-body">
                        <div class="cs-form-group">
                            <label>Map Name</label>
                            <input type="text" @bind="formMapName" placeholder="e.g. Ragnarok, The Island" />
                        </div>
                        <div class="cs-form-group">
                            <label>Note (optional)</label>
                            <input type="text" @bind="formMapNote" placeholder="e.g. Custom caves and landmarks" />
                        </div>
                    </div>
                    <div class="cs-modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                        <button class="btn btn-primary" @onclick="SaveMap">Save</button>
                    </div>
                    break;

                case ModalMode.AddSpot:
                case ModalMode.EditSpot:
                case ModalMode.AddMesaSpot:
                case ModalMode.EditMesaSpot:
                    var isMesa = modalMode is ModalMode.AddMesaSpot or ModalMode.EditMesaSpot;
                    <div class="cs-modal-body">
                        <div class="cs-form-group">
                            <label>Spot Name</label>
                            <input type="text" @bind="formSpotName" placeholder="e.g. Horror Cave" />
                        </div>
                        <div class="cs-form-row">
                            <div class="cs-form-group">
                                <label>Latitude</label>
                                <input type="text" @bind="formSpotLat" placeholder="e.g. 50" />
                            </div>
                            <div class="cs-form-group">
                                <label>Longitude</label>
                                <input type="text" @bind="formSpotLon" placeholder="e.g. 72" />
                            </div>
                        </div>
                        <div class="cs-form-group">
                            <label>Type</label>
                            <div class="cs-type-picker">
                                @foreach (var t in spotTypes)
                                {
                                    <button class="cs-type-btn @(formSpotType == t ? "active" : "")"
                                            @onclick="() => formSpotType = t">@t</button>
                                }
                            </div>
                        </div>
                        <div class="cs-form-group">
                            <label>Note (optional)</label>
                            <input type="text" @bind="formSpotNote" placeholder="Optional notes" />
                        </div>
                    </div>
                    <div class="cs-modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                        <button class="btn btn-primary" @onclick="@(isMesa ? SaveMesaSpot : SaveSpot)">Save</button>
                    </div>
                    break;

                case ModalMode.ConfirmDelete:
                    <div class="cs-modal-body">
                        <p class="cs-confirm-text">@confirmMessage</p>
                    </div>
                    <div class="cs-modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                        <button class="btn btn-danger" @onclick="ExecuteDelete">Delete</button>
                    </div>
                    break;
            }
        </div>
    </div>
}

