@page "/notifier"
@using Microsoft.JSInterop
@using RazorReaper.Services.Overlay
@using RazorReaper.Components.Shared
@using RazorReaper.Services.Localization
@inject INotifierClientService NotifierClient
@inject ILocalizer Localizer
@inject IJSRuntime JS
@implements IDisposable

<header class="page-header">
    <h1 class="page-title">@Localizer.T("notifier.title")</h1>
    <p class="page-subtitle">@Localizer.T("notifier.subtitle")</p>
</header>

<div class="nt-page">

    <StatusHeader State="@StatusState" Label="@StatusLabel" Description="@NotifierClient.StateDetail">
        <Actions>
            @if (IsConnectingOrConnected)
            {
                <button class="btn btn-danger" @onclick="Disconnect">@Localizer.T("notifier.disconnect")</button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="Connect" disabled="@(!CanConnect)">@Localizer.T("notifier.connect")</button>
            }
            <button class="btn btn-secondary" data-sound-skip="true" @onclick="() => NotifierClient.TestAlert()">@Localizer.T("notifier.testalert")</button>
        </Actions>
    </StatusHeader>

    <div class="nt-grid">

        @* ── Endpoint ────────────────────────────────────────────────────── *@
        <div class="content-card nt-card">
            <h3 class="nt-card-title">@Localizer.T("notifier.endpoint.title")</h3>
            <p class="nt-card-desc">@Localizer.T("notifier.endpoint.description")</p>

            <div class="nt-rows">
                <SettingRow Title="@Localizer.T("notifier.endpoint.url.title")" Description="@Localizer.T("notifier.endpoint.url.description")">
                    <input class="nt-input nt-input-wide" type="url" spellcheck="false"
                           placeholder="https://…" @bind="_endpointDraft" @bind:after="ApplyEndpoint" />
                </SettingRow>
            </div>

            <div class="nt-note">
                <p>
                    @Localizer.T("notifier.endpoint.note.lead")
                    <strong>@Localizer.T("notifier.testalert")</strong>
                    @Localizer.T("notifier.endpoint.note.rest")
                </p>
            </div>
        </div>

        @* ── Alert types ─────────────────────────────────────────────────── *@
        <div class="content-card nt-card">
            <h3 class="nt-card-title">@Localizer.T("notifier.types.title")</h3>
            <p class="nt-card-desc">@Localizer.T("notifier.types.description")</p>

            <div class="nt-rows">
                @foreach (var def in NotifierClient.TypeDefs)
                {
                    <SettingRow Title="@Localizer.T(def.LabelKey)" Description="@Localizer.T(def.DescriptionKey)">
                        <div class="nt-type-control">
                            <Dropdown Value="@NotifierClient.GetTypeSound(def.Type).ToString()"
                                      ValueChanged="v => OnTypeSound(def.Type, v)"
                                      Options="SoundOptions" />
                            <button class="nt-mini" data-sound-skip="true" @onclick="() => NotifierClient.TestAlert(def.Type)">@Localizer.T("notifier.test")</button>
                            <Switch Value="NotifierClient.IsTypeEnabled(def.Type)"
                                    ValueChanged="v => NotifierClient.SetTypeEnabled(def.Type, v)" />
                        </div>
                    </SettingRow>
                }
            </div>
        </div>

        @* ── Rare dino filter ────────────────────────────────────────────── *@
        <div class="content-card nt-card">
            <div class="nt-card-head">
                <div>
                    <h3 class="nt-card-title">@Localizer.T("notifier.species.title")</h3>
                    <p class="nt-card-desc">
                        @Localizer.T("notifier.species.description", Localizer.T("notifier.type.rare-dino.label"))
                        <span class="nt-count">@Localizer.T("notifier.species.count", SpeciesEnabledCount, NotifierClient.Species.Count)</span>
                    </p>
                </div>
                <div class="nt-head-actions">
                    <button class="nt-mini" @onclick="() => NotifierClient.SetAllSpecies(true)">@Localizer.T("common.all")</button>
                    <button class="nt-mini" @onclick="() => NotifierClient.SetAllSpecies(false)">@Localizer.T("notifier.species.none")</button>
                </div>
            </div>

            <div class="nt-species-grid @(RareEnabled ? "" : "is-disabled")">
                @foreach (var sp in NotifierClient.Species)
                {
                    <button class="nt-chip @(NotifierClient.IsSpeciesEnabled(sp.Id) ? "on" : "")"
                            disabled="@(!RareEnabled)"
                            @onclick="() => ToggleSpecies(sp.Id)">@sp.Name</button>
                }
            </div>
        </div>

        @* ── Clusters ────────────────────────────────────────────────────── *@
        <div class="content-card nt-card">
            <h3 class="nt-card-title">@Localizer.T("notifier.clusters.title")</h3>
            <p class="nt-card-desc">@Localizer.T("notifier.clusters.description")</p>

            <div class="nt-rows">
                @foreach (var c in NotifierClient.Clusters)
                {
                    <div class="nt-cluster-row">
                        <input class="nt-input" type="text" spellcheck="false"
                               value="@c.Label" @onchange="e => OnClusterLabel(c.Id, e)" />
                        <Switch Value="c.Enabled" ValueChanged="v => NotifierClient.SetClusterEnabled(c.Id, v)" />
                    </div>
                }
            </div>
        </div>

        @* ── Tribe log triggers ──────────────────────────────────────────── *@
        <div class="content-card nt-card">
            <h3 class="nt-card-title">@Localizer.T("notifier.tribelog.title")</h3>
            <p class="nt-card-desc">@Localizer.T("notifier.tribelog.description", Localizer.T("notifier.type.tribe-log.label"))</p>

            <textarea class="nt-input nt-triggers" spellcheck="false" rows="5"
                      placeholder="@Localizer.T("notifier.tribelog.placeholder")"
                      value="@_tribeTriggersDraft"
                      @onchange="ApplyTribeTriggers"></textarea>
        </div>

    </div>

    @* ── Watched channels (managed live via the backend) ──────────────────── *@
    <div class="content-card nt-card nt-channels-card">
        <div class="nt-card-head">
            <div>
                <h3 class="nt-card-title">@Localizer.T("notifier.channels.title")</h3>
                <p class="nt-card-desc">@Localizer.T("notifier.channels.description")</p>
            </div>
            <div class="nt-head-actions">
                <button class="nt-mini" @onclick="() => LoadChannels(false)" disabled="@_channelsBusy">@Localizer.T("notifier.channels.refresh")</button>
            </div>
        </div>

        <div class="nt-channel-add">
            <input class="nt-input nt-chan-id" type="text" spellcheck="false" inputmode="numeric"
                   placeholder="@Localizer.T("notifier.channels.id.placeholder")" @bind="_newChannelId" />
            <input class="nt-input nt-chan-cluster" type="text" spellcheck="false"
                   placeholder="@Localizer.T("notifier.channels.cluster.placeholder")" @bind="_newCluster" />
            <Dropdown @bind-Value="_newType" Options="ChannelTypeOptions" />
            <button class="nt-mini nt-chan-add" @onclick="AddChannel"
                    disabled="@(_channelsBusy || string.IsNullOrWhiteSpace(_newChannelId))">@Localizer.T("notifier.channels.add")</button>
        </div>

        @if (!string.IsNullOrEmpty(_channelError))
        {
            <div class="nt-channel-error">@_channelError</div>
        }

        @if (_watchedChannels.Count == 0)
        {
            <div class="nt-empty">
                @Localizer.T("notifier.channels.empty.lead")
                <strong>@Localizer.T("notifier.channels.refresh")</strong>
                @Localizer.T("notifier.channels.empty.rest")
            </div>
        }
        else
        {
            <div class="nt-channel-list">
                @foreach (var ch in _watchedChannels)
                {
                    <div class="nt-channel-row">
                        <span class="nt-type-chip nt-type-@TypeCssFromKey(ch.Type)">@ChannelTypeLabel(ch.Type)</span>
                        <span class="nt-chan-cluster-label">@ch.Cluster</span>
                        <span class="nt-chan-id-label">@ch.ChannelId</span>
                        <button class="nt-chan-remove" title="@Localizer.T("notifier.channels.remove")" data-sound-skip="true"
                                @onclick="() => RemoveChannel(ch.ChannelId)" disabled="@_channelsBusy">&times;</button>
                    </div>
                }
            </div>
        }
    </div>

    @* ── Recent alerts ───────────────────────────────────────────────────── *@
    <div class="content-card nt-card nt-recent-card">
        <h3 class="nt-card-title">@Localizer.T("notifier.recent.title")</h3>
        <p class="nt-card-desc">@Localizer.T("notifier.recent.description")</p>

        @{
            var recent = NotifierClient.RecentAlerts;
        }
        @if (recent.Count == 0)
        {
            <div class="nt-empty">@Localizer.T("notifier.recent.empty")</div>
        }
        else
        {
            <div class="nt-alert-list">
                @foreach (var a in recent)
                {
                    <div class="nt-alert-row">
                        <span class="nt-type-chip nt-type-@TypeCss(a.Type)">@TypeShort(a.Type)</span>
                        <div class="nt-alert-text">@a.Text</div>
                        <span class="nt-alert-time">@a.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                    </div>
                }
            </div>
        }
    </div>

</div>

@code {
    [CascadingParameter(Name = "Language")]
    private string? Language { get; set; }

    private string _endpointDraft = "";
    private string _tribeTriggersDraft = "";

    // Watched-channel manager state.
    private List<NotifierWatchedChannel> _watchedChannels = new();
    private string _newChannelId = "";
    private string _newCluster = "";
    private string _newType = "osd";
    private bool _channelsBusy;
    private string _channelError = "";

    protected override void OnInitialized()
    {
        _endpointDraft = NotifierClient.Endpoint;
        _tribeTriggersDraft = string.Join('\n', NotifierClient.TribeTriggers);
        NotifierClient.Changed += OnChanged;
        NotifierClient.AlertReceived += OnAlertReceived;

        // Best-effort silent load so the list is populated when a backend is already configured.
        if (!string.IsNullOrWhiteSpace(NotifierClient.Endpoint))
            _ = LoadChannels(quiet: true);
    }

    // ── Alert types ─────────────────────────────────────────────────────────

    // Computed, not a property initializer: a list built once cannot see the localizer and would
    // keep the language it was built in for the rest of the session.
    private IReadOnlyList<Dropdown.Option> SoundOptions => new List<Dropdown.Option>
    {
        new(nameof(NotifierSound.None), Localizer.T("notifier.sound.silent")),
        new(nameof(NotifierSound.Notification), Localizer.T("notifier.sound.notification")),
        new(nameof(NotifierSound.Click), Localizer.T("notifier.sound.click"))
    };

    private void OnTypeSound(NotifierAlertType type, string value)
    {
        if (Enum.TryParse<NotifierSound>(value, out var sound))
            NotifierClient.SetTypeSound(type, sound);
    }

    // ── Watched channels ────────────────────────────────────────────────────

    private IReadOnlyList<Dropdown.Option> ChannelTypeOptions => new List<Dropdown.Option>
    {
        new("rare-dino", ChannelTypeLabel("rare-dino")),
        new("resource", ChannelTypeLabel("resource")),
        new("element-node", ChannelTypeLabel("element-node")),
        new("osd", ChannelTypeLabel("osd")),
        new("tribe-log", ChannelTypeLabel("tribe-log"))
    };

    /// <summary>
    /// The backend's own type key, worded. An unknown key is shown as it arrived — the backend
    /// may learn a type this build does not know about.
    /// </summary>
    private string ChannelTypeLabel(string type) => type switch
    {
        "rare-dino" => Localizer.T("notifier.channeltype.rare-dino"),
        "resource" => Localizer.T("notifier.channeltype.resource"),
        "element-node" => Localizer.T("notifier.channeltype.element-node"),
        "osd" => Localizer.T("notifier.channeltype.osd"),
        "tribe-log" => Localizer.T("notifier.channeltype.tribe-log"),
        _ => type
    };

    private async Task LoadChannels(bool quiet)
    {
        _channelsBusy = true;
        if (!quiet) _channelError = "";
        try
        {
            _watchedChannels = (await NotifierClient.GetWatchedChannelsAsync()).ToList();
            if (quiet) _channelError = "";
        }
        catch (Exception ex)
        {
            if (!quiet) _channelError = ex.Message;
        }
        finally
        {
            _channelsBusy = false;
            StateHasChanged();
        }
    }

    private async Task AddChannel()
    {
        if (string.IsNullOrWhiteSpace(_newChannelId)) return;
        _channelsBusy = true;
        _channelError = "";
        try
        {
            _watchedChannels = (await NotifierClient.AddWatchedChannelAsync(_newChannelId.Trim(), _newCluster ?? "", _newType ?? "osd")).ToList();
            _newChannelId = "";
            _newCluster = "";
        }
        catch (Exception ex)
        {
            _channelError = ex.Message;
        }
        finally
        {
            _channelsBusy = false;
            StateHasChanged();
        }
    }

    private async Task RemoveChannel(string channelId)
    {
        _channelsBusy = true;
        _channelError = "";
        try
        {
            _watchedChannels = (await NotifierClient.RemoveWatchedChannelAsync(channelId)).ToList();
        }
        catch (Exception ex)
        {
            _channelError = ex.Message;
        }
        finally
        {
            _channelsBusy = false;
            StateHasChanged();
        }
    }

    private static string TypeCssFromKey(string type) => type switch
    {
        "rare-dino" => "dino",
        "resource" => "resource",
        "element-node" => "element",
        _ => "osd"
    };

    private void ApplyTribeTriggers(ChangeEventArgs e)
    {
        var raw = e?.Value?.ToString() ?? "";
        _tribeTriggersDraft = raw;
        NotifierClient.SetTribeTriggers(raw.Split('\n'));
    }

    private void OnChanged() => this.DispatchRender(() => InvokeAsync(StateHasChanged));

    private void OnAlertReceived(NotifierAlert alert)
    {
        this.DispatchRender(() => InvokeAsync(async () =>
        {
            await PlaySound(NotifierClient.GetTypeSound(alert.Type));
            StateHasChanged();
        }));
    }

    // ── Status header ──────────────────────────────────────────────────────

    private bool IsConnectingOrConnected =>
        NotifierClient.State is NotifierConnectionState.Connected or NotifierConnectionState.Connecting;

    private bool CanConnect => !string.IsNullOrWhiteSpace(NotifierClient.Endpoint);

    private string StatusState => NotifierClient.State switch
    {
        NotifierConnectionState.Connected => "online",
        NotifierConnectionState.Connecting => "warning",
        NotifierConnectionState.Error => "error",
        _ => "off"
    };

    private string StatusLabel => Localizer.T(NotifierClient.State switch
    {
        NotifierConnectionState.Connected => "notifier.status.connected",
        NotifierConnectionState.Connecting => "notifier.status.connecting",
        NotifierConnectionState.Error => "notifier.status.error",
        _ => "notifier.status.disconnected"
    });

    // ── Filters ────────────────────────────────────────────────────────────

    private bool RareEnabled => NotifierClient.IsTypeEnabled(NotifierAlertType.RareDino);

    private int SpeciesEnabledCount => NotifierClient.Species.Count(s => NotifierClient.IsSpeciesEnabled(s.Id));

    private void ToggleSpecies(string id) => NotifierClient.SetSpeciesEnabled(id, !NotifierClient.IsSpeciesEnabled(id));

    private void ApplyEndpoint() => NotifierClient.SetEndpoint(_endpointDraft ?? "");

    private void OnClusterLabel(string id, ChangeEventArgs e)
        => NotifierClient.SetClusterLabel(id, e?.Value?.ToString() ?? "");

    // ── Actions ────────────────────────────────────────────────────────────

    private void Connect() => NotifierClient.Start();

    private void Disconnect() => NotifierClient.Stop();

    private async Task PlaySound(NotifierSound sound)
    {
        try
        {
            switch (sound)
            {
                case NotifierSound.Notification:
                    await JS.InvokeVoidAsync("playNotificationSound");
                    break;
                case NotifierSound.Click:
                    await JS.InvokeVoidAsync("playClickSound");
                    break;
            }
        }
        catch
        {
            // Sound playback failures must never bubble up.
        }
    }

    // ── Alert chip mapping ─────────────────────────────────────────────────

    private string TypeShort(NotifierAlertType type) => Localizer.T(type switch
    {
        NotifierAlertType.RareDino => "notifier.chip.dino",
        NotifierAlertType.Resource => "notifier.chip.resource",
        NotifierAlertType.ElementNode => "notifier.chip.element",
        _ => "notifier.chip.osd"
    });

    private static string TypeCss(NotifierAlertType type) => type switch
    {
        NotifierAlertType.RareDino => "dino",
        NotifierAlertType.Resource => "resource",
        NotifierAlertType.ElementNode => "element",
        _ => "osd"
    };

    // Singleton client keeps running when the user navigates away; only detach handlers.
    public void Dispose()
    {
        this.StopRenderDispatch();
        NotifierClient.Changed -= OnChanged;
        NotifierClient.AlertReceived -= OnAlertReceived;
    }
}
