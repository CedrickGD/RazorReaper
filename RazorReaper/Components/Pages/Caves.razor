@page "/caves"
@using Microsoft.Extensions.Logging
@using RazorReaper.Services

@inject ILogger<Caves> Logger
@inject INotificationService NotificationService
@inject IActivityService ActivityService

<div class="caves-page">
    <header class="page-header">
        <h1 class="page-title">Cave Database</h1>
        <p class="page-subtitle">Artifact and resource caves with entrances, hazards, and loot notes.</p>
    </header>

    <div class="caves-map-selector">
        @foreach (var map in CaveDatabase.Maps)
        {
            <button @key="map"
                    class="caves-map-chip @(map == selectedMap ? "active" : "")"
                    @onclick="() => SelectMap(map)">
                <span class="caves-map-chip-name">@map</span>
                <span class="caves-map-chip-count">@CountFor(map)</span>
            </button>
        }
    </div>

    <div class="caves-body">
        <section class="content-card caves-list-card">
            <div class="caves-list-header">
                <h3>@selectedMap</h3>
                <span class="caves-list-count">@currentCaves.Count caves</span>
            </div>
            <div class="caves-list">
                @foreach (var cave in currentCaves)
                {
                    <button @key="cave.Name"
                            class="cave-row @(cave == selectedCave ? "active" : "")"
                            @onclick="() => SelectCave(cave)">
                        <span class="cave-diff-dot @DiffClass(cave.Difficulty)"></span>
                        <span class="cave-row-text">
                            <span class="cave-row-name">@cave.Name</span>
                            <span class="cave-row-sub">@(cave.Artifact ?? "No artifact")</span>
                        </span>
                    </button>
                }
            </div>
        </section>

        <section class="content-card caves-detail-card">
            @if (selectedCave is null)
            {
                <p class="cave-empty">Select a cave to see its details.</p>
            }
            else
            {
                <div class="cave-image-slot">
                    @if (string.IsNullOrEmpty(selectedCave.ImagePath))
                    {
                        <div class="cave-image-placeholder">
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 16.5 10 4l7 12.5H3Z" />
                                <path d="M7.6 16.5a2.4 2.4 0 0 1 4.8 0" />
                            </svg>
                            <span>No image yet</span>
                        </div>
                    }
                    else
                    {
                        <img class="cave-image" src="@selectedCave.ImagePath" alt="@selectedCave.Name" />
                    }
                </div>

                <div class="cave-detail-header">
                    <div class="cave-detail-titles">
                        <h3 class="cave-detail-title">@selectedCave.Name</h3>
                        <span class="cave-detail-map">@selectedCave.Map</span>
                    </div>
                    <span class="cave-diff-chip @DiffClass(selectedCave.Difficulty)">@selectedCave.Difficulty</span>
                </div>

                <div class="cave-detail-rows">
                    <div class="cave-detail-row">
                        <span class="cave-detail-label">Artifact</span>
                        <span class="cave-detail-value">@(selectedCave.Artifact ?? "None")</span>
                    </div>

                    <div class="cave-detail-row">
                        <span class="cave-detail-label">Entrance</span>
                        <span class="cave-detail-value cave-coords-value">
                            @if (selectedCave.Lat is not null && selectedCave.Lon is not null)
                            {
                                <span class="cave-coords">Lat @FormatCoord(selectedCave.Lat.Value) / Lon @FormatCoord(selectedCave.Lon.Value)</span>
                            }
                            else
                            {
                                <span class="cave-coords">Not documented</span>
                            }
                            @if (!string.IsNullOrEmpty(selectedCave.SetPlayerPos))
                            {
                                <button class="cave-copy-btn" @onclick="CopyTeleport">
                                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="7" y="7" width="9" height="9" rx="1.5" />
                                        <path d="M13 7V5.5A1.5 1.5 0 0 0 11.5 4h-6A1.5 1.5 0 0 0 4 5.5v6A1.5 1.5 0 0 0 5.5 13H7" />
                                    </svg>
                                    <span>Copy teleport</span>
                                </button>
                            }
                        </span>
                    </div>

                    <div class="cave-detail-row">
                        <span class="cave-detail-label">Hazards</span>
                        <span class="cave-detail-value">
                            <span class="cave-hazard-chips">
                                @foreach (var hazard in selectedCave.Hazards)
                                {
                                    <span @key="hazard" class="cave-hazard-chip">@hazard</span>
                                }
                            </span>
                        </span>
                    </div>

                    <div class="cave-detail-row">
                        <span class="cave-detail-label">Loadout</span>
                        <span class="cave-detail-value">@selectedCave.Loadout</span>
                    </div>

                    <div class="cave-detail-row">
                        <span class="cave-detail-label">Loot</span>
                        <span class="cave-detail-value">@selectedCave.Loot</span>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@code {
    private string selectedMap = CaveDatabase.Maps[0];
    private List<CaveEntry> currentCaves = new();
    private CaveEntry? selectedCave;

    protected override void OnInitialized()
    {
        RefreshList();
    }

    private void SelectMap(string map)
    {
        if (map == selectedMap)
            return;

        selectedMap = map;
        RefreshList();
    }

    private void SelectCave(CaveEntry cave)
    {
        selectedCave = cave;
    }

    private void RefreshList()
    {
        currentCaves = CaveDatabase.All.Where(c => c.Map == selectedMap).ToList();
        selectedCave = currentCaves.FirstOrDefault();
    }

    private int CountFor(string map)
        => CaveDatabase.All.Count(c => c.Map == map);

    private static string DiffClass(CaveDifficulty difficulty) => difficulty switch
    {
        CaveDifficulty.Easy => "diff-easy",
        CaveDifficulty.Medium => "diff-medium",
        _ => "diff-hard"
    };

    private static string FormatCoord(double value)
        => value.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);

    private async Task CopyTeleport()
    {
        if (selectedCave?.SetPlayerPos is not { Length: > 0 } command)
            return;

        try
        {
            await Clipboard.Default.SetTextAsync(command);
            NotificationService.ShowSuccess("Teleport command copied.");
            ActivityService.AddActivity($"Copied cave teleport: {selectedCave.Name}", "info");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to copy cave teleport command");
            NotificationService.ShowError("Failed to copy the command.");
        }
    }
}
