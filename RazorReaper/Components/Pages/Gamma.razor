@page "/gamma"
@using System.Globalization
@using Microsoft.Extensions.Logging
@using RazorReaper.Services.Gamma
@using RazorReaper.Components.Shared
@using RazorReaper.Services.Localization
@inject IGammaService GammaSvc
@inject ILocalizer Localizer
@inject IJSRuntime JSRuntime
@inject ILogger<Gamma> Logger
@implements IDisposable

<header class="page-header">
    <h1 class="page-title">@Localizer.T("gamma.title")</h1>
    <p class="page-subtitle">@Localizer.T("gamma.subtitle")</p>
</header>

<div class="gm-page">

    <StatusHeader State="@(GammaSvc.IsListening ? "online" : "off")"
                  Label="@Localizer.T(GammaSvc.IsListening ? "gamma.status.listening" : "gamma.status.off")"
                  Description="@StatusDescription">
        <Actions>
            @if (GammaSvc.IsListening)
            {
                <button class="btn btn-danger" @onclick="StopListening">@Localizer.T("gamma.stop")</button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="StartListening">@Localizer.T("gamma.start")</button>
            }
            <button class="btn btn-secondary" @onclick="ResetToDefault">@Localizer.T("gamma.reset")</button>
        </Actions>
    </StatusHeader>

    @if (_listenError)
    {
        <div class="gm-note gm-note-warn">
            <p>@Localizer.T("gamma.hookerror")</p>
        </div>
    }

    <div class="gm-grid">

        @* ── Live preview ────────────────────────────────────────────────── *@
        <div class="content-card gm-card">
            <h3 class="gm-card-title">@Localizer.T("gamma.preview.title")</h3>
            <p class="gm-card-desc">@Localizer.T("gamma.preview.description")</p>

            <div class="gm-preview-value-row">
                <span class="gm-preview-value">@FormatGamma(GammaSvc.CurrentGamma)</span>
                <span class="gm-preview-unit">@Localizer.T("gamma.preview.unit")</span>
            </div>

            @* step 0.01, and the drag is the apply — same as the interface-scale slider.
               There is no separate commit: GammaService.Preview and ApplyValue are the
               same call, so the old "Apply / test" button did nothing the drag hadn't
               already done. *@
            @* NOT @bind. @bind formats the double with the current culture, and this machine
               runs de-DE, so it emitted value="1,30". A range input only accepts a dot
               decimal, so Chromium threw the value away and fell back to the midpoint of
               min/max — 1.30 for 0.10..2.50 — which is why the thumb sat still while the
               readout moved. Invariant both ways. *@
            <input type="range" class="gm-slider"
                   min="0.10" max="2.50" step="0.01"
                   value="@PreviewValue.ToString("0.00", CultureInfo.InvariantCulture)"
                   @oninput="OnSliderInput"
                   @onpointerdown="() => _dragging = true"
                   @onpointerup="EndDrag"
                   @onpointercancel="EndDrag" />

            <div class="gm-slider-scale">
                <span>0.10</span>
                <span>1.00</span>
                <span>2.50</span>
            </div>

        </div>

        @* ── Presets ─────────────────────────────────────────────────────── *@
        <div class="content-card gm-card">
            <h3 class="gm-card-title">@Localizer.T("gamma.presets.title")</h3>
            <p class="gm-card-desc">@Localizer.T("gamma.presets.description")</p>

            <div class="gm-preset-list">
                @foreach (var p in GammaSvc.Presets)
                {
                    <div class="gm-preset-row">
                        <input class="gm-preset-name" type="text" spellcheck="false"
                               @bind="p.Name" @bind:after="() => GammaSvc.UpdatePreset(p.Id, name: p.Name)" />
                        @* Same culture trap as the slider: type="number" is dot-only too,
                           so @bind wrote "0,5" and the field could not be edited. *@
                        <input class="gm-preset-val" type="number" min="0.10" max="2.50" step="0.05"
                               value="@p.Value.ToString("0.##", CultureInfo.InvariantCulture)"
                               @onchange="@(e => OnPresetValueChanged(p, e))" />
                        <div class="gm-preset-cycle">
                            <Switch Value="p.InCycle" Compact="true"
                                    ValueChanged="@((bool v) => GammaSvc.UpdatePreset(p.Id, inCycle: v))" />
                            <span class="gm-preset-cycle-label">@Localizer.T("gamma.preset.cycle")</span>
                        </div>
                        <button class="btn btn-secondary gm-preset-apply" @onclick="() => GammaSvc.ApplyPreset(p.Id)">@Localizer.T("gamma.preset.apply")</button>
                    </div>
                }
            </div>
        </div>

        @* ── Trigger mode ────────────────────────────────────────────────── *@
        <div class="content-card gm-card">
            <h3 class="gm-card-title">@Localizer.T("gamma.triggers.title")</h3>
            <p class="gm-card-desc">@Localizer.T("gamma.triggers.description")</p>

            <div class="gm-seg">
                <button class="gm-seg-btn @(GammaSvc.Mode == TriggerMode.Cycle ? "active" : "")"
                        @onclick="() => GammaSvc.SetMode(TriggerMode.Cycle)">@Localizer.T("gamma.trigger.cycle")</button>
                <button class="gm-seg-btn @(GammaSvc.Mode == TriggerMode.Direct ? "active" : "")"
                        @onclick="() => GammaSvc.SetMode(TriggerMode.Direct)">@Localizer.T("gamma.trigger.direct")</button>
            </div>

            @if (GammaSvc.Mode == TriggerMode.Cycle)
            {
                <div class="gm-trigger-list">
                    <div class="gm-trigger-row">
                        <span class="gm-trigger-label">@Localizer.T("gamma.trigger.advance")</span>
                        @{ var cyc = GammaSvc.CycleTrigger; }
                        <button class="gm-capture-btn @(IsCapturing("cycle") ? "capturing" : "")"
                                @onclick='() => BeginCapture("cycle")'>
                            @(IsCapturing("cycle")
                                ? Localizer.T("gamma.trigger.capturing")
                                : cyc.IsEmpty ? Localizer.T("gamma.trigger.set") : cyc.Describe())
                        </button>
                        @if (!cyc.IsEmpty && !IsCapturing("cycle"))
                        {
                            <button class="gm-trigger-clear" title="@Localizer.T("common.clear")" @onclick="() => GammaSvc.SetCycleTrigger(TriggerInput.None)">×</button>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="gm-trigger-list">
                    @foreach (var p in GammaSvc.Presets)
                    {
                        var binding = GammaSvc.DirectBindings.FirstOrDefault(b => b.PresetId == p.Id);
                        var trig = binding?.Trigger ?? TriggerInput.None;
                        var target = "preset:" + p.Id;
                        <div class="gm-trigger-row">
                            <span class="gm-trigger-label">@p.Name</span>
                            <button class="gm-capture-btn @(IsCapturing(target) ? "capturing" : "")"
                                    @onclick="() => BeginCapture(target)">
                                @(IsCapturing(target)
                                    ? Localizer.T("gamma.trigger.capturing")
                                    : trig.IsEmpty ? Localizer.T("gamma.trigger.set") : trig.Describe())
                            </button>
                            @if (!trig.IsEmpty && !IsCapturing(target))
                            {
                                <button class="gm-trigger-clear" title="@Localizer.T("common.clear")" @onclick="() => GammaSvc.RemoveDirectBinding(trig)">×</button>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* ── Monitors ────────────────────────────────────────────────────── *@
        <div class="content-card gm-card">
            <h3 class="gm-card-title">@Localizer.T("gamma.monitors.title")</h3>
            <p class="gm-card-desc">@Localizer.T("gamma.monitors.description")</p>

            <SettingRow Title="@Localizer.T("gamma.monitors.all")" Description="@Localizer.T("gamma.monitors.all.description")">
                <Switch Value="GammaSvc.ApplyToAllMonitors"
                        ValueChanged="@((bool v) => GammaSvc.SetTargets(v, GammaSvc.SelectedMonitors))" />
            </SettingRow>

            @if (!GammaSvc.ApplyToAllMonitors)
            {
                <div class="gm-monitor-list">
                    @if (_monitors.Count == 0)
                    {
                        <p class="gm-empty">@Localizer.T("gamma.monitors.empty")</p>
                    }
                    else
                    {
                        @foreach (var m in _monitors)
                        {
                            var selected = GammaSvc.SelectedMonitors.Contains(m.DeviceName);
                            @* The whole row is the hit target. The checkbox is a button, so its
                               click would bubble up here and toggle a second time — hence the
                               wrapper that swallows it. *@
                            <div class="gm-monitor-row" @onclick="() => ToggleMonitor(m.DeviceName, !selected)">
                                <span class="gm-monitor-check" @onclick:stopPropagation="true">
                                    <CheckBox Value="@selected"
                                              ValueChanged="@(v => ToggleMonitor(m.DeviceName, v))" />
                                </span>
                                <span class="gm-monitor-name">@m.FriendlyName</span>
                                @if (m.IsPrimary)
                                {
                                    <span class="gm-monitor-tag">@Localizer.T("gamma.monitor.primary")</span>
                                }
                            </div>
                        }
                    }
                </div>
            }
        </div>

    </div>

    @* ── G HUB export ─────────────────────────────────────────────────────── *@
    @* The script used to sit in a 12-row textarea that owned a third of the page for
       something you read once and paste into G HUB. It opens in its own window now. *@
    <div class="content-card gm-card gm-lua-card">
        <div class="gm-lua-head">
            <div>
                <h3 class="gm-card-title">@Localizer.T("gamma.lua.title")</h3>
                <p class="gm-card-desc">@Localizer.T("gamma.lua.description")</p>
            </div>
            <div class="gm-lua-actions">
                <button class="btn btn-secondary" @onclick="() => _luaOpen = true">@Localizer.T("gamma.lua.view")</button>
                <button class="btn btn-primary" @onclick="CopyLua">@CopyLabel</button>
            </div>
        </div>
    </div>

    <div class="gm-note">
        <p>@Localizer.T("gamma.note")</p>
    </div>

</div>

@if (_luaOpen)
{
    @* Click the backdrop or press Escape to dismiss — @onkeydown needs the tabindex to
       fire, and autofocus puts the key handler in reach without a click first. *@
    <div class="gm-modal-overlay" @onclick="() => _luaOpen = false">
        <div class="gm-modal" @onclick:stopPropagation="true"
             tabindex="0" autofocus
             @onkeydown="OnLuaKeyDown">
            <div class="gm-modal-head">
                <h3 class="gm-card-title">@Localizer.T("gamma.lua.title")</h3>
                <div class="gm-lua-actions">
                    <button class="btn btn-primary" @onclick="CopyLua">@CopyLabel</button>
                    <button class="btn btn-secondary" @onclick="() => _luaOpen = false">@Localizer.T("common.close")</button>
                </div>
            </div>
            <textarea class="gm-lua-area" readonly spellcheck="false">@_lua</textarea>
        </div>
    </div>
}

@code {
    [CascadingParameter(Name = "Language")]
    private string? Language { get; set; }

    private double PreviewValue { get; set; } = GammaPresets.Default;
    private IReadOnlyList<GammaMonitor> _monitors = Array.Empty<GammaMonitor>();
    private string _lua = "";

    // A bool, not the label itself: a field initialised to "Copy" is baked in at compile time
    // and would still say Copy in a Russian window.
    private bool _copied;
    private string? _capturingTarget;
    private bool _listenError;
    private bool _luaOpen;

    private void OnLuaKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _luaOpen = false;
    }

    private string CopyLabel => Localizer.T(_copied ? "gamma.copied" : "gamma.copy");

    private string StatusDescription
    {
        get
        {
            var modeText = Localizer.T(GammaSvc.Mode == TriggerMode.Cycle ? "gamma.mode.cycle" : "gamma.mode.direct");
            return Localizer.T(GammaSvc.IsListening ? "gamma.status.watching" : "gamma.status.idle", modeText);
        }
    }

    protected override void OnInitialized()
    {
        GammaSvc.StateChanged += OnStateChanged;
        PreviewValue = GammaSvc.CurrentGamma;
        RefreshMonitors();
        _lua = GammaSvc.GenerateLua();
    }

    /// <summary>
    /// True while the thumb is held. Preview() raises StateChanged on every input event, so
    /// without this the handler below wrote CurrentGamma straight back into the slider
    /// mid-drag and the thumb fought the cursor — which is what made this feel broken.
    /// </summary>
    private bool _dragging;

    private void OnStateChanged()
    {
        _lua = GammaSvc.GenerateLua();

        // Do NOT write the slider's own value back into it mid-drag. Preview() raises
        // StateChanged on every input event, so this handler runs constantly while you
        // drag; assigning PreviewValue here made the thumb fight the cursor. A hotkey or
        // preset firing while you are not dragging should still move it, hence the guard
        // rather than removing the assignment.
        //
        // Renders are NOT suppressed during the drag. An earlier attempt overrode
        // ShouldRender to skip them, which desynced the readout, the thumb and the CSS
        // fill from each other — the fill is painted by sliders.js from input events, so
        // freezing renders left three different values on screen at once.
        if (!_dragging)
        {
            PreviewValue = GammaSvc.CurrentGamma;
        }

        this.DispatchRender(() => InvokeAsync(StateHasChanged), Logger);
    }

    private void EndDrag()
    {
        _dragging = false;
        PreviewValue = GammaSvc.CurrentGamma;
    }

    private void RefreshMonitors()
    {
        try { _monitors = GammaSvc.ListMonitors(); }
        catch (Exception ex) { Logger.LogWarning(ex, "Gamma ListMonitors failed"); }
    }

    private static string FormatGamma(double g) => g.ToString("0.00", CultureInfo.InvariantCulture);

    // ── Preview ─────────────────────────────────────────────────────────────

    /// <summary>
    /// Parses invariant, because the element always reports a dot decimal regardless of the
    /// user's locale. Applying is the whole interaction — there is no separate commit.
    /// </summary>
    private void OnSliderInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var value))
        {
            PreviewValue = value;
            GammaSvc.Preview(value);
        }
    }

    /// <summary>
    /// Presets is a defensive copy, so writing to the row would go nowhere — UpdatePreset
    /// is what persists, and its StateChanged re-renders the row from the service.
    /// </summary>
    private void OnPresetValueChanged(PresetConfig preset, ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var value))
        {
            GammaSvc.UpdatePreset(preset.Id, value: value);
        }
    }

    // ── Listening / reset ───────────────────────────────────────────────────

    private void StartListening()
    {
        _listenError = !GammaSvc.StartListening();
    }

    private void StopListening()
    {
        _listenError = false;
        GammaSvc.StopListening();
    }

    private void ResetToDefault()
    {
        GammaSvc.ResetToDefault();
        PreviewValue = GammaSvc.CurrentGamma;
    }

    // ── Trigger capture ─────────────────────────────────────────────────────

    private bool IsCapturing(string target) => _capturingTarget == target;

    private void BeginCapture(string target)
    {
        // Only one capture at a time — cancel any in-flight capture first.
        if (_capturingTarget != null)
            GammaSvc.CancelCapture();

        _capturingTarget = target;
        StateHasChanged();

        GammaSvc.BeginCapture(
            onCaptured: trigger => this.DispatchRender(() => InvokeAsync(() => OnTriggerCaptured(target, trigger)), Logger),
            onCancelled: () => this.DispatchRender(() => InvokeAsync(() => OnCaptureCancelled(target)), Logger));
    }

    private void OnTriggerCaptured(string target, TriggerInput trigger)
    {
        if (_capturingTarget == target)
            _capturingTarget = null;

        if (target == "cycle")
        {
            GammaSvc.SetCycleTrigger(trigger);
        }
        else if (target.StartsWith("preset:", StringComparison.Ordinal))
        {
            string presetId = target.Substring("preset:".Length);
            // Keep one trigger per preset: drop this preset's previous binding first.
            var existing = GammaSvc.DirectBindings.FirstOrDefault(b => b.PresetId == presetId);
            if (existing != null && !existing.Trigger.Equals(trigger))
                GammaSvc.RemoveDirectBinding(existing.Trigger);
            GammaSvc.SetDirectBinding(trigger, presetId);
        }

        StateHasChanged();
    }

    private void OnCaptureCancelled(string target)
    {
        if (_capturingTarget == target)
            _capturingTarget = null;
        StateHasChanged();
    }

    // ── Monitors ────────────────────────────────────────────────────────────

    private void ToggleMonitor(string deviceName, bool add)
    {
        var selected = GammaSvc.SelectedMonitors.ToList();
        if (add)
        {
            if (!selected.Contains(deviceName))
                selected.Add(deviceName);
        }
        else
        {
            selected.Remove(deviceName);
        }
        GammaSvc.SetTargets(false, selected);
    }

    // ── G HUB export ────────────────────────────────────────────────────────

    private async Task CopyLua()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _lua);
            _copied = true;
            StateHasChanged();
            await Task.Delay(1500);
            _copied = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Gamma Lua copy failed");
        }
    }

    // Deliberately does NOT stop listening — the service is a singleton that keeps
    // running (and firing triggers) when the user navigates away.
    public void Dispose()
    {
        this.StopRenderDispatch();
        GammaSvc.StateChanged -= OnStateChanged;
        if (_capturingTarget != null)
        {
            try { GammaSvc.CancelCapture(); } catch { }
            _capturingTarget = null;
        }
    }
}
