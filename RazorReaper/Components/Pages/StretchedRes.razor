@page "/stretched-res"
@using Microsoft.Extensions.Logging
@using RazorReaper.Services
@using RazorReaper.Services.Localization
@using RazorReaper.Components.Shared
@implements IDisposable
@inject IStretchedResService Stretched
@inject INotificationService NotificationService
@inject IUsageGateService UsageGate
@inject ILocalizer Localizer
@inject ILogger<StretchedRes> Logger

<header class="page-header">
    <h1 class="page-title">@Localizer.T("stretchedres.title")</h1>
    <p class="page-subtitle">@Localizer.T("stretchedres.subtitle")</p>
</header>

<div class="stretched-res-page">

    @* ============================================================
       CONFIRMATION — the safety gate. Only shows while a change is
       pending; a live countdown reverts automatically if ignored.
       It names the screen as well as the mode: on a second monitor
       the one that went black is the one you cannot read this on.
       ============================================================ *@
    @if (Stretched.IsPendingConfirmation)
    {
        <section class="content-card stretched-confirm-card">
            <div class="stretched-confirm-head">
                <div class="stretched-confirm-text">
                    <div class="stretched-confirm-title">@Localizer.T("stretchedres.confirm.title")</div>
                    <div class="stretched-confirm-sub">
                        @Localizer.T("stretchedres.confirm.sub",
                            Stretched.PendingResolution?.Label ?? Localizer.T("stretchedres.confirm.newmode"),
                            MonitorLabelFor(Stretched.PendingDeviceName),
                            Stretched.PreviousResolution?.Label ?? Localizer.T("stretchedres.confirm.previousmode"))
                    </div>
                </div>
                <div class="stretched-countdown" aria-live="polite">
                    @Stretched.SecondsRemaining<span class="stretched-countdown-unit">@Localizer.T("stretchedres.confirm.unit")</span>
                </div>
            </div>
            <div class="stretched-countdown-bar">
                <div class="stretched-countdown-fill" style="width: @CountdownPercentCss%"></div>
            </div>
            <div class="stretched-confirm-actions">
                <button class="btn btn-primary" @onclick="Keep">@Localizer.T("stretchedres.confirm.keep")</button>
                <button class="btn btn-secondary" @onclick="RevertNow">@Localizer.T("stretchedres.confirm.revert")</button>
            </div>
        </section>
    }

    @* ============================================================
       STATUS — current vs native resolution + detected GPU, for the
       screen a resolution was last applied to (from either section),
       falling back to the one the presets below are aimed at. Restore
       native acts on that same screen, so the button always takes back
       the change the card is describing.
       ============================================================ *@
    <section class="content-card">
        <StatusHeader State="@StatusState" Label="@StatusLabel" Description="@StatusDescription">
            <Actions>
                <button class="btn btn-secondary" @onclick="RestoreNative" disabled="@Stretched.IsPendingConfirmation">
                    @Localizer.T("stretchedres.status.restore")
                </button>
            </Actions>
        </StatusHeader>

        <div class="stretched-facts">
            <div class="stretched-fact">
                <div class="stretched-fact-label">@Localizer.T("stretchedres.fact.current")</div>
                <div class="stretched-fact-value">@CurrentLabel</div>
                <div class="stretched-fact-sub">@CurrentAspectSub</div>
            </div>
            <div class="stretched-fact">
                <div class="stretched-fact-label">@Localizer.T("stretchedres.fact.native")</div>
                <div class="stretched-fact-value">@NativeLabel</div>
                <div class="stretched-fact-sub">@Localizer.T("stretchedres.fact.native.sub")</div>
            </div>
            <div class="stretched-fact">
                <div class="stretched-fact-label">@Localizer.T("stretchedres.fact.gpu")</div>
                <div class="stretched-fact-value stretched-fact-value-sm">@GpuLabel</div>
                <div class="stretched-fact-sub">@GpuVendorSub</div>
            </div>
        </div>
    </section>

    @* ============================================================
       PRESETS — apply a temporary stretched mode to one monitor.
       The picker sits above the grid because it decides what every
       button below it does, and while nothing is applied it is also
       what the status card above describes.
       ============================================================ *@
    <section class="content-card">
        <h3>@Localizer.T("stretchedres.presets.title") <UsageChip Feature="@UsageFeatures.StretchedRes" /></h3>
        <p class="stretched-intro">@Localizer.T("stretchedres.presets.intro")</p>

        <div class="stretched-monitor">
            <span class="stretched-field-label">@Localizer.T("stretchedres.monitor.label")</span>
            @if (monitors.Count == 0)
            {
                <div class="stretched-monitor-note">@Localizer.T("stretchedres.monitor.none")</div>
            }
            else
            {
                <Dropdown Value="@stretchedDevice"
                          ValueChanged="SelectStretchedMonitor"
                          Options="MonitorOptions"
                          Disabled="@ApplyDisabled" />
                @if (stretchedFellBack)
                {
                    <div class="stretched-monitor-note">
                        @Localizer.T("stretchedres.monitor.fallback", MonitorLabelFor(stretchedDevice))
                    </div>
                }
            }
        </div>

        <div class="stretched-preset-grid">
            @foreach (var preset in presets)
            {
                <button type="button"
                        class="stretched-preset @(IsChosen(preset.Width, preset.Height) ? "active" : "")"
                        @onclick="() => Apply(preset.Width, preset.Height, false)"
                        disabled="@ApplyDisabled"
                        @key="preset.Name">
                    <span class="stretched-preset-res">@preset.Width × @preset.Height</span>
                    <span class="stretched-preset-aspect">@preset.AspectLabel</span>
                    <span class="stretched-preset-note">@PresetNote(preset)</span>
                </button>
            }
        </div>

        <div class="stretched-safety-note">@Localizer.T("stretchedres.safety")</div>
    </section>

    @* ============================================================
       CUSTOM — its own card, and its own monitor. A custom mode is
       as often aimed at the second screen as a preset is at the
       first, and two pickers in one card would read as one.
       ============================================================ *@
    <section class="content-card">
        <h3>@Localizer.T("stretchedres.custom.title")</h3>

        <div class="stretched-monitor">
            <span class="stretched-field-label">@Localizer.T("stretchedres.monitor.label")</span>
            @if (monitors.Count == 0)
            {
                <div class="stretched-monitor-note">@Localizer.T("stretchedres.monitor.none")</div>
            }
            else
            {
                <Dropdown Value="@customDevice"
                          ValueChanged="SelectCustomMonitor"
                          Options="MonitorOptions"
                          Disabled="@ApplyDisabled" />
                @if (customFellBack)
                {
                    <div class="stretched-monitor-note">
                        @Localizer.T("stretchedres.monitor.fallback", MonitorLabelFor(customDevice))
                    </div>
                }
            }
        </div>

        <div class="stretched-custom">
            <div class="stretched-custom-fields">
                <label class="stretched-field">
                    <span class="stretched-field-label">@Localizer.T("stretchedres.custom.width")</span>
                    <input type="number" class="stretched-num"
                           min="@StretchedResService.MinDimension" max="@StretchedResService.MaxWidth" step="1"
                           @bind="customWidth" disabled="@ApplyDisabled" />
                </label>
                <span class="stretched-custom-x">×</span>
                <label class="stretched-field">
                    <span class="stretched-field-label">@Localizer.T("stretchedres.custom.height")</span>
                    <input type="number" class="stretched-num"
                           min="@StretchedResService.MinDimension" max="@StretchedResService.MaxHeight" step="1"
                           @bind="customHeight" disabled="@ApplyDisabled" />
                </label>
                <button class="btn btn-primary" @onclick="ApplyCustom" disabled="@ApplyDisabled">
                    @Localizer.T("stretchedres.custom.apply")
                </button>
            </div>
            @if (customError != CustomError.None)
            {
                <div class="stretched-custom-error">@CustomErrorText</div>
            }
        </div>
    </section>

    @* ============================================================
       GPU SCALING GUIDANCE — neutral info card, vendor-aware.
       ============================================================ *@
    <section class="content-card stretched-info-card">
        <h3>@Localizer.T("stretchedres.scaling.title")</h3>
        <p class="stretched-info-lead">@Localizer.T("stretchedres.scaling.lead", VendorLead)</p>

        @if (gpu.Vendor == GpuVendor.Nvidia)
        {
            <ol class="stretched-steps">
                <li>@Localizer.T("stretchedres.steps.nvidia.1")</li>
                <li>@Localizer.T("stretchedres.steps.nvidia.2")</li>
                <li>@Localizer.T("stretchedres.steps.nvidia.3")</li>
                <li>@Localizer.T("stretchedres.steps.nvidia.4")</li>
                <li>@Localizer.T("stretchedres.steps.nvidia.5")</li>
            </ol>
        }
        else if (gpu.Vendor == GpuVendor.Amd)
        {
            <ol class="stretched-steps">
                <li>@Localizer.T("stretchedres.steps.amd.1")</li>
                <li>@Localizer.T("stretchedres.steps.amd.2")</li>
                <li>@Localizer.T("stretchedres.steps.amd.3")</li>
            </ol>
        }
        else if (gpu.Vendor == GpuVendor.Intel)
        {
            <ol class="stretched-steps">
                <li>@Localizer.T("stretchedres.steps.intel.1")</li>
                <li>@Localizer.T("stretchedres.steps.intel.2")</li>
                <li>@Localizer.T("stretchedres.steps.intel.3")</li>
            </ol>
        }
        else
        {
            <ol class="stretched-steps">
                <li>@Localizer.T("stretchedres.steps.generic.1")</li>
                <li>@Localizer.T("stretchedres.steps.generic.2")</li>
                <li>@Localizer.T("stretchedres.steps.generic.3")</li>
            </ol>
        }
    </section>

    @* ============================================================
       ARK (opt-in) — mirror the resolution into GameUserSettings.ini.
       ============================================================ *@
    <section class="content-card">
        <h3>@Localizer.T("stretchedres.ark.title")</h3>
        <SettingRow Title="@Localizer.T("stretchedres.ark.row.title")"
                    Description="@Localizer.T("stretchedres.ark.row.description")"
                    Disabled="@(!lastChosenWidth.HasValue)">
            <button class="btn btn-secondary" @onclick="WriteArkAsync" disabled="@(!CanWriteArk)">
                @ArkButtonLabel
            </button>
        </SettingRow>
        @if (arkRunning)
        {
            <div class="stretched-ark-note">@Localizer.T("stretchedres.ark.note")</div>
        }
    </section>

</div>

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    // Auto-revert window mirrored from the service (display only, for the countdown bar).
    private const int AutoRevertSeconds = 15;

    /// <summary>Which bound a rejected custom size broke, so the message is worded on render.</summary>
    private enum CustomError { None, TooSmall, TooLarge }

    private IReadOnlyList<StretchedPreset> presets = Array.Empty<StretchedPreset>();
    private IReadOnlyList<DisplayMonitor> monitors = Array.Empty<DisplayMonitor>();
    private GpuInfo gpu = new(GpuVendor.Unknown, string.Empty);
    private DisplayResolution current = new(0, 0, 0);
    private DisplayResolution native = new(0, 0, 0);

    // The monitor each section is aimed at. Empty means "nothing resolved" — only possible when
    // no display enumerated at all, and the service then falls back to the Win32 default.
    private string stretchedDevice = string.Empty;
    private string customDevice = string.Empty;
    private bool stretchedFellBack;
    private bool customFellBack;

    /// <summary>The screen the native/GPU facts on show were read from, so a move is detectable.</summary>
    private string? factsDevice;

    private int customWidth = 1440;
    private int customHeight = 1080;
    private CustomError customError = CustomError.None;

    // The last preset/custom size the user chose this session (or restored from Preferences).
    // Drives the "active" highlight and the ARK write target — never auto-applied.
    private int? lastChosenWidth;
    private int? lastChosenHeight;

    private bool arkRunning;
    private bool _applying;

    private bool ApplyDisabled => Stretched.IsPendingConfirmation || _applying;

    private bool CanWriteArk => lastChosenWidth.HasValue && lastChosenHeight.HasValue && !arkRunning;

    private bool HasCurrent => current.Width > 0 && current.Height > 0;
    private bool HasNative => native.Width > 0 && native.Height > 0;

    private bool IsStretchedActive =>
        HasCurrent && HasNative &&
        (current.Width != native.Width || current.Height != native.Height);

    /// <summary>Empty is not a device name — it is "the service picks", i.e. the primary.</summary>
    private static string? Device(string deviceName) =>
        string.IsNullOrEmpty(deviceName) ? null : deviceName;

    /// <summary>
    /// The screen the status card describes and "Restore native" acts on: the one a resolution was
    /// last applied to, whichever section it was applied from, and only otherwise the one the
    /// presets picker is aimed at.
    ///
    /// The distinction is the whole point of having two pickers. Stretch the second screen from the
    /// Custom card and the card above must not go on reporting the first one as native while the
    /// only restore button on the page resets a screen nobody touched.
    /// </summary>
    private string? StatusDevice => Stretched.LastAppliedDeviceName ?? Device(stretchedDevice);

    private IReadOnlyList<Dropdown.Option> MonitorOptions =>
        monitors.Select(m => new Dropdown.Option(m.DeviceName, MonitorLabel(m))).ToList();

    private string MonitorLabel(DisplayMonitor monitor) => monitor.IsPrimary
        ? Localizer.T("stretchedres.monitor.option.primary", monitor.Index, monitor.CurrentMode.Width, monitor.CurrentMode.Height)
        : Localizer.T("stretchedres.monitor.option", monitor.Index, monitor.CurrentMode.Width, monitor.CurrentMode.Height);

    private string MonitorLabelFor(string? deviceName)
    {
        var match = monitors.FirstOrDefault(
            m => string.Equals(m.DeviceName, deviceName, StringComparison.OrdinalIgnoreCase));
        return match is null ? Localizer.T("stretchedres.monitor.unknown") : MonitorLabel(match);
    }

    private string CurrentLabel => HasCurrent ? current.Label : "—";
    private string CurrentAspectSub =>
        HasCurrent
            ? (IsStretchedActive
                ? Localizer.T("stretchedres.fact.current.stretched", current.AspectLabel)
                : Localizer.T("stretchedres.fact.current.native", current.AspectLabel))
            : Localizer.T("stretchedres.fact.current.none");
    private string NativeLabel => HasNative ? native.Label : "—";
    private string GpuLabel => string.IsNullOrWhiteSpace(gpu.AdapterName)
        ? Localizer.T("stretchedres.gpu.unknown")
        : gpu.AdapterName;
    private string GpuVendorSub => gpu.Vendor switch
    {
        GpuVendor.Nvidia => Localizer.T("stretchedres.gpu.sub.nvidia"),
        GpuVendor.Amd => Localizer.T("stretchedres.gpu.sub.amd"),
        GpuVendor.Intel => Localizer.T("stretchedres.gpu.sub.intel"),
        _ => Localizer.T("stretchedres.gpu.sub.none")
    };

    private string VendorLead => gpu.Vendor switch
    {
        GpuVendor.Nvidia => Localizer.T("stretchedres.scaling.vendor.nvidia"),
        GpuVendor.Amd => Localizer.T("stretchedres.scaling.vendor.amd"),
        GpuVendor.Intel => Localizer.T("stretchedres.scaling.vendor.intel"),
        _ => Localizer.T("stretchedres.scaling.vendor.none")
    };

    /// <summary>
    /// The curated presets are the service's, and so is their English. Spelled out here with
    /// literal keys because the key scan reads the source, not the running app.
    /// </summary>
    private string PresetNote(StretchedPreset preset) => (preset.Width, preset.Height) switch
    {
        (1440, 1080) => Localizer.T("stretchedres.preset.note.1440x1080"),
        (1280, 1024) => Localizer.T("stretchedres.preset.note.1280x1024"),
        (1024, 768) => Localizer.T("stretchedres.preset.note.1024x768"),
        (1600, 1080) => Localizer.T("stretchedres.preset.note.1600x1080"),
        (1280, 960) => Localizer.T("stretchedres.preset.note.1280x960"),
        _ => preset.Note
    };

    private string CustomErrorText => customError == CustomError.TooSmall
        ? Localizer.T("stretchedres.custom.error.min", StretchedResService.MinDimension)
        : Localizer.T("stretchedres.custom.error.max", StretchedResService.MaxWidth, StretchedResService.MaxHeight);

    private string StatusState =>
        Stretched.IsPendingConfirmation ? "warning"
        : IsStretchedActive ? "online"
        : "off";

    private string StatusLabel =>
        Stretched.IsPendingConfirmation ? Localizer.T("stretchedres.status.pending")
        : IsStretchedActive ? Localizer.T("stretchedres.status.active")
        : Localizer.T("stretchedres.status.native");

    private string StatusDescription =>
        Stretched.IsPendingConfirmation
            ? Localizer.T("stretchedres.status.desc.pending")
            : HasCurrent
                ? Localizer.T("stretchedres.status.desc.current",
                    MonitorLabelFor(StatusDevice), current.Label, current.AspectLabel)
                : Localizer.T("stretchedres.status.desc.unknown");

    private string ArkButtonLabel
    {
        get
        {
            if (arkRunning) return Localizer.T("stretchedres.ark.button.closefirst");
            if (!lastChosenWidth.HasValue || !lastChosenHeight.HasValue) return Localizer.T("stretchedres.ark.button.choose");
            return Localizer.T("stretchedres.ark.button.write", lastChosenWidth.Value, lastChosenHeight.Value);
        }
    }

    // Invariant culture so the inline width never gets a decimal comma.
    private string CountdownPercentCss
    {
        get
        {
            var pct = Math.Clamp(Stretched.SecondsRemaining / (double)AutoRevertSeconds * 100.0, 0, 100);
            return pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        }
    }

    private bool IsChosen(int width, int height) =>
        lastChosenWidth == width && lastChosenHeight == height;

    protected override void OnInitialized()
    {
        try
        {
            presets = Stretched.GetPresets();
            LoadMonitors();
            RefreshDisplayFacts();

            var last = Stretched.LoadLastChoice();
            if (last is { } l)
            {
                customWidth = l.Width;
                customHeight = l.Height;
                lastChosenWidth = l.Width;
                lastChosenHeight = l.Height;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to initialize Stretched Res page");
        }

        // NEVER auto-applies — the page only reads state on load.
        Stretched.StateChanged += OnServiceStateChanged;
    }

    /// <summary>
    /// Reads the attached monitors and resolves both stored choices against them. A monitor that
    /// has been unplugged since the last session resolves to the primary and sets the note, so
    /// the page never aims a change at a screen whose label is no longer on it.
    /// </summary>
    private void LoadMonitors()
    {
        monitors = Stretched.GetMonitors();

        var stretchedTarget = Stretched.ResolveMonitor(Stretched.LoadDeviceChoice(ResolutionFeature.Stretched));
        stretchedDevice = stretchedTarget.DeviceName ?? string.Empty;
        stretchedFellBack = stretchedTarget.FellBackToPrimary;

        var customTarget = Stretched.ResolveMonitor(Stretched.LoadDeviceChoice(ResolutionFeature.Custom));
        customDevice = customTarget.DeviceName ?? string.Empty;
        customFellBack = customTarget.FellBackToPrimary;
    }

    private void SelectStretchedMonitor(string deviceName)
    {
        stretchedDevice = deviceName;
        stretchedFellBack = false;
        Stretched.SaveDeviceChoice(ResolutionFeature.Stretched, Device(deviceName));
        RefreshDisplayFacts();
    }

    private void SelectCustomMonitor(string deviceName)
    {
        customDevice = deviceName;
        customFellBack = false;
        Stretched.SaveDeviceChoice(ResolutionFeature.Custom, Device(deviceName));
    }

    private void OnServiceStateChanged()
    {
        this.DispatchRender(() => InvokeAsync(() =>
        {
            RefreshCurrent();
            StateHasChanged();
        }), Logger);
    }

    /// <summary>
    /// Re-reads the three facts for whatever <see cref="StatusDevice"/> currently is, and records
    /// which screen they were read from so a later tick can notice that it moved.
    /// </summary>
    private void RefreshDisplayFacts()
    {
        var device = StatusDevice;
        factsDevice = device;
        gpu = Stretched.GetGpuInfo(device);
        native = Stretched.GetNativeResolution(device);
        current = Stretched.GetCurrentResolution(device);
        arkRunning = Stretched.IsArkRunning();
    }

    private void RefreshCurrent()
    {
        var device = StatusDevice;
        if (!string.Equals(device, factsDevice, StringComparison.OrdinalIgnoreCase))
        {
            // An apply, a revert or a restore moved the card to another screen — native and GPU
            // belong to that screen too, so they have to be re-read, not just the current mode.
            RefreshDisplayFacts();
            return;
        }

        current = Stretched.GetCurrentResolution(device);
        arkRunning = Stretched.IsArkRunning();
    }

    private async Task Apply(int width, int height, bool isCustom)
    {
        if (Stretched.IsPendingConfirmation || _applying)
        {
            return;
        }
        _applying = true; // set before any await — a double-click must not double-consume

        try
        {
            customError = CustomError.None;
            var device = Device(isCustom ? customDevice : stretchedDevice);
            var result = Stretched.ApplyResolution(width, height, device);
            if (!result.Success)
            {
                // Nothing changed on screen, so nothing is counted — a driver-rejected mode
                // must not burn a monthly use.
                NotificationService.ShowError(result.Error ?? Localizer.T("stretchedres.error.apply"));
                return;
            }

            // Counted only after the change actually took. If the month is used up, undo it
            // right away — Keep, RevertNow and the 15s auto-revert themselves never count.
            var gate = await UsageGate.TryConsumeAsync(UsageFeatures.StretchedRes);
            if (!gate.Allowed)
            {
                Stretched.RevertNow();
                RefreshCurrent();
                NotificationService.ShowWarning(Localizer.T("stretchedres.limit", gate.Limit));
                return;
            }

            Stretched.SaveLastChoice(width, height, isCustom);
            lastChosenWidth = width;
            lastChosenHeight = height;
            RefreshCurrent();
        }
        finally
        {
            _applying = false;
        }
    }

    private async Task ApplyCustom()
    {
        var validation = Stretched.ValidateResolution(customWidth, customHeight);
        if (!validation.Success)
        {
            // The service decides whether the size is allowed; the page decides how to say so,
            // in the reader's language, off the same bounds the service validated against.
            customError = customWidth < StretchedResService.MinDimension || customHeight < StretchedResService.MinDimension
                ? CustomError.TooSmall
                : CustomError.TooLarge;
            return;
        }

        await Apply(customWidth, customHeight, true);
    }

    private void Keep()
    {
        Stretched.ConfirmKeep();
        RefreshCurrent();
    }

    private void RevertNow()
    {
        Stretched.RevertNow();
        RefreshCurrent();
    }

    private void RestoreNative()
    {
        // The screen the card above is describing, which is the stretched one when there is one.
        Stretched.RestoreNative(StatusDevice);
        RefreshCurrent();
    }

    private async Task WriteArkAsync()
    {
        if (!lastChosenWidth.HasValue || !lastChosenHeight.HasValue)
        {
            return;
        }

        arkRunning = Stretched.IsArkRunning();
        if (arkRunning)
        {
            NotificationService.ShowWarning(Localizer.T("stretchedres.ark.toast.closefirst"));
            return;
        }

        try
        {
            var result = await Stretched.WriteArkResolutionAsync(lastChosenWidth.Value, lastChosenHeight.Value);
            if (result.Success)
            {
                NotificationService.ShowSuccess(
                    Localizer.T("stretchedres.ark.toast.written", lastChosenWidth.Value, lastChosenHeight.Value));
            }
            else
            {
                NotificationService.ShowError(result.Error ?? Localizer.T("stretchedres.ark.toast.error"));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to write ARK resolution from Stretched Res page");
            NotificationService.ShowError(Localizer.T("stretchedres.ark.toast.failed", ex.Message));
        }
    }

    public void Dispose()
    {
        this.StopRenderDispatch();
        // Unsubscribe only. A pending change is deliberately left to the service's
        // auto-revert so navigating away can never strand the display.
        Stretched.StateChanged -= OnServiceStateChanged;
    }
}
