@page "/char-manager"
@using System.Globalization
@using Microsoft.Extensions.Logging
@using RazorReaper.Services
@using RazorReaper.Services.Localization

@inject ICharPresetService PresetService
@inject INotificationService Notifications
@inject IActivityService Activity
@inject IProcessService ProcessService
@inject ILocalizer Localizer
@inject ILogger<CharManager> Logger

<div class="char-manager-page">
    <header class="page-header">
        <h1 class="page-title">@Localizer.T("charmanager.title")</h1>
        <p class="page-subtitle">@Localizer.T("charmanager.subtitle")</p>
    </header>

    @if (!_arkFound)
    {
        <div class="content-card cm-empty-card">
            <div class="cm-empty-icon">
                <svg fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.721-1.36 3.486 0l5.58 9.92c.75 1.334-.214 2.98-1.743 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
            </div>
            <h3>@Localizer.T("charmanager.noark.title")</h3>
            <p>@Localizer.T("charmanager.noark.text")</p>
            <button type="button" class="btn btn-primary" @onclick="Refresh">@Localizer.T("charmanager.rescan")</button>
        </div>
    }
    else if (!_folderFound)
    {
        <div class="content-card cm-empty-card">
            <div class="cm-empty-icon">
                <svg fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
                </svg>
            </div>
            <h3>@Localizer.T("charmanager.nofolder.title")</h3>
            <p>@Localizer.T("charmanager.nofolder.text")</p>
            <p class="cm-empty-path">@_presetsFolder</p>
            <button type="button" class="btn btn-primary" @onclick="Refresh">@Localizer.T("charmanager.rescan")</button>
        </div>
    }
    else
    {
        <StatusHeader State="online" Label="@HeaderLabel" Description="@_presetsFolder">
            <Actions>
                <button type="button" class="btn btn-secondary" @onclick="Refresh" disabled="@_busy">@Localizer.T("charmanager.rescan")</button>
                <button type="button" class="btn btn-secondary" @onclick="OpenPresetsFolder" disabled="@_busy">@Localizer.T("charmanager.openfolder")</button>
                <button type="button" class="btn btn-primary" @onclick="ImportPresetAsync" disabled="@_busy">@Localizer.T("charmanager.import")</button>
            </Actions>
        </StatusHeader>

        <div class="content-card cm-info-card">
            <p class="cm-info-text">@Localizer.T("charmanager.info.text")</p>
            <p class="cm-info-note">@Localizer.T("charmanager.info.note") <code>@_backupFolder</code></p>
        </div>

        <div class="content-card cm-presets-card">
            @if (_presets.Count == 0)
            {
                <div class="cm-empty-state">
                    <p>@Localizer.T("charmanager.empty.title")</p>
                    <p>@Localizer.T("charmanager.empty.text")</p>
                </div>
            }
            else
            {
                <div class="cm-rows">
                    @foreach (var preset in _presets)
                    {
                        <div class="cm-preset" @key="preset.FileName">
                            <SettingRow Title="@preset.Name" Description="@RowDescription(preset)">
                                @if (_renamingFile == preset.FileName)
                                {
                                    <input class="cm-input"
                                           @bind="_renameValue"
                                           @bind:event="oninput"
                                           @onkeydown="e => OnRenameKeyDown(e)"
                                           placeholder="@Localizer.T("charmanager.rename.placeholder")" />
                                    <button type="button" class="btn btn-primary" @onclick="ConfirmRenameAsync" disabled="@_busy">@Localizer.T("common.save")</button>
                                    <button type="button" class="btn btn-secondary" @onclick="CancelRename" disabled="@_busy">@Localizer.T("common.cancel")</button>
                                }
                                else if (_confirmDeleteFile == preset.FileName)
                                {
                                    <span class="cm-confirm-text">@Localizer.T("charmanager.delete.confirm")</span>
                                    <button type="button" class="btn btn-danger" @onclick="() => ConfirmDeleteAsync(preset)" disabled="@_busy">@Localizer.T("common.delete")</button>
                                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete" disabled="@_busy">@Localizer.T("common.cancel")</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-secondary" @onclick="() => ToggleEditorAsync(preset)" disabled="@_busy">
                                        @Localizer.T(_editorFile == preset.FileName ? "common.close" : "common.edit")
                                    </button>
                                    <button type="button" class="btn btn-secondary" @onclick="() => StartRename(preset)" disabled="@_busy">@Localizer.T("charmanager.rename")</button>
                                    <button type="button" class="btn btn-secondary" @onclick="() => DuplicateAsync(preset)" disabled="@_busy">@Localizer.T("charmanager.duplicate")</button>
                                    <button type="button" class="btn btn-secondary" @onclick="() => ExportAsync(preset)" disabled="@_busy">@Localizer.T("charmanager.export")</button>
                                    <button type="button" class="btn btn-danger" @onclick="() => StartDelete(preset)" disabled="@_busy">@Localizer.T("common.delete")</button>
                                }
                            </SettingRow>

                            @if (_editorFile == preset.FileName)
                            {
                                <div class="cm-editor">
                                    @if (_document is null)
                                    {
                                        <div class="cm-editor-loading">@Localizer.T("charmanager.editor.loading")</div>
                                    }
                                    else
                                    {
                                        @if (_document.ColorSliders.Count > 0)
                                        {
                                            <div class="cm-editor-section">
                                                <div class="cm-editor-title">@Localizer.T("charmanager.editor.colors")</div>
                                                <div class="cm-slider-grid">
                                                    @foreach (var slider in _document.ColorSliders)
                                                    {
                                                        <div class="cm-slider" @key="slider.Key">
                                                            <span class="cm-slider-label">@SliderLabel(slider)</span>
                                                            <input type="range" min="0" max="1" step="0.01"
                                                                   value="@SliderAttr(slider.Value)"
                                                                   @oninput="e => OnSliderInput(slider, e)" />
                                                            <span class="cm-slider-value">@SliderText(slider.Value)</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        @if (_document.BoneSliders.Count > 0)
                                        {
                                            <div class="cm-editor-section">
                                                <div class="cm-editor-title">@Localizer.T("charmanager.editor.body")</div>
                                                <div class="cm-slider-grid">
                                                    @foreach (var slider in _document.BoneSliders)
                                                    {
                                                        <div class="cm-slider" @key="slider.Key">
                                                            <span class="cm-slider-label">@SliderLabel(slider)</span>
                                                            <input type="range" min="0" max="1" step="0.01"
                                                                   value="@SliderAttr(slider.Value)"
                                                                   @oninput="e => OnSliderInput(slider, e)" />
                                                            <span class="cm-slider-value">@SliderText(slider.Value)</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        <div class="cm-editor-footer">
                                            <span class="cm-editor-note">@Localizer.T("charmanager.editor.note")</span>
                                            <div class="cm-editor-actions">
                                                <button type="button" class="btn btn-secondary" @onclick="ResetEditor" disabled="@(_busy || !_editorDirty)">@Localizer.T("common.reset")</button>
                                                <button type="button" class="btn btn-primary" @onclick="SaveEditorAsync" disabled="@(_busy || !_editorDirty)">
                                                    @Localizer.T(_saving ? "charmanager.editor.saving" : "charmanager.editor.save")
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter(Name = "Language")]
    private string? Language { get; set; }

    private List<CharPresetInfo> _presets = new();
    private string? _presetsFolder;
    private string _backupFolder = "";
    private bool _arkFound;
    private bool _folderFound;
    private bool _busy;
    private bool _saving;

    private string? _renamingFile;
    private string _renameValue = "";
    private string? _confirmDeleteFile;

    private string? _editorFile;
    private CharPresetDocument? _document;
    private List<float> _originalValues = new();
    private bool _editorDirty;

    private string HeaderLabel => _presets.Count == 1
        ? Localizer.T("charmanager.header.one")
        : Localizer.T("charmanager.header.many", _presets.Count);

    /// <summary>
    /// The slider names, resolved where they render. ARK's file names none of them: the parser
    /// reports the raw property name and the index it was written at, and these are RazorReaper's
    /// own words for those offsets — so they are translated, and named here rather than in the
    /// parser, where a language switch would need the file read again to be seen.
    /// </summary>
    private string SliderLabel(CharPresetSlider slider) => slider.Key switch
    {
        "BodyColorSliderValue" => Localizer.T("charmanager.slider.skintone"),
        "HairColorSliderValue" => Localizer.T("charmanager.slider.haircolor"),
        "EyeColorSliderValue" => Localizer.T("charmanager.slider.eyecolor"),
        "Bone0" => Localizer.T("charmanager.slider.headsize"),
        "Bone1" => Localizer.T("charmanager.slider.necksize"),
        "Bone2" => Localizer.T("charmanager.slider.necklength"),
        "Bone3" => Localizer.T("charmanager.slider.chest"),
        "Bone4" => Localizer.T("charmanager.slider.shoulders"),
        "Bone5" => Localizer.T("charmanager.slider.armlength"),
        "Bone6" => Localizer.T("charmanager.slider.upperarm"),
        "Bone7" => Localizer.T("charmanager.slider.lowerarm"),
        "Bone8" => Localizer.T("charmanager.slider.hand"),
        "Bone9" => Localizer.T("charmanager.slider.leglength"),
        "Bone10" => Localizer.T("charmanager.slider.upperleg"),
        "Bone11" => Localizer.T("charmanager.slider.lowerleg"),
        "Bone12" => Localizer.T("charmanager.slider.foot"),
        "Bone13" => Localizer.T("charmanager.slider.hip"),
        "Bone14" => Localizer.T("charmanager.slider.torsowidth"),
        "Bone15" => Localizer.T("charmanager.slider.upperfacesize"),
        "Bone16" => Localizer.T("charmanager.slider.lowerfacesize"),
        "Bone17" => Localizer.T("charmanager.slider.torsodepth"),
        "Bone18" => Localizer.T("charmanager.slider.headheight"),
        "Bone19" => Localizer.T("charmanager.slider.headwidth"),
        "Bone20" => Localizer.T("charmanager.slider.headdepth"),
        "Bone21" => Localizer.T("charmanager.slider.torsoheight"),
        _ => Localizer.T("charmanager.slider.unnamed", slider.Index + 1)
    };

    protected override void OnInitialized()
    {
        try
        {
            _backupFolder = PresetService.GetBackupFolderPath();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to resolve the character preset backup folder");
        }
        Refresh();
    }

    private void Refresh()
    {
        try
        {
            _presetsFolder = PresetService.GetPresetsFolderPath();
            _arkFound = _presetsFolder is not null;
            _folderFound = _arkFound && PresetService.PresetsFolderExists();
            _presets = _folderFound ? PresetService.ListPresets() : new List<CharPresetInfo>();

            if (_editorFile is not null && _presets.All(p => p.FileName != _editorFile))
            {
                CloseEditor();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the ARK character preset list");
            Notifications.ShowError(Localizer.T("charmanager.toast.readfailed"));
        }
    }

    private static string RowDescription(CharPresetInfo preset) =>
        $"{preset.FileName} · {FormatSize(preset.SizeBytes)} · {preset.ModifiedLocal.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)}";

    private static string SliderAttr(float value) =>
        Math.Clamp(value, 0f, 1f).ToString("0.###", CultureInfo.InvariantCulture);

    private static string SliderText(float value) =>
        Math.Clamp(value, 0f, 1f).ToString("0.00", CultureInfo.InvariantCulture);

    private void WarnIfArkRunning()
    {
        try
        {
            if (ProcessService.IsProcessRunning("ShooterGame"))
            {
                Notifications.ShowWarning(Localizer.T("charmanager.toast.arkrunning"));
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "ARK process check failed");
        }
    }

    private void OpenPresetsFolder()
    {
        if (_presetsFolder is null) return;
        try
        {
            ProcessService.Start(_presetsFolder);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to open the presets folder");
            Notifications.ShowError(Localizer.T("charmanager.toast.openfolderfailed"));
        }
    }

    // ── Rename ───────────────────────────────────────────────────────────────

    private void StartRename(CharPresetInfo preset)
    {
        _confirmDeleteFile = null;
        _renamingFile = preset.FileName;
        _renameValue = preset.Name;
    }

    private void CancelRename()
    {
        _renamingFile = null;
        _renameValue = "";
    }

    private async Task OnRenameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmRenameAsync();
        else if (e.Key == "Escape") CancelRename();
    }

    private async Task ConfirmRenameAsync()
    {
        if (_busy || _renamingFile is null) return;

        var fileName = _renamingFile;
        _busy = true;
        try
        {
            var result = await PresetService.RenameAsync(fileName, _renameValue);
            if (result.Success)
            {
                Notifications.ShowSuccess(result.Message);
                Activity.AddActivity(Localizer.T("charmanager.activity.renamed", _renameValue.Trim()), "success");
                if (_editorFile == fileName) CloseEditor();
                CancelRename();
            }
            else
            {
                Notifications.ShowError(result.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Renaming preset {FileName} failed", fileName);
            Notifications.ShowError(Localizer.T("charmanager.toast.renamefailed"));
        }
        finally
        {
            _busy = false;
            Refresh();
        }
    }

    // ── Duplicate ────────────────────────────────────────────────────────────

    private async Task DuplicateAsync(CharPresetInfo preset)
    {
        if (_busy) return;

        _busy = true;
        try
        {
            var result = await PresetService.DuplicateAsync(preset.FileName);
            if (result.Success)
            {
                Notifications.ShowSuccess(result.Message);
                Activity.AddActivity(Localizer.T("charmanager.activity.duplicated", preset.Name), "success");
            }
            else
            {
                Notifications.ShowError(result.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Duplicating preset {FileName} failed", preset.FileName);
            Notifications.ShowError(Localizer.T("charmanager.toast.duplicatefailed"));
        }
        finally
        {
            _busy = false;
            Refresh();
        }
    }

    // ── Delete ───────────────────────────────────────────────────────────────

    private void StartDelete(CharPresetInfo preset)
    {
        CancelRename();
        _confirmDeleteFile = preset.FileName;
    }

    private void CancelDelete()
    {
        _confirmDeleteFile = null;
    }

    private async Task ConfirmDeleteAsync(CharPresetInfo preset)
    {
        if (_busy) return;

        _busy = true;
        try
        {
            WarnIfArkRunning();
            var result = await PresetService.DeleteAsync(preset.FileName);
            if (result.Success)
            {
                Notifications.ShowSuccess(result.Message);
                Activity.AddActivity(Localizer.T("charmanager.activity.deleted", preset.Name), "warning");
                if (_editorFile == preset.FileName) CloseEditor();
            }
            else
            {
                Notifications.ShowError(result.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Deleting preset {FileName} failed", preset.FileName);
            Notifications.ShowError(Localizer.T("charmanager.toast.deletefailed"));
        }
        finally
        {
            _busy = false;
            _confirmDeleteFile = null;
            Refresh();
        }
    }

    // ── Import / Export ──────────────────────────────────────────────────────

    private async Task ImportPresetAsync()
    {
        if (_busy) return;

        string? picked;
        try
        {
            var fileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
            {
                { DevicePlatform.WinUI, new[] { ".arkcharactersetting" } }
            });
            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = Localizer.T("charmanager.picker.import"),
                FileTypes = fileTypes
            });
            picked = result?.FullPath;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Preset file picker failed");
            Notifications.ShowError(Localizer.T("charmanager.toast.pickerfailed"));
            return;
        }

        if (picked is null) return;

        _busy = true;
        try
        {
            var result = await PresetService.ImportAsync(picked);
            if (result.Success)
            {
                Notifications.ShowSuccess(result.Message);
                Activity.AddActivity(Localizer.T("charmanager.activity.imported"), "success");
            }
            else
            {
                Notifications.ShowError(result.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Importing preset from {Path} failed", picked);
            Notifications.ShowError(Localizer.T("charmanager.toast.importfailed"));
        }
        finally
        {
            _busy = false;
            Refresh();
        }
    }

    private async Task ExportAsync(CharPresetInfo preset)
    {
        if (_busy) return;

        string? folder;
        try
        {
            folder = await PickFolderAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Folder picker failed");
            Notifications.ShowError(Localizer.T("charmanager.toast.folderpickerfailed"));
            return;
        }

        if (string.IsNullOrWhiteSpace(folder)) return;

        _busy = true;
        try
        {
            var result = await PresetService.ExportAsync(preset.FileName, folder);
            if (result.Success)
            {
                Notifications.ShowSuccess(result.Message);
                Activity.AddActivity(Localizer.T("charmanager.activity.exported", preset.Name), "success");
            }
            else
            {
                Notifications.ShowError(result.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exporting preset {FileName} failed", preset.FileName);
            Notifications.ShowError(Localizer.T("charmanager.toast.exportfailed"));
        }
        finally
        {
            _busy = false;
        }
    }

    private static async Task<string?> PickFolderAsync()
    {
        var picker = new Windows.Storage.Pickers.FolderPicker();
        picker.FileTypeFilter.Add("*");

        var windows = Microsoft.Maui.Controls.Application.Current?.Windows;
        if (windows == null || windows.Count == 0) return null;

        var window = windows[0].Handler?.PlatformView as Microsoft.UI.Xaml.Window;
        if (window == null) return null;

        WinRT.Interop.InitializeWithWindow.Initialize(picker, WinRT.Interop.WindowNative.GetWindowHandle(window));
        var folder = await picker.PickSingleFolderAsync();
        return folder?.Path;
    }

    // ── Slider editor ────────────────────────────────────────────────────────

    private async Task ToggleEditorAsync(CharPresetInfo preset)
    {
        if (_editorFile == preset.FileName)
        {
            CloseEditor();
            return;
        }

        CancelRename();
        CancelDelete();
        _editorFile = preset.FileName;
        _document = null;
        _editorDirty = false;
        StateHasChanged();

        var result = await PresetService.ParseAsync(preset.FileName);
        if (_editorFile != preset.FileName) return;

        if (result.Success && result.Document is not null)
        {
            _document = result.Document;
            _originalValues = _document.ColorSliders.Concat(_document.BoneSliders).Select(s => s.Value).ToList();
        }
        else
        {
            Notifications.ShowError(result.Error ?? Localizer.T("charmanager.toast.parsefailed"));
            CloseEditor();
        }
    }

    private void CloseEditor()
    {
        _editorFile = null;
        _document = null;
        _originalValues = new List<float>();
        _editorDirty = false;
    }

    private void OnSliderInput(CharPresetSlider slider, ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        if (float.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var value))
        {
            slider.Value = Math.Clamp(value, 0f, 1f);
            _editorDirty = true;
        }
    }

    private void ResetEditor()
    {
        if (_document is null) return;

        var sliders = _document.ColorSliders.Concat(_document.BoneSliders).ToList();
        for (var i = 0; i < sliders.Count && i < _originalValues.Count; i++)
        {
            sliders[i].Value = _originalValues[i];
        }
        _editorDirty = false;
    }

    private async Task SaveEditorAsync()
    {
        if (_busy || _document is null) return;

        _busy = true;
        _saving = true;
        try
        {
            WarnIfArkRunning();
            var result = await PresetService.SaveSlidersAsync(_document);
            if (result.Success)
            {
                Notifications.ShowSuccess(result.Message);
                Activity.AddActivity(
                    Localizer.T("charmanager.activity.edited", Path.GetFileNameWithoutExtension(_document.FileName)),
                    "success");
                _originalValues = _document.ColorSliders.Concat(_document.BoneSliders).Select(s => s.Value).ToList();
                _editorDirty = false;
            }
            else
            {
                Notifications.ShowError(result.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving preset edits failed");
            Notifications.ShowError(Localizer.T("charmanager.toast.savefailed"));
        }
        finally
        {
            _busy = false;
            _saving = false;
            Refresh();
        }
    }

    private static string FormatSize(long bytes)
    {
        string[] units = { "B", "KB", "MB" };
        double size = bytes;
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }
        return unit == 0 ? $"{size:0} {units[unit]}" : $"{size:0.0} {units[unit]}";
    }
}
