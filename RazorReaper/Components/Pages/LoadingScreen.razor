@page "/loading-screen"
@using Microsoft.Extensions.Logging
@using RazorReaper.Services
@using RazorReaper.Services.Media
@using RazorReaper.Services.Localization

@inject ILoadingScreenService MovieService
@inject INotificationService Notifications
@inject IActivityService Activity
@inject IProcessService ProcessService
@inject IUsageGateService UsageGate
@inject ILocalizer Localizer
@inject ILogger<LoadingScreen> Logger

<div class="loading-screen-page">
    <header class="page-header">
        <h1 class="page-title">@Localizer.T("loadingscreen.title")</h1>
        <p class="page-subtitle">@Localizer.T("loadingscreen.subtitle")</p>
    </header>

    @if (!_arkFound)
    {
        <div class="content-card ls-empty-card">
            <div class="ls-empty-icon">
                <svg fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.721-1.36 3.486 0l5.58 9.92c.75 1.334-.214 2.98-1.743 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
            </div>
            <h3>@Localizer.T("loadingscreen.noark.title")</h3>
            <p>@Localizer.T("loadingscreen.noark.text")</p>
            <button type="button" class="btn btn-primary" @onclick="Refresh">@Localizer.T("loadingscreen.rescan")</button>
        </div>
    }
    else if (!_moviesFolderFound)
    {
        <div class="content-card ls-empty-card">
            <div class="ls-empty-icon">
                <svg fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
                </svg>
            </div>
            <h3>@Localizer.T("loadingscreen.nomovies.title")</h3>
            <p>@Localizer.T("loadingscreen.nomovies.text")</p>
            <p class="ls-empty-path">@_moviesPath</p>
            <button type="button" class="btn btn-primary" @onclick="Refresh">@Localizer.T("loadingscreen.rescan")</button>
        </div>
    }
    else
    {
        <StatusHeader State="@HeaderState" Label="@HeaderLabel" Description="@HeaderDescription">
            <Actions>
                <UsageChip Feature="@UsageFeatures.LoadingScreen" />
                <button type="button" class="btn btn-secondary" @onclick="Refresh" disabled="@_busy">@Localizer.T("loadingscreen.rescan")</button>
                <button type="button"
                        class="btn btn-warning"
                        @onclick="RestoreAllMoviesAsync"
                        disabled="@(_busy || _replacedCount == 0)">
                    @Localizer.T(_restoringAll ? "loadingscreen.restoringall" : "loadingscreen.restoreall")
                </button>
            </Actions>
        </StatusHeader>

        @* Was two paragraphs in a card of its own, pushing everything you can actually
           press below the fold. The settings under it already carry their own descriptions,
           so this only needs to say where the backups go and where to get the right format. *@
        <div class="ls-info-card">
            <p class="ls-info-text">
                @Localizer.T("loadingscreen.info.backup")
                <code>@_backupFolder</code>
                @Localizer.T("loadingscreen.info.applies")
                <a class="ls-convert-link" href="/convert">@Localizer.T("nav.page.convert")</a>
                @Localizer.T("loadingscreen.info.format")
            </p>
        </div>

        <div class="content-card ls-options-card">
            <div class="ls-option-row">
                <div class="ls-option-label">
                    <span class="ls-option-title">@Localizer.T("loadingscreen.volume.title")</span>
                    <span class="ls-option-desc">@Localizer.T("loadingscreen.volume.description")</span>
                </div>
                <div class="ls-volume">
                    <input type="range" class="ls-slider" min="0" max="200" step="1"
                           @bind="_volumePercent" @bind:event="oninput" disabled="@_busy" />
                    <span class="ls-volume-value">@_volumePercent%</span>
                </div>
            </div>
        </div>

        @if (_busy && _progressActive)
        {
            <div class="content-card ls-progress-card">
                <div class="ls-progress-head">
                    <span class="ls-progress-label">@_progressLabel</span>
                    <span class="ls-progress-percent">@(_progressPercent >= 0 ? $"{_progressPercent}%" : "")</span>
                </div>
                <div class="ls-progress-track">
                    <div class="ls-progress-fill @(_progressPercent < 0 ? "indeterminate" : "")"
                         style="width:@(_progressPercent >= 0 ? _progressPercent : 100)%"></div>
                </div>
            </div>
        }

        <div class="content-card ls-movies-card">
            @if (_movies.Count == 0)
            {
                <div class="ls-no-movies">@Localizer.T("loadingscreen.nofiles")</div>
            }
            else
            {
                @* One row per movie, not per file. ARK ships each movie twice — an .mp4 and a
                   .wmv — so listing files meant every name appeared twice. Replacing does both
                   variants, which is what you want anyway: leave one behind and ARK may still
                   play the old one.

                   Two columns, with the size and buttons on fixed widths so they line up down
                   each one. Earlier attempts let every row size itself, which put the buttons at
                   a different x on every line; a single full-width column fixed that but left a
                   canyon of empty space in the middle and pushed the list off the page. *@
                <div class="ls-list">
                    @foreach (var group in MovieGroups)
                    {
                        <div class="ls-group" @key="@("g:" + group.Kind)">
                            <div class="ls-group-title">@GroupTitle(group.Kind)</div>
                            @foreach (var entry in group.Entries)
                            {
                                <div class="ls-row @(entry.IsReplaced ? "replaced" : null)" @key="@("m:" + entry.Name)">
                                    <span class="ls-row-name" title="@entry.Name">@entry.Name</span>
                                    @if (entry.IsReplaced)
                                    {
                                        <span class="ls-badge">@Localizer.T("loadingscreen.badge.custom")</span>
                                    }
                                    <span class="ls-row-size">@entry.SizeLabel</span>
                                    <span class="ls-row-actions">
                                        @if (entry.IsReplaced)
                                        {
                                            <button type="button" class="btn btn-secondary"
                                                    @onclick="() => RestoreEntryAsync(entry)" disabled="@_busy">@Localizer.T("loadingscreen.restore")</button>
                                        }
                                        <button type="button" class="btn btn-primary"
                                                @onclick="() => ReplaceEntryAsync(entry)" disabled="@_busy">
                                            @Localizer.T(entry.IsReplaced ? "loadingscreen.change" : "loadingscreen.replace")
                                        </button>
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter(Name = "Language")]
    private string? Language { get; set; }

    private List<ArkMovieInfo> _movies = new();
    private string? _moviesPath;
    private string _backupFolder = "";
    private bool _arkFound;
    private bool _moviesFolderFound;
    private bool _busy;
    private bool _restoringAll;
    private int _replacedCount;

    private int _volumePercent = 100;

    private bool _progressActive;
    private string _progressLabel = "";
    private int _progressPercent;

    private static readonly ArkMovieKind[] GroupOrder =
    {
        ArkMovieKind.Loading,
        ArkMovieKind.Startup,
        ArkMovieKind.Cinematic,
        ArkMovieKind.Other,
    };

    /// <summary>
    /// Resolved where the group heading renders, not where the order is declared: a static
    /// initializer cannot reach the localizer, and a title baked in once would survive a switch.
    /// </summary>
    private string GroupTitle(ArkMovieKind kind) => Localizer.T(kind switch
    {
        ArkMovieKind.Loading => "loadingscreen.group.loading",
        ArkMovieKind.Startup => "loadingscreen.group.startup",
        ArkMovieKind.Cinematic => "loadingscreen.group.cinematic",
        _ => "loadingscreen.group.other",
    });

    /// <summary>
    /// One movie and every container it ships in. ARK stores most movies as an .mp4 and a
    /// .wmv of the same thing, and treating those as two separate entries is what made the
    /// list twice as long as it needed to be with every name in it twice.
    /// </summary>
    private sealed record MovieEntry(string Name, List<ArkMovieInfo> Variants)
    {
        public bool IsReplaced => Variants.Any(v => v.IsReplaced);

        /// <summary>"mp4 · wmv" — which containers exist, without the filenames.</summary>
        public string VariantLabel =>
            string.Join(" · ", Variants.Select(v => v.Extension.TrimStart('.')).Distinct());

        public string SizeLabel => FormatSize(Variants.Sum(v => v.SizeBytes));

        /// <summary>The one a replace is aimed at; the service handles its sibling.</summary>
        public ArkMovieInfo Primary => Variants[0];
    }

    private IEnumerable<(ArkMovieKind Kind, List<MovieEntry> Entries)> MovieGroups =>
        GroupOrder
            .Select(kind => (
                Kind: kind,
                Entries: _movies
                    .Where(m => m.Kind == kind)
                    .GroupBy(m => m.DisplayName, StringComparer.OrdinalIgnoreCase)
                    .Select(grp => new MovieEntry(grp.Key, grp.ToList()))
                    .ToList()))
            .Where(g => g.Entries.Count > 0);

    private Task ReplaceEntryAsync(MovieEntry entry) => ReplaceMovieAsync(entry.Primary);

    private async Task RestoreEntryAsync(MovieEntry entry)
    {
        foreach (var variant in entry.Variants.Where(v => v.IsReplaced))
        {
            await RestoreMovieAsync(variant);
        }
    }

    private string HeaderState => _replacedCount > 0 ? "warning" : "online";

    private string HeaderLabel => _replacedCount > 0
        ? Localizer.T("loadingscreen.header.replaced", _replacedCount, _movies.Count)
        : Localizer.T("loadingscreen.header.intact");

    private string HeaderDescription => Localizer.T(_replacedCount > 0
        ? "loadingscreen.header.replaced.description"
        : "loadingscreen.header.intact.description");

    protected override void OnInitialized()
    {
        try
        {
            _backupFolder = MovieService.GetBackupFolderPath();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to resolve the movie backup folder");
        }
        Refresh();
    }

    private void Refresh()
    {
        try
        {
            _moviesPath = MovieService.GetMoviesFolderPath();
            _arkFound = _moviesPath is not null;
            _moviesFolderFound = _arkFound && MovieService.MoviesFolderExists();
            _movies = _moviesFolderFound ? MovieService.ListMovies() : new List<ArkMovieInfo>();
            _replacedCount = _movies.Count(m => m.IsReplaced);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the ARK movie list");
            Notifications.ShowError(Localizer.T("loadingscreen.toast.readfailed"));
        }
    }

    private static string RowDescription(ArkMovieInfo movie) =>
        $"{movie.FileName} · {FormatSize(movie.SizeBytes)}";

    private void WarnIfArkRunning()
    {
        try
        {
            if (ProcessService.IsProcessRunning("ShooterGame"))
            {
                Notifications.ShowWarning(Localizer.T("loadingscreen.toast.arkrunning"));
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "ARK process check failed");
        }
    }

    private async Task ReplaceMovieAsync(ArkMovieInfo movie)
    {
        if (_busy) return;

        string? picked;
        try
        {
            // MAUI takes the dialog's owner from the *active* window, and while ARK holds
            // exclusive fullscreen this app is not active — IFileDialog::Show then fails with
            // COMException 0x80004005, which reached the user as "Could not open the file
            // picker" whenever the game was running. Raising our own window first fixes it.
            WindowActivator.BringToFront();

            var fileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
            {
                { DevicePlatform.WinUI, MovieService.SupportedSourceExtensions.ToArray() }
            });
            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = Localizer.T("loadingscreen.picker.title", movie.DisplayName),
                FileTypes = fileTypes
            });
            picked = result?.FullPath;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Movie file picker failed");
            Notifications.ShowError(Localizer.T("loadingscreen.toast.pickerfailed"));
            return;
        }

        if (picked is null) return;

        // The byte-copy fast path is gone: a replace now covers both the .mp4 and the .wmv,
        // and one picked file can only ever match one of them, so there is always a
        // conversion to do.

        _busy = true;
        try
        {
            WarnIfArkRunning();

            // Converter ships with the app; this only downloads on a build made from a fresh clone.
            if (!MovieService.ConverterReady)
            {
                _progressActive = true;
                _progressLabel = Localizer.T("loadingscreen.progress.downloading");
                _progressPercent = -1;
                await InvokeAsync(StateHasChanged);

                var setupProgress = new Progress<FfmpegSetupProgress>(p =>
                {
                    _progressLabel = Localizer.T(p.Phase == FfmpegSetupPhase.Extracting
                        ? "loadingscreen.progress.preparing"
                        : "loadingscreen.progress.downloading");
                    _progressPercent = p.Percent;
                    this.DispatchRender(() => InvokeAsync(StateHasChanged), Logger);
                });

                var ready = await MovieService.EnsureConverterAsync(setupProgress);
                if (!ready)
                {
                    Notifications.ShowError(Localizer.T("loadingscreen.toast.converterfailed"));
                    return;
                }
            }

            // Counted here, after the converter is confirmed ready but before the progress UI
            // appears — a denied replace must not flash "Converting…". Restores never count.
            var gate = await UsageGate.TryConsumeAsync(UsageFeatures.LoadingScreen);
            if (!gate.Allowed)
            {
                Notifications.ShowWarning(Localizer.T("loadingscreen.toast.limit", gate.Limit));
                return;
            }

            _progressActive = true;
            _progressLabel = Localizer.T("loadingscreen.progress.converting");
            _progressPercent = 0;
            await InvokeAsync(StateHasChanged);

            var convertProgress = new Progress<int>(p =>
            {
                _progressPercent = p;
                this.DispatchRender(() => InvokeAsync(StateHasChanged), Logger);
            });

            var result = await MovieService.ConvertAndReplaceAsync(
                movie.FileName, picked, _volumePercent, bothFormats: true, convertProgress);
            ReportReplace(movie, result);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Replacing movie {FileName} failed", movie.FileName);
            Notifications.ShowError(Localizer.T("loadingscreen.toast.replacefailed", movie.FileName));
        }
        finally
        {
            _busy = false;
            _progressActive = false;
            Refresh();
        }
    }

    private void ReportReplace(ArkMovieInfo movie, MovieOperationResult op)
    {
        if (op.Success)
        {
            Notifications.ShowSuccess(op.Message);
            Activity.AddActivity(Localizer.T("loadingscreen.activity.replaced", movie.DisplayName), "success");
        }
        else
        {
            Notifications.ShowError(op.Message);
        }
    }

    private async Task RestoreMovieAsync(ArkMovieInfo movie)
    {
        if (_busy) return;

        _busy = true;
        try
        {
            WarnIfArkRunning();
            var op = await MovieService.RestoreAsync(movie.FileName);
            if (op.Success)
            {
                Notifications.ShowSuccess(op.Message);
                Activity.AddActivity(Localizer.T("loadingscreen.activity.restored", movie.FileName), "success");
            }
            else
            {
                Notifications.ShowError(op.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Restoring movie {FileName} failed", movie.FileName);
            Notifications.ShowError(Localizer.T("loadingscreen.toast.restorefailed", movie.FileName));
        }
        finally
        {
            _busy = false;
            Refresh();
        }
    }

    private async Task RestoreAllMoviesAsync()
    {
        if (_busy || _replacedCount == 0) return;

        _busy = true;
        _restoringAll = true;
        try
        {
            WarnIfArkRunning();
            var summary = await MovieService.RestoreAllAsync();
            if (summary.Failed == 0 && summary.Restored > 0)
            {
                Notifications.ShowSuccess(Localizer.T("loadingscreen.toast.restoredall", summary.Restored));
                Activity.AddActivity(Localizer.T("loadingscreen.activity.restoredall", summary.Restored), "success");
            }
            else if (summary.Failed > 0)
            {
                var firstError = summary.Errors.Count > 0
                    ? " " + Localizer.T("loadingscreen.toast.firsterror", summary.Errors[0])
                    : "";
                Notifications.ShowError(
                    Localizer.T("loadingscreen.toast.restoredpartial", summary.Restored, summary.Failed) + firstError);
            }
            else
            {
                Notifications.ShowInfo(Localizer.T("loadingscreen.toast.nothingtorestore"));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Movie restore-all failed");
            Notifications.ShowError(Localizer.T("loadingscreen.toast.restoreallfailed"));
        }
        finally
        {
            _busy = false;
            _restoringAll = false;
            Refresh();
        }
    }

    private static string FormatSize(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB" };
        double size = bytes;
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }
        return unit == 0 ? $"{size:0} {units[unit]}" : $"{size:0.0} {units[unit]}";
    }
}
