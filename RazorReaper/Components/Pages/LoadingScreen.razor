@page "/loading-screen"
@using Microsoft.Extensions.Logging
@using RazorReaper.Services
@using RazorReaper.Services.Media

@inject ILoadingScreenService MovieService
@inject INotificationService Notifications
@inject IActivityService Activity
@inject IProcessService ProcessService
@inject ILogger<LoadingScreen> Logger

<div class="loading-screen-page">
    <header class="page-header">
        <h1 class="page-title">Custom Loading Screen</h1>
        <p class="page-subtitle">Swap ARK's startup and loading videos for your own — fully reversible.</p>
    </header>

    @if (!_arkFound)
    {
        <div class="content-card ls-empty-card">
            <div class="ls-empty-icon">
                <svg fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.721-1.36 3.486 0l5.58 9.92c.75 1.334-.214 2.98-1.743 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
            </div>
            <h3>ARK installation not found</h3>
            <p>ARK wasn't found through Steam — make sure it's installed, then rescan.</p>
            <button type="button" class="btn btn-primary" @onclick="Refresh">Rescan</button>
        </div>
    }
    else if (!_moviesFolderFound)
    {
        <div class="content-card ls-empty-card">
            <div class="ls-empty-icon">
                <svg fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
                </svg>
            </div>
            <h3>Movies folder missing</h3>
            <p>The Movies folder doesn't exist — verify the game files in Steam, then rescan.</p>
            <p class="ls-empty-path">@_moviesPath</p>
            <button type="button" class="btn btn-primary" @onclick="Refresh">Rescan</button>
        </div>
    }
    else
    {
        <StatusHeader State="@HeaderState" Label="@HeaderLabel" Description="@HeaderDescription">
            <Actions>
                <button type="button" class="btn btn-secondary" @onclick="Refresh" disabled="@_busy">Rescan</button>
                <button type="button"
                        class="btn btn-warning"
                        @onclick="RestoreAllMoviesAsync"
                        disabled="@(_busy || _replacedCount == 0)">
                    @(_restoringAll ? "Restoring…" : "Restore all")
                </button>
            </Actions>
        </StatusHeader>

        <div class="content-card ls-info-card">
            <div class="ls-info-header">
                <div class="ls-info-icon">
                    <svg fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-4a1 1 0 100 2 1 1 0 000-2zm-1 4a1 1 0 011-1h1a1 1 0 011 1v4a1 1 0 01-2 0v-3a1 1 0 01-1-1z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ls-info-title">
                    <h3>How it works</h3>
                </div>
            </div>
            <p class="ls-info-text">
                Pick any video and RazorReaper converts it to ARK's format for you. Turn on <em>Replace both formats</em>
                to update the .mp4 and .wmv variants together, and set the audio volume before replacing.
                Originals are backed up to <code>@_backupFolder</code> and changes apply on the next game start.
                The first conversion downloads the video converter (~80&nbsp;MB), stored under your app data.
            </p>
        </div>

        <div class="content-card ls-options-card">
            <div class="ls-option-row">
                <div class="ls-option-label">
                    <span class="ls-option-title">Audio volume</span>
                    <span class="ls-option-desc">Applied to the converted video. 100% keeps the original loudness; 0% mutes it.</span>
                </div>
                <div class="ls-volume">
                    <input type="range" class="ls-slider" min="0" max="200" step="1"
                           @bind="_volumePercent" @bind:event="oninput" disabled="@_busy" />
                    <span class="ls-volume-value">@_volumePercent%</span>
                </div>
            </div>
            <div class="ls-option-row">
                <div class="ls-option-label">
                    <span class="ls-option-title">Replace both formats</span>
                    <span class="ls-option-desc">Convert and swap the .mp4 and .wmv variant of a movie in one go.</span>
                </div>
                <Switch Value="_bothFormats" ValueChanged="v => _bothFormats = v" />
            </div>
        </div>

        @if (_busy && _progressActive)
        {
            <div class="content-card ls-progress-card">
                <div class="ls-progress-head">
                    <span class="ls-progress-label">@_progressLabel</span>
                    <span class="ls-progress-percent">@(_progressPercent >= 0 ? $"{_progressPercent}%" : "")</span>
                </div>
                <div class="ls-progress-track">
                    <div class="ls-progress-fill @(_progressPercent < 0 ? "indeterminate" : "")"
                         style="width:@(_progressPercent >= 0 ? _progressPercent : 100)%"></div>
                </div>
            </div>
        }

        <div class="content-card ls-movies-card">
            @if (_movies.Count == 0)
            {
                <div class="ls-no-movies">No video files found in the Movies folder.</div>
            }
            else
            {
                @foreach (var group in MovieGroups)
                {
                    <div class="ls-group" @key="group.Title">
                        <div class="ls-group-title">@group.Title</div>
                        <div class="ls-rows">
                            @foreach (var movie in group.Movies)
                            {
                                <SettingRow @key="movie.FileName" Title="@movie.DisplayName" Description="@RowDescription(movie)">
                                    @if (movie.IsReplaced)
                                    {
                                        <span class="ls-badge">Replaced</span>
                                    }
                                    <button type="button"
                                            class="btn btn-primary"
                                            @onclick="() => ReplaceMovieAsync(movie)"
                                            disabled="@_busy">
                                        Replace…
                                    </button>
                                    @if (movie.IsReplaced)
                                    {
                                        <button type="button"
                                                class="btn btn-secondary"
                                                @onclick="() => RestoreMovieAsync(movie)"
                                                disabled="@_busy">
                                            Restore
                                        </button>
                                    }
                                </SettingRow>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private List<ArkMovieInfo> _movies = new();
    private string? _moviesPath;
    private string _backupFolder = "";
    private bool _arkFound;
    private bool _moviesFolderFound;
    private bool _busy;
    private bool _restoringAll;
    private int _replacedCount;

    private int _volumePercent = 100;
    private bool _bothFormats;

    private bool _progressActive;
    private string _progressLabel = "";
    private int _progressPercent;

    private static readonly (ArkMovieKind Kind, string Title)[] GroupOrder =
    {
        (ArkMovieKind.Loading, "Loading screen"),
        (ArkMovieKind.Startup, "Startup & title"),
        (ArkMovieKind.Cinematic, "Map cinematics"),
        (ArkMovieKind.Other, "Other video files"),
    };

    private IEnumerable<(string Title, List<ArkMovieInfo> Movies)> MovieGroups =>
        GroupOrder
            .Select(g => (g.Title, Movies: _movies.Where(m => m.Kind == g.Kind).ToList()))
            .Where(g => g.Movies.Count > 0);

    private string HeaderState => _replacedCount > 0 ? "warning" : "online";

    private string HeaderLabel => _replacedCount > 0
        ? $"{_replacedCount} of {_movies.Count} videos replaced"
        : "All original videos intact";

    private string HeaderDescription => _replacedCount > 0
        ? "Custom videos play on the next game start."
        : "ARK's stock startup and loading videos are untouched.";

    protected override void OnInitialized()
    {
        try
        {
            _backupFolder = MovieService.GetBackupFolderPath();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to resolve the movie backup folder");
        }
        Refresh();
    }

    private void Refresh()
    {
        try
        {
            _moviesPath = MovieService.GetMoviesFolderPath();
            _arkFound = _moviesPath is not null;
            _moviesFolderFound = _arkFound && MovieService.MoviesFolderExists();
            _movies = _moviesFolderFound ? MovieService.ListMovies() : new List<ArkMovieInfo>();
            _replacedCount = _movies.Count(m => m.IsReplaced);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the ARK movie list");
            Notifications.ShowError("Could not read the ARK Movies folder — see the log for details.");
        }
    }

    private static string RowDescription(ArkMovieInfo movie) =>
        $"{movie.FileName} · {FormatSize(movie.SizeBytes)}";

    private void WarnIfArkRunning()
    {
        try
        {
            if (ProcessService.IsProcessRunning("ShooterGame"))
            {
                Notifications.ShowWarning("ARK is running — it may lock these files. Close the game if the change fails.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "ARK process check failed");
        }
    }

    private async Task ReplaceMovieAsync(ArkMovieInfo movie)
    {
        if (_busy) return;

        string? picked;
        try
        {
            var fileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
            {
                { DevicePlatform.WinUI, MovieService.SupportedSourceExtensions.ToArray() }
            });
            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = $"Select a video for {movie.DisplayName}",
                FileTypes = fileTypes
            });
            picked = result?.FullPath;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Movie file picker failed");
            Notifications.ShowError("Could not open the file picker.");
            return;
        }

        if (picked is null) return;

        // A same-format pick with default volume and a single target needs no conversion —
        // fall back to the fast byte-copy path so ffmpeg never has to be involved.
        var pickedExt = Path.GetExtension(picked).ToLowerInvariant();
        var needsConvert = _bothFormats
            || _volumePercent != 100
            || !string.Equals(pickedExt, movie.Extension, StringComparison.OrdinalIgnoreCase);

        _busy = true;
        try
        {
            WarnIfArkRunning();

            if (!needsConvert)
            {
                var op = await MovieService.ReplaceAsync(movie.FileName, picked);
                ReportReplace(movie, op);
                return;
            }

            // Make sure the converter is present (downloads ~80 MB on first use).
            if (!MovieService.ConverterReady)
            {
                _progressActive = true;
                _progressLabel = "Downloading video converter…";
                _progressPercent = -1;
                await InvokeAsync(StateHasChanged);

                var setupProgress = new Progress<FfmpegSetupProgress>(p =>
                {
                    _progressLabel = p.Phase == FfmpegSetupPhase.Extracting
                        ? "Preparing video converter…"
                        : "Downloading video converter…";
                    _progressPercent = p.Percent;
                    _ = InvokeAsync(StateHasChanged);
                });

                var ready = await MovieService.EnsureConverterAsync(setupProgress);
                if (!ready)
                {
                    Notifications.ShowError("Could not download the video converter — check your connection and try again.");
                    return;
                }
            }

            _progressActive = true;
            _progressLabel = _bothFormats ? "Converting both formats…" : "Converting video…";
            _progressPercent = 0;
            await InvokeAsync(StateHasChanged);

            var convertProgress = new Progress<int>(p =>
            {
                _progressPercent = p;
                _ = InvokeAsync(StateHasChanged);
            });

            var result = await MovieService.ConvertAndReplaceAsync(
                movie.FileName, picked, _volumePercent, _bothFormats, convertProgress);
            ReportReplace(movie, result);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Replacing movie {FileName} failed", movie.FileName);
            Notifications.ShowError($"Replacing {movie.FileName} failed — see the log for details.");
        }
        finally
        {
            _busy = false;
            _progressActive = false;
            Refresh();
        }
    }

    private void ReportReplace(ArkMovieInfo movie, MovieOperationResult op)
    {
        if (op.Success)
        {
            Notifications.ShowSuccess(op.Message);
            Activity.AddActivity($"Replaced ARK video {movie.DisplayName}", "success");
        }
        else
        {
            Notifications.ShowError(op.Message);
        }
    }

    private async Task RestoreMovieAsync(ArkMovieInfo movie)
    {
        if (_busy) return;

        _busy = true;
        try
        {
            WarnIfArkRunning();
            var op = await MovieService.RestoreAsync(movie.FileName);
            if (op.Success)
            {
                Notifications.ShowSuccess(op.Message);
                Activity.AddActivity($"Restored ARK video {movie.FileName}", "success");
            }
            else
            {
                Notifications.ShowError(op.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Restoring movie {FileName} failed", movie.FileName);
            Notifications.ShowError($"Restoring {movie.FileName} failed — see the log for details.");
        }
        finally
        {
            _busy = false;
            Refresh();
        }
    }

    private async Task RestoreAllMoviesAsync()
    {
        if (_busy || _replacedCount == 0) return;

        _busy = true;
        _restoringAll = true;
        try
        {
            WarnIfArkRunning();
            var summary = await MovieService.RestoreAllAsync();
            if (summary.Failed == 0 && summary.Restored > 0)
            {
                Notifications.ShowSuccess($"Restored {summary.Restored} original video(s).");
                Activity.AddActivity($"Restored all ARK videos ({summary.Restored})", "success");
            }
            else if (summary.Failed > 0)
            {
                var firstError = summary.Errors.Count > 0 ? $" First error: {summary.Errors[0]}" : "";
                Notifications.ShowError($"Restored {summary.Restored} video(s), {summary.Failed} failed.{firstError}");
            }
            else
            {
                Notifications.ShowInfo("Nothing to restore — no videos are currently replaced.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Movie restore-all failed");
            Notifications.ShowError("Restoring the original videos failed — see the log for details.");
        }
        finally
        {
            _busy = false;
            _restoringAll = false;
            Refresh();
        }
    }

    private static string FormatSize(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB" };
        double size = bytes;
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }
        return unit == 0 ? $"{size:0} {units[unit]}" : $"{size:0.0} {units[unit]}";
    }
}
