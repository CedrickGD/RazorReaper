@page "/steam-mods"
@using RazorReaper.Models
@using RazorReaper.Services
@inject ISteamWorkshopService SteamWorkshopService
@inject INotificationService NotificationService
@inject IActivityService ActivityService
@inject IProcessService ProcessService
@implements IDisposable
@using RazorReaper.Services.Localization
@inject ILocalizer Localizer

<header class="page-header">
    <h1 class="page-title">@Localizer.T("nav.page.steam-mods")</h1>
    <p class="page-subtitle">@Localizer.T("steammods.subtitle")</p>
</header>

<div class="steam-mods-layout">
    <section class="content-card steam-mods-summary-card">
        <div class="steam-mods-summary-header">
            <div class="steam-mods-summary-meta">
                <div class="steam-mods-meta-item">
                    <span class="steam-mods-meta-label">@Localizer.T("steammods.meta.installed")</span>
                    <span class="steam-mods-meta-value">@allMods.Count</span>
                </div>
                <div class="steam-mods-meta-item">
                    <span class="steam-mods-meta-label">@Localizer.T("steammods.meta.showing")</span>
                    <span class="steam-mods-meta-value">@visibleMods.Count</span>
                </div>
                <div class="steam-mods-meta-item">
                    <span class="steam-mods-meta-label">@Localizer.T("steammods.meta.libraries")</span>
                    <span class="steam-mods-meta-value">@librariesScanned.Count</span>
                </div>
                <div class="steam-mods-meta-item">
                    <span class="steam-mods-meta-label">@Localizer.T("steammods.meta.named")</span>
                    <span class="steam-mods-meta-value">@allMods.Count(mod => mod.HasSteamMetadata)</span>
                </div>
            </div>

            <button class="btn btn-primary steam-mods-refresh-btn" @onclick="RefreshModsAsync" disabled="@isLoading">
                @Localizer.T(isLoading ? "steammods.scanning" : "steammods.refresh")
            </button>
        </div>

        <div class="steam-mods-path-line">
            <span class="steam-mods-path-label">@Localizer.T("steammods.steampath")</span>
            <span class="steam-mods-path-value">@(string.IsNullOrWhiteSpace(steamPath) ? Localizer.T("steammods.path.notdetected") : steamPath)</span>
        </div>
        <div class="steam-mods-path-line">
            <span class="steam-mods-path-label">@Localizer.T("steammods.lastscan")</span>
            <span class="steam-mods-path-value">@FormatScanTime(lastScannedLocal)</span>
        </div>
    </section>

    <section class="content-card steam-mods-filter-card">
        <div class="steam-mods-filter-grid">
            <div class="steam-mods-filter-field">
                <label for="mod-search">@Localizer.T("common.search")</label>
                <input id="mod-search"
                       class="steam-mods-input"
                       @bind="SearchQuery"
                       @bind:event="oninput"
                       placeholder="@Localizer.T("steammods.search.placeholder")" />
            </div>

            <div class="steam-mods-filter-field">
                <label for="mod-sort">@Localizer.T("steammods.sort")</label>
                <Dropdown Value="@sortOption.ToString()"
                          ValueChanged="OnSortChanged"
                          Options="SortOptions" />
            </div>

            <div class="steam-mods-filter-field">
                <label for="mod-recency">@Localizer.T("steammods.recency")</label>
                <Dropdown Value="@recencyFilter.ToString()"
                          ValueChanged="OnRecencyChanged"
                          Options="RecencyOptions" />
            </div>

            <div class="steam-mods-filter-field">
                <label for="mod-size-filter">@Localizer.T("steammods.sizefilter")</label>
                <Dropdown Value="@sizeFilter.ToString()"
                          ValueChanged="OnSizeFilterChanged"
                          Options="SizeFilterOptions" />
            </div>
        </div>

        <div class="steam-mods-toggle-row">
            <Switch Compact="true" Label="@Localizer.T("steammods.onlynamed")" @bind-Value="OnlyNamedMods" />
        </div>
    </section>

    @if (scanWarnings.Count > 0)
    {
        <section class="content-card steam-mods-warning-card">
            <h3>@Localizer.T("steammods.scannotes")</h3>
            <ul class="steam-mods-warning-list">
                @foreach (var warning in scanWarnings)
                {
                    <li>@warning</li>
                }
            </ul>
        </section>
    }

    @if (isLoading)
    {
        <section class="content-card steam-mods-empty-card">
            <div class="steam-mods-spinner"></div>
            <p>@Localizer.T("steammods.scanning.text")</p>
        </section>
    }
    else if (!steamDetected)
    {
        <section class="content-card steam-mods-empty-card">
            <h3>@Localizer.T("steammods.nosteam.title")</h3>
            <p>@Localizer.T("steammods.nosteam.text")</p>
        </section>
    }
    else if (allMods.Count == 0)
    {
        <section class="content-card steam-mods-empty-card">
            <h3>@Localizer.T("steammods.nomods.title")</h3>
            <p>@Localizer.T("steammods.nomods.lead")<code>steamapps\workshop\content\346110</code>@Localizer.T("steammods.nomods.rest")</p>
        </section>
    }
    else if (visibleMods.Count == 0)
    {
        <section class="content-card steam-mods-empty-card">
            <h3>@Localizer.T("steammods.nomatch.title")</h3>
            <p>@Localizer.T("steammods.nomatch.text")</p>
        </section>
    }
    else
    {
        <section class="steam-mods-list">
            @foreach (var mod in visibleMods)
            {
                <article @key="mod.WorkshopId" class="content-card steam-mods-item-card">
                    <div class="steam-mods-item-main">
                        <div class="steam-mods-item-title-row">
                            <h3>@mod.Title</h3>
                            <span class="steam-mods-id-chip">ID @mod.WorkshopId</span>
                        </div>

                        <div class="steam-mods-tag-row">
                            <span class="steam-mods-tag">@Localizer.T("steammods.tag.drive", GetDriveRoot(mod.LibraryPath))</span>
                            <span class="steam-mods-tag">@Localizer.T("steammods.tag.size", FormatSize(mod.SizeBytes))</span>
                            <span class="steam-mods-tag">@Localizer.T("steammods.tag.installed", GetRelativeAge(mod.InstalledAtUtc))</span>
                            <span class="steam-mods-tag">@Localizer.T("steammods.tag.updated", GetRelativeAge(mod.EffectiveLastUpdatedUtc))</span>
                        </div>

                        <div class="steam-mods-time-grid">
                            <div>
                                <span class="steam-mods-time-label">@Localizer.T("steammods.time.installed")</span>
                                <span class="steam-mods-time-value">@FormatTimestamp(mod.InstalledAtUtc)</span>
                            </div>
                            <div>
                                <span class="steam-mods-time-label">@Localizer.T("steammods.time.updated")</span>
                                <span class="steam-mods-time-value">@FormatTimestamp(mod.EffectiveLastUpdatedUtc)</span>
                            </div>
                        </div>
                    </div>

                    <div class="steam-mods-actions">
                        <button class="btn btn-secondary" @onclick="() => CopyWorkshopIdAsync(mod.WorkshopId)">@Localizer.T("steammods.copyid")</button>
                        <button class="btn btn-secondary" @onclick="() => OpenWorkshopInBrowser(mod.WorkshopId)">@Localizer.T("steammods.openweb")</button>
                        <button class="btn btn-secondary" @onclick="() => OpenWorkshopInSteam(mod.WorkshopId)">@Localizer.T("steammods.opensteam")</button>
                        <button class="btn btn-secondary" @onclick="() => OpenModFolder(mod.ContentPath)">@Localizer.T("home.sound.openfolder")</button>
                    </div>
                </article>
            }
        </section>
    }
</div>

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    private readonly List<SteamWorkshopMod> allMods = new();
    private readonly List<SteamWorkshopMod> visibleMods = new();
    private readonly List<string> librariesScanned = new();
    private readonly List<string> scanWarnings = new();

    private CancellationTokenSource scanCts = new();
    private bool isLoading;
    private bool steamDetected;
    private string steamPath = string.Empty;
    private DateTime? lastScannedLocal;

    private string searchQuery = string.Empty;
    private SteamModsSort sortOption = SteamModsSort.LatestInstalled;
    private SteamModsRecency recencyFilter = SteamModsRecency.All;
    private SteamModsSizeFilter sizeFilter = SteamModsSizeFilter.All;
    private bool onlyNamedMods;

    private string SearchQuery
    {
        get => searchQuery;
        set
        {
            if (string.Equals(searchQuery, value, StringComparison.Ordinal))
            {
                return;
            }

            searchQuery = value;
            ApplyFilters();
        }
    }

    private SteamModsSort SortOption
    {
        get => sortOption;
        set
        {
            if (sortOption == value)
            {
                return;
            }

            sortOption = value;
            ApplyFilters();
        }
    }

    private IReadOnlyList<Dropdown.Option> SortOptions => new List<Dropdown.Option>
    {
        new(nameof(SteamModsSort.LatestInstalled), Localizer.T("steammods.sort.latestinstalled")),
        new(nameof(SteamModsSort.LatestUpdated), Localizer.T("steammods.sort.latestupdated")),
        new(nameof(SteamModsSort.SizeDescending), Localizer.T("steammods.sort.sizedesc")),
        new(nameof(SteamModsSort.SizeAscending), Localizer.T("steammods.sort.sizeasc")),
        new(nameof(SteamModsSort.NameAscending), Localizer.T("steammods.sort.nameasc")),
        new(nameof(SteamModsSort.NameDescending), Localizer.T("steammods.sort.namedesc")),
        new(nameof(SteamModsSort.IdAscending), Localizer.T("steammods.sort.idasc")),
        new(nameof(SteamModsSort.IdDescending), Localizer.T("steammods.sort.iddesc"))
    };

    private void OnSortChanged(string value)
    {
        if (Enum.TryParse<SteamModsSort>(value, out var parsed))
        {
            SortOption = parsed;
        }
    }

    private SteamModsRecency RecencyFilter
    {
        get => recencyFilter;
        set
        {
            if (recencyFilter == value)
            {
                return;
            }

            recencyFilter = value;
            ApplyFilters();
        }
    }

    private IReadOnlyList<Dropdown.Option> RecencyOptions => new List<Dropdown.Option>
    {
        new(nameof(SteamModsRecency.All), Localizer.T("common.all")),
        new(nameof(SteamModsRecency.Last7Days), Localizer.T("steammods.recency.7")),
        new(nameof(SteamModsRecency.Last30Days), Localizer.T("steammods.recency.30")),
        new(nameof(SteamModsRecency.Last90Days), Localizer.T("steammods.recency.90"))
    };

    private void OnRecencyChanged(string value)
    {
        if (Enum.TryParse<SteamModsRecency>(value, out var parsed))
        {
            RecencyFilter = parsed;
        }
    }

    private SteamModsSizeFilter SizeFilter
    {
        get => sizeFilter;
        set
        {
            if (sizeFilter == value)
            {
                return;
            }

            sizeFilter = value;
            ApplyFilters();
        }
    }

    private IReadOnlyList<Dropdown.Option> SizeFilterOptions => new List<Dropdown.Option>
    {
        new(nameof(SteamModsSizeFilter.All), Localizer.T("steammods.size.all")),
        new(nameof(SteamModsSizeFilter.Unknown), Localizer.T("steammods.size.unknown")),
        new(nameof(SteamModsSizeFilter.Under100Mb), Localizer.T("steammods.size.under100")),
        new(nameof(SteamModsSizeFilter.Mb100To500), Localizer.T("steammods.size.100to500")),
        new(nameof(SteamModsSizeFilter.Mb500To1Gb), Localizer.T("steammods.size.500to1g")),
        new(nameof(SteamModsSizeFilter.Over1Gb), Localizer.T("steammods.size.over1g"))
    };

    private void OnSizeFilterChanged(string value)
    {
        if (Enum.TryParse<SteamModsSizeFilter>(value, out var parsed))
        {
            SizeFilter = parsed;
        }
    }

    private bool OnlyNamedMods
    {
        get => onlyNamedMods;
        set
        {
            if (onlyNamedMods == value)
            {
                return;
            }

            onlyNamedMods = value;
            ApplyFilters();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshModsAsync(showToast: false);
    }

    private async Task RefreshModsAsync()
    {
        await RefreshModsAsync(showToast: true);
    }

    private async Task RefreshModsAsync(bool showToast)
    {
        if (isLoading)
        {
            return;
        }

        isLoading = true;
        StateHasChanged();

        scanCts.Cancel();
        scanCts.Dispose();
        scanCts = new CancellationTokenSource();

        try
        {
            var result = await SteamWorkshopService.ScanInstalledArkModsAsync(scanCts.Token);

            steamDetected = result.SteamDetected;
            steamPath = result.SteamPath ?? string.Empty;
            lastScannedLocal = result.ScannedAtUtc.ToLocalTime();

            librariesScanned.Clear();
            librariesScanned.AddRange(result.LibrariesScanned);

            scanWarnings.Clear();
            scanWarnings.AddRange(result.Warnings);

            allMods.Clear();
            allMods.AddRange(result.Mods);

            ApplyFilters();

            if (showToast)
            {
                if (!steamDetected)
                {
                    NotificationService.ShowWarning(Localizer.T("steammods.toast.nosteam"));
                }
                else if (allMods.Count == 0)
                {
                    NotificationService.ShowInfo(Localizer.T("steammods.toast.nomods"));
                }
                else
                {
                    NotificationService.ShowSuccess(Localizer.T("steammods.toast.loaded", allMods.Count));
                }
            }

            ActivityService.AddActivity(Localizer.T("steammods.activity.scanned", allMods.Count), "info");
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            NotificationService.ShowError(Localizer.T("steammods.toast.scanfailed", ex.Message));
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ApplyFilters()
    {
        IEnumerable<SteamWorkshopMod> query = allMods;
        var term = searchQuery.Trim();

        if (!string.IsNullOrWhiteSpace(term))
        {
            query = query.Where(mod =>
                mod.WorkshopId.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                mod.Title.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        if (onlyNamedMods)
        {
            query = query.Where(mod => mod.HasSteamMetadata);
        }

        var utcNow = DateTime.UtcNow;
        query = recencyFilter switch
        {
            SteamModsRecency.Last7Days => query.Where(mod => mod.InstalledAtUtc.HasValue && mod.InstalledAtUtc.Value >= utcNow.AddDays(-7)),
            SteamModsRecency.Last30Days => query.Where(mod => mod.InstalledAtUtc.HasValue && mod.InstalledAtUtc.Value >= utcNow.AddDays(-30)),
            SteamModsRecency.Last90Days => query.Where(mod => mod.InstalledAtUtc.HasValue && mod.InstalledAtUtc.Value >= utcNow.AddDays(-90)),
            _ => query
        };

        if (sizeFilter != SteamModsSizeFilter.All)
        {
            query = query.Where(mod => MatchesSizeFilter(mod.SizeBytes, sizeFilter));
        }

        query = sortOption switch
        {
            SteamModsSort.LatestInstalled => query.OrderByDescending(mod => mod.InstalledAtUtc ?? DateTime.MinValue),
            SteamModsSort.LatestUpdated => query.OrderByDescending(mod => mod.EffectiveLastUpdatedUtc ?? DateTime.MinValue),
            SteamModsSort.SizeDescending => query
                .OrderByDescending(mod => mod.SizeBytes ?? -1)
                .ThenBy(mod => mod.Title, StringComparer.OrdinalIgnoreCase),
            SteamModsSort.SizeAscending => query
                .OrderBy(mod => mod.SizeBytes ?? long.MaxValue)
                .ThenBy(mod => mod.Title, StringComparer.OrdinalIgnoreCase),
            SteamModsSort.NameAscending => query.OrderBy(mod => mod.Title, StringComparer.OrdinalIgnoreCase),
            SteamModsSort.NameDescending => query.OrderByDescending(mod => mod.Title, StringComparer.OrdinalIgnoreCase),
            SteamModsSort.IdAscending => query.OrderBy(mod => mod.WorkshopId, StringComparer.OrdinalIgnoreCase),
            SteamModsSort.IdDescending => query.OrderByDescending(mod => mod.WorkshopId, StringComparer.OrdinalIgnoreCase),
            _ => query
        };

        visibleMods.Clear();
        visibleMods.AddRange(query);
    }

    private static bool MatchesSizeFilter(long? sizeBytes, SteamModsSizeFilter filter)
    {
        const long oneMegabyte = 1024L * 1024L;
        const long oneGigabyte = 1024L * 1024L * 1024L;

        if (!sizeBytes.HasValue || sizeBytes.Value <= 0)
        {
            return filter == SteamModsSizeFilter.Unknown;
        }

        var size = sizeBytes.Value;
        return filter switch
        {
            SteamModsSizeFilter.Unknown => false,
            SteamModsSizeFilter.Under100Mb => size < 100L * oneMegabyte,
            SteamModsSizeFilter.Mb100To500 => size >= 100L * oneMegabyte && size < 500L * oneMegabyte,
            SteamModsSizeFilter.Mb500To1Gb => size >= 500L * oneMegabyte && size < oneGigabyte,
            SteamModsSizeFilter.Over1Gb => size >= oneGigabyte,
            _ => true
        };
    }

    private async Task CopyWorkshopIdAsync(string workshopId)
    {
        try
        {
            await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(workshopId);
            NotificationService.ShowSuccess(Localizer.T("steammods.toast.copied", workshopId));
        }
        catch (Exception ex)
        {
            NotificationService.ShowError(Localizer.T("steammods.toast.copyfailed", ex.Message));
        }
    }

    private void OpenWorkshopInBrowser(string workshopId)
    {
        OpenProcess(GetWorkshopWebUrl(workshopId), Localizer.T("steammods.toast.openweb.failed"));
    }

    private void OpenWorkshopInSteam(string workshopId)
    {
        OpenProcess($"steam://url/CommunityFilePage/{workshopId}", Localizer.T("steammods.toast.opensteam.failed"));
    }

    private void OpenModFolder(string contentPath)
    {
        if (string.IsNullOrWhiteSpace(contentPath))
        {
            NotificationService.ShowWarning(Localizer.T("steammods.toast.nofolder"));
            return;
        }

        OpenProcess(contentPath, Localizer.T("steammods.toast.openfolder.failed"));
    }

    private void OpenProcess(string target, string errorMessage)
    {
        try
        {
            ProcessService.Start(target);
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"{errorMessage} {ex.Message}");
        }
    }

    private static string GetWorkshopWebUrl(string workshopId)
    {
        return $"https://steamcommunity.com/sharedfiles/filedetails/?id={workshopId}";
    }

    private string FormatScanTime(DateTime? localTime)
    {
        if (!localTime.HasValue)
        {
            return Localizer.T("steammods.notscanned");
        }

        return localTime.Value.ToString("yyyy-MM-dd HH:mm:ss");
    }

    private string GetDriveRoot(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return Localizer.T("common.unknown");
        }

        try
        {
            return Path.GetPathRoot(path) ?? path;
        }
        catch
        {
            return path;
        }
    }

    private string FormatTimestamp(DateTime? timestampUtc)
    {
        if (!timestampUtc.HasValue)
        {
            return Localizer.T("common.unknown");
        }

        return timestampUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
    }

    private string GetRelativeAge(DateTime? timestampUtc)
    {
        if (!timestampUtc.HasValue)
        {
            return Localizer.T("common.unknown");
        }

        var span = DateTime.UtcNow - timestampUtc.Value;
        if (span.TotalDays >= 1)
        {
            return Localizer.T("activity.days", (int)span.TotalDays);
        }

        if (span.TotalHours >= 1)
        {
            return Localizer.T("activity.hours", (int)span.TotalHours);
        }

        if (span.TotalMinutes >= 1)
        {
            return Localizer.T("activity.minutes", (int)span.TotalMinutes);
        }

        return Localizer.T("activity.justnow");
    }

    private string FormatSize(long? bytes)
    {
        if (!bytes.HasValue || bytes.Value <= 0)
        {
            return Localizer.T("common.unknown");
        }

        string[] units = ["B", "KB", "MB", "GB", "TB"];
        double value = bytes.Value;
        var unitIndex = 0;

        while (value >= 1024 && unitIndex < units.Length - 1)
        {
            value /= 1024;
            unitIndex++;
        }

        return $"{value:0.##} {units[unitIndex]}";
    }

    public void Dispose()
    {
        scanCts.Cancel();
        scanCts.Dispose();
    }

    private enum SteamModsSort
    {
        LatestInstalled,
        LatestUpdated,
        SizeDescending,
        SizeAscending,
        NameAscending,
        NameDescending,
        IdAscending,
        IdDescending
    }

    private enum SteamModsRecency
    {
        All,
        Last7Days,
        Last30Days,
        Last90Days
    }

    private enum SteamModsSizeFilter
    {
        All,
        Unknown,
        Under100Mb,
        Mb100To500,
        Mb500To1Gb,
        Over1Gb
    }
}
