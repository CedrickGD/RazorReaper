@page "/launch-options"
@using System.Diagnostics
@using RazorReaper.Services
@inject INotificationService NotificationService
@inject IActivityService ActivityService
@using RazorReaper.Services.Localization
@inject ILocalizer Localizer

<header class="page-header">
    <h1 class="page-title">@Localizer.T("nav.page.launch-options")</h1>
    <p class="page-subtitle">@Localizer.T("launch.subtitle")</p>
</header>

<div class="launch-options-layout">
    <section class="content-card launch-options-intro-card">
        <div class="launch-options-intro-header">
            <div class="launch-options-intro-icon" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10 2a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V3a1 1 0 011-1z" />
                </svg>
            </div>
            <div>
                <h3>@Localizer.T("launch.before.title")</h3>
                <p>@Localizer.T("launch.before.text")</p>
            </div>
        </div>
    </section>

    <section class="content-card launch-options-args-card">
        <div class="launch-options-section-header">
            <h3>@Localizer.T("launch.args.title")</h3>
            <p>@Localizer.T("launch.args.text")</p>
        </div>

        <div class="launch-options-grid">
            @foreach (var option in Options)
            {
                <article @key="option.Flag" class="launch-option-card">
                    <button class="launch-option-flag launch-option-flag-btn"
                            @onclick="() => CopyTextAsync(option.Flag)"
                            title="@Localizer.T("launch.copyflag", option.Flag)">
                        @option.Flag
                    </button>
                    <p class="launch-option-description">@Localizer.T(option.DescriptionKey)</p>

                    <div class="launch-option-list-block">
                        <div class="launch-option-list-title">@Localizer.T("launch.goodfor")</div>
                        <ul class="launch-option-list">
                            @foreach (var key in option.ProKeys)
                            {
                                <li @key="key">@Localizer.T(key)</li>
                            }
                        </ul>
                    </div>

                    <div class="launch-option-list-block launch-option-list-block-warning">
                        <div class="launch-option-list-title">@Localizer.T("launch.watchout")</div>
                        <ul class="launch-option-list">
                            @foreach (var key in option.ConKeys)
                            {
                                <li @key="key">@Localizer.T(key)</li>
                            }
                        </ul>
                    </div>
                </article>
            }
        </div>
    </section>

    <div class="launch-options-bottom-grid">
        <section class="content-card launch-options-steps-card">
            <h3>@Localizer.T("launch.steps.title")</h3>
            <button class="launch-options-steam-btn" @onclick="OpenArkLaunchOptionsInSteam">
                Open ARK Properties (General)
            </button>
            <ol class="launch-options-steps">
                <li>@Localizer.T("launch.step.1")</li>
                <li>@Localizer.T("launch.step.2")</li>
                <li>@Localizer.T("launch.step.3")</li>
                <li>@Localizer.T("launch.step.4")</li>
            </ol>
            <p class="launch-options-note">
                If you already use custom options, keep them. Example: keep <code>-culture=zh-Hans-CN</code> and append new flags with spaces.
            </p>
        </section>

        <section class="content-card launch-options-example-card">
            <h3>@Localizer.T("launch.example.title")</h3>
            <p>@Localizer.T("launch.example.text")</p>
            <button class="launch-options-code launch-options-code-btn"
                    @onclick="() => CopyTextAsync(ExampleLaunchLine)"
                    title="@Localizer.T("launch.example.tooltip")">
                @ExampleLaunchLine
            </button>
            <p class="launch-options-note">@Localizer.T("launch.note.lead")<code>-lowmemory</code>@Localizer.T("launch.note.rest")</p>
        </section>
    </div>
</div>

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    private const string ArkSteamUrl = "steam://gameproperties/346110/general";
    private const string ArkSteamFallbackUrl = "steam://gameproperties/346110";
    private const string ExampleLaunchLine = "-lowmemory -USEALLAVAILABLECORES -sm4 -high -noVerifiedMappings -nomansky";

    /// <summary>
    /// The flags, and where each one's prose lives. Public and static so the set of keys the page
    /// asks for can be read off it by a test — a list of keys inside a razor file is invisible to
    /// a grep for T("…"), and an unused entry in four dictionaries is four people translating
    /// something nothing renders.
    ///
    /// The flags themselves are ARK's own command-line switches and are never translated.
    /// </summary>
    public static readonly IReadOnlyList<LaunchOptionInfo> Options = new List<LaunchOptionInfo>
    {
        new("-lowmemory", 3, 1),
        new("-USEALLAVAILABLECORES", 1, 1),
        new("-sm4", 1, 1),
        new("-high", 1, 1),
        new("-noVerifiedMappings", 1, 1),
        new("-nomansky", 2, 1),
    };

    private async Task CopyTextAsync(string text)
    {
        try
        {
            await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(text);
            NotificationService.ShowSuccess(Localizer.T("launch.toast.copied"));
            ActivityService.AddActivity(Localizer.T("launch.activity.copied", text), "info");
        }
        catch (Exception ex)
        {
            NotificationService.ShowError(Localizer.T("launch.toast.copyfailed", ex.Message));
        }
    }

    private void OpenArkLaunchOptionsInSteam()
    {
        try
        {
            Process.Start(new ProcessStartInfo
            {
                FileName = ArkSteamUrl,
                UseShellExecute = true
            });

            NotificationService.ShowSuccess(Localizer.T("launch.toast.opened"));
            ActivityService.AddActivity(Localizer.T("launch.activity.opened"), "info");
        }
        catch (Exception ex)
        {
            try
            {
                Process.Start(new ProcessStartInfo
                {
                    FileName = ArkSteamFallbackUrl,
                    UseShellExecute = true
                });

                NotificationService.ShowWarning(Localizer.T("launch.toast.opened.fallback"));
                ActivityService.AddActivity(Localizer.T("launch.activity.opened.fallback"), "warning");
            }
            catch
            {
                NotificationService.ShowError(Localizer.T("launch.toast.openfailed", ex.Message));
            }
        }
    }

    /// <param name="Flag">ARK's own switch, as it is typed into Steam.</param>
    /// <param name="Pros">How many "Good for" lines this flag has.</param>
    /// <param name="Cons">How many "Watch out" lines it has.</param>
    public sealed record LaunchOptionInfo(string Flag, int Pros, int Cons)
    {
        /// <summary>Key prefix, derived from the flag: "-sm4" is "launch.opt.sm4".</summary>
        public string KeyPrefix => "launch.opt." + Flag.TrimStart('-').ToLowerInvariant();

        public string DescriptionKey => KeyPrefix + ".description";

        public IEnumerable<string> ProKeys => Enumerable.Range(1, Pros).Select(n => $"{KeyPrefix}.pro.{n}");

        public IEnumerable<string> ConKeys => Enumerable.Range(1, Cons).Select(n => $"{KeyPrefix}.con.{n}");
    }
}
