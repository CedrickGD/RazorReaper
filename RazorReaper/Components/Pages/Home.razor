        {
            if (isCheckingForUpdates)
                return "update-badge update-badge-checking";

            if (updateResult == null)
                return "update-badge update-badge-idle";

            if (!string.IsNullOrWhiteSpace(updateResult.ErrorMessage))
                return "update-badge update-badge-error";

