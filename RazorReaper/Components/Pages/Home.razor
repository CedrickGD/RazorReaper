    private async Task LoadThemeSettingsAsync()
    {
        try
        {
            var settings = await JSRuntime.InvokeAsync<ThemeSettings>("getThemeSettings");
            if (settings != null)
            {
                selectedAccentColor = string.IsNullOrWhiteSpace(settings.Accent)
                    ? DefaultAccentColor
                    : settings.Accent.ToUpperInvariant();
                accentLightOverride = settings.Light ?? "";
                accentDarkOverride = settings.Dark ?? "";
                accentDarkerOverride = settings.Darker ?? "";
                accentSoftOverride = settings.Soft ?? "";
                SyncPickerFromAccent();
            }
        }
        catch (Exception ex)
