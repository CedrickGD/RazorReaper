        {
            Logger.LogError(ex, "Error copying font download link for {PresetId}", preset.Id);
            NotificationService.ShowError("Failed to copy download link.");
        }
    }

    private FontPreset ResolveFontPreset(string? presetId)
    {
        if (!string.IsNullOrWhiteSpace(presetId))
        {
            var match = FontPresets.FirstOrDefault(preset =>
                string.Equals(preset.Id, presetId, StringComparison.OrdinalIgnoreCase));
            if (match != null)
            {
                return match;
            }
        }

        return FontPresets[0];
    }

    private void ResolveCustomSoundFolder()
    {
        try
        {
            var candidate = Path.Combine(AppContext.BaseDirectory, "wwwroot", "assets", "sounds", "custom");
            customSoundFolderAvailable = Directory.Exists(candidate);
            customSoundFolderPath = customSoundFolderAvailable ? candidate : "";
            customSoundFolderDisplay = customSoundFolderAvailable ? candidate : CustomSoundFolderRelative;
        }
        catch
        {
            customSoundFolderAvailable = false;
            customSoundFolderPath = "";
            customSoundFolderDisplay = CustomSoundFolderRelative;
        }
    }

    private void OpenCustomSoundFolder()
    {
        if (!customSoundFolderAvailable)
        {
            NotificationService.ShowError("Custom sound folder not found.");
            return;
        }

        OpenFolderInExplorer(customSoundFolderPath);
    }

    private async Task HandleNotificationSoundUpload(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file == null)
        {
            return;
        }

        if (!IsSupportedSoundFile(file))
        {
            NotificationService.ShowWarning("Unsupported audio format. Use MP3, WAV, OGG, M4A, or AAC.");
            return;
        }

        if (file.Size > MaxSoundFileBytes)
        {
            NotificationService.ShowWarning($"Sound file too large. Max size is {MaxSoundFileMb} MB.");
            return;
        }

        var dataUrl = await ReadSoundFileAsDataUrl(file);
        if (string.IsNullOrWhiteSpace(dataUrl))
        {
            NotificationService.ShowError("Could not read the sound file.");
            return;
        }

        notificationSoundSource = dataUrl;
        notificationSoundLabel = file.Name;
        notificationSoundCustom = true;

        await PersistSoundSettingsAsync();
        NotificationService.ShowSuccess("Notification sound updated");
    }

    private async Task HandleClickSoundUpload(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file == null)
        {
            return;
        }

        if (!IsSupportedSoundFile(file))
        {
            NotificationService.ShowWarning("Unsupported audio format. Use MP3, WAV, OGG, M4A, or AAC.");
            return;
        }

        if (file.Size > MaxSoundFileBytes)
        {
            NotificationService.ShowWarning($"Sound file too large. Max size is {MaxSoundFileMb} MB.");
            return;
        }

        var dataUrl = await ReadSoundFileAsDataUrl(file);
        if (string.IsNullOrWhiteSpace(dataUrl))
        {
            NotificationService.ShowError("Could not read the sound file.");
            return;
        }

        clickSoundSource = dataUrl;
        clickSoundLabel = file.Name;
        clickSoundCustom = true;

        await PersistSoundSettingsAsync();
        NotificationService.ShowSuccess("Click sound updated");
    }

    private async Task<string?> ReadSoundFileAsDataUrl(IBrowserFile file)
    {
        try
        {
            var contentType = ResolveSoundContentType(file);
            await using var stream = file.OpenReadStream(MaxSoundFileBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var base64 = Convert.ToBase64String(buffer.ToArray());
            return $"data:{contentType};base64,{base64}";
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to read sound file");
            return null;
        }
    }

    private static string ResolveSoundContentType(IBrowserFile file)
    {
        if (!string.IsNullOrWhiteSpace(file.ContentType) &&
            file.ContentType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase))
        {
            return file.ContentType;
        }

        var extension = Path.GetExtension(file.Name);
        return extension switch
        {
            ".wav" => "audio/wav",
            ".ogg" => "audio/ogg",
            ".m4a" => "audio/mp4",
            ".aac" => "audio/aac",
            _ => "audio/mpeg"
        };
    }

    private static bool IsSupportedSoundFile(IBrowserFile file)
    {
        if (!string.IsNullOrWhiteSpace(file.ContentType) &&
            file.ContentType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var extension = Path.GetExtension(file.Name);
        return SupportedSoundExtensions.Contains(extension);
    }

