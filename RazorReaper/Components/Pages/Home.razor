    private async Task HandleNotificationSoundUpload(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file == null)
        {
            return;
        }

        if (!IsSupportedSoundFile(file))
        {
            NotificationService.ShowWarning("Unsupported audio format. Use MP3, WAV, OGG, M4A, or AAC.");
            return;
        }

        if (file.Size > MaxSoundFileBytes)
        {
            NotificationService.ShowWarning($"Sound file too large. Max size is {MaxSoundFileMb} MB.");
            return;
        }

        var dataUrl = await ReadSoundFileAsDataUrl(file);
        if (string.IsNullOrWhiteSpace(dataUrl))
        {
            NotificationService.ShowError("Could not read the sound file.");
            return;
        }

        notificationSoundSource = dataUrl;
        notificationSoundLabel = file.Name;
        notificationSoundCustom = true;

        await PersistSoundSettingsAsync();
        NotificationService.ShowSuccess("Notification sound updated");
    }

