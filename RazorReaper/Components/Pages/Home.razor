    private void StartResourceMonitoring()
    {
        try
        {
            // Initialize CPU counter - using "Processor Information" for better accuracy on modern systems
            try
            {
                if (PerformanceCounterCategory.Exists("Processor Information"))
                {
                    cpuCounter = new PerformanceCounter("Processor Information", "% Processor Time", "_Total");
                    Logger.LogDebug("Using 'Processor Information' category for CPU monitoring");
                }
                else
                {
                    cpuCounter = new PerformanceCounter("Processor", "% Processor Time", "_Total");
                    Logger.LogDebug("Using 'Processor' category for CPU monitoring (fallback)");
                }
            }
            catch
            {
                // Fallback to older counter if Processor Information doesn't exist
                cpuCounter = new PerformanceCounter("Processor", "% Processor Time", "_Total");
                Logger.LogDebug("Using 'Processor' category for CPU monitoring (fallback)");
            }

            // Initialize RAM counter
            ramCounter = new PerformanceCounter("Memory", "% Committed Bytes In Use");

            // Get physical RAM using GlobalMemoryStatusEx for accurate totals
            var memStatus = new MEMORYSTATUSEX();
            if (GlobalMemoryStatusEx(memStatus))
            {
                ramTotalGB = Math.Round(memStatus.ullTotalPhys / 1024.0 / 1024.0 / 1024.0, 2);
                Logger.LogDebug("Physical RAM detected: {TotalGB} GB", ramTotalGB);
            }
            else
            {
                // Fallback to older method
                GetPhysicallyInstalledSystemMemory(out long totalMemoryKB);
                ramTotalGB = Math.Round(totalMemoryKB / 1024.0 / 1024.0, 2);
                Logger.LogDebug("Physical RAM detected (fallback): {TotalGB} GB", ramTotalGB);
            }

            // Initialize GPU counters - track ALL engine types, not just 3D
            try
            {
                Logger.LogInformation("Detecting GPU performance counters...");

                if (PerformanceCounterCategory.Exists("GPU Engine"))
                {
                    var cat = new PerformanceCounterCategory("GPU Engine");
                    var instanceNames = cat.GetInstanceNames();

                    Logger.LogDebug("Found {Count} GPU Engine instances", instanceNames.Length);

                    // Create counters for ALL GPU engines (3D, Compute, Copy, Video)
                    foreach (var instance in instanceNames)
                    {
                        try
                        {
                            var counter = new PerformanceCounter("GPU Engine", "Utilization Percentage", instance);
                            counter.NextValue(); // Warm up counter
                            gpuCounters.Add(counter);
                            Logger.LogDebug("GPU Engine counter added: {Instance}", instance);
                        }
                        catch (Exception ex)
                        {
                            Logger.LogDebug(ex, "Failed to add GPU counter for instance: {Instance}", instance);
                        }
                    }

                    if (gpuCounters.Count > 0)
                    {
                        hasGpuCounter = true;
                        Logger.LogInformation("GPU monitoring enabled: Successfully initialized {Count} GPU engine counter(s)", gpuCounters.Count);
                    }
                    else
                    {
                        Logger.LogWarning("GPU monitoring disabled: No GPU engine counters found");
                        hasGpuCounter = false;
                    }
                }
                else
                {
                    Logger.LogWarning("GPU monitoring disabled: GPU Engine performance category not available");
                    hasGpuCounter = false;
                }
            }
            catch (Exception gpuEx)
            {
                Logger.LogWarning(gpuEx, "GPU monitoring disabled: Could not initialize GPU counters");
                hasGpuCounter = false;
            }

            // Cache current process
            currentProcess = Process.GetCurrentProcess();

            // Warm up counters with initial reads
            cpuCounter.NextValue();
            ramCounter.NextValue();

            // Wait a brief moment for CPU counter to stabilize (required for accurate first reading)
            Thread.Sleep(100);

            // Mark initialization as complete
            resourceMonitoringInitialized = true;

            // Do an immediate first update to show data right away
            UpdateResources(null, null!);

            // Start monitoring timer at 1000ms for Task Manager-like responsiveness
            resourceTimer = new System.Timers.Timer(1000);
            resourceTimer.Elapsed += UpdateResources;
            resourceTimer.Start();

            Logger.LogInformation("Resource monitoring started: {TotalRAM} GB total RAM, GPU monitoring: {HasGPU} with {GPUCount} engines",
                ramTotalGB, hasGpuCounter, gpuCounters.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error starting resource monitoring");
            resourceMonitoringInitialized = false;
        }
    }

    private void UpdateResources(object? sender, System.Timers.ElapsedEventArgs? e)
    {
        // Don't update if initialization hasn't completed or component is disposed
        if (!resourceMonitoringInitialized || _isDisposed)
            return;

        if (System.Threading.Interlocked.Exchange(ref resourceUpdateInProgress, 1) == 1)
            return;

        try
        {
            var nowUtc = DateTime.UtcNow;

            // Get CPU usage - ensure it's between 0-100
            var cpuValue = cpuCounter?.NextValue() ?? 0;
            cpuUsage = (int)Math.Round(Math.Clamp(cpuValue, 0, 100));

            // Get RAM usage using GlobalMemoryStatusEx for accuracy
            var memStatus = new MEMORYSTATUSEX();
            if (GlobalMemoryStatusEx(memStatus))
            {
                // Calculate actual physical RAM usage percentage
                var usedPhys = memStatus.ullTotalPhys - memStatus.ullAvailPhys;
                ramUsage = (int)Math.Round(Math.Clamp((usedPhys * 100.0 / memStatus.ullTotalPhys), 0, 100));
                ramUsedGB = Math.Round(usedPhys / 1024.0 / 1024.0 / 1024.0, 2);
            }
            else
            {
                // Fallback to committed bytes percentage
                var ramValue = ramCounter?.NextValue() ?? 0;
                ramUsage = (int)Math.Round(Math.Clamp(ramValue, 0, 100));
                ramUsedGB = Math.Round((ramUsage / 100.0) * ramTotalGB, 2);
            }

            // Get GPU usage - parse LUIDs and aggregate by adapter (Task Manager method)
            if (hasGpuCounter && gpuCounters.Count > 0)
            {
                try
                {
                    // Track unique physical engines per adapter to avoid overcounting
                    var adapters = new Dictionary<string, GpuAdapter>();

                    foreach (var counter in gpuCounters)
                    {
                        try
                        {
                            var instanceName = counter.InstanceName;
                            var value = counter.NextValue();

                            if (!TryParseGpuInstance(instanceName, out var luid, out var engineType))
                                continue;

                            // Get or create adapter entry
                            if (!adapters.ContainsKey(luid))
                            {
                                adapters[luid] = new GpuAdapter { Luid = luid };
                            }

                            var adapter = adapters[luid];

                            var normalizedValue = Math.Clamp(value, 0, 100);
                            adapter.TotalUtilization = Math.Max(adapter.TotalUtilization, normalizedValue);

                            if (engineType.Equals("3D", StringComparison.OrdinalIgnoreCase))
                            {
                                adapter.Utilization3D = Math.Max(adapter.Utilization3D, normalizedValue);
                            }
                            else if (engineType.Equals("Compute", StringComparison.OrdinalIgnoreCase))
                            {
                                adapter.UtilizationCompute = Math.Max(adapter.UtilizationCompute, normalizedValue);
                            }
                            else if (engineType.Equals("Copy", StringComparison.OrdinalIgnoreCase))
                            {
                                adapter.UtilizationCopy = Math.Max(adapter.UtilizationCopy, normalizedValue);
                            }
                            else if (engineType.StartsWith("Video", StringComparison.OrdinalIgnoreCase))
                            {
                                adapter.UtilizationVideo = Math.Max(adapter.UtilizationVideo, normalizedValue);
                            }
                        }
                        catch (Exception counterEx)
                        {
                            Logger.LogTrace(counterEx, "Failed to read individual GPU counter");
                        }
                    }

                    // Find the adapter with highest total utilization (like Task Manager does)
                    if (adapters.Count > 0)
                    {
                        var primaryAdapter = adapters.Values.OrderByDescending(a => a.TotalUtilization).First();

                        // Task Manager-style summary: use the busiest engine for the primary adapter.
                        gpuUsage = (int)Math.Round(Math.Clamp(primaryAdapter.TotalUtilization, 0, 100));

                        Logger.LogTrace("GPU Adapter {Luid}: Total={Total}%, 3D={D3D}%, Compute={Compute}%, Copy={Copy}%, Video={Video}%",
                            primaryAdapter.Luid,
                            primaryAdapter.TotalUtilization,
                            primaryAdapter.Utilization3D,
                            primaryAdapter.UtilizationCompute,
                            primaryAdapter.UtilizationCopy,
                            primaryAdapter.UtilizationVideo);
                    }
                    else
                    {
                        gpuUsage = 0;
                    }
                }
                catch (Exception gpuEx)
                {
                    Logger.LogDebug(gpuEx, "Error reading GPU usage");
                    gpuUsage = 0;
                }
            }

            if (nowUtc - lastWifiRefreshUtc >= WifiRefreshInterval)
            {
                LoadWiFiInfo();
                lastWifiRefreshUtc = nowUtc;
            }

            if (nowUtc - lastStorageRefreshUtc >= StorageRefreshInterval)
            {
                LoadSystemComponentsInfo();
                lastStorageRefreshUtc = nowUtc;
            }

            // Get current process memory - use cached process to avoid lag
            if (currentProcess != null)
            {
                try
                {
                    currentProcess.Refresh(); // Refresh the cached process data
                    processMemoryMB = Math.Round(currentProcess.WorkingSet64 / 1024.0 / 1024.0, 1);
                }
                catch
                {
                    // Process might have exited, recreate it
                    currentProcess?.Dispose();
                    currentProcess = Process.GetCurrentProcess();
                    processMemoryMB = Math.Round(currentProcess.WorkingSet64 / 1024.0 / 1024.0, 1);
                }
            }

            // Log resource usage periodically for debugging
            Logger.LogTrace("Resource Update - CPU: {CPU}%, RAM: {RAM}% ({Used}/{Total} GB), GPU: {GPU}%, Process: {Process}MB",
                cpuUsage, ramUsage, ramUsedGB, ramTotalGB, gpuUsage, processMemoryMB);

            if (!_isDisposed)
                InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating resource usage");
        }
        finally
        {
            System.Threading.Interlocked.Exchange(ref resourceUpdateInProgress, 0);
        }
    }

    private bool TryParseGpuInstance(string instanceName, out string adapterKey, out string engineType)
    {
        adapterKey = string.Empty;
        engineType = string.Empty;

        try
        {
            // Example instance:
            // pid_1234_luid_0x00000000_0x0000D4CB_phys_0_engtype_3D
            var parts = instanceName.Split('_', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length < 8)
                return false;

            var luidIndex = Array.IndexOf(parts, "luid");
            var physIndex = Array.IndexOf(parts, "phys");
            var engTypeIndex = Array.IndexOf(parts, "engtype");

            if (luidIndex < 0 || physIndex < 0 || engTypeIndex < 0)
                return false;

            if (luidIndex + 2 >= parts.Length || physIndex + 1 >= parts.Length || engTypeIndex + 1 >= parts.Length)
                return false;

            adapterKey = $"luid_{parts[luidIndex + 1]}_{parts[luidIndex + 2]}";
            engineType = parts[engTypeIndex + 1];
            return true;
        }
        catch
        {
            return false;
        }
    }

    private void UpdateTimeZoneInfo()
    {
        var localTimeZone = TimeZoneInfo.Local;
        timeZoneInfo = FormatTimeZoneDisplayName(localTimeZone.DisplayName);
        var offset = localTimeZone.GetUtcOffset(currentTime);

        // Format UTC offset (e.g., UTC+01:00 or UTC-05:00)
        var offsetHours = offset.Hours;
        var offsetMinutes = Math.Abs(offset.Minutes);
        var sign = offsetHours >= 0 ? "+" : "";
        utcOffset = $"UTC{sign}{offsetHours:00}:{offsetMinutes:00}";

        // Calculate ISO week number
        var culture = System.Globalization.CultureInfo.CurrentCulture;
        var calendar = culture.Calendar;
        weekNumber = calendar.GetWeekOfYear(
            currentTime,
            culture.DateTimeFormat.CalendarWeekRule,
            culture.DateTimeFormat.FirstDayOfWeek
        );
    }

    private void UpdateUptimeInfo()
    {
        var uptimeSpan = TimeSpan.FromMilliseconds(Environment.TickCount64);
        systemUptime = FormatDuration(uptimeSpan);
        appSessionDuration = FormatDuration(DateTime.Now - appStartTime);
    }

    private string FormatDuration(TimeSpan span)
    {
        if (span.Days > 0)
            return $"{span.Days}d {span.Hours}h";

        if (span.Hours > 0)
            return $"{span.Hours}h {span.Minutes}m";

        if (span.Minutes > 0)
            return $"{span.Minutes}m {span.Seconds}s";

        return $"{span.Seconds}s";
    }

    private string FormatTimeZoneDisplayName(string displayName)
    {
        if (string.IsNullOrWhiteSpace(displayName))
            return displayName;

        if (displayName.StartsWith("(", StringComparison.Ordinal))
        {
            var endIndex = displayName.IndexOf(')');
            if (endIndex >= 0 && endIndex + 1 < displayName.Length)
            {
                return displayName.Substring(endIndex + 1).Trim();
            }
        }

        return displayName.Trim();
    }

    private void LoadWiFiInfo() => _ = LoadWiFiInfoAsync();

    private async Task LoadWiFiInfoAsync()
    {
        try
        {
            Logger.LogDebug("Detecting WiFi information...");

            // Use netsh command to get WiFi information - works on all Windows 10+ systems
            var processInfo = new ProcessStartInfo
            {
                FileName = "netsh",
                Arguments = "wlan show interfaces",
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                UseShellExecute = false,
                CreateNoWindow = true
            };

            using var process = Process.Start(processInfo);
            if (process != null)
            {
                var outputTask = process.StandardOutput.ReadToEndAsync();
                var errorTask = process.StandardError.ReadToEndAsync();

                if (!process.WaitForExit(2000))
                {
                    try
                    {
                        process.Kill(true);
                    }
                    catch
                    {
                        // ignore kill failures
                    }

                    Logger.LogDebug("WiFi detection timed out");
                    wifiName = "Timed Out";
                    wifiSignalStrength = "N/A";
                    return;
                }

                var readBoth = Task.WhenAll(outputTask, errorTask);
                var readCompleted = await Task.WhenAny(readBoth, Task.Delay(2000));
                if (readCompleted != readBoth)
                {
                    Logger.LogDebug("WiFi detection output read timed out");
                    wifiName = "Timed Out";
                    wifiSignalStrength = "N/A";
                    return;
                }

                var output = await outputTask;
                var error = await errorTask;

                if (!string.IsNullOrWhiteSpace(error))
                {
                    Logger.LogDebug("WiFi detection reported an error: {Error}", error);
                }

                if (output.Contains("There is no wireless interface on the system", StringComparison.OrdinalIgnoreCase))
                {
                    wifiName = "No WiFi Adapter";
                    wifiSignalStrength = "N/A";
                    return;
                }

                // Parse the output to extract SSID and signal strength
                var lines = output.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
                bool foundWifi = false;
                string state = string.Empty;

                wifiName = "Not Connected";
                wifiSignalStrength = "N/A";

                foreach (var line in lines)
                {
                    var trimmedLine = line.Trim();

                    if (trimmedLine.StartsWith("State", StringComparison.OrdinalIgnoreCase))
                    {
                        var parts = trimmedLine.Split(':', 2);
                        if (parts.Length == 2)
                        {
                            state = parts[1].Trim();
                        }
                    }
                    if (trimmedLine.StartsWith("SSID", StringComparison.OrdinalIgnoreCase) &&
                        !trimmedLine.StartsWith("BSSID", StringComparison.OrdinalIgnoreCase))
                    {
                        var parts = trimmedLine.Split(':', 2);
                        if (parts.Length == 2)
                        {
                            wifiName = parts[1].Trim();
                            if (string.IsNullOrWhiteSpace(wifiName))
                            {
                                wifiName = "Not Connected";
                            }
                            else
                            {
                                foundWifi = true;
                            }
                        }
                    }
                    else if (trimmedLine.StartsWith("Signal", StringComparison.OrdinalIgnoreCase))
                    {
                        var parts = trimmedLine.Split(':', 2);
                        if (parts.Length == 2)
                        {
                            wifiSignalStrength = parts[1].Trim();
                        }
                    }
                }

                if (state.Equals("disconnected", StringComparison.OrdinalIgnoreCase) ||
                    state.Equals("disconnecting", StringComparison.OrdinalIgnoreCase) ||
                    state.Equals("not ready", StringComparison.OrdinalIgnoreCase))
                {
                    wifiName = "Not Connected";
                    wifiSignalStrength = "N/A";
                    Logger.LogDebug("WiFi adapter is present but not connected");
                    return;
                }

                if (foundWifi)
                {
                    Logger.LogDebug("WiFi connected: {Name} - {Signal}", wifiName, wifiSignalStrength);
                }
                else
                {
                    Logger.LogDebug("WiFi adapter available but not connected");
                }
            }
            else
            {
                Logger.LogDebug("Failed to start netsh process - WiFi detection unavailable");
                wifiName = "Unable to detect";
                wifiSignalStrength = "N/A";
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not detect WiFi information (this is normal for Ethernet-only systems)");
            wifiName = "Not Available";
            wifiSignalStrength = "N/A";
        }
    }

    private void LoadSystemHardwareInfo()
    {
        try
        {
            // Get CPU name - works for Intel, AMD, and all processor brands
            try
            {
                using (var searcher = new ManagementObjectSearcher("SELECT Name FROM Win32_Processor"))
                {
                    foreach (ManagementObject processor in searcher.Get())
                    {
                        cpuName = processor["Name"]?.ToString()?.Trim() ?? "Unknown";
                        break;
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Could not detect CPU name");
                cpuName = "Unknown";
            }

            // Get GPU name - works for NVIDIA, AMD, Intel, and all GPU brands
            try
            {
                using (var searcher = new ManagementObjectSearcher("SELECT Name FROM Win32_VideoController"))
                {
                    foreach (ManagementObject gpu in searcher.Get())
                    {
                        var name = gpu["Name"]?.ToString() ?? "";
                        // Skip Microsoft Basic Display Adapter (software renderer)
                        if (!string.IsNullOrWhiteSpace(name) &&
                            !name.Contains("Microsoft Basic", StringComparison.OrdinalIgnoreCase) &&
                            !name.Contains("Remote Desktop", StringComparison.OrdinalIgnoreCase))
                        {
                            gpuName = name.Trim();
                            break;
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Could not detect GPU name");
                gpuName = "Unknown";
            }

            // Get Motherboard name
            try
            {
                using (var searcher = new ManagementObjectSearcher("SELECT Product, Manufacturer FROM Win32_BaseBoard"))
                {
                    foreach (ManagementObject board in searcher.Get())
                    {
                        var manufacturer = board["Manufacturer"]?.ToString() ?? "";
                        var product = board["Product"]?.ToString() ?? "";
                        motherboardName = $"{manufacturer} {product}".Trim();
                        if (string.IsNullOrWhiteSpace(motherboardName))
                        {
                            motherboardName = "Unknown";
                        }
                        break;
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Could not detect motherboard name");
                motherboardName = "Unknown";
            }

            Logger.LogInformation("Hardware detected: CPU={CPU}, GPU={GPU}, Motherboard={Motherboard}", cpuName, gpuName, motherboardName);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error loading system hardware information");
        }
    }

    private void LoadSystemComponentsInfo()
    {
        try
        {
            var drives = new List<DriveUsageInfo>();

            foreach (var drive in DriveInfo.GetDrives())
            {
                if (!drive.IsReady || drive.DriveType != DriveType.Fixed)
                    continue;

                try
                {
                    var totalBytes = drive.TotalSize;
                    var usedBytes = Math.Max(totalBytes - drive.TotalFreeSpace, 0);
                    var usedPercent = totalBytes > 0
                        ? (int)Math.Round(usedBytes * 100.0 / totalBytes)
                        : 0;

                    drives.Add(new DriveUsageInfo
                    {
                        Name = drive.Name.TrimEnd('\\'),
                        FileSystem = string.IsNullOrWhiteSpace(drive.DriveFormat) ? "Unknown" : drive.DriveFormat,
                        TotalBytes = totalBytes,
                        UsedBytes = usedBytes,
                        UsedPercent = usedPercent
                    });
                }
                catch (Exception driveEx)
                {
                    Logger.LogDebug(driveEx, "Could not read drive info for {DriveName}", drive.Name);
                }
            }

            driveInfos = drives.OrderBy(drive => drive.Name).ToList();
            driveCount = driveInfos.Count;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not detect drive information");
            driveInfos = new List<DriveUsageInfo>();
            driveCount = 0;
        }
    }

    private string FormatBytes(long bytes)
    {
        if (bytes <= 0)
            return "0 B";

        var size = (double)bytes;
        var units = new[] { "B", "KB", "MB", "GB", "TB" };
        var unitIndex = 0;

        while (size >= 1024 && unitIndex < units.Length - 1)
        {
            size /= 1024;
            unitIndex++;
        }

        return $"{size:0.#} {units[unitIndex]}";
    }

