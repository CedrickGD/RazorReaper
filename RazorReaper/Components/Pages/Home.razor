                return "Check failed";

            return updateResult.HasUpdate ? "Update available" : "Up to date";
        }
    }

    private string UpdateStatusMessage
    {
        get
        {
            if (isCheckingForUpdates)
                return "Checking for updates...";

            if (updateResult == null)
                return "Run a check to see if a new version is available.";

            if (!string.IsNullOrWhiteSpace(updateResult.ErrorMessage))
                return updateResult.ErrorMessage;

            if (updateResult.HasUpdate)
                return $"Version {updateResult.LatestVersion} is ready to download.";

            return "You're on the latest version.";
        }
    }

    private bool ShowUpdateBadge
    {
        get
        {
            if (isCheckingForUpdates)
                return true;

            if (updateResult == null)
                return true;

            if (!string.IsNullOrWhiteSpace(updateResult.ErrorMessage))
                return true;

            return updateResult.HasUpdate;
        }
    }

    private bool CanDownloadUpdate => !isCheckingForUpdates
        && updateResult?.HasUpdate == true
        && !string.IsNullOrWhiteSpace(updateResult.DownloadUrl);

    private async Task CheckForUpdatesAsync(bool showToast)
    {
        if (isCheckingForUpdates || _isDisposed)
            return;

        isCheckingForUpdates = true;
        if (!_isDisposed)
        {
            await InvokeAsync(StateHasChanged);
        }

        UpdateCheckResult result;
        try
        {
            result = await UpdateService.CheckForUpdatesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Update check failed");
            result = new UpdateCheckResult
            {
                CurrentVersion = UpdateService.CurrentVersion,
                ErrorMessage = "Update check failed.",
                CheckedAt = DateTimeOffset.UtcNow
            };
        }

        updateResult = result;
        cachedUpdateResult = result;
        isCheckingForUpdates = false;

        if (showToast && !_isDisposed)
        {
            if (!string.IsNullOrWhiteSpace(result.ErrorMessage))
            {
                NotificationService.ShowError(result.ErrorMessage);
            }
            else if (result.HasUpdate)
            {
                var latestLabel = result.LatestVersion?.ToString() ?? "new version";
                NotificationService.ShowWarning($"Update available: v{latestLabel}");
            }
            else
            {
                NotificationService.ShowSuccess("You're up to date.");
            }
        }

        if (!_isDisposed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DownloadUpdate()
    {
        if (!CanDownloadUpdate || updateResult == null)
            return;

        try
        {
            var downloadUrl = updateResult.DownloadUrl;
            if (string.IsNullOrWhiteSpace(downloadUrl))
            {
                NotificationService.ShowError("Download link is missing.");
                return;
            }

            if (!Uri.TryCreate(downloadUrl, UriKind.Absolute, out var uri))
            {
                NotificationService.ShowError("Download link is invalid.");
                return;
            }

            await Launcher.Default.OpenAsync(uri);
            ActivityService.AddActivity($"Opened update download for v{updateResult.LatestVersion}", "info");
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("Failed to open update download.");
            Logger.LogError(ex, "Failed to open update download link");
        }
    }

