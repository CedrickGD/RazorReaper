    // ARK Path Management Methods
    private const string ArkConfigPathFallback = @"ARK\ShooterGame\Saved\Config\WindowsNoEditor";
    private static readonly string[] ArkPathSuffixes =
    {
        Path.Combine("ShooterGame", "Saved", "Config", "WindowsNoEditor"),
        Path.Combine("ShooterGame", "Saved", "Config"),
        Path.Combine("ShooterGame", "Saved"),
        Path.Combine("ShooterGame")
    };

    private static string BuildArkConfigPath(string basePath)
    {
        return Path.Combine(basePath, "ShooterGame", "Saved", "Config", "WindowsNoEditor");
    }

    private string GetConfigPathHint(string? inputPath)
    {
        var normalized = NormalizeCustomArkPath(inputPath, out _);
        if (!string.IsNullOrEmpty(normalized))
        {
            return BuildArkConfigPath(normalized);
        }

        return ArkConfigPathFallback;
    }

    private static string? NormalizeCustomArkPath(string? inputPath, out bool wasAdjusted)
    {
        wasAdjusted = false;

        if (string.IsNullOrWhiteSpace(inputPath))
        {
            return null;
        }

        var candidate = inputPath.Trim().Trim('"');
        candidate = Environment.ExpandEnvironmentVariables(candidate);
        candidate = candidate.Replace(Path.AltDirectorySeparatorChar, Path.DirectorySeparatorChar);
        candidate = candidate.TrimEnd(Path.DirectorySeparatorChar);

        if (Path.HasExtension(candidate))
        {
            var directory = Path.GetDirectoryName(candidate);
            if (!string.IsNullOrEmpty(directory))
            {
                candidate = directory;
                wasAdjusted = true;
            }
        }

        foreach (var suffix in ArkPathSuffixes)
        {
            if (candidate.EndsWith(suffix, StringComparison.OrdinalIgnoreCase))
            {
                candidate = candidate.Substring(0, candidate.Length - suffix.Length);
                candidate = candidate.TrimEnd(Path.DirectorySeparatorChar);
                wasAdjusted = true;
                break;
            }
        }

        return string.IsNullOrWhiteSpace(candidate) ? null : candidate;
    }

    private static bool PathsEqual(string? left, string? right)
    {
        if (string.IsNullOrWhiteSpace(left) || string.IsNullOrWhiteSpace(right))
        {
            return false;
        }

        var leftNormalized = left.Trim().Trim('"').TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        var rightNormalized = right.Trim().Trim('"').TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);

        return string.Equals(leftNormalized, rightNormalized, StringComparison.OrdinalIgnoreCase);
    }

    private void SetArkPaths(string? installPath)
    {
        arkInstallPath = installPath ?? string.Empty;
        configPath = string.IsNullOrEmpty(arkInstallPath)
            ? string.Empty
            : BuildArkConfigPath(arkInstallPath);
    }

    private void LoadArkPaths()
    {
        try
        {
            // Try to load custom path from preferences
            var customPath = Preferences.Get(CustomPathPreferenceKey, string.Empty);
            var normalizedCustomPath = NormalizeCustomArkPath(customPath, out _);

            if (!string.IsNullOrEmpty(normalizedCustomPath) && Directory.Exists(normalizedCustomPath))
            {
                if (ArkPathProvider.IsValidArkPath(normalizedCustomPath))
                {
                    if (!PathsEqual(customPath, normalizedCustomPath))
                    {
                        Preferences.Set(CustomPathPreferenceKey, normalizedCustomPath);
                    }

                    SetArkPaths(normalizedCustomPath);
                    Logger.LogInformation("Using custom ARK path: {Path}", arkInstallPath);
                    return;
                }

                Logger.LogWarning("Custom ARK path is invalid, falling back to auto-detect: {Path}", normalizedCustomPath);
            }

            // Auto-detect ARK path
            SetArkPaths(ArkUtilities.FindArkPath() ?? string.Empty);
            Logger.LogInformation("Auto-detected ARK path: {Path}", arkInstallPath);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading ARK paths");
        }
    }

    private void OpenFolderInExplorer(string? path)
    {
        try
        {
            if (string.IsNullOrEmpty(path) || !Directory.Exists(path))
            {
                NotificationService.ShowError("Path does not exist");
                return;
            }

            Process.Start(new ProcessStartInfo
            {
                FileName = "explorer.exe",
                Arguments = $"\"{path}\"",
                UseShellExecute = true
            });

            ActivityService.AddActivity($"Opened folder: {Path.GetFileName(path)}", "info");
            Logger.LogInformation("Opened folder in explorer: {Path}", path);
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Failed to open folder: {ex.Message}");
            Logger.LogError(ex, "Error opening folder in explorer");
        }
    }

    private void StartEditingArkPath()
    {
        isEditingArkPath = true;
        customArkPath = arkInstallPath;
        StateHasChanged();
    }

    private void CancelEditingArkPath()
    {
        isEditingArkPath = false;
        customArkPath = "";
        StateHasChanged();
    }

    private void SaveCustomArkPath()
    {
        try
        {
            var normalizedPath = NormalizeCustomArkPath(customArkPath, out var wasAdjusted);
            if (string.IsNullOrWhiteSpace(normalizedPath))
            {
                NotificationService.ShowError("Please enter a valid ARK installation path");
                return;
            }

            if (!Directory.Exists(normalizedPath))
            {
                NotificationService.ShowError("The specified directory does not exist");
                return;
            }

            if (!ArkPathProvider.IsValidArkPath(normalizedPath))
            {
                NotificationService.ShowError("This doesn't appear to be a valid ARK installation. Paste the folder that contains ShooterGame.");
                return;
            }

            // Save to preferences
            Preferences.Set(CustomPathPreferenceKey, normalizedPath);
            SetArkPaths(normalizedPath);

            isEditingArkPath = false;
            customArkPath = "";

            if (wasAdjusted)
            {
                NotificationService.ShowInfo($"Detected a subfolder. Using ARK install root: {arkInstallPath}");
            }

            NotificationService.ShowSuccess("Custom ARK path saved successfully");
            ActivityService.AddActivity($"ARK path set to: {arkInstallPath}", "success");
            Logger.LogInformation("Custom ARK path saved: {Path}", arkInstallPath);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Error saving path: {ex.Message}");
            Logger.LogError(ex, "Error saving custom ARK path");
        }
    }

    private void ResetToAutoDetect()
    {
        try
        {
            // Remove custom path preference
            Preferences.Remove(CustomPathPreferenceKey);

            // Auto-detect again
            LoadArkPaths();

            isEditingArkPath = false;
            customArkPath = "";

            NotificationService.ShowSuccess("Reset to auto-detect mode");
            ActivityService.AddActivity("ARK path reset to auto-detect", "info");

            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Error resetting path: {ex.Message}");
            Logger.LogError(ex, "Error resetting to auto-detect");
        }
    }

    public async ValueTask DisposeAsync()
    {
        Logger.LogDebug("Disposing Home component resources");

        _isDisposed = true;
        LicenseService.OnLicenseStateChanged -= OnLicenseStateChangedHandler;
        AutoUpdateManager.StateChanged -= OnAutoUpdateStateChanged;
        _themeRef?.Dispose();

        updateTimer?.Stop();
        updateTimer?.Dispose();
        resourceTimer?.Stop();
        resourceTimer?.Dispose();
        cpuCounter?.Dispose();
        ramCounter?.Dispose();
        currentProcess?.Dispose();

        // Dispose all GPU counters
        foreach (var counter in gpuCounters)
        {
            counter?.Dispose();
        }
        gpuCounters.Clear();

        await Task.CompletedTask;
    }
