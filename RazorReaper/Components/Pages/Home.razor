    private async Task LoadSoundSettingsAsync()
    {
        try
        {
            var settings = await JSRuntime.InvokeAsync<SoundSettings>("getSoundSettings");
            ApplySoundSettings(settings);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not load sound settings");
        }
    }

    private async Task PersistSoundSettingsAsync()
    {
        try
        {
            var settings = new SoundSettings
            {
                Enabled = soundsEnabled,
                NotificationEnabled = notificationSoundEnabled,
                ClickEnabled = clickSoundEnabled,
                NotificationSource = notificationSoundSource,
                ClickSource = clickSoundSource,
                NotificationLabel = notificationSoundLabel,
                ClickLabel = clickSoundLabel,
                NotificationCustom = notificationSoundCustom,
                ClickCustom = clickSoundCustom
            };

            await JSRuntime.InvokeVoidAsync("updateSoundSettings", settings);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not save sound settings");
        }
    }

    private void ApplySoundSettings(SoundSettings settings)
    {
        soundsEnabled = settings.Enabled;
        notificationSoundEnabled = settings.NotificationEnabled;
        clickSoundEnabled = settings.ClickEnabled;
        notificationSoundCustom = settings.NotificationCustom;
        clickSoundCustom = settings.ClickCustom;

        notificationSoundSource = string.IsNullOrWhiteSpace(settings.NotificationSource)
            ? DefaultNotificationSound
            : settings.NotificationSource;
        clickSoundSource = string.IsNullOrWhiteSpace(settings.ClickSource)
            ? DefaultClickSound
            : settings.ClickSource;

        notificationSoundLabel = ResolveSoundLabel(
            settings.NotificationLabel,
            notificationSoundCustom,
            DefaultNotificationLabel);
        clickSoundLabel = ResolveSoundLabel(
            settings.ClickLabel,
            clickSoundCustom,
            DefaultClickLabel);
    }

    private static string ResolveSoundLabel(string? label, bool isCustom, string fallback)
    {
        if (!string.IsNullOrWhiteSpace(label))
        {
            return label;
        }

        return isCustom ? "Custom" : fallback;
    }

    private async Task LoadFontSettingsAsync()
    {
        try
        {
            var settings = await JSRuntime.InvokeAsync<FontSettings>("getFontSettings");
            var preset = ResolveFontPreset(settings?.PresetId);
            selectedFontPresetId = preset.Id;

            if (string.IsNullOrWhiteSpace(settings?.UiStack) || string.IsNullOrWhiteSpace(settings?.MonoStack))
            {
                await PersistFontSettingsAsync(preset);
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not load font settings");
        }
    }

    private async Task SelectFontPresetAsync(FontPreset preset)
    {
        selectedFontPresetId = preset.Id;
        await PersistFontSettingsAsync(preset);

        ActivityService.AddActivity($"UI font set: {preset.Name}", "info");
        Logger.LogInformation("UI font preset selected: {PresetId}", preset.Id);

        _ = EnsureFontPresetInstalledAsync(preset);
    }

    private async Task PersistFontSettingsAsync(FontPreset preset)
    {
        try
        {
            var settings = new FontSettings
            {
                PresetId = preset.Id,
                UiStack = preset.UiStack,
                MonoStack = preset.MonoStack
            };

            await JSRuntime.InvokeVoidAsync("updateFontSettings", settings);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not save font settings");
        }
    }

    private async Task EnsureFontPresetInstalledAsync(FontPreset preset)
    {
        if (string.IsNullOrWhiteSpace(preset.InstallerId))
        {
            fontInstallStatus[preset.Id] = true;
            return;
        }

        if (IsFontPresetInstalled(preset))
        {
            return;
        }

        if (!installingFontPresets.Add(preset.Id))
        {
            return;
        }

        await InvokeAsync(StateHasChanged);

        NotificationService.ShowInfo($"Installing {preset.Name}...");

        try
        {
            await FontInstaller.EnsureFontInstalledAsync(preset.InstallerId);
            var installed = FontInstaller.IsFontInstalled(preset.InstallerId);
            fontInstallStatus[preset.Id] = installed;

            if (installed)
            {
                NotificationService.ShowSuccess($"{preset.Name} installed.");
                await PersistFontSettingsAsync(preset);
            }
            else
            {
                NotificationService.ShowWarning($"{preset.Name} installation pending. Try the preset again in a few seconds.");
            }
        }
        catch (InvalidDataException ex)
        {
            Logger.LogError(ex, "Invalid font package for preset {PresetId}", preset.Id);
            NotificationService.ShowError("Font package is invalid or blocked. Use the manual install links below.");
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogError(ex, "Font files could not be installed for preset {PresetId}", preset.Id);
            NotificationService.ShowError("Font files are in use. Close other apps using the font and try again.");
        }
        catch (System.Net.Http.HttpRequestException ex)
        {
            Logger.LogError(ex, "Font download failed for preset {PresetId}", preset.Id);
            NotificationService.ShowError("Font download failed. Check your network or add the font zip to wwwroot/assets/fonts.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error installing font preset {PresetId}", preset.Id);
            NotificationService.ShowError($"Font installation failed: {ex.Message}");
        }
        finally
        {
            installingFontPresets.Remove(preset.Id);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshFontInstallStatusAsync()
    {
        try
        {
            foreach (var preset in FontPresets)
            {
                if (string.IsNullOrWhiteSpace(preset.InstallerId))
                {
                    fontInstallStatus[preset.Id] = true;
                    continue;
                }

                fontInstallStatus[preset.Id] = FontInstaller.IsFontInstalled(preset.InstallerId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not refresh font installation status");
        }

        if (!_isDisposed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool IsFontPresetInstalled(FontPreset preset)
    {
        if (string.IsNullOrWhiteSpace(preset.InstallerId))
        {
            return true;
        }

        return fontInstallStatus.TryGetValue(preset.Id, out var installed) && installed;
    }

    private string GetFontPresetStatus(FontPreset preset)
    {
        if (string.IsNullOrWhiteSpace(preset.InstallerId))
        {
            return "System";
        }

        if (IsFontPresetInstalling(preset))
        {
            return "Installing";
        }

        return IsFontPresetInstalled(preset) ? "Installed" : "Auto-install";
    }

    private string GetFontPresetName(string presetId)
    {
        return ResolveFontPreset(presetId).Name;
