    private async Task CheckForUpdatesAsync(bool showToast)
    {
        if (isCheckingForUpdates || _isDisposed)
            return;

        isCheckingForUpdates = true;
        if (!_isDisposed)
        {
            await InvokeAsync(StateHasChanged);
        }

        UpdateCheckResult result;
        try
        {
            result = await UpdateService.CheckForUpdatesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Update check failed");
            result = new UpdateCheckResult
            {
                CurrentVersion = UpdateService.CurrentVersion,
                ErrorMessage = "Update check failed.",
                CheckedAt = DateTimeOffset.UtcNow
            };
        }

        updateResult = result;
        isCheckingForUpdates = false;

        if (showToast && !_isDisposed)
        {
            if (!string.IsNullOrWhiteSpace(result.ErrorMessage))
            {
                NotificationService.ShowError(result.ErrorMessage);
            }
            else if (result.HasUpdate)
            {
                var latestLabel = result.LatestVersion?.ToString() ?? "new version";
                NotificationService.ShowWarning($"Update available: v{latestLabel}");
            }
            else
            {
                NotificationService.ShowSuccess("You're up to date.");
            }
        }

        if (!_isDisposed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool isUpdateNowInFlight;

    private bool IsUpdateNowDisabled =>
        isUpdateNowInFlight
        || AutoUpdateManager.IsDownloading
        || isCheckingForUpdates;

    private string UpdateNowButtonLabel
    {
        get
        {
            if (AutoUpdateManager.IsDownloading)
                return "Downloading…";
            if (AutoUpdateManager.IsInstallerReady)
                return "Install & Restart";
            return "Update Now";
        }
    }

    private async Task OnUpdateNowAsync()
    {
        if (isUpdateNowInFlight) return;
        isUpdateNowInFlight = true;
        StateHasChanged();

        try
        {
            // Force a download if the auto-update toggle was off — Update Now is an explicit
            // user gesture and must work even without the background-download path enabled.
            if (!AutoUpdateManager.IsInstallerReady)
            {
                await AutoUpdateManager.PrepareInstallerOnDemandAsync();
            }

            if (!AutoUpdateManager.IsInstallerReady)
            {
                NotificationService.ShowError(
                    string.IsNullOrWhiteSpace(AutoUpdateManager.StatusMessage)
                        ? "Could not prepare the installer."
                        : AutoUpdateManager.StatusMessage);
                return;
            }

            if (!AutoUpdateManager.LaunchPendingInstaller())
            {
                NotificationService.ShowError("Could not launch the installer.");
                return;
            }

            // Hand off to the installer. With /VERYSILENT it overwrites files and the .iss
            // [Run] PostInstall entry relaunches RazorReaper.exe. We exit hard so file locks
            // are released before the installer's file-replace step runs — ProcessExit still
            // fires (telemetry flush stays bounded).
            Environment.Exit(0);
        }
        finally
        {
            isUpdateNowInFlight = false;
            if (!_isDisposed)
            {
                StateHasChanged();
            }
        }
    }

    private void ToggleAutoUpdate(ChangeEventArgs e)
    {
        var enabled = (bool)(e.Value ?? false);
        AutoUpdateManager.IsAutoUpdateEnabled = enabled;

        if (enabled && updateResult?.HasUpdate == true
            && !AutoUpdateManager.IsInstallerReady
            && !AutoUpdateManager.IsDownloading)
        {
            _ = Task.Run(() => AutoUpdateManager.RunStartupCheckAsync());
        }
    }

    private void OnAutoUpdateStateChanged()
    {
        if (!_isDisposed)
        {
            updateResult = AutoUpdateManager.LastCheckResult ?? updateResult;
            InvokeAsync(StateHasChanged);
        }
    }

