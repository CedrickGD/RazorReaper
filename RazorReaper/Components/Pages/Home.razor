@page "/"
@page "/home"
@using RazorReaper.Services
@using RazorReaper.Models
@using System.Globalization
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Options
@using RazorReaper.Configuration
@using Microsoft.Maui.ApplicationModel
@using System.Diagnostics
@using System.IO
@using System.Management
@using System.Runtime.InteropServices
@inject IActivityService ActivityService
@inject IArkPathProvider ArkPathProvider
@inject ILogger<Home> Logger
@inject IOptions<AppConfiguration> Configuration
@inject IJSRuntime JSRuntime
@inject INotificationService NotificationService
@inject IFontInstaller FontInstaller
@inject IUpdateService UpdateService
@inject IAutoUpdateManager AutoUpdateManager
@inject IDiscordPresenceService DiscordPresence
@inject ILicenseService LicenseService
@implements IAsyncDisposable


        <header class="page-header">
            <h1 class="page-title">Welcome, @userName</h1>
            <p class="page-subtitle">ARK: Survival Evolved Configuration & Server Management Tool</p>
        </header>



        <div class="content-card update-card">
            <div class="update-card-header">
                <div class="update-title">
                    <div class="update-icon">
                        <svg fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M3 14a1 1 0 011 1v1h12v-1a1 1 0 112 0v2a1 1 0 01-1 1H3a1 1 0 01-1-1v-2a1 1 0 011-1zm7-12a1 1 0 011 1v7.586l2.293-2.293a1 1 0 111.414 1.414l-4.004 4.004a1 1 0 01-1.414 0L5.286 9.707a1 1 0 111.414-1.414L9 10.586V3a1 1 0 011-1z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <div>
                        <h3>Update</h3>
                        <p class="update-subtitle">Keep Razor Reaper current with the latest release.</p>
                    </div>
                </div>
                <div class="update-actions">
                    <label class="sound-toggle sound-toggle-master">
                        <input type="checkbox"
                               checked="@AutoUpdateManager.IsAutoUpdateEnabled"
                               @onchange="ToggleAutoUpdate" />
                        <span>Auto-update</span>
                    </label>
                    <button class="btn-small" @onclick="() => CheckForUpdatesAsync(true)" disabled="@isCheckingForUpdates">
                        @(isCheckingForUpdates ? "Checking..." : "Check")
                    </button>
                    @if (updateResult?.HasUpdate == true)
                    {
                        <button class="btn-small btn-small-primary"
                                @onclick="OnUpdateNowAsync"
                                disabled="@IsUpdateNowDisabled">
                            @UpdateNowButtonLabel
                        </button>
                    }
                </div>
            </div>
            <div class="update-status">
                @if (ShowUpdateBadge)
                {
                    <div class="@UpdateBadgeClass">@UpdateBadgeText</div>
                }
                <div class="update-meta">
                    <div class="update-meta-item">
                        <span class="update-meta-label">Current</span>
                        <span class="update-meta-value">@UpdateService.CurrentVersionLabel</span>
                    </div>
                    <div class="update-meta-item">
                        <span class="update-meta-label">Latest</span>
                        <span class="update-meta-value">@LatestVersionLabel</span>
                    </div>
                    <div class="update-meta-item">
                        <span class="update-meta-label">Checked</span>
                        <span class="update-meta-value">@LastCheckedLabel</span>
                    </div>
                </div>

                @if (AutoUpdateManager.IsDownloading)
                {
                    <div class="update-progress">
                        <div class="update-progress-bar">
                            <div class="update-progress-fill" style="width: @(AutoUpdateManager.DownloadProgressPercent ?? 0)%"></div>
                        </div>
                        <span class="update-progress-label">Downloading... @(AutoUpdateManager.DownloadProgressPercent ?? 0)%</span>
                    </div>
                }
                else if (AutoUpdateManager.IsInstallerReady)
                {
                    <div class="update-ready-message">
                        v@(AutoUpdateManager.PendingVersion) ready — will install silently when you close the app.
                    </div>
                }
                else
                {
                    @* The progress bar above is self-labeled with its own percentage, so the
                       generic status line is only useful when no bar is on screen. Rendering
                       both during download produced two side-by-side percent readouts that
                       looked like a double progress bar. *@
                    <div class="update-message">@UpdateStatusMessage</div>
                }

                @* Notes show whenever the manifest carries them, even when the user is already
                   on the latest. Pre-update: they're the "what's new" preview the user asked
                   for. Post-update: they double as a recap of what just got installed. The
                   summary reads "What's new in v{LatestVersion}" either way. *@
                @if (updateResult?.LatestVersion != null && updateResult.Notes.Count > 0)
                {
                    <details class="update-notes" open="@(updateResult.HasUpdate)">
                        <summary>What's new in v@(updateResult.LatestVersion)</summary>
                        <ul class="update-notes-list">
                            @foreach (var note in updateResult.Notes)
                            {
                                <li>@note</li>
                            }
                        </ul>
                    </details>
                }
            </div>
            <div class="update-card-footer">
                <a href="https://github.com/CedrickGD/RazorReaper/releases/latest"
                   target="_blank"
                   class="btn-link-subtle"
                   data-sound-skip="true">
                    View releases on GitHub
                    <svg fill="currentColor" viewBox="0 0 20 20" style="width:12px;height:12px;margin-left:4px;">
                        <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
                        <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
                    </svg>
                </a>
            </div>
        </div>

        <div class="dashboard-widgets">
            <div class="content-card widget-card clock-widget">
                <div class="widget-header">
                    <svg fill="currentColor" viewBox="0 0 20 20" class="widget-icon">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                    </svg>
                    <h3>Local Time</h3>
                </div>
                <div class="clock-display">
                    <div class="clock-time">@currentTime.ToString("HH:mm:ss")</div>
                    <div class="clock-date">@currentTime.ToString("dddd, MMMM dd, yyyy")</div>
                    <div class="clock-details">
                        <div class="clock-detail-item">
                            <span class="detail-label">Timezone:</span>
                            <span class="detail-value">@timeZoneInfo</span>
                        </div>
                        <div class="clock-detail-item">
                            <span class="detail-label">UTC Offset:</span>
                            <span class="detail-value">@utcOffset</span>
                        </div>
                        <div class="clock-detail-item">
                            <span class="detail-label">Week:</span>
                            <span class="detail-value">Week @weekNumber of @currentTime.Year</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-card widget-card uptime-widget">
                <div class="widget-header">
                    <svg fill="currentColor" viewBox="0 0 20 20" class="widget-icon">
                        <path fill-rule="evenodd" d="M4 4a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V5a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
                    </svg>
                    <h3>Uptime</h3>
                </div>
                <div class="uptime-details">
                    <div class="system-item">
                        <div class="system-label">System</div>
                        <div class="system-value">@systemUptime</div>
                    </div>
                    <div class="system-item">
                        <div class="system-label">App Session</div>
                        <div class="system-value">@appSessionDuration</div>
                    </div>
                </div>
            </div>

            <div class="content-card widget-card system-info-widget">
                <div class="widget-header">
                    <svg fill="currentColor" viewBox="0 0 20 20" class="widget-icon">
                        <path d="M2 7.5a13 13 0 0 1 16 0l-1.4 1.4a11 11 0 0 0-13.2 0L2 7.5z" />
                        <path d="M4.9 10.4a8.5 8.5 0 0 1 10.2 0l-1.4 1.4a6.5 6.5 0 0 0-7.4 0l-1.4-1.4z" />
                        <path d="M7.8 13.3a4 4 0 0 1 4.4 0l-1.4 1.4a2 2 0 0 0-1.6 0l-1.4-1.4z" />
                        <circle cx="10" cy="17" r="1.2" />
                    </svg>
                    <h3>Network</h3>
                </div>
                <div class="system-info-list">
                    <div class="system-item">
                        <div class="system-label">Connected Network</div>
                        <div class="system-value">@wifiName</div>
                    </div>
                    <div class="system-item">
                        <div class="system-label">Signal Strength</div>
                        <div class="system-value">@wifiSignalStrength</div>
                    </div>
                </div>
            </div>

            <div class="content-card widget-card storage-widget">
                <div class="widget-header">
                    <svg fill="currentColor" viewBox="0 0 20 20" class="widget-icon">
                        <path d="M3 4.5c0-1.1 3.1-2 7-2s7 .9 7 2-3.1 2-7 2-7-.9-7-2z" />
                        <path d="M3 4.5v3c0 1.1 3.1 2 7 2s7-.9 7-2v-3c0 1.1-3.1 2-7 2s-7-.9-7-2z" />
                        <path d="M3 9.5v3c0 1.1 3.1 2 7 2s7-.9 7-2v-3c0 1.1-3.1 2-7 2s-7-.9-7-2z" />
                        <path d="M3 14.5v1c0 1.1 3.1 2 7 2s7-.9 7-2v-1c0 1.1-3.1 2-7 2s-7-.9-7-2z" />
                    </svg>
                    <h3>Storage</h3>
                </div>
                <div class="storage-summary">
                    <span class="storage-label">Installed Drives</span>
                    <span class="storage-value">@driveCount</span>
                </div>
                <div class="drive-list">
                    @if (driveInfos.Count == 0)
                    {
                        <div class="drive-empty">Drive info unavailable</div>
                    }
                    else
                    {
                        var visibleDrives = driveInfos.Take(MaxDriveCards).ToList();
                        foreach (var drive in visibleDrives)
                        {
                            <div class="drive-item">
                                <div class="drive-header">
                                    <span class="drive-name">@drive.Name</span>
                                    <span class="drive-format">@drive.FileSystem</span>
                                </div>
                                <div class="drive-meta">
                                    <span>@drive.UsedPercent% used</span>
                                    <span>@FormatBytes(drive.UsedBytes) / @FormatBytes(drive.TotalBytes)</span>
                                </div>
                                <div class="drive-bar">
                                    <div class="drive-fill" style="width: @Math.Min(drive.UsedPercent, 100)%"></div>
                                </div>
                            </div>
                        }
                        if (driveInfos.Count > MaxDriveCards)
                        {
                            <div class="drive-more">+@(driveInfos.Count - MaxDriveCards) more drives</div>
                        }
                    }
                </div>
            </div>

            <div class="content-card widget-card resource-widget">
                <div class="widget-header">
                    <svg fill="currentColor" viewBox="0 0 20 20" class="widget-icon">
                        <path fill-rule="evenodd" d="M3 5a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2h-2.22l.123.489.804.804A1 1 0 0113 18H7a1 1 0 01-.707-1.707l.804-.804L7.22 15H5a2 2 0 01-2-2V5zm5.771 7H5V5h10v7H8.771z" clip-rule="evenodd" />
                    </svg>
                    <h3>System Resources</h3>
                </div>
                <div class="resource-stats">
                    @if (resourceMonitoringInitialized)
                    {
                        <div class="resource-usage">
                            <div class="resource-item">
                                <div class="resource-header">
                                    <span class="resource-label">CPU Usage</span>
                                    <span class="resource-value">@cpuUsage%</span>
                                </div>
                                <div class="resource-bar">
                                    <div class="resource-fill cpu" style="width: @Math.Min(cpuUsage, 100)%"></div>
                                </div>
                            </div>
                            @if (hasGpuCounter)
                            {
                                <div class="resource-item">
                                    <div class="resource-header">
                                        <span class="resource-label">GPU Usage</span>
                                        <span class="resource-value">@gpuUsage%</span>
                                    </div>
                                    <div class="resource-bar">
                                        <div class="resource-fill gpu" style="width: @Math.Min(gpuUsage, 100)%"></div>
                                    </div>
                                </div>
                            }
                            <div class="resource-item">
                                <div class="resource-header">
                                    <span class="resource-label">RAM Usage</span>
                                    <span class="resource-value">@ramUsage%</span>
                                </div>
                                <div class="resource-bar">
                                    <div class="resource-fill ram" style="width: @Math.Min(ramUsage, 100)%"></div>
                                </div>
                            </div>
                            <div class="resource-info">
                                <div class="resource-detail">
                                    <span>Total Memory:</span>
                                    <span>@ramUsedGB GB / @ramTotalGB GB</span>
                                </div>
                                <div class="resource-detail">
                                    <span>App Usage:</span>
                                    <span>@processMemoryMB MB</span>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="resource-usage">
                            <div class="resource-loading">
                                <svg fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
                                </svg>
                                <p>Initializing system monitoring...</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="content-card widget-card hardware-widget">
                <div class="widget-header">
                    <svg fill="currentColor" viewBox="0 0 20 20" class="widget-icon">
                        <path fill-rule="evenodd" d="M2 5a2 2 0 012-2h12a2 2 0 012 2v2a2 2 0 01-2 2H4a2 2 0 01-2-2V5zm14 1a1 1 0 11-2 0 1 1 0 012 0zM2 13a2 2 0 012-2h12a2 2 0 012 2v2a2 2 0 01-2 2H4a2 2 0 01-2-2v-2zm14 1a1 1 0 11-2 0 1 1 0 012 0z" clip-rule="evenodd" />
                    </svg>
                    <h3>Hardware</h3>
                </div>
                <div class="hardware-info">
                    <div class="hardware-item">
                        <div class="hardware-label">CPU</div>
                        <div class="hardware-value">@cpuName</div>
                    </div>
                    <div class="hardware-item">
                        <div class="hardware-label">GPU</div>
                        <div class="hardware-value">@gpuName</div>
                    </div>
                    <div class="hardware-item">
                        <div class="hardware-label">Motherboard</div>
                        <div class="hardware-value">@motherboardName</div>
                    </div>
                </div>
            </div>

        </div>

        <div class="content-card activity-card">
            <div class="activity-header">
                <h3 class="activity-title">Recent Activity</h3>
                <button class="btn-small" @onclick="ClearActivity">Clear All</button>
            </div>
            <div class="activity-timeline-container">
                @if (ActivityService.GetRecentActivities().Count == 0)
                {
                    <div class="activity-empty">
                        <svg fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                        </svg>
                        <p>No recent activity</p>
                    </div>
                }
                else
                {
                    <div class="activity-timeline">
                        @foreach (var activity in ActivityService.GetRecentActivities())
                        {
                            <div @key="activity.Timestamp.Ticks" class="timeline-item @activity.Type">
                                <div class="timeline-marker">
                                    <div class="timeline-dot"></div>
                                </div>
                                <div class="timeline-content">
                                    <div class="timeline-icon">
                                        @if (activity.Type == "success")
                                        {
                                            <svg fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                            </svg>
                                        }
                                        else if (activity.Type == "warning")
                                        {
                                            <svg fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                                            </svg>
                                        }
                                    </div>
                                    <div class="timeline-body">
                                        <div class="timeline-title">@activity.Title</div>
                                        <div class="timeline-time">@activity.GetTimeAgo()</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="content-card sound-settings-card collapsible-card">
            <div class="sound-settings-header">
                <div>
                    <h3>Sound Settings</h3>
                    <p class="sound-settings-subtitle">Control UI click and notification audio.</p>
                </div>
                <div class="collapsible-actions">
                    <label class="sound-toggle sound-toggle-master">
                        <input type="checkbox" @bind="soundsEnabled" @bind:after="PersistSoundSettingsAsync" />
                        <span>Enable UI sounds</span>
                    </label>
                    <button type="button"
                            class="collapsible-toggle"
                            @onclick="ToggleSoundSettings"
                            aria-expanded="@isSoundSettingsOpen"
                            aria-controls="sound-settings-content">
                        <span class="collapsible-toggle-label">@(isSoundSettingsOpen ? "Collapse" : "Expand")</span>
                        <svg class="collapsible-toggle-icon" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.25a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd" />
                        </svg>
                    </button>
                </div>
            </div>
            <div id="sound-settings-content" class="collapsible-content" hidden="@(!isSoundSettingsOpen)">
                <div class="sound-settings-grid">
                    <div class="sound-setting">
                        <div class="sound-setting-header">
                            <span class="sound-setting-title">Notification Sound</span>
                            <label class="sound-toggle sound-toggle-inline">
                                <input type="checkbox" @bind="notificationSoundEnabled" @bind:after="PersistSoundSettingsAsync" />
                                <span>Enabled</span>
                            </label>
                        </div>
                        <div class="sound-setting-body">
                            <div class="sound-source">
                                <span class="sound-source-label">Current</span>
                                <span class="sound-source-value">@notificationSoundLabel</span>
                            </div>
                            <div class="sound-actions">
                                <label class="btn-small sound-upload-button" for="notificationSoundUpload">Upload</label>
                                <InputFile id="notificationSoundUpload"
                                           class="sound-upload-input"
                                           OnChange="HandleNotificationSoundUpload"
                                           accept="audio/*,.mp3,.wav,.ogg,.m4a,.aac" />
                                <button class="btn-small" @onclick="ResetNotificationSound">Reset</button>
                                <button class="btn-small" data-sound-skip="true" @onclick="PlayNotificationPreview">Test</button>
                            </div>
                        </div>
                    </div>

                    <div class="sound-setting">
                        <div class="sound-setting-header">
                            <span class="sound-setting-title">Click Sound</span>
                            <label class="sound-toggle sound-toggle-inline">
                                <input type="checkbox" @bind="clickSoundEnabled" @bind:after="PersistSoundSettingsAsync" />
                                <span>Enabled</span>
                            </label>
                        </div>
                        <div class="sound-setting-body">
                            <div class="sound-source">
                                <span class="sound-source-label">Current</span>
                                <span class="sound-source-value">@clickSoundLabel</span>
                            </div>
                            <div class="sound-actions">
                                <label class="btn-small sound-upload-button" for="clickSoundUpload">Upload</label>
                                <InputFile id="clickSoundUpload"
                                           class="sound-upload-input"
                                           OnChange="HandleClickSoundUpload"
                                           accept="audio/*,.mp3,.wav,.ogg,.m4a,.aac" />
                                <button class="btn-small" @onclick="ResetClickSound">Reset</button>
                                <button class="btn-small" data-sound-skip="true" @onclick="PlayClickPreview">Test</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="sound-folder">
                    <div class="sound-folder-info">
                        <div class="sound-folder-label">Custom sounds folder</div>
                        <div class="sound-folder-path">@customSoundFolderDisplay</div>
                    </div>
                    <button class="btn-small" @onclick="OpenCustomSoundFolder" disabled="@(!customSoundFolderAvailable)">Open Folder</button>
                </div>
                <div class="sound-folder-note">Supports MP3, WAV, OGG, M4A, AAC. Keep files under @MaxSoundFileMb MB for fast playback.</div>
            </div>
        </div>

        <div class="content-card font-settings-card collapsible-card">
            <div class="font-settings-header">
                <div>
                    <h3>Interface Font</h3>
                    <p class="font-settings-subtitle">Switch the UI font preset. Fonts auto-install in the background.</p>
                </div>
                <div class="collapsible-actions">
                    <div class="font-current">
                        <span class="font-current-label">Active</span>
                        <span class="font-current-value">@GetFontPresetName(selectedFontPresetId)</span>
                    </div>
                    <button type="button"
                            class="collapsible-toggle"
                            @onclick="ToggleFontSettings"
                            aria-expanded="@isFontSettingsOpen"
                            aria-controls="font-settings-content">
                        <span class="collapsible-toggle-label">@(isFontSettingsOpen ? "Collapse" : "Expand")</span>
                        <svg class="collapsible-toggle-icon" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.25a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd" />
                        </svg>
                    </button>
                </div>
            </div>
            <div id="font-settings-content" class="collapsible-content" hidden="@(!isFontSettingsOpen)">
                <div class="font-preset-grid">
                    @foreach (var preset in FontPresets)
                    {
                        var isActive = selectedFontPresetId == preset.Id;
                        var statusLabel = GetFontPresetStatus(preset);
                        <button class="font-preset-card @(isActive ? "active" : "")"
                                @onclick="@(() => SelectFontPresetAsync(preset))"
                                disabled="@IsFontPresetInstalling(preset)">
                            <div class="font-preset-top">
                                <span class="font-preset-name">@preset.Name</span>
                                <span class="font-preset-status">@statusLabel</span>
                            </div>
                            <div class="font-preset-description">@preset.Description</div>
                            <div class="font-preset-preview" style="font-family: @preset.UiStack">
                                The quick brown fox jumps over the lazy dog 0123456789.
                            </div>
                        </button>
                    }
                </div>
                <div class="font-manual-install">
                    <div class="font-manual-title">Manual install (if auto-install fails)</div>
                    <ol class="font-manual-steps">
                        <li>Download the font from the official link below.</li>
                        <li>If you get a zip, extract it.</li>
                        <li>Right-click the .ttf file and choose <strong>Install</strong> (or double-click and install).</li>
                        <li>Return here and select the preset again. Switching updates the UI instantly.</li>
                    </ol>
                    <div class="font-manual-links">
                        @foreach (var preset in FontPresets)
                        {
                            if (string.IsNullOrWhiteSpace(preset.DownloadUrl))
                            {
                                continue;
                            }

                            <button class="font-manual-link" @onclick="@(() => CopyFontDownloadLinkAsync(preset))" data-sound-skip="true">
                                <span class="font-manual-link-name">@preset.Name</span>
                                <span class="font-manual-link-url">@preset.DownloadUrl</span>
                            </button>
                        }
                    </div>
                </div>
                <div class="font-settings-note">Fonts install per-user in the background. Switching updates the UI instantly.</div>
            </div>
        </div>

