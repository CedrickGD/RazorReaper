    private async Task EnsureFontPresetInstalledAsync(FontPreset preset)
    {
        if (string.IsNullOrWhiteSpace(preset.InstallerId))
        {
            fontInstallStatus[preset.Id] = true;
            return;
        }

        if (IsFontPresetInstalled(preset))
        {
            return;
        }

        if (!installingFontPresets.Add(preset.Id))
        {
            return;
        }

        await InvokeAsync(StateHasChanged);

        NotificationService.ShowInfo($"Installing {preset.Name}...");

        try
        {
            await FontInstaller.EnsureFontInstalledAsync(preset.InstallerId);
            var installed = FontInstaller.IsFontInstalled(preset.InstallerId);
            fontInstallStatus[preset.Id] = installed;

            if (installed)
            {
                NotificationService.ShowSuccess($"{preset.Name} installed.");
                await PersistFontSettingsAsync(preset);
            }
            else
            {
                NotificationService.ShowWarning($"{preset.Name} installation pending. Try the preset again in a few seconds.");
            }
        }
        catch (InvalidDataException ex)
        {
            Logger.LogError(ex, "Invalid font package for preset {PresetId}", preset.Id);
            NotificationService.ShowError("Font package is invalid or blocked. Use the manual install links below.");
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogError(ex, "Font files could not be installed for preset {PresetId}", preset.Id);
            NotificationService.ShowError("Font files are in use. Close other apps using the font and try again.");
        }
        catch (System.Net.Http.HttpRequestException ex)
        {
            Logger.LogError(ex, "Font download failed for preset {PresetId}", preset.Id);
            NotificationService.ShowError("Font download failed. Check your network or add the font zip to wwwroot/assets/fonts.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error installing font preset {PresetId}", preset.Id);
            NotificationService.ShowError($"Font installation failed: {ex.Message}");
        }
        finally
        {
            installingFontPresets.Remove(preset.Id);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshFontInstallStatusAsync()
    {
        try
        {
            foreach (var preset in FontPresets)
            {
                if (string.IsNullOrWhiteSpace(preset.InstallerId))
                {
                    fontInstallStatus[preset.Id] = true;
                    continue;
                }

                fontInstallStatus[preset.Id] = FontInstaller.IsFontInstalled(preset.InstallerId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not refresh font installation status");
        }

        if (!_isDisposed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool IsFontPresetInstalled(FontPreset preset)
    {
        if (string.IsNullOrWhiteSpace(preset.InstallerId))
        {
            return true;
        }

        return fontInstallStatus.TryGetValue(preset.Id, out var installed) && installed;
    }

    private string GetFontPresetStatus(FontPreset preset)
    {
        if (string.IsNullOrWhiteSpace(preset.InstallerId))
        {
            return "System";
        }

        if (IsFontPresetInstalling(preset))
        {
            return "Installing";
        }

        return IsFontPresetInstalled(preset) ? "Installed" : "Auto-install";
    }

    private string GetFontPresetName(string presetId)
    {
        return ResolveFontPreset(presetId).Name;
    }

    private bool IsFontPresetInstalling(FontPreset preset)
    {
        return installingFontPresets.Contains(preset.Id);
    }

    private async Task CopyFontDownloadLinkAsync(FontPreset preset)
    {
        if (string.IsNullOrWhiteSpace(preset.DownloadUrl))
        {
            return;
        }

        try
        {
            await Clipboard.Default.SetTextAsync(preset.DownloadUrl);
            NotificationService.ShowSuccess($"Copied download link for {preset.Name}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error copying font download link for {PresetId}", preset.Id);
            NotificationService.ShowError("Failed to copy download link.");
        }
    }

