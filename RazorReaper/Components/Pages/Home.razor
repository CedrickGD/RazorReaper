    private bool _isDisposed = false;
    private bool _hasInitialized = false;

    protected override Task OnInitializedAsync()
    {
        LicenseService.OnLicenseStateChanged += OnLicenseStateChangedHandler;
        
        // Keep initial render lightweight to reduce navigation lag.
        userName = Environment.UserName;

        UpdateTimeZoneInfo();
        UpdateUptimeInfo();

        // Seed the picker's HSV from the (default) accent so the handle is exact even
        // before LoadThemeSettingsAsync runs / if theme interop fails.
        SyncPickerFromAccent();

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hasInitialized || _isDisposed)
            return;

        _hasInitialized = true;
        await InitializeAsync();
    }

    private async Task InitializeAsync()
    {
        // Load ARK paths
        LoadArkPaths();
        ResolveCustomSoundFolder();
        await LoadSoundSettingsAsync();
        await LoadFontSettingsAsync();
        await LoadThemeSettingsAsync();
        await RefreshFontInstallStatusAsync();

        if (_isDisposed)
            return;

        if (AutoUpdateManager.LastCheckResult != null)
        {
            updateResult = AutoUpdateManager.LastCheckResult;
        }
        AutoUpdateManager.StateChanged += OnAutoUpdateStateChanged;

        // Start consolidated update timer (updates clock)
        // Set to 1 second for smooth clock updates without excessive overhead
        updateTimer = new System.Timers.Timer(1000);
        updateTimer.Elapsed += (s, e) =>
        {
            if (_isDisposed)
                return;

            currentTime = DateTime.Now;
            UpdateTimeZoneInfo();
            UpdateUptimeInfo();

            if (!_isDisposed)
                InvokeAsync(StateHasChanged);
        };
        updateTimer.Start();

        // Add initial activity
        ActivityService.AddActivity("Dashboard loaded", "success");

        // Start resource monitoring in background to prevent UI blocking
        _ = Task.Run(() => StartResourceMonitoring());

        // Load WiFi and system information (run in background to avoid blocking)
        _ = Task.Run(() =>
        {
            LoadWiFiInfo();
            LoadSystemHardwareInfo();
            LoadSystemComponentsInfo();
            lastWifiRefreshUtc = DateTime.UtcNow;
            lastStorageRefreshUtc = DateTime.UtcNow;
            InvokeAsync(StateHasChanged);
        });

        await InvokeAsync(StateHasChanged);
    }

