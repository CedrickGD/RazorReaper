    {
        if (string.IsNullOrWhiteSpace(licenseKeyInput))
        {
            activationError = "Please enter a license key.";
            return;
        }

        isActivating = true;
        activationError = "";
        StateHasChanged();

        var result = await LicenseService.ActivateLicenseAsync(licenseKeyInput.Trim());
        
        isActivating = false;
        
        if (result.Success)
        {
            activationError = "";
            NotificationService.ShowSuccess(result.Message);
        }
        else
        {
            activationError = result.Message;
        }
        
        StateHasChanged();
