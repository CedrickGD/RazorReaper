    private async Task PersistSoundSettingsAsync()
    {
        try
        {
            var settings = new SoundSettings
            {
                Enabled = soundsEnabled,
                NotificationEnabled = notificationSoundEnabled,
                ClickEnabled = clickSoundEnabled,
                NotificationSource = notificationSoundSource,
                ClickSource = clickSoundSource,
                NotificationLabel = notificationSoundLabel,
                ClickLabel = clickSoundLabel,
                NotificationCustom = notificationSoundCustom,
                ClickCustom = clickSoundCustom
            };

