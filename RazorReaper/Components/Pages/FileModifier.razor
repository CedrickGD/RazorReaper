@page "/file-modifier"
@using RazorReaper.Services
@using RazorReaper.Services.FileModifier
@using RazorReaper.Services.Localization
@inject IFileModifierService FileMod
@inject INotificationService Notifications
@inject IProcessService ProcessService
@inject ILocalizer Localizer
@implements IDisposable

<div class="file-modifier-page">
    <header class="page-header">
        <h1 class="page-title">@Localizer.T("filemodifier.title")</h1>
        <p class="page-subtitle">@Localizer.T("filemodifier.subtitle")</p>
    </header>

    @if (_arkPath is null)
    {
        <div class="content-card">
            <StatusHeader State="off" Label="@Localizer.T("filemodifier.noark.label")"
                          Description="@Localizer.T("filemodifier.noark.description")">
                <Actions>
                    <button class="btn btn-secondary" @onclick="Rescan">@Localizer.T("filemodifier.rescan")</button>
                </Actions>
            </StatusHeader>
        </div>
    }
    else
    {
        <ElevationPrompt Message="@Localizer.T("filemodifier.elevation")" />

        @* ── SeekFree cleanup ─────────────────────────────────────────────── *@
        <div class="content-card">
            <StatusHeader State="@(_seekFree?.Exists == true ? "warning" : "off")"
                          Label="@SeekFreeLabel"
                          Description="@Localizer.T("filemodifier.sfc.description")">
                <Actions>
                    <button class="btn btn-secondary" @onclick="ScanSeekFreeAsync" disabled="@_busy">
                        @Localizer.T(_scanning ? "filemodifier.scanning" : "filemodifier.scan")
                    </button>
                    <button class="btn btn-secondary" @onclick="() => FileMod.OpenSteamVerify()" disabled="@_busy">
                        @Localizer.T("filemodifier.verify")
                    </button>
                </Actions>
            </StatusHeader>

            @* One emphasised sentence rather than four emphasised words: a dictionary value carries
               no markup, and four <strong>/<em> spans inside one sentence would have been nine keys
               whose order no other language keeps. *@
            <div class="fm-note">
                <strong>@Localizer.T("filemodifier.note.warning")</strong>
                @Localizer.T("filemodifier.note.undo")
            </div>

            @if (_seekFree is { Exists: true })
            {
                @if (_seekFree.Items.Count == 0)
                {
                    <p class="fm-empty">@Localizer.T("filemodifier.sfc.empty")</p>
                }
                else
                {
                    <div class="fm-sfc-list">
                        @foreach (var item in _seekFree.Items)
                        {
                            @* The whole row is the hit target. The checkbox is a button, so its
                               click would bubble up here and toggle a second time — hence the
                               wrapper that swallows it. *@
                            <div class="fm-sfc-row @(item.Id == "core" ? "advanced" : "")" @key="item.Id"
                                 @onclick="() => ToggleSelected(item.Id, !_selected.Contains(item.Id))">
                                <span class="fm-sfc-check" @onclick:stopPropagation="true">
                                    <CheckBox Value="@_selected.Contains(item.Id)"
                                              ValueChanged="@(v => ToggleSelected(item.Id, v))"
                                              Disabled="@_busy" />
                                </span>
                                <span class="fm-sfc-main">
                                    <span class="fm-sfc-name">@ItemLabel(item)</span>
                                    <span class="fm-sfc-cat">@CategoryLabel(item.Kind)</span>
                                </span>
                                <span class="fm-sfc-size">@FormatBytes(item.SizeBytes)</span>
                            </div>
                        }
                    </div>

                    <div class="fm-sfc-actions">
                        @if (_confirmDelete)
                        {
                            <span class="fm-confirm-text">@Localizer.T("filemodifier.confirm", _selected.Count, FormatBytes(SelectedBytes))</span>
                            <button class="btn btn-danger" @onclick="DeleteSeekFreeAsync" disabled="@_busy">
                                @Localizer.T(_deleting ? "filemodifier.deleting" : "filemodifier.delete.confirm")
                            </button>
                            <button class="btn btn-secondary" @onclick="() => _confirmDelete = false" disabled="@_busy">@Localizer.T("common.cancel")</button>
                        }
                        else
                        {
                            <button class="btn btn-danger" @onclick="() => _confirmDelete = true"
                                    disabled="@(_busy || _selected.Count == 0)">
                                @(_selected.Count > 0
                                    ? Localizer.T("filemodifier.delete.selected.size", FormatBytes(SelectedBytes))
                                    : Localizer.T("filemodifier.delete.selected"))
                            </button>
                        }
                    </div>
                }
            }
            else if (_seekFree is not null)
            {
                <p class="fm-empty">@Localizer.T("filemodifier.sfc.none")</p>
            }
        </div>

        @* ── Generic file modifier ────────────────────────────────────────── *@
        <div class="content-card">
            <StatusHeader State="@(_modified.Count > 0 ? "warning" : "online")"
                          Label="@ModifiedLabel"
                          Description="@Localizer.T("filemodifier.files.description")">
                <Actions>
                    <button class="btn btn-secondary" @onclick="RemoveFileAsync" disabled="@_busy">@Localizer.T("filemodifier.remove")</button>
                    <button class="btn btn-secondary" @onclick="ReplaceFileAsync" disabled="@_busy">@Localizer.T("filemodifier.replace")</button>
                    @if (_modified.Count > 0)
                    {
                        <button class="btn btn-secondary" @onclick="RestoreAllAsync" disabled="@_busy">@Localizer.T("filemodifier.restoreall")</button>
                    }
                </Actions>
            </StatusHeader>

            @if (_modified.Count == 0)
            {
                <p class="fm-empty">@Localizer.T("filemodifier.files.empty")</p>
            }
            else
            {
                <div class="fm-mod-list">
                    @foreach (var entry in _modified)
                    {
                        <SettingRow @key="entry.Id" Title="@System.IO.Path.GetFileName(entry.RelativePath)"
                                    Description="@ModEntryDescription(entry)">
                            <span class="fm-badge @(entry.Action == FileModAction.Removed ? "removed" : "")">
                                @ActionLabel(entry.Action)
                            </span>
                            <button class="btn btn-secondary" @onclick="() => RestoreAsync(entry.Id)" disabled="@_busy">
                                @Localizer.T("filemodifier.restore")
                            </button>
                        </SettingRow>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter(Name = "Language")]
    private string? Language { get; set; }

    private string? _arkPath;
    private SeekFreeReport? _seekFree;
    private IReadOnlyList<FileModEntry> _modified = Array.Empty<FileModEntry>();
    private readonly HashSet<string> _selected = new();

    private bool _busy;
    private bool _scanning;
    private bool _deleting;
    private bool _confirmDelete;

    protected override void OnInitialized()
    {
        FileMod.Changed += OnChanged;
        Rescan();
    }

    private void Rescan()
    {
        _arkPath = FileMod.GetArkPath();
        _modified = FileMod.GetModifiedFiles();
    }

    private long SelectedBytes =>
        _seekFree?.Items.Where(i => _selected.Contains(i.Id)).Sum(i => i.SizeBytes) ?? 0;

    private string SeekFreeLabel => _seekFree is { Exists: true }
        ? Localizer.T("filemodifier.sfc.label.size", FormatBytes(_seekFree.TotalBytes))
        : Localizer.T("filemodifier.sfc.label");

    private string ModifiedLabel => _modified.Count switch
    {
        0 => Localizer.T("filemodifier.files.none"),
        1 => Localizer.T("filemodifier.files.one"),
        _ => Localizer.T("filemodifier.files.many", _modified.Count)
    };

    private string ActionLabel(FileModAction action) =>
        Localizer.T(action == FileModAction.Removed
            ? "filemodifier.badge.removed"
            : "filemodifier.badge.replaced");

    // A map row is named after its folder — that is ARK's own map name and stays as it is. The
    // two fixed rows are named here rather than by the scan, so they follow a language switch
    // without a rescan.
    private string ItemLabel(SeekFreeItem item) => item.Kind switch
    {
        SeekFreeKind.ShaderModel4 => Localizer.T("filemodifier.sfc.sm4"),
        SeekFreeKind.CoreBlueprints => Localizer.T("filemodifier.sfc.core"),
        _ => item.Label ?? item.Id
    };

    private string CategoryLabel(SeekFreeKind kind) => Localizer.T(kind switch
    {
        SeekFreeKind.ShaderModel4 => "filemodifier.sfc.category.shaders",
        SeekFreeKind.Map => "filemodifier.sfc.category.map",
        SeekFreeKind.OfficialMap => "filemodifier.sfc.category.mod",
        _ => "filemodifier.sfc.category.core"
    });

    private void ToggleSelected(string id, bool on)
    {
        // The row itself is clickable, so it — unlike the checkbox — has no disabled state.
        if (_busy) return;
        if (on) _selected.Add(id);
        else _selected.Remove(id);
        _confirmDelete = false;
    }

    private async Task ScanSeekFreeAsync()
    {
        if (_busy) return;
        _busy = true;
        _scanning = true;
        _confirmDelete = false;
        try
        {
            _seekFree = await FileMod.ScanSeekFreeAsync();
            _selected.Clear();
        }
        finally
        {
            _busy = false;
            _scanning = false;
        }
    }

    private async Task DeleteSeekFreeAsync()
    {
        if (_busy || _seekFree is null) return;
        var items = _seekFree.Items.Where(i => _selected.Contains(i.Id)).ToList();
        if (items.Count == 0) return;

        WarnIfArkRunning();
        _busy = true;
        _deleting = true;
        try
        {
            var result = await FileMod.DeleteSeekFreeAsync(items);
            if (result.Success) Notifications.ShowSuccess(result.Message);
            else Notifications.ShowWarning(result.Message);

            _seekFree = await FileMod.ScanSeekFreeAsync();
            _selected.Clear();
        }
        catch (Exception ex)
        {
            Notifications.ShowError(Localizer.T("filemodifier.toast.cleanupfailed", ex.Message));
        }
        finally
        {
            _busy = false;
            _deleting = false;
            _confirmDelete = false;
        }
    }

    private async Task RemoveFileAsync()
    {
        if (_busy) return;
        var picked = await PickFileAsync(Localizer.T("filemodifier.picker.remove"));
        if (picked is null) return;

        WarnIfArkRunning();
        _busy = true;
        try
        {
            var result = await FileMod.RemoveAsync(picked);
            Report(result);
        }
        finally
        {
            _busy = false;
            Rescan();
        }
    }

    private async Task ReplaceFileAsync()
    {
        if (_busy) return;
        var target = await PickFileAsync(Localizer.T("filemodifier.picker.replace.target"));
        if (target is null) return;

        var source = await PickFileAsync(Localizer.T("filemodifier.picker.replace.source"));
        if (source is null) return;

        WarnIfArkRunning();
        _busy = true;
        try
        {
            var result = await FileMod.ReplaceAsync(target, source);
            Report(result);
        }
        finally
        {
            _busy = false;
            Rescan();
        }
    }

    private async Task RestoreAsync(string id)
    {
        if (_busy) return;
        WarnIfArkRunning();
        _busy = true;
        try
        {
            var result = await FileMod.RestoreAsync(id);
            Report(result);
        }
        finally
        {
            _busy = false;
            Rescan();
        }
    }

    private async Task RestoreAllAsync()
    {
        if (_busy) return;
        WarnIfArkRunning();
        _busy = true;
        try
        {
            var (restored, failed) = await FileMod.RestoreAllAsync();
            if (failed == 0 && restored > 0)
                Notifications.ShowSuccess(Localizer.T("filemodifier.toast.restoredall", restored));
            else if (failed > 0)
                Notifications.ShowWarning(Localizer.T("filemodifier.toast.restoredpartial", restored, failed));
            else Notifications.ShowInfo(Localizer.T("filemodifier.toast.nothingtorestore"));
        }
        finally
        {
            _busy = false;
            Rescan();
        }
    }

    private async Task<string?> PickFileAsync(string title)
    {
        try
        {
            var result = await FilePicker.Default.PickAsync(new PickOptions { PickerTitle = title });
            return result?.FullPath;
        }
        catch (Exception ex)
        {
            Notifications.ShowError(Localizer.T("filemodifier.toast.pickerfailed"));
            System.Diagnostics.Debug.WriteLine(ex);
            return null;
        }
    }

    private void Report(FileModResult result)
    {
        if (result.Success) Notifications.ShowSuccess(result.Message);
        else Notifications.ShowError(result.Message);
    }

    private void WarnIfArkRunning()
    {
        try
        {
            if (ProcessService.IsProcessRunning("ShooterGame"))
                Notifications.ShowWarning(Localizer.T("filemodifier.toast.arkrunning"));
        }
        catch { /* best-effort */ }
    }

    // Not static: a static helper cannot reach the injected localizer, and the badge word in
    // the middle of this line is the one thing on the row that has to follow a switch.
    private string ModEntryDescription(FileModEntry entry) =>
        Localizer.T("filemodifier.entry.description",
            entry.RelativePath,
            ActionLabel(entry.Action),
            entry.TimestampUtc.ToLocalTime().ToString("g"));

    private static string FormatBytes(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB", "TB" };
        double size = bytes;
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }
        return unit == 0 ? $"{size:0} {units[unit]}" : $"{size:0.0} {units[unit]}";
    }

    // `async void` is worse here than a dropped dispatch: FileMod.Changed is raised off the
    // renderer's thread, so a fault has no SynchronizationContext to land on and is rethrown on
    // the thread pool instead of becoming RR-E1003.
    private void OnChanged() => this.DispatchRender(() => InvokeAsync(() =>
    {
        _modified = FileMod.GetModifiedFiles();
        StateHasChanged();
    }));

    public void Dispose()
    {
        this.StopRenderDispatch();
        FileMod.Changed -= OnChanged;
    }
}
