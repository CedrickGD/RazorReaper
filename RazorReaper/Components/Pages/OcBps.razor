@page "/oc-bps"
@using RazorReaper.Services.Localization
@inject ILocalizer Localizer

<header class="page-header">
    <h1 class="page-title">@Localizer.T("nav.page.oc-bps")</h1>
    <p class="page-subtitle">@Localizer.T("ocbps.subtitle")</p>
</header>

<div class="ocbps-layout">
    <div class="content-card ocbps-intro">
        <div class="ocbps-intro-header">
            <div class="ocbps-intro-icon">
                <svg fill="currentColor" viewBox="0 0 20 20">
                    <path d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7.414a1 1 0 00-.293-.707l-3.414-3.414A1 1 0 0011.586 3H6z" />
                    <path d="M13 8H7m6 4H7m6 4H7" />
                </svg>
            </div>
            <div>
                <h3>@Localizer.T("ocbps.how.title")</h3>
                <p>@Localizer.T("ocbps.how.text")</p>
            </div>
        </div>
    </div>

    <div class="ocbps-grid">
        @foreach (var category in categories)
        {
            <section class="content-card ocbps-card">
                <div class="ocbps-card-header">
                    <h2>@Localizer.T(category.TitleKey)</h2>
                    <span class="ocbps-count">@Localizer.T("ocbps.count", category.Entries.Count)</span>
                </div>
                <div class="ocbps-table">
                    <div class="ocbps-row ocbps-row-header">
                        <span>@Localizer.T("ocbps.column.item")</span>
                        <span>@Localizer.T("ocbps.column.mission")</span>
                        <span>@Localizer.T("ocbps.column.difficulty")</span>
                    </div>
                    @foreach (var entry in category.Entries)
                    {
                        <div class="ocbps-row">
                            <div class="ocbps-item">
                @if (entry.Item == "Flamethrower")
                {
                    <text>Flame<wbr />thrower</text>
                }
                else if (entry.Item == "Deinonychus")
                {
                    <text>Deino<wbr />nychus</text>
                }
                else
                {
                    @entry.Item
                }
            </div>
                            <div class="ocbps-mission">
                                @entry.Mission
                                @if (!string.IsNullOrWhiteSpace(entry.Note))
                                {
                                    <span class="ocbps-note">(@entry.Note)</span>
                                }
                            </div>
                            <div>
                                <span class="ocbps-tag @entry.Difficulty.ToLowerInvariant()" title="@DifficultyHint(entry.Difficulty)">@entry.Difficulty</span>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    </div>
</div>

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    private readonly List<BpCategory> categories = new()
    {
        new BpCategory
        {
            TitleKey = "ocbps.category.armor",
            Entries = new List<BpEntry>
            {
                new BpEntry { Item = "Flak Helmet", Mission = "Maewing Poach", Difficulty = "Beta" },
                new BpEntry { Item = "Flak Chest", Mission = "Maewing Poach", Difficulty = "Beta" },
                new BpEntry { Item = "Flak Gaunts", Mission = "Ferox Cull", Difficulty = "Beta" },
                new BpEntry { Item = "Flak Legs", Mission = "Bulbdog Fetch", Difficulty = "Beta" },
                new BpEntry { Item = "Flak Boots", Mission = "Ferox Cull", Difficulty = "Beta" },
                new BpEntry { Item = "Hazard Helmet", Mission = "Survive the Ark", Difficulty = "Beta" }
            }
        },
        new BpCategory
        {
            TitleKey = "ocbps.category.weapons",
            Entries = new List<BpEntry>
            {
                new BpEntry { Item = "Fabby BP", Mission = "Bulbdog Fetch / Ferox Cull", Difficulty = "Beta", Note = "both" },
                new BpEntry { Item = "Comp BP", Mission = "Shadowmane Prowl", Difficulty = "Beta" },
                new BpEntry { Item = "Crossbow", Mission = "Velonasaur Stalk", Difficulty = "Beta" },
                new BpEntry { Item = "Metal Hatchet", Mission = "Code Red", Difficulty = "Beta" },
                new BpEntry { Item = "Flamethrower", Mission = "Choose Your Own Adventure", Difficulty = "Beta" },
                new BpEntry { Item = "Tek Rifle", Mission = "Velonasaur Stalk", Difficulty = "Alpha" },
                new BpEntry { Item = "Riot Shield", Mission = "Velonasaur Stalk", Difficulty = "Beta" }
            }
        },
        new BpCategory
        {
            TitleKey = "ocbps.category.saddles",
            Entries = new List<BpEntry>
            {
                new BpEntry { Item = "Giga", Mission = "Shadowmane Prowl", Difficulty = "Alpha" },
                new BpEntry { Item = "Thylacoleo", Mission = "Maewing Poach", Difficulty = "Beta" },
                new BpEntry { Item = "Racer", Mission = "Paracer Roundup", Difficulty = "Alpha" },
                new BpEntry { Item = "Yuti", Mission = "Ferox Cull", Difficulty = "Alpha" },
                new BpEntry { Item = "Carbo", Mission = "Velonasaur Stalk", Difficulty = "Gamma" },
                new BpEntry { Item = "Stego", Mission = "Paracer Roundup", Difficulty = "Gamma" },
                new BpEntry { Item = "Deinonychus", Mission = "Bulbdog Fetch", Difficulty = "Beta" },
                new BpEntry { Item = "Racer", Mission = "Shadowmane Prowl", Difficulty = "Beta" },
                new BpEntry { Item = "Owl", Mission = "Maewing Poach", Difficulty = "Beta" },
                new BpEntry { Item = "Ptero", Mission = "Shadowmane Prowl", Difficulty = "Beta" },
                new BpEntry { Item = "Daedon", Mission = "Velonasaur Stalk", Difficulty = "Beta" },
                new BpEntry { Item = "Karkinos", Mission = "Velonasaur Stalk", Difficulty = "Alpha" },
                new BpEntry { Item = "Basilisk", Mission = "Ferox Cull", Difficulty = "Alpha" },
                new BpEntry { Item = "Tek Tape", Mission = "Shadowmane Prowl", Difficulty = "Alpha" }
            }
        }
    };

    private sealed class BpEntry
    {
        public string Item { get; init; } = "";
        public string Mission { get; init; } = "";
        public string Difficulty { get; init; } = "";
        public string Note { get; init; } = "";
    }

    private sealed class BpCategory
    {
        public string TitleKey { get; init; } = "";
        public List<BpEntry> Entries { get; init; } = new();
    }

    // ARK's own difficulty names, so the tag itself stays Alpha/Beta/Gamma; only what they
    // are worth is translated.
    private string DifficultyHint(string difficulty) => difficulty switch
    {
        "Alpha" => Localizer.T("ocbps.difficulty.alpha"),
        "Beta" => Localizer.T("ocbps.difficulty.beta"),
        "Gamma" => Localizer.T("ocbps.difficulty.gamma"),
        _ => ""
    };
}
