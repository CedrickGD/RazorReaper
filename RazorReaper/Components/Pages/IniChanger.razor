                        "success",
                        string.IsNullOrEmpty(selectedPreset)
                            ? "inichanger.activity.inisaved"
                            : "inichanger.activity.inisaved.preset");
                }), Logger);
                Logger.LogInformation("INI file saved to: {Path}", iniPath);
