    // Safety net: snapshot the live INI before we overwrite or clear it, so a bad preset is always
    // recoverable. Keeps the newest 20 snapshots under %LOCALAPPDATA%\RazorReaper\IniBackups
    // (same convention the INI Builder uses for GameUserSettings/Game.ini).
    private void BackupLiveIni(string iniPath)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(iniPath) || !File.Exists(iniPath)) return;

            var dir = Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
                "RazorReaper", "IniBackups");
            Directory.CreateDirectory(dir);

            var name = Path.GetFileNameWithoutExtension(iniPath);
            var dest = Path.Combine(dir, $"{name}_{DateTime.Now:yyyyMMdd_HHmmss}.ini");
            ArkUtilities.CopyToBackup(iniPath, dest, overwrite: true);

            foreach (var stale in new DirectoryInfo(dir)
                         .GetFiles($"{name}_*.ini")
                         .OrderByDescending(f => f.LastWriteTimeUtc)
                         .Skip(20))
            {
                try { stale.Delete(); } catch { /* pruning is best-effort */ }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "BaseDeviceProfiles backup failed");
        }
    }

