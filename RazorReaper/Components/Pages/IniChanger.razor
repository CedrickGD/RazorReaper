@page "/ini-changer"
@using Microsoft.Win32
@using System.IO
@using System.IO.Compression
@using Microsoft.Extensions.Logging
@using Microsoft.Maui.Storage
@using RazorReaper.Services
@using RazorReaper.Models

@inject IJSRuntime JSRuntime
@inject IIniPresetService PresetService
@inject IArkPathProvider ArkPathProvider
@inject IFileSystemService FileSystem
@inject ILogger<IniChanger> Logger
@inject INotificationService NotificationService
@inject IActivityService ActivityService
@inject ITextureBackupService BackupService


        <header class="page-header">
            <h1 class="page-title">INI Configuration</h1>
            <p class="page-subtitle">Manage & optimize ARK configuration presets</p>
        </header>

        @{
            var activePreset = string.IsNullOrEmpty(selectedPreset) ? null : PresetService.GetPresetByName(selectedPreset);
            var totalLines = string.IsNullOrEmpty(currentIniContent) ? 0 : currentIniContent.Count(c => c == '\n') + 1;
            var totalBytes = string.IsNullOrEmpty(currentIniContent) ? 0 : System.Text.Encoding.UTF8.GetByteCount(currentIniContent);
        }

        <div class="ini-page @(isDeleteMode ? "delete-mode" : "")">

            @* ============================================================
               TOP BAR — Active preset strip stacked over the action toolbar
               ============================================================ *@
            <section class="content-card ini-topbar">
                <div class="ini-active-row">
                    <div class="ini-active-thumb @(activePreset == null ? "is-empty" : "")">
                        @if (activePreset != null)
                        {
                            var activeSrc = GetPresetImageSource(activePreset.Name);
                            if (activeSrc != null)
                            {
                                <img src="@activeSrc" alt="@activePreset.Name preview" onclick="rrZoom(this)" />
                            }
                            else
                            {
                                <div class="hosted-media-placeholder">
                                    @if (IsPresetImageResolved(activePreset.Name))
                                    {
                                        <svg fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <span class="hosted-media-spinner"></span>
                                    }
                                </div>
                            }
                            @if (activePreset.IsCustom)
                            {
                                <span class="ini-active-custom">Custom</span>
                            }
                        }
                        else
                        {
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd" />
                            </svg>
                        }
                    </div>
                    <div class="ini-active-meta">
                        <div class="ini-active-label">
                            <span class="ini-launcher-stat-dot @(activePreset == null ? "muted" : "live")"></span>
                            @(activePreset == null ? "No preset applied" : "Active preset")
                        </div>
                        <div class="ini-active-name">@(activePreset?.Name ?? "Pick a preset below")</div>
                        <p class="ini-active-desc">@(activePreset?.Description ?? "Click any card to apply that preset to your live ARK INI.")</p>
                    </div>
                    <div class="ini-active-stats">
                        <div class="ini-active-stat">
                            <div class="ini-active-stat-value">@PresetService.GetAllPresets().Count</div>
                            <div class="ini-active-stat-label">Presets</div>
                        </div>
                    </div>
                </div>

                <div class="ini-topbar-divider"></div>

                <div class="ini-toolbar-row">
                    <div class="ini-toolbar-group">
                        <button class="ini-btn" @onclick="OpenIniFile" data-tooltip="Open the live ARK INI" data-tooltip-pos="bottom">
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
                            </svg>
                            Open
                        </button>
                        <button class="ini-btn" @onclick="CheckIniFileExists" data-tooltip="Verify INI file path" data-tooltip-pos="bottom">
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                            </svg>
                            Check
                        </button>
                        <button class="ini-btn" @onclick="SaveChanges" data-tooltip="Write current buffer to disk" data-tooltip-pos="bottom">
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path d="M7.707 10.293a1 1 0 10-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 11.586V6h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V8a2 2 0 012-2h5v5.586l-1.293-1.293zM9 4a1 1 0 012 0v2H9V4z" />
                            </svg>
                            Save
                        </button>
                        <button class="ini-btn" @onclick="ClearFile" data-tooltip="Empty the live INI" data-tooltip-pos="bottom">
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" clip-rule="evenodd" />
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                            </svg>
                            Clear
                        </button>
                        <button class="ini-btn" @onclick="DownloadAllPresets" data-tooltip="Export all presets as a zip" data-tooltip-pos="bottom">
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
                            </svg>
                            Export
                        </button>
                    </div>

                    <div class="ini-toolbar-sep"></div>

                    <div class="ini-toolbar-group">
                        <button class="ini-btn" @onclick="CheckWaterFiles" data-tooltip="Check water surface files" data-tooltip-pos="bottom">
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path d="M10 2a6 6 0 016 6c0 4-6 10-6 10S4 12 4 8a6 6 0 016-6zm0 4a2 2 0 100 4 2 2 0 000-4z" />
                            </svg>
                            Water
                        </button>
                        <button class="ini-btn @(WaterSurfaceRemoved ? "ini-btn-accent" : "ini-btn-danger")" @onclick="ToggleWaterSurface" data-tooltip="@(WaterSurfaceRemoved ? "Restore the water surface" : "Remove the water surface (reversible)")" data-tooltip-pos="bottom">
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                @if (WaterSurfaceRemoved)
                                {
                                    <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
                                }
                                else
                                {
                                    <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                                }
                            </svg>
                            @(WaterSurfaceRemoved ? "Restore Water" : "Remove Water")
                        </button>
                    </div>

                    <div class="ini-toolbar-spacer"></div>

                    <div class="ini-toolbar-group">
                        <button class="ini-btn ini-btn-accent" @onclick="OpenAddPresetDialog" data-tooltip="Save current INI as a custom preset" data-tooltip-pos="bottom">
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                            </svg>
                            Add Preset
                        </button>
                        <label class="ini-toolbar-toggle @(isDeleteMode ? "is-active" : "")" data-tooltip="Click a custom preset to remove it" data-tooltip-pos="bottom">
                            <input type="checkbox" checked="@isDeleteMode" @onchange="ToggleDeleteMode" />
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                            </svg>
                            Delete mode
                        </label>
                    </div>
                </div>
            </section>

            @* ============================================================
               PRESETS — Inline gallery as the main view
               ============================================================ *@
            <section class="content-card ini-presets-card @(isDeleteMode ? "delete-mode" : "")">
                <div class="preset-gallery-grid">
                    @foreach (var preset in PresetService.GetAllPresets())
                    {
                        var isActive = selectedPreset == preset.Name;
                        <div @key="@($"{preset.Name}-{imageVersion}")" class="preset-gallery-card @(isActive ? "active" : "")">
                            <div class="preset-gallery-image" @onclick="() => OnGalleryImageClick(preset)" @onclick:stopPropagation="true">
                                @{ var gallerySrc = GetPresetImageSource(preset.Name); }
                                @if (gallerySrc != null)
                                {
                                    <img src="@gallerySrc" alt="@preset.Name preview" />
                                }
                                else
                                {
                                    <div class="hosted-media-placeholder">
                                        @if (IsPresetImageResolved(preset.Name))
                                        {
                                            <svg fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <span class="hosted-media-spinner"></span>
                                        }
                                    </div>
                                }
                                @if (isActive)
                                {
                                    <div class="preset-gallery-active-badge">
                                        <svg fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                        </svg>
                                        Active
                                    </div>
                                }
                                @if (preset.IsCustom)
                                {
                                    <div class="preset-gallery-custom-badge">Custom</div>
                                }
                            </div>
                            <div class="preset-gallery-info" @onclick="() => HandleGalleryCardClick(preset)">
                                <div class="preset-gallery-name">@preset.Name</div>
                                <div class="preset-gallery-desc">@preset.Description</div>
                            </div>
                        </div>
                    }
                </div>
            </section>

            @* ============================================================
               EDITOR — Collapsible, hidden by default. Stays editable.
               ============================================================ *@
            <section class="content-card ini-editor-collapse @(editorExpanded ? "expanded" : "collapsed")">
                <button type="button" class="ini-editor-collapse-header" @onclick="ToggleEditor">
                    <h3>INI Editor</h3>
                    <span class="ini-widget-pill muted">@IniEditorStatusLabel()</span>
                    <svg class="ini-editor-chevron @(editorExpanded ? "open" : "")" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
                <div class="ini-editor-collapse-body">
                    <textarea @bind="currentIniContent"
                              class="ini-editor-embedded-textarea"
                              placeholder="Load an INI file or apply a preset to start editing…"
                              spellcheck="false"></textarea>
                </div>
            </section>

        </div>

@if (showAddPresetDialog)
{
    <div class="ini-overlay" @onclick="CloseAddPresetDialog">
        <div class="ini-overlay-container ini-overlay-narrow" @onclick:stopPropagation="true">
            <div class="ini-overlay-header">
                <div class="ini-overlay-title-block">
                    <h2 class="ini-overlay-title">Create Preset</h2>
                    <span class="ini-overlay-subtitle">Save your tuned INI as a reusable preset</span>
                </div>
                <button class="ini-overlay-close" @onclick="CloseAddPresetDialog" data-tooltip="Close" data-tooltip-pos="bottom">
                    <svg fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>

            <div class="ini-overlay-body">
                <div class="ini-preset-form">
                    <div class="ini-preset-field">
                        <label class="ini-preset-label" for="preset-name">Preset name</label>
                        <input id="preset-name" class="ini-preset-input" @bind="newPresetName" placeholder="Enter preset name" />
                    </div>

                    <div class="ini-preset-field">
                        <label class="ini-preset-label" for="preset-description">Description</label>
                        <input id="preset-description" class="ini-preset-input" @bind="newPresetDescription" placeholder="Short description" />
                    </div>

                    <div class="ini-preset-field">
                        <label class="ini-preset-label">Preview image <span class="ini-preset-label-optional">optional</span></label>
                        <div class="ini-preset-image-picker">
                            <div class="ini-preset-image-thumb @(newPresetImagePreviewUrl == null ? "is-empty" : "")">
                                @if (newPresetImagePreviewUrl != null)
                                {
                                    <img src="@newPresetImagePreviewUrl" alt="Preset image preview" />
                                }
                                else
                                {
                                    <svg fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd" />
                                    </svg>
                                }
                            </div>
                            <div class="ini-preset-image-controls">
                                <button type="button" class="ini-overlay-ghost-btn" @onclick="PickPresetImage">
                                    @(newPresetImagePreviewUrl != null ? "Change image" : "Choose image…")
                                </button>
                                @if (newPresetImagePreviewUrl != null)
                                {
                                    <button type="button" class="ini-overlay-ghost-btn" @onclick="ClearPresetImage">Remove</button>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="ini-preset-field">
                        <label class="ini-preset-label" for="preset-content">INI content</label>
                        <textarea id="preset-content" class="ini-preset-textarea" @bind="newPresetContent" rows="8"
                                  placeholder="Paste INI content or import a file..."></textarea>
                    </div>

                    <div class="ini-preset-actions">
                        <button type="button" class="ini-overlay-ghost-btn" @onclick="UseCurrentIniContent">Use Current Editor</button>
                        <button type="button" class="ini-overlay-ghost-btn" @onclick="ImportPresetFile">Import INI File</button>
                    </div>

                    <p class="ini-preset-note">Custom presets are saved locally and appear in your preset list.</p>
                </div>
            </div>

            <div class="ini-overlay-footer">
                <button type="button" class="ini-overlay-ghost-btn" @onclick="CloseAddPresetDialog">Cancel</button>
                <button type="button" class="ini-overlay-ghost-btn ini-overlay-primary-btn" @onclick="SaveCustomPreset" disabled="@IsSavePresetDisabled()">Save Preset</button>
            </div>
        </div>
    </div>
}


@code {
    private string currentIniContent = "";
    private string selectedPreset = "";
    private bool showAddPresetDialog = false;
    private bool editorExpanded = false;
    private string newPresetName = "";
    private string newPresetDescription = "";
    private string newPresetContent = "";
    private bool isSavingPreset = false;
    private bool isDeleteMode = false;
    // Image attached to a new custom preset (picked in the Create Preset dialog).
    private string? newPresetImagePath;
    private string? newPresetImageExt;
    private string? newPresetImagePreviewUrl;
    // Bumped after a preset image override is saved/reset so @key forces a fresh <img> render
    // (data URL changes need a new DOM node to defeat the WebView's in-memory image cache).
    private int imageVersion = 0;
    // Resolved image source per preset name (data URL for overrides, virtual-host URL for
    // hosted CDN images). Sources resolve asynchronously — no entry yet renders a spinner,
    // an entry holding null means resolve finished with nothing available (offline and
    // nothing cached yet) and renders a static no-image placeholder.
    private readonly Dictionary<string, string?> presetImageSources = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        // Restore the visual indicator for the last applied preset so the hero card
        // shows it across sessions. We deliberately do NOT reload the .ini content into
        // the editor — that would clobber any uncommitted manual tweak the user left in
        // memory. The user still hits Open to read the live ARK INI.
        var lastApplied = PresetService.GetLastAppliedPresetName();
        if (!string.IsNullOrWhiteSpace(lastApplied))
        {
            selectedPreset = lastApplied;
        }

        await RefreshPresetImagesAsync();
    }

    private string? GetPresetImageSource(string presetName) =>
        presetImageSources.TryGetValue(presetName, out var src) ? src : null;

    /// <summary>True once the preset's image resolve has completed (even with no result).</summary>
    private bool IsPresetImageResolved(string presetName) =>
        presetImageSources.ContainsKey(presetName);

    /// <summary>
    /// Re-resolves every preset's image source. Each card updates as its own resolve
    /// completes so a first-run CDN download shows images progressively.
    /// </summary>
    private async Task RefreshPresetImagesAsync()
    {
        await Task.WhenAll(PresetService.GetAllPresets().Select(async preset =>
        {
            presetImageSources[preset.Name] = await PresetService.GetPresetImageSourceAsync(preset.Name);
            await InvokeAsync(StateHasChanged);
        }));
    }

    private void ToggleEditor()
    {
        editorExpanded = !editorExpanded;
    }

    private async Task HandleGalleryCardClick(IniPreset preset)
    {
        if (isDeleteMode)
        {
            // Delete mode: route to the existing confirm + remove flow.
            await HandlePresetClick(preset);
            return;
        }

        // Apply mode: load the preset content into the buffer and write it straight to the
        // live ARK INI file. The hero strip updates on the next render.
        SelectPreset(preset);
        await InvokeAsync(StateHasChanged);
        await SaveChanges();
    }

    private async Task OnGalleryImageClick(IniPreset preset)
    {
        if (isDeleteMode)
        {
            // Delete mode is sticky — clicks anywhere on the card should delete.
            await HandlePresetClick(preset);
            return;
        }

        // Normal mode: open the shared lightbox with this preset's image.
        var src = GetPresetImageSource(preset.Name);
        if (src == null)
        {
            return; // Still resolving (or unavailable) — nothing to zoom yet.
        }

        await JSRuntime.InvokeVoidAsync("rrZoomUrl", src, $"{preset.Name} preview");
    }

    private string IniEditorStatusLabel()
    {
        if (string.IsNullOrEmpty(currentIniContent))
        {
            return "Empty buffer";
        }

        var lineCount = currentIniContent.Count(c => c == '\n') + 1;
        var byteCount = System.Text.Encoding.UTF8.GetByteCount(currentIniContent);
        return $"{lineCount:N0} lines · {FormatByteCount(byteCount)}";
    }

    private static string FormatByteCount(int bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private void OpenAddPresetDialog()
    {
        showAddPresetDialog = true;
        newPresetName = "";
        newPresetDescription = "";
        newPresetContent = currentIniContent;
        newPresetImagePath = null;
        newPresetImageExt = null;
        newPresetImagePreviewUrl = null;
        isDeleteMode = false;
    }

    private void CloseAddPresetDialog()
    {
        showAddPresetDialog = false;
    }

    private async Task PickPresetImage()
    {
        try
        {
            var fileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
            {
                { DevicePlatform.WinUI, new[] { ".jpg", ".jpeg", ".png", ".webp", ".gif" } }
            });

            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Pick preset image",
                FileTypes = fileTypes
            });

            if (result == null)
            {
                return;
            }

            // Build a data URL for the in-modal thumbnail. The actual file gets re-opened on
            // Save Preset and handed to the service — we don't keep the source stream open.
            var ext = Path.GetExtension(result.FileName);
            await using var stream = await result.OpenReadAsync();
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            var bytes = memory.ToArray();

            var mime = ext.ToLowerInvariant() switch
            {
                ".jpg" or ".jpeg" => "image/jpeg",
                ".png" => "image/png",
                ".webp" => "image/webp",
                ".gif" => "image/gif",
                _ => "image/jpeg"
            };

            newPresetImagePath = result.FullPath;
            newPresetImageExt = ext;
            newPresetImagePreviewUrl = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error picking preset image");
            NotificationService.ShowError($"Image pick failed: {ex.Message}");
        }
    }

    private void ClearPresetImage()
    {
        newPresetImagePath = null;
        newPresetImageExt = null;
        newPresetImagePreviewUrl = null;
    }

    private void UseCurrentIniContent()
    {
        newPresetContent = currentIniContent;

        if (string.IsNullOrWhiteSpace(newPresetContent))
        {
            NotificationService.ShowWarning("Current INI content is empty.");
        }
    }

    private async Task ImportPresetFile()
    {
        try
        {
            var fileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
            {
                { DevicePlatform.WinUI, new[] { ".ini", ".txt" } }
            });

            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Select an INI file",
                FileTypes = fileTypes
            });

            if (result == null)
            {
                return;
            }

            await using var stream = await result.OpenReadAsync();
            using var reader = new StreamReader(stream);
            newPresetContent = await reader.ReadToEndAsync();

            if (string.IsNullOrWhiteSpace(newPresetName))
            {
                newPresetName = Path.GetFileNameWithoutExtension(result.FileName);
            }

            NotificationService.ShowSuccess("INI file imported.");
