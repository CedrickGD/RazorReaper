@page "/ini-changer"
@using Microsoft.Win32
@using System.IO
@using System.IO.Compression
@using Microsoft.Extensions.Logging
@using Microsoft.Maui.Storage
@using RazorReaper.Services
@using RazorReaper.Models

@inject IJSRuntime JSRuntime
@inject IIniPresetService PresetService
@inject IArkPathProvider ArkPathProvider
@inject IFileSystemService FileSystem
@inject ILogger<IniChanger> Logger
@inject INotificationService NotificationService
@inject IActivityService ActivityService


        <header class="page-header">
            <h1 class="page-title">INI Configuration</h1>
            <p class="page-subtitle">Manage & optimize ARK configuration presets</p>
        </header>

        @{
            var activePreset = string.IsNullOrEmpty(selectedPreset) ? null : PresetService.GetPresetByName(selectedPreset);
            var totalLines = string.IsNullOrEmpty(currentIniContent) ? 0 : currentIniContent.Count(c => c == '\n') + 1;
            var totalBytes = string.IsNullOrEmpty(currentIniContent) ? 0 : System.Text.Encoding.UTF8.GetByteCount(currentIniContent);
        }

        <div class="ini-layout @(isDeleteMode ? "delete-mode" : "")">

            @* ============================================================
               LEFT: Combined Tools widget — File ops + Water Surface
               ============================================================ *@
            <aside class="content-card ini-tools-panel">
                <header class="ini-tools-section-head">
                    <h3>Tools</h3>
                    <span class="ini-tools-stat">
                        <span class="ini-launcher-stat-dot @(string.IsNullOrEmpty(selectedPreset) ? "muted" : "live")"></span>
                        @(string.IsNullOrEmpty(selectedPreset) ? "No preset" : selectedPreset)
                    </span>
                </header>

                <div class="ini-tools-buttons">
                    <button class="ini-btn" @onclick="OpenIniFile">
                        <svg fill="currentColor" viewBox="0 0 20 20">
                            <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
                        </svg>
                        Open
                    </button>
                    <button class="ini-btn" @onclick="CheckIniFileExists">
                        <svg fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                        </svg>
                        Check Path
                    </button>
                    <button class="ini-btn" @onclick="SaveChanges">
                        <svg fill="currentColor" viewBox="0 0 20 20">
                            <path d="M7.707 10.293a1 1 0 10-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 11.586V6h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V8a2 2 0 012-2h5v5.586l-1.293-1.293zM9 4a1 1 0 012 0v2H9V4z" />
                        </svg>
                        Save
                    </button>
                    <button class="ini-btn" @onclick="ClearFile">
                        <svg fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" clip-rule="evenodd" />
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                        </svg>
                        Clear
                    </button>
                    <button class="ini-btn" @onclick="DownloadAllPresets">
                        <svg fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                        Export
                    </button>
                </div>

                <div class="ini-tools-divider"></div>

                <header class="ini-tools-section-head">
                    <h4>Water Surface</h4>
                </header>

                <div class="ini-tools-water-row">
                    <button class="ini-btn" @onclick="CheckWaterFiles">
                        <svg fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                        </svg>
                        Check
                    </button>
                    <button class="ini-btn ini-btn-danger" @onclick="DeleteWaterSurfaceFiles">
                        <svg fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                        Remove
                    </button>
                </div>
            </aside>

            @* ============================================================
               MIDDLE: Preset preview widget
               ============================================================ *@
            <div class="content-card ini-widget preset-widget">
                <div class="ini-widget-header">
                    <h3>Preset</h3>
                    <span class="ini-widget-pill @(string.IsNullOrEmpty(selectedPreset) ? "muted" : "live")">
                        <span class="ini-launcher-stat-dot @(string.IsNullOrEmpty(selectedPreset) ? "muted" : "live")"></span>
                        @(string.IsNullOrEmpty(selectedPreset) ? "None" : "Active")
                    </span>
                </div>

                <div class="ini-widget-body">
                    @if (activePreset != null)
                    {
                        <div class="ini-widget-preset-image">
                            <img src="@PresetService.GetPresetImagePath(activePreset.Name)" alt="@activePreset.Name preview" />
                            @if (activePreset.IsCustom)
                            {
                                <div class="preset-gallery-custom-badge">Custom</div>
                            }
                        </div>
                        <div class="ini-widget-preset-name">@activePreset.Name</div>
                        <p class="ini-widget-preset-desc">@activePreset.Description</p>
                    }
                    else
                    {
                        <div class="ini-widget-preset-image ini-widget-preset-image-empty">
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd" />
                            </svg>
                            <span class="ini-widget-empty-hint">@PresetService.GetAllPresets().Count presets ready</span>
                        </div>
                        <p class="ini-widget-preset-desc">Pick a tuned configuration from the gallery.</p>
                    }
                </div>

                <button class="ini-widget-cta" @onclick="OpenPresetGallery">
                    Browse Presets
                    <svg fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>

            @* ============================================================
               RIGHT: Embedded INI Editor — full-height textarea, no overlay
               ============================================================ *@
            <div class="content-card ini-editor-embedded">
                <div class="ini-widget-header">
                    <h3>INI Editor</h3>
                    <span class="ini-widget-pill muted">@IniEditorStatusLabel()</span>
                </div>
                <textarea @bind="currentIniContent"
                          class="ini-editor-embedded-textarea"
                          placeholder="Load an INI file or apply a preset to start editing…"
                          spellcheck="false"></textarea>
            </div>

        </div>


@if (showPresetGallery)
{
    <div class="ini-overlay" @onclick="CloseGalleryOverlay">
        <div class="ini-overlay-container ini-overlay-wide" @onclick:stopPropagation="true">
            <div class="ini-overlay-header">
                <div class="ini-overlay-title-block">
                    <h2 class="ini-overlay-title">INI Preset Gallery</h2>
                    <span class="ini-overlay-subtitle">@PresetService.GetAllPresets().Count presets · click a card to apply@(isDeleteMode ? " · DELETE MODE" : "")</span>
                </div>
                <div class="ini-overlay-header-actions">
                    <button class="ini-overlay-ghost-btn" @onclick="OpenAddPresetFromGallery" data-tooltip="Create a custom preset" data-tooltip-pos="bottom">
                        <svg fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                        </svg>
                        Add
                    </button>
                    <button class="ini-overlay-ghost-btn" @onclick="DownloadAllPresets" data-tooltip="Export all presets as a zip" data-tooltip-pos="bottom">
                        <svg fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                        Export
                    </button>
                    <label class="ini-overlay-check @(isDeleteMode ? "is-active" : "")" data-tooltip="Click a custom preset to remove it" data-tooltip-pos="bottom">
                        <input type="checkbox" checked="@isDeleteMode" @onchange="ToggleDeleteMode" />
                        <span>Delete mode</span>
                    </label>
                    <button class="ini-overlay-close" @onclick="CloseGalleryOverlay" data-tooltip="Close" data-tooltip-pos="bottom">
                        <svg fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                    </button>
                </div>
            </div>

            <div class="ini-overlay-body @(isDeleteMode ? "delete-mode" : "")">
                <div class="preset-gallery-grid">
                    @foreach (var preset in PresetService.GetAllPresets())
                    {
                        var isActive = selectedPreset == preset.Name;
                        var hasOverride = PresetService.HasCustomImage(preset.Name);
                        <div @key="@($"{preset.Name}-{imageVersion}")" class="preset-gallery-card @(isActive ? "active" : "")"
                             @onclick="() => HandleGalleryCardClick(preset)">
                            <div class="preset-gallery-image">
                                <img src="@PresetService.GetPresetImagePath(preset.Name)" alt="@preset.Name preview" />
                                @if (isActive)
                                {
                                    <div class="preset-gallery-active-badge">
                                        <svg fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                        </svg>
                                        Active
                                    </div>
                                }
                                @if (preset.IsCustom)
                                {
                                    <div class="preset-gallery-custom-badge">Custom</div>
                                }
                                <div class="preset-gallery-image-actions" @onclick:stopPropagation="true">
                                    <button type="button" class="preset-gallery-action-btn" data-tooltip="Replace image" @onclick="() => ReplacePresetImage(preset)">
                                        <svg fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M4 5a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V7a2 2 0 00-2-2h-1.586a1 1 0 01-.707-.293l-1.121-1.121A2 2 0 0011.172 3H8.828a2 2 0 00-1.414.586L6.293 4.707A1 1 0 015.586 5H4zm6 9a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
                                        </svg>
                                    </button>
                                    @if (hasOverride)
                                    {
                                        <button type="button" class="preset-gallery-action-btn" data-tooltip="Reset to default" @onclick="() => ResetPresetImageOverride(preset)">
                                            <svg fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
                                            </svg>
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="preset-gallery-info">
                                <div class="preset-gallery-name">@preset.Name</div>
                                <div class="preset-gallery-desc">@preset.Description</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (showAddPresetDialog)
{
    <div class="modal-overlay ini-modal-overlay" @onclick="CloseAddPresetDialog">
        <div class="modal-content ini-preset-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Create Preset</h2>
                <button class="modal-close" @onclick="CloseAddPresetDialog">
                    <svg fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="ini-preset-form">
                    <div class="ini-preset-field">
                        <label class="ini-preset-label" for="preset-name">Preset name</label>
                        <input id="preset-name" class="ini-preset-input" @bind="newPresetName" placeholder="Enter preset name" />
                    </div>

                    <div class="ini-preset-field">
                        <label class="ini-preset-label" for="preset-description">Description</label>
                        <input id="preset-description" class="ini-preset-input" @bind="newPresetDescription" placeholder="Short description" />
                    </div>

                    <div class="ini-preset-field">
                        <label class="ini-preset-label" for="preset-content">INI content</label>
                        <textarea id="preset-content" class="ini-preset-textarea" @bind="newPresetContent" rows="8"
                                  placeholder="Paste INI content or import a file..."></textarea>
                    </div>

                    <div class="ini-preset-actions">
                        <button class="btn btn-secondary" @onclick="UseCurrentIniContent">Use Current Editor</button>
                        <button class="btn btn-secondary" @onclick="ImportPresetFile">Import INI File</button>
                    </div>

                    <p class="ini-preset-note">Custom presets are saved locally and appear in your preset list.</p>
                </div>

                <div class="ini-preset-footer">
                    <button class="btn btn-primary" @onclick="SaveCustomPreset" disabled="@IsSavePresetDisabled()">Save Preset</button>
                    <button class="btn btn-secondary" @onclick="CloseAddPresetDialog">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    private string currentIniContent = "";
    private string selectedPreset = "";
    private bool showAddPresetDialog = false;
    private bool showPresetGallery = false;
    private string newPresetName = "";
    private string newPresetDescription = "";
    private string newPresetContent = "";
    private bool isSavingPreset = false;
    private bool isDeleteMode = false;
    // Bumped after a preset image override is saved/reset so @key forces a fresh <img> render
    // (data URL changes need a new DOM node to defeat the WebView's in-memory image cache).
    private int imageVersion = 0;

    private void OpenPresetGallery()
    {
        showPresetGallery = true;
    }

    private void CloseGalleryOverlay()
    {
        showPresetGallery = false;
        // Don't auto-exit delete mode here — user might be mid-curate. Toggle button in header handles it.
    }


    private void OpenAddPresetFromGallery()
    {
        // Close the gallery so the Add Preset modal isn't stacked on top.
        showPresetGallery = false;
        OpenAddPresetDialog();
    }

    private async Task HandleGalleryCardClick(IniPreset preset)
    {
        if (isDeleteMode)
        {
            // Delete mode: route to the existing confirm + remove flow.
            await HandlePresetClick(preset);
            return;
        }

        // Apply mode: load the preset content into the buffer, write it straight to the live ARK
        // INI file, and close the gallery. This replaces the old manual "Save Changes" button.
        SelectPreset(preset);
        showPresetGallery = false;
        await InvokeAsync(StateHasChanged);
        await SaveChanges();
    }

    private string IniEditorStatusLabel()
    {
        if (string.IsNullOrEmpty(currentIniContent))
        {
            return "Empty buffer";
        }

        var lineCount = currentIniContent.Count(c => c == '\n') + 1;
        var byteCount = System.Text.Encoding.UTF8.GetByteCount(currentIniContent);
        return $"{lineCount:N0} lines · {FormatByteCount(byteCount)}";
    }

    private static string FormatByteCount(int bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private void OpenAddPresetDialog()
    {
        showAddPresetDialog = true;
        newPresetName = "";
        newPresetDescription = "";
        newPresetContent = currentIniContent;
        isDeleteMode = false;
    }

    private void CloseAddPresetDialog()
    {
        showAddPresetDialog = false;
    }

    private void UseCurrentIniContent()
    {
        newPresetContent = currentIniContent;

        if (string.IsNullOrWhiteSpace(newPresetContent))
        {
            NotificationService.ShowWarning("Current INI content is empty.");
        }
    }

    private async Task ImportPresetFile()
    {
        try
        {
            var fileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
            {
                { DevicePlatform.WinUI, new[] { ".ini", ".txt" } }
            });

            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Select an INI file",
                FileTypes = fileTypes
            });

            if (result == null)
            {
                return;
            }

            await using var stream = await result.OpenReadAsync();
            using var reader = new StreamReader(stream);
            newPresetContent = await reader.ReadToEndAsync();

            if (string.IsNullOrWhiteSpace(newPresetName))
            {
                newPresetName = Path.GetFileNameWithoutExtension(result.FileName);
            }

            NotificationService.ShowSuccess("INI file imported.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error importing INI file");
            NotificationService.ShowError($"Import failed: {ex.Message}");
        }
    }

    private async Task SaveCustomPreset()
    {
        var name = newPresetName?.Trim() ?? string.Empty;
        var description = newPresetDescription?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(name))
        {
            NotificationService.ShowWarning("Preset name is required.");
            return;
        }

        if (string.IsNullOrWhiteSpace(newPresetContent))
        {
            NotificationService.ShowWarning("Preset content is required.");
            return;
        }

        if (PresetService.GetPresetByName(name) != null)
        {
            NotificationService.ShowWarning("A preset with this name already exists.");
            return;
        }

        try
        {
            isSavingPreset = true;

            var preset = new IniPreset
            {
                Name = name,
                Description = description,
                Content = newPresetContent
            };

            var saved = await PresetService.AddCustomPresetAsync(preset);
            if (!saved)
            {
                NotificationService.ShowError("Failed to save preset.");
                return;
            }

            selectedPreset = preset.Name;
            currentIniContent = preset.Content;
            showAddPresetDialog = false;

            NotificationService.ShowSuccess("Preset saved successfully.");
            ActivityService.AddActivity($"Custom preset saved: {preset.Name}", "success");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving custom preset");
            NotificationService.ShowError($"Save failed: {ex.Message}");
        }
        finally
        {
            isSavingPreset = false;
        }
    }

    private void ToggleDeleteMode()
    {
        isDeleteMode = !isDeleteMode;

        if (isDeleteMode)
        {
            NotificationService.ShowInfo("Select a custom preset to delete.");
        }
    }

    private async Task HandlePresetClick(IniPreset preset)
    {
        if (!isDeleteMode)
        {
            SelectPreset(preset);
            return;
        }

        isDeleteMode = false;
        await InvokeAsync(StateHasChanged);

        if (!preset.IsCustom)
        {
            NotificationService.ShowWarning("Only custom presets can be deleted.");
            return;
        }

        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete custom preset '{preset.Name}'?");
        if (!confirm)
        {
            return;
        }

        try
        {
            var removed = await PresetService.RemoveCustomPresetAsync(preset.Name);
            if (!removed)
            {
                NotificationService.ShowWarning("Unable to remove this preset.");
                return;
            }

            if (string.Equals(selectedPreset, preset.Name, StringComparison.OrdinalIgnoreCase))
            {
                selectedPreset = "";
            }

            NotificationService.ShowSuccess("Custom preset removed.");
            ActivityService.AddActivity($"Custom preset removed: {preset.Name}", "warning");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error removing custom preset");
            NotificationService.ShowError($"Remove failed: {ex.Message}");
        }
    }

    private bool IsSavePresetDisabled()
    {
        return isSavingPreset || string.IsNullOrWhiteSpace(newPresetName) || string.IsNullOrWhiteSpace(newPresetContent);
    }

    private async Task ReplacePresetImage(IniPreset preset)
    {
        try
        {
            var fileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
            {
                { DevicePlatform.WinUI, new[] { ".jpg", ".jpeg", ".png", ".webp", ".gif" } }
            });

            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = $"Pick image for '{preset.Name}'",
                FileTypes = fileTypes
            });

            if (result == null)
            {
                return;
            }

            var ext = Path.GetExtension(result.FileName);
            await using var stream = await result.OpenReadAsync();
            var saved = await PresetService.SetPresetImageAsync(preset.Name, stream, ext);

            if (!saved)
            {
                NotificationService.ShowError("Failed to save preset image.");
                return;
            }

            imageVersion++;
            NotificationService.ShowSuccess($"Image updated for '{preset.Name}'.");
            ActivityService.AddActivity($"Preset image updated: {preset.Name}", "success");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error replacing preset image for {Preset}", preset.Name);
            NotificationService.ShowError($"Image replace failed: {ex.Message}");
        }
    }

    private void ResetPresetImageOverride(IniPreset preset)
    {
        try
        {
            var reset = PresetService.ResetPresetImage(preset.Name);
            if (!reset)
            {
                NotificationService.ShowInfo("No custom image to reset.");
                return;
            }

            imageVersion++;
            NotificationService.ShowSuccess($"Reset image for '{preset.Name}'.");
            ActivityService.AddActivity($"Preset image reset: {preset.Name}", "info");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error resetting preset image for {Preset}", preset.Name);
            NotificationService.ShowError($"Image reset failed: {ex.Message}");
        }
    }

    private async Task OpenIniFile()
    {
        try
        {
            Logger.LogInformation("Opening INI file");

            // Run file operations on background thread to prevent UI freezing
            await Task.Run(() =>
            {
                string? iniPath = ArkUtilities.GetBaseDeviceProfilesPath();

                if (iniPath == null)
                {
                    InvokeAsync(() => NotificationService.ShowError("Steam installation not found in registry."));
                    return;
                }

                if (!File.Exists(iniPath))
                {
                    InvokeAsync(() => NotificationService.ShowWarning("INI file does not exist at expected location."));
                    return;
                }

                currentIniContent = File.ReadAllText(iniPath, System.Text.Encoding.UTF8);
                InvokeAsync(() =>
                {
                    NotificationService.ShowSuccess("INI file loaded successfully.");
                    ActivityService.AddActivity("INI file loaded successfully", "success");
                    StateHasChanged();
                });
                Logger.LogInformation("INI file loaded from: {Path}", iniPath);
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading INI file");
            NotificationService.ShowError($"Error loading INI file: {ex.Message}");
        }
    }

