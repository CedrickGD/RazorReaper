    private async Task HandlePresetClick(IniPreset preset)
    {
        if (!isDeleteMode)
        {
            SelectPreset(preset);
            return;
        }

        isDeleteMode = false;
        await InvokeAsync(StateHasChanged);

        if (!preset.IsCustom)
        {
            NotificationService.ShowWarning(Localizer.T("inichanger.toast.onlycustom"));
            return;
        }

        var confirm = await JSRuntime.InvokeAsync<bool>(
            "confirm", Localizer.T("inichanger.confirm.delete", preset.Name));
        if (!confirm)
        {
            return;
        }

        try
        {
            var removed = await PresetService.RemoveCustomPresetAsync(preset.Name);
            if (!removed)
            {
                NotificationService.ShowWarning(Localizer.T("inichanger.toast.removefailed"));
                return;
            }

            if (string.Equals(selectedPreset, preset.Name, StringComparison.OrdinalIgnoreCase))
            {
                selectedPreset = "";
                PresetService.SetLastAppliedPresetName(string.Empty);
            }

            presetImageSources.Remove(preset.Name);
            NotificationService.ShowSuccess(Localizer.T("inichanger.toast.presetremoved"));
            ActivityService.AddActivity(Localizer.T("inichanger.activity.presetremoved", preset.Name), "warning", "inichanger.activity.presetremoved");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error removing custom preset");
            NotificationService.ShowError(Localizer.T("inichanger.toast.removeerror", ex.Message));
        }
    }

