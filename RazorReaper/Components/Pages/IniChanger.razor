@page "/ini-changer"
@using Microsoft.Win32
@using System.IO
@using System.IO.Compression
@using Microsoft.Extensions.Logging
@using Microsoft.Maui.Storage
@using RazorReaper.Services
@using RazorReaper.Models

@inject IJSRuntime JSRuntime
@inject IIniPresetService PresetService
@inject IArkPathProvider ArkPathProvider
@inject IFileSystemService FileSystem
@inject ILogger<IniChanger> Logger
@inject INotificationService NotificationService
@inject IActivityService ActivityService


        <header class="page-header">
            <h1 class="page-title">INI Configuration</h1>
            <p class="page-subtitle">Manage & optimize ARK configuration presets</p>
        </header>

        <div class="ini-layout @(isDeleteMode ? "delete-mode" : "")">
            <div class="ini-operations-panel">
                <div class="content-card">
                    <div class="section-info">
                        <div class="icon-circle white">
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
                            </svg>
                        </div>
                        <div>
                            <h3>File Operations</h3>
                            <p class="section-description">Load, modify & save BaseDeviceProfiles.ini</p>
                        </div>
                    </div>

                    <div class="file-operations">
                        <button class="ini-btn" @onclick="OpenIniFile">
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
                            </svg>
                            Open INI File
                        </button>

                        <button class="ini-btn" @onclick="CheckIniFileExists">
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                            </svg>
                            Check Path
                        </button>

                        <button class="ini-btn" @onclick="SaveChanges">
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path d="M7.707 10.293a1 1 0 10-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 11.586V6h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V8a2 2 0 012-2h5v5.586l-1.293-1.293zM9 4a1 1 0 012 0v2H9V4z" />
                            </svg>
                            Save Changes
                        </button>

                        <button class="ini-btn" @onclick="ClearFile">
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" clip-rule="evenodd" />
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                            </svg>
                            Clear File
                        </button>

                        <button class="ini-btn" @onclick="ToggleDeleteMode">
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                            </svg>
                            Remove Preset
                        </button>

                        <button class="ini-btn" @onclick="DownloadAllPresets">
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
                            </svg>
                            Download INI's
                        </button>
                    </div>
                </div>

                <div class="content-card">
                    <div class="section-info">
                        <div class="icon-circle white">
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div>
                            <h3>Water Surface</h3>
                            <p class="section-description">Remove water textures for underwater visibility</p>
                        </div>
                    </div>

                    <div class="water-info-clean">
                        <p>Removes water surface for clear visibility, independent of ini -config.</p>
                        <div style="display: flex; gap: 0.5rem; margin-top: 0.8rem; flex-wrap: wrap;">
                            <div class="feature-tag">🔍 Visibility</div>
                            <div class="feature-tag">⚔️ PvP</div>
                            <div class="feature-tag">🌊 Clear</div>
                        </div>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                        <button class="ini-btn" @onclick="CheckWaterFiles">
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                            </svg>
                            Check Files
                        </button>

                        <button class="ini-btn" @onclick="DeleteWaterSurfaceFiles">
                            <svg fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                            </svg>
                            Remove Water
                        </button>
                    </div>

                    <div class="restore-info-clean">
                        <p><strong>Restore:</strong> Verify game integrity through Steam to restore deleted files.</p>
                    </div>
                </div>
            </div>

            <div class="ini-main-column">
                <div class="content-card">
                    <h3>Configuration Presets</h3>
                    <p style="color: var(--text-secondary); margin-bottom: 1.5rem; font-size: 0.8rem; line-height: 1.5;">
                        Optimized presets for different gameplay scenarios. Each preset is designed for performance and visual quality.
                    </p>

                    <div class="presets-grid">
                        @foreach (var preset in PresetService.GetAllPresets())
                        {
                            <button @key="preset.Name" class="preset-button @(selectedPreset == preset.Name ? "active" : "")"
                                    @onclick="() => HandlePresetClick(preset)">
                                <div class="preset-info">
                                    <div class="preset-name">@preset.Name</div>
                                    <div class="preset-description">@preset.Description</div>
                                </div>
                            </button>
                        }
                        <button class="preset-button preset-add-button" @onclick="OpenAddPresetDialog">
                            <div class="preset-add-icon">+</div>
                            <div class="preset-add-text">Add Preset</div>
                        </button>
                    </div>
                </div>

                <div class="content-card ini-content-area">
                    <h3>INI File Content</h3>
                    <textarea @bind="currentIniContent"
                              class="ini-textarea"
                              placeholder="INI file content will appear here..."></textarea>
                </div>

                <div class="content-card">
                    <div class="images-header">
                        <div>
                            <h3>Configuration Previews</h3>
                            <p style="color: var(--text-secondary); margin: 0; font-size: 0.75rem;">Visual examples of each preset</p>
                        </div>
                        <button class="images-toggle-btn" @onclick="ToggleImages">
                            @(showImages ? "▼ Hide" : "▶ Show")
                        </button>
                    </div>

                    @if (showImages)
                    {
                        <div class="images-grid">
                            @foreach (var preset in PresetService.GetAllPresets())
                            {
                                <div @key="preset.Name" class="image-item">
                                    <div class="image-preview">
                                        <img src="@PresetService.GetPresetImagePath(preset.Name)" alt="@preset.Name Preview" />
                                    </div>
                                    <div class="image-name">@preset.Name</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>


@if (showAddPresetDialog)
{
    <div class="modal-overlay ini-modal-overlay" @onclick="CloseAddPresetDialog">
        <div class="modal-content ini-preset-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Create Preset</h2>
                <button class="modal-close" @onclick="CloseAddPresetDialog">
                    <svg fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="ini-preset-form">
                    <div class="ini-preset-field">
                        <label class="ini-preset-label" for="preset-name">Preset name</label>
                        <input id="preset-name" class="ini-preset-input" @bind="newPresetName" placeholder="Enter preset name" />
                    </div>

                    <div class="ini-preset-field">
                        <label class="ini-preset-label" for="preset-description">Description</label>
                        <input id="preset-description" class="ini-preset-input" @bind="newPresetDescription" placeholder="Short description" />
                    </div>

                    <div class="ini-preset-field">
                        <label class="ini-preset-label" for="preset-content">INI content</label>
                        <textarea id="preset-content" class="ini-preset-textarea" @bind="newPresetContent" rows="8"
                                  placeholder="Paste INI content or import a file..."></textarea>
                    </div>

                    <div class="ini-preset-actions">
                        <button class="btn btn-secondary" @onclick="UseCurrentIniContent">Use Current Editor</button>
                        <button class="btn btn-secondary" @onclick="ImportPresetFile">Import INI File</button>
                    </div>

                    <p class="ini-preset-note">Custom presets are saved locally and appear in your preset list.</p>
                </div>

                <div class="ini-preset-footer">
                    <button class="btn btn-primary" @onclick="SaveCustomPreset" disabled="@IsSavePresetDisabled()">Save Preset</button>
                    <button class="btn btn-secondary" @onclick="CloseAddPresetDialog">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    private string currentIniContent = "";
    private string selectedPreset = "";
    private bool showImages = false;
    private bool showAddPresetDialog = false;
    private string newPresetName = "";
    private string newPresetDescription = "";
    private string newPresetContent = "";
    private bool isSavingPreset = false;
    private bool isDeleteMode = false;

    private void ToggleImages()
    {
        showImages = !showImages;
    }

    private void OpenAddPresetDialog()
    {
        showAddPresetDialog = true;
        newPresetName = "";
        newPresetDescription = "";
        newPresetContent = currentIniContent;
        isDeleteMode = false;
    }

    private void CloseAddPresetDialog()
    {
        showAddPresetDialog = false;
    }

    private void UseCurrentIniContent()
    {
        newPresetContent = currentIniContent;

        if (string.IsNullOrWhiteSpace(newPresetContent))
        {
            NotificationService.ShowWarning("Current INI content is empty.");
        }
    }

    private async Task ImportPresetFile()
    {
        try
        {
            var fileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
            {
                { DevicePlatform.WinUI, new[] { ".ini", ".txt" } }
            });

            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Select an INI file",
                FileTypes = fileTypes
            });

            if (result == null)
            {
                return;
            }

            await using var stream = await result.OpenReadAsync();
            using var reader = new StreamReader(stream);
            newPresetContent = await reader.ReadToEndAsync();

            if (string.IsNullOrWhiteSpace(newPresetName))
            {
                newPresetName = Path.GetFileNameWithoutExtension(result.FileName);
            }

            NotificationService.ShowSuccess("INI file imported.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error importing INI file");
            NotificationService.ShowError($"Import failed: {ex.Message}");
        }
    }

    private async Task SaveCustomPreset()
    {
        var name = newPresetName?.Trim() ?? string.Empty;
        var description = newPresetDescription?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(name))
        {
            NotificationService.ShowWarning("Preset name is required.");
            return;
        }

        if (string.IsNullOrWhiteSpace(newPresetContent))
        {
            NotificationService.ShowWarning("Preset content is required.");
            return;
        }

        if (PresetService.GetPresetByName(name) != null)
        {
            NotificationService.ShowWarning("A preset with this name already exists.");
            return;
        }

        try
        {
            isSavingPreset = true;

            var preset = new IniPreset
            {
                Name = name,
                Description = description,
                Content = newPresetContent
            };

            var saved = await PresetService.AddCustomPresetAsync(preset);
            if (!saved)
            {
                NotificationService.ShowError("Failed to save preset.");
                return;
            }

            selectedPreset = preset.Name;
            currentIniContent = preset.Content;
            showAddPresetDialog = false;
            showImages = false;

            NotificationService.ShowSuccess("Preset saved successfully.");
            ActivityService.AddActivity($"Custom preset saved: {preset.Name}", "success");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving custom preset");
            NotificationService.ShowError($"Save failed: {ex.Message}");
        }
        finally
        {
            isSavingPreset = false;
        }
    }

    private void ToggleDeleteMode()
    {
        isDeleteMode = !isDeleteMode;

        if (isDeleteMode)
        {
            NotificationService.ShowInfo("Select a custom preset to delete.");
        }
    }

    private async Task HandlePresetClick(IniPreset preset)
    {
        if (!isDeleteMode)
        {
            SelectPreset(preset);
            return;
        }

        isDeleteMode = false;
        await InvokeAsync(StateHasChanged);

        if (!preset.IsCustom)
        {
            NotificationService.ShowWarning("Only custom presets can be deleted.");
            return;
        }

        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete custom preset '{preset.Name}'?");
        if (!confirm)
        {
            return;
        }

        try
        {
            var removed = await PresetService.RemoveCustomPresetAsync(preset.Name);
            if (!removed)
            {
                NotificationService.ShowWarning("Unable to remove this preset.");
                return;
            }

            if (string.Equals(selectedPreset, preset.Name, StringComparison.OrdinalIgnoreCase))
            {
                selectedPreset = "";
            }

            showImages = false;
            NotificationService.ShowSuccess("Custom preset removed.");
            ActivityService.AddActivity($"Custom preset removed: {preset.Name}", "warning");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error removing custom preset");
            NotificationService.ShowError($"Remove failed: {ex.Message}");
        }
    }

    private bool IsSavePresetDisabled()
    {
        return isSavingPreset || string.IsNullOrWhiteSpace(newPresetName) || string.IsNullOrWhiteSpace(newPresetContent);
    }

    private async Task OpenIniFile()
    {
        try
        {
            Logger.LogInformation("Opening INI file");

            // Run file operations on background thread to prevent UI freezing
            await Task.Run(() =>
            {
                string? iniPath = ArkUtilities.GetBaseDeviceProfilesPath();

                if (iniPath == null)
                {
                    InvokeAsync(() => NotificationService.ShowError("Steam installation not found in registry."));
                    return;
                }

                if (!File.Exists(iniPath))
                {
                    InvokeAsync(() => NotificationService.ShowWarning("INI file does not exist at expected location."));
                    return;
                }

                currentIniContent = File.ReadAllText(iniPath, System.Text.Encoding.UTF8);
                InvokeAsync(() =>
                {
                    NotificationService.ShowSuccess("INI file loaded successfully.");
                    ActivityService.AddActivity("INI file loaded successfully", "success");
                    StateHasChanged();
                });
                Logger.LogInformation("INI file loaded from: {Path}", iniPath);
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading INI file");
            NotificationService.ShowError($"Error loading INI file: {ex.Message}");
        }
    }

    private async Task ClearFile()
    {
        try
        {
            Logger.LogInformation("Clearing INI file");

            // Run file operations on background thread
            await Task.Run(() =>
            {
                string? iniPath = ArkUtilities.GetBaseDeviceProfilesPath();

                if (iniPath == null)
                {
                    InvokeAsync(() => NotificationService.ShowError("Steam installation not found in registry."));
                    return;
                }

                currentIniContent = "";
                File.WriteAllText(iniPath, currentIniContent, System.Text.Encoding.UTF8);

                InvokeAsync(() =>
                {
                    selectedPreset = "";
                    NotificationService.ShowSuccess("INI file content cleared successfully.");
                    ActivityService.AddActivity("INI file cleared", "warning");
                    StateHasChanged();
                });
                Logger.LogInformation("INI file cleared");
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error clearing INI file");
            NotificationService.ShowError($"Error clearing INI file: {ex.Message}");
        }
    }

    private void SelectPreset(IniPreset preset)
    {
        selectedPreset = preset.Name;
        showImages = false;
        currentIniContent = preset.Content;
        ActivityService.AddActivity($"Preset selected: {preset.Name}", "info");
        Logger.LogInformation("Preset selected: {PresetName}", preset.Name);
    }

    private async Task SaveChanges()
    {
        try
        {
            Logger.LogInformation("Saving INI file changes");

            // Run file operations on background thread
            await Task.Run(() =>
            {
                string? iniPath = ArkUtilities.GetBaseDeviceProfilesPath();

                if (iniPath == null)
                {
                    InvokeAsync(() => NotificationService.ShowError("Steam installation not found in registry."));
                    return;
                }

                var directory = Path.GetDirectoryName(iniPath);
                if (string.IsNullOrEmpty(directory))
                {
                    InvokeAsync(() => NotificationService.ShowError("Invalid directory path"));
                    Logger.LogError("Directory path is null or empty for INI file: {Path}", iniPath);
                    return;
                }

                if (!Directory.Exists(directory))
                {
                    Directory.CreateDirectory(directory);
                }

                File.WriteAllText(iniPath, currentIniContent, System.Text.Encoding.UTF8);
                InvokeAsync(() =>
                {
                    NotificationService.ShowSuccess("INI file saved successfully!");
                    ActivityService.AddActivity($"INI file saved{(string.IsNullOrEmpty(selectedPreset) ? "" : $" (Preset: {selectedPreset})")}", "success");
                });
                Logger.LogInformation("INI file saved to: {Path}", iniPath);
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving INI file");
            NotificationService.ShowError($"Error saving INI file: {ex.Message}");
        }
    }

    private async Task DownloadAllPresets()
    {
        try
        {
            var presets = PresetService.GetAllPresets();
            if (presets.Count == 0)
            {
                NotificationService.ShowWarning("No presets available to download.");
                return;
            }

            await Task.Run(() =>
            {
                var downloadsPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads");
                var zipName = $"RazorReaper_INI_Presets_{DateTime.Now:yyyyMMdd_HHmmss}.zip";
                var zipPath = Path.Combine(downloadsPath, zipName);

                if (!Directory.Exists(downloadsPath))
                {
                    Directory.CreateDirectory(downloadsPath);
                }

                if (File.Exists(zipPath))
                {
                    File.Delete(zipPath);
                }

                using var archive = ZipFile.Open(zipPath, ZipArchiveMode.Create);
                var usedNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

                foreach (var preset in presets)
                {
                    var baseName = GetSafePresetFileName(preset.Name);
                    var entryName = GetUniquePresetFileName(baseName, usedNames);

                    var entry = archive.CreateEntry(entryName, CompressionLevel.Optimal);
                    using var writer = new StreamWriter(entry.Open());
                    writer.Write(preset.Content ?? string.Empty);
                }

                InvokeAsync(() =>
                {
                    NotificationService.ShowSuccess($"Presets downloaded to {zipPath}");
                    ActivityService.AddActivity("INI presets downloaded", "success");
                });
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error downloading presets");
            NotificationService.ShowError($"Download failed: {ex.Message}");
        }
    }

    private static string GetSafePresetFileName(string name)
    {
        var safeName = string.IsNullOrWhiteSpace(name) ? "Preset" : name.Trim();

        foreach (var invalidChar in Path.GetInvalidFileNameChars())
        {
            safeName = safeName.Replace(invalidChar, '_');
        }

        return string.IsNullOrWhiteSpace(safeName) ? "Preset" : safeName;
    }

    private static string GetUniquePresetFileName(string baseName, HashSet<string> usedNames)
    {
        var entryName = $"{baseName}.ini";
        var index = 1;

        while (usedNames.Contains(entryName))
        {
            entryName = $"{baseName}_{index}.ini";
            index++;
        }

        usedNames.Add(entryName);
        return entryName;
    }

    private async Task CheckIniFileExists()
    {
        try
        {
            Logger.LogInformation("Checking INI file existence");

            // Run file operations on background thread
            await Task.Run(() =>
            {
                string? iniPath = ArkUtilities.GetBaseDeviceProfilesPath();

                if (iniPath == null)
                {
                    InvokeAsync(() => NotificationService.ShowError("Steam installation not found in registry. Please ensure Steam is properly installed."));
                    return;
                }

                if (!File.Exists(iniPath))
                {
                    InvokeAsync(() => NotificationService.ShowWarning($"INI file not found at: {iniPath}"));
                    Logger.LogWarning("INI file not found at: {Path}", iniPath);
                }
                else
                {
                    var fileInfo = new FileInfo(iniPath);
                    var fileSize = fileInfo.Length;
                    var lastModified = fileInfo.LastWriteTime;

                    InvokeAsync(() => NotificationService.ShowSuccess($"INI file found!\nPath: {iniPath}\nSize: {fileSize} bytes\nModified: {lastModified:yyyy-MM-dd HH:mm}"));
                    Logger.LogInformation("INI file found at: {Path}, Size: {Size} bytes", iniPath, fileSize);
                }
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error checking INI file");
            NotificationService.ShowError($"Error checking INI file: {ex.Message}");
        }
    }

    private async Task CheckWaterFiles()
    {
        try
        {
            Logger.LogInformation("Checking water files");

            // Run file operations on background thread
            await Task.Run(() =>
            {
                string? arkBasePath = ArkUtilities.FindArkPath();

                if (string.IsNullOrEmpty(arkBasePath) || !Directory.Exists(arkBasePath))
                {
                    InvokeAsync(() => NotificationService.ShowError("ARK installation not found. Please ensure ARK is properly installed."));
                    return;
                }

                string waterFilesPath = Path.Combine(arkBasePath, "ShooterGame", "Content", "PrimalEarth", "Effects", "Textures", "Generic");

                if (!Directory.Exists(waterFilesPath))
                {
                    InvokeAsync(() => NotificationService.ShowWarning($"Water files directory not found at: {waterFilesPath}"));
                    return;
                }

                var waterFiles = new[] { "SoftEdgeGradient_Linear.uasset", "SoftEdgeGradient.uasset" };
                var existingFiles = new List<string>();

                foreach (string fileName in waterFiles)
                {
                    string filePath = Path.Combine(waterFilesPath, fileName);
                    if (File.Exists(filePath))
                    {
                        existingFiles.Add(fileName);
                    }
                }

                if (existingFiles.Count == waterFiles.Length)
                {
                    InvokeAsync(() =>
                    {
                        NotificationService.ShowSuccess($"All water surface files found ({existingFiles.Count} files)\nPath: {waterFilesPath}");
                        ActivityService.AddActivity($"Water files check: All {existingFiles.Count} files found", "success");
                    });
                    Logger.LogInformation("All water files found at: {Path}", waterFilesPath);
                }
                else if (existingFiles.Count > 0)
                {
                    InvokeAsync(() =>
                    {
                        NotificationService.ShowWarning($"Partial water files found ({existingFiles.Count}/{waterFiles.Length} files)\nPath: {waterFilesPath}");
                        ActivityService.AddActivity($"Water files check: {existingFiles.Count}/{waterFiles.Length} files found", "warning");
                    });
                    Logger.LogWarning("Partial water files: {Count}/{Total} at {Path}", existingFiles.Count, waterFiles.Length, waterFilesPath);
                }
                else
                {
                    InvokeAsync(() =>
                    {
                        NotificationService.ShowInfo($"Water surface already removed (0/{waterFiles.Length} files found)\nPath: {waterFilesPath}");
                        ActivityService.AddActivity("Water files check: Already removed", "info");
                    });
                    Logger.LogInformation("No water files found - already removed");
                }
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error checking water files");
            NotificationService.ShowError($"Error checking water files: {ex.Message}");
        }
    }

    private async Task DeleteWaterSurfaceFiles()
    {
        try
        {
            Logger.LogInformation("Deleting water surface files");

            // Run file operations on background thread
            await Task.Run(() =>
            {
                string? arkBasePath = ArkUtilities.FindArkPath();

                if (string.IsNullOrEmpty(arkBasePath) || !Directory.Exists(arkBasePath))
                {
                    InvokeAsync(() => NotificationService.ShowError("ARK installation not found!"));
                    return;
                }

                string shooterGamePath = Path.Combine(arkBasePath, "ShooterGame", "Content", "PrimalEarth");
                int deletedCount = 0;

                var waterSurfaceFiles = new Dictionary<string, string[]>
                {
                    { Path.Combine(shooterGamePath, "Effects", "Textures", "Generic"), new[] {
                        "SoftEdgeGradient_Linear.uasset",
                        "SoftEdgeGradient.uasset"
                    }}
                };

                foreach (var folder in waterSurfaceFiles)
                {
                    string folderPath = folder.Key;
                    if (!Directory.Exists(folderPath))
                        continue;

                    foreach (string fileName in folder.Value)
                    {
                        string filePath = Path.Combine(folderPath, fileName);
                        if (File.Exists(filePath))
                        {
                            File.Delete(filePath);
                            deletedCount++;
                            Logger.LogInformation("Deleted water file: {FileName}", fileName);
                        }
                    }
                }

                int count = deletedCount;
                InvokeAsync(() =>
                {
                    NotificationService.ShowSuccess($"Successfully deleted {count} water surface file(s)");
                    ActivityService.AddActivity($"Water surface files deleted: {count} file(s)", "success");
                });
                Logger.LogInformation("Deleted {Count} water surface files", deletedCount);
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting water surface files");
            NotificationService.ShowError($"Error deleting water surface files: {ex.Message}");
        }
    }

}
