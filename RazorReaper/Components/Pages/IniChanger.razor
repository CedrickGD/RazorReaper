    private async Task DownloadAllPresets()
    {
        try
        {
            var presets = PresetService.GetAllPresets();
            if (presets.Count == 0)
            {
                NotificationService.ShowWarning(Localizer.T("inichanger.toast.nopresets"));
                return;
            }

            await Task.Run(() =>
            {
                var downloadsPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads");
                var zipName = $"RazorReaper_INI_Presets_{DateTime.Now:yyyyMMdd_HHmmss}.zip";
                var zipPath = Path.Combine(downloadsPath, zipName);

                if (!Directory.Exists(downloadsPath))
                {
                    Directory.CreateDirectory(downloadsPath);
                }

                if (File.Exists(zipPath))
                {
                    File.Delete(zipPath);
                }

                using var archive = ZipFile.Open(zipPath, ZipArchiveMode.Create);
                var usedNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

                foreach (var preset in presets)
                {
                    var baseName = GetSafePresetFileName(preset.Name);
                    var entryName = GetUniquePresetFileName(baseName, usedNames);

                    var entry = archive.CreateEntry(entryName, CompressionLevel.Optimal);
                    using var writer = new StreamWriter(entry.Open());
                    writer.Write(preset.Content ?? string.Empty);
                }

                this.DispatchRender(() => InvokeAsync(() =>
                {
                    NotificationService.ShowSuccess(Localizer.T("inichanger.toast.downloaded", zipPath));
                    ActivityService.AddActivity(Localizer.T("inichanger.activity.downloaded"), "success", "inichanger.activity.downloaded");
                }), Logger);
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error downloading presets");
            NotificationService.ShowError(Localizer.T("inichanger.toast.downloadfailed", ex.Message));
        }
    }

    private static string GetSafePresetFileName(string name)
    {
        var safeName = string.IsNullOrWhiteSpace(name) ? "Preset" : name.Trim();

        foreach (var invalidChar in Path.GetInvalidFileNameChars())
        {
            safeName = safeName.Replace(invalidChar, '_');
        }

        return string.IsNullOrWhiteSpace(safeName) ? "Preset" : safeName;
    }

    private static string GetUniquePresetFileName(string baseName, HashSet<string> usedNames)
    {
        var entryName = $"{baseName}.ini";
        var index = 1;

        while (usedNames.Contains(entryName))
        {
            entryName = $"{baseName}_{index}.ini";
            index++;
        }

        usedNames.Add(entryName);
        return entryName;
    }

