@page "/suitfov"
@using System.Diagnostics
@using System.IO
@using System.Linq
@using System.Text.RegularExpressions
@using RazorReaper.Services
@inject INotificationService NotificationService
@inject IActivityService ActivityService

<header class="page-header suitfov-header">
    <h1 class="page-title">Vision Tools</h1>
    <p class="page-subtitle">Manage TEK camera behavior and scope visibility in one place.</p>
</header>

<div class="suitfov-layout">
    <div class="vision-tools-grid">
        <div class="content-card">
            <div class="section-header-fov">
                <div class="icon-circle-fov">
                    <svg fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
                        <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div>
                    <h3>TEK Camera</h3>
                </div>
            </div>

            <div class="settings-status-card compact-card">
                <div class="settings-display">
                    <div class="setting-item @(bUseOldThirdPersonCameraTrace ? "enabled" : "disabled")">
                        <div class="setting-status-dot"></div>
                        <div class="setting-info">
                            <div class="setting-name">bUseOldThirdPersonCameraTrace</div>
                            <div class="setting-value">@(bUseOldThirdPersonCameraTrace ? "True" : "False")</div>
                        </div>
                    </div>
                    <div class="setting-item @(bUseOldThirdPersonCameraOffset ? "enabled" : "disabled")">
                        <div class="setting-status-dot"></div>
                        <div class="setting-info">
                            <div class="setting-name">bUseOldThirdPersonCameraOffset</div>
                            <div class="setting-value">@(bUseOldThirdPersonCameraOffset ? "True" : "False")</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="fov-main-actions">
                @if (!bUseOldThirdPersonCameraTrace || !bUseOldThirdPersonCameraOffset)
                {
                    <button class="fov-btn-large enable" @onclick="EnableCameraTrace">
                        <div class="btn-content-large">
                            <span class="btn-title">Enable Camera Trace</span>
                        </div>
                    </button>
                }
                else
                {
                    <button class="fov-btn-large disable" @onclick="DisableCameraTrace">
                        <div class="btn-content-large">
                            <span class="btn-title">Disable Camera Trace</span>
                        </div>
                    </button>
                }
            </div>

            <div class="path-section">
                <strong>Config Path</strong>
                <div class="path-display @(string.IsNullOrEmpty(gameUserSettingsPath) ? string.Empty : "clickable")"
                     @onclick="OpenGameSettingsFolder"
                     title="@(string.IsNullOrEmpty(gameUserSettingsPath) ? "Path not available" : "Open folder")">
                    @GetConfigPathDisplay()
                </div>
            </div>
        </div>

        <div class="content-card">
            <div class="section-header-fov">
                <div class="icon-circle-fov">
                    <svg fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div>
                    <h3>Scope Files</h3>
                </div>
            </div>

            <div class="settings-status-card compact-card">
                <div class="settings-display">
                    <div class="setting-item @(ScopeHasDisabledFiles() ? "disabled" : "enabled")">
                        <div class="setting-status-dot"></div>
                        <div class="setting-info">
                            <div class="setting-name">Scope</div>
                            <div class="setting-value">@(ScopeHasDisabledFiles() ? "Disabled" : "Enabled")</div>
                        </div>
                    </div>
                </div>
                @if (isScopeStatusLoading)
                {
                    <div class="scope-status-note">Scanning scope files...</div>
                }
            </div>

            <div class="fov-main-actions">
                <button class="fov-btn-large @(ScopeHasDisabledFiles() ? "enable" : "disable")"
                        @onclick="ToggleScopeFiles"
                        disabled="@IsScopeToggleDisabled()">
                    <div class="btn-content-large">
                        <span class="btn-title">@(ScopeHasDisabledFiles() ? "Restore Scope Files" : "Disable Scope Files")</span>
                    </div>
                </button>
            </div>

            <div class="path-section">
                <strong>Scope Root</strong>
                <div class="path-display @(string.IsNullOrEmpty(scopeRootPath) ? string.Empty : "clickable")"
                     @onclick="OpenScopeFolder"
                     title="@(string.IsNullOrEmpty(scopeRootPath) ? "Path not available" : "Open folder")">
                    @GetScopeRootDisplay()
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private const string ScopeDisabledSuffix = ".rrscopeoff";
    private const string DefaultGameSettingsPath = @"ARK\ShooterGame\Saved\Config\WindowsNoEditor\GameUserSettings.ini";
    private const string DefaultScopeRootPath = @"ARK\ShooterGame\Content\PrimalEarth";

    private static readonly string[] ScopeFilePatterns =
    {
        "*scope*.uasset",
        "*scope*.uexp",
        "*scope*.ubulk"
    };

    private string arkInstallPath = string.Empty;
    private string gameUserSettingsPath = string.Empty;
    private string scopeRootPath = string.Empty;

    private bool bUseOldThirdPersonCameraTrace;
    private bool bUseOldThirdPersonCameraOffset;

    private int? scopeActiveFileCount;
    private int? scopeDisabledFileCount;
    private bool isScopeStatusLoading;
    private bool isScopeBusy;

    protected override async Task OnInitializedAsync()
    {
        CheckFileAndReadSettings();
        ResolveScopeRootPath();
        _ = LoadScopeStateAsync();
        await Task.CompletedTask;
    }

    private bool ResolveArkPath()
    {
        if (!string.IsNullOrEmpty(arkInstallPath) && Directory.Exists(arkInstallPath))
        {
            return true;
        }

        arkInstallPath = ArkUtilities.FindArkPath() ?? string.Empty;
        return !string.IsNullOrEmpty(arkInstallPath) && Directory.Exists(arkInstallPath);
    }

    private void ResolveScopeRootPath()
    {
        scopeRootPath = string.Empty;
        if (!ResolveArkPath())
        {
            return;
        }

        var preferred = Path.Combine(arkInstallPath, "ShooterGame", "Content", "PrimalEarth");
        if (Directory.Exists(preferred))
        {
            scopeRootPath = preferred;
            return;
        }

        scopeRootPath = arkInstallPath;
    }

    private void CheckFileAndReadSettings()
    {
        try
        {
            if (!ResolveArkPath())
            {
                NotificationService.ShowError("ARK installation not found. Please ensure ARK is installed.");
                return;
            }

            gameUserSettingsPath = Path.Combine(arkInstallPath, "ShooterGame", "Saved", "Config", "WindowsNoEditor", "GameUserSettings.ini");
            if (!File.Exists(gameUserSettingsPath))
            {
                NotificationService.ShowWarning("GameUserSettings.ini not found. Launch ARK once to create it.");
                return;
            }

            ReadCurrentSettings();
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Error: {ex.Message}");
        }
    }

    private void ReadCurrentSettings()
    {
        try
        {
            if (!File.Exists(gameUserSettingsPath))
            {
                return;
            }

            var content = File.ReadAllText(gameUserSettingsPath);

            var traceMatch = Regex.Match(content, @"bUseOldThirdPersonCameraTrace=(\w+)", RegexOptions.IgnoreCase);
            if (traceMatch.Success)
            {
                bUseOldThirdPersonCameraTrace = traceMatch.Groups[1].Value.Equals("True", StringComparison.OrdinalIgnoreCase);
            }

            var offsetMatch = Regex.Match(content, @"bUseOldThirdPersonCameraOffset=(\w+)", RegexOptions.IgnoreCase);
            if (offsetMatch.Success)
            {
                bUseOldThirdPersonCameraOffset = offsetMatch.Groups[1].Value.Equals("True", StringComparison.OrdinalIgnoreCase);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error reading settings: {ex.Message}");
        }
    }

    private async Task LoadScopeStateAsync()
    {
        if (string.IsNullOrEmpty(scopeRootPath) || !Directory.Exists(scopeRootPath))
        {
            scopeActiveFileCount = 0;
            scopeDisabledFileCount = 0;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            isScopeStatusLoading = true;
            await InvokeAsync(StateHasChanged);

            var (active, disabled) = await Task.Run(() => CountScopeFiles(scopeRootPath));
            scopeActiveFileCount = active;
            scopeDisabledFileCount = disabled;
        }
        catch
        {
            scopeActiveFileCount = 0;
            scopeDisabledFileCount = 0;
        }
        finally
        {
            isScopeStatusLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task EnableCameraTrace()
    {
        try
        {
            if (string.IsNullOrEmpty(gameUserSettingsPath))
            {
                CheckFileAndReadSettings();
            }

            await Task.Run(() =>
            {
                if (!File.Exists(gameUserSettingsPath))
                {
                    InvokeAsync(() => NotificationService.ShowError("GameUserSettings.ini file not found."));
                    return;
                }

                var content = File.ReadAllText(gameUserSettingsPath);
                var modified = false;

                var tracePattern = @"bUseOldThirdPersonCameraTrace=\w+";
                if (Regex.IsMatch(content, tracePattern, RegexOptions.IgnoreCase))
                {
                    content = Regex.Replace(content, tracePattern, "bUseOldThirdPersonCameraTrace=True", RegexOptions.IgnoreCase);
                    modified = true;
                }
                else if (content.Contains("[/Script/ShooterGame.ShooterGameUserSettings]", StringComparison.Ordinal))
                {
                    content = content.Replace(
                        "[/Script/ShooterGame.ShooterGameUserSettings]",
                        "[/Script/ShooterGame.ShooterGameUserSettings]\r\nbUseOldThirdPersonCameraTrace=True");
                    modified = true;
                }

                var offsetPattern = @"bUseOldThirdPersonCameraOffset=\w+";
                if (Regex.IsMatch(content, offsetPattern, RegexOptions.IgnoreCase))
                {
                    content = Regex.Replace(content, offsetPattern, "bUseOldThirdPersonCameraOffset=True", RegexOptions.IgnoreCase);
                    modified = true;
                }
                else if (content.Contains("[/Script/ShooterGame.ShooterGameUserSettings]", StringComparison.Ordinal) &&
                         content.Contains("bUseOldThirdPersonCameraTrace=True", StringComparison.Ordinal) &&
                         !content.Contains("bUseOldThirdPersonCameraOffset", StringComparison.OrdinalIgnoreCase))
                {
                    content = content.Replace(
                        "bUseOldThirdPersonCameraTrace=True",
                        "bUseOldThirdPersonCameraTrace=True\r\nbUseOldThirdPersonCameraOffset=True");
                    modified = true;
                }

                if (!modified)
                {
                    InvokeAsync(() => NotificationService.ShowWarning("Could not find settings section in GameUserSettings.ini."));
                    return;
                }

                File.WriteAllText(gameUserSettingsPath, content);
                InvokeAsync(() =>
                {
                    bUseOldThirdPersonCameraTrace = true;
                    bUseOldThirdPersonCameraOffset = true;
                    NotificationService.ShowSuccess("Camera trace enabled.");
                    ActivityService.AddActivity("Camera trace enabled", "success");
                    StateHasChanged();
                });
            });
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task DisableCameraTrace()
    {
        try
        {
            if (string.IsNullOrEmpty(gameUserSettingsPath))
            {
                CheckFileAndReadSettings();
            }

            await Task.Run(() =>
            {
                if (!File.Exists(gameUserSettingsPath))
                {
                    InvokeAsync(() => NotificationService.ShowError("GameUserSettings.ini file not found."));
                    return;
                }

                var content = File.ReadAllText(gameUserSettingsPath);
                content = Regex.Replace(content, @"bUseOldThirdPersonCameraTrace=\w+", "bUseOldThirdPersonCameraTrace=False", RegexOptions.IgnoreCase);
                content = Regex.Replace(content, @"bUseOldThirdPersonCameraOffset=\w+", "bUseOldThirdPersonCameraOffset=False", RegexOptions.IgnoreCase);

                File.WriteAllText(gameUserSettingsPath, content);
                InvokeAsync(() =>
                {
                    bUseOldThirdPersonCameraTrace = false;
                    bUseOldThirdPersonCameraOffset = false;
                    NotificationService.ShowWarning("Camera trace disabled.");
                    ActivityService.AddActivity("Camera trace disabled", "warning");
                    StateHasChanged();
                });
            });
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Error: {ex.Message}");
        }
    }

    private Task ToggleScopeFiles()
    {
        return ScopeHasDisabledFiles() ? RestoreScopeFiles() : DisableScopeFiles();
    }

    private bool IsScopeToggleDisabled()
    {
        if (isScopeBusy || isScopeStatusLoading)
        {
            return true;
        }

        if (ScopeHasDisabledFiles())
        {
            return !scopeDisabledFileCount.HasValue || scopeDisabledFileCount.Value == 0;
        }

        return !scopeActiveFileCount.HasValue || scopeActiveFileCount.Value == 0;
    }

    private async Task DisableScopeFiles()
    {
        if (isScopeBusy)
        {
            return;
        }

        if (string.IsNullOrEmpty(scopeRootPath) || !Directory.Exists(scopeRootPath))
        {
            NotificationService.ShowError("Scope root path not found.");
            return;
        }

        try
        {
            isScopeBusy = true;
            await InvokeAsync(StateHasChanged);

            var result = await Task.Run(() =>
            {
                var renamed = 0;
                var skipped = 0;
                var failed = 0;

                var activeFiles = EnumerateActiveScopeFiles(scopeRootPath).ToList();
                foreach (var filePath in activeFiles)
                {
                    var renamedPath = filePath + ScopeDisabledSuffix;
                    try
                    {
                        if (File.Exists(renamedPath))
                        {
                            skipped++;
                            continue;
                        }

                        File.Move(filePath, renamedPath);
                        renamed++;
                    }
                    catch
                    {
                        failed++;
                    }
                }

                var counts = CountScopeFiles(scopeRootPath);
                return (renamed, skipped, failed, counts.active, counts.disabled, scanned: activeFiles.Count);
            });

            scopeActiveFileCount = result.active;
            scopeDisabledFileCount = result.disabled;
            Preferences.Set(ScopeModeConstants.ScopeModePreferenceKey, ScopeModeConstants.ScopeModeDisabled);

            if (result.renamed > 0)
            {
                NotificationService.ShowSuccess($"Renamed {result.renamed} scope file(s).");
                ActivityService.AddActivity($"Scope files disabled: {result.renamed}", "success");
            }
            else if (result.scanned == 0)
            {
                NotificationService.ShowInfo("No active scope files found.");
            }
            else
            {
                NotificationService.ShowWarning($"No files renamed. Skipped: {result.skipped}, Failed: {result.failed}.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Scope disable failed: {ex.Message}");
        }
        finally
        {
            isScopeBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RestoreScopeFiles()
    {
        if (isScopeBusy)
        {
            return;
        }

        if (string.IsNullOrEmpty(scopeRootPath) || !Directory.Exists(scopeRootPath))
        {
            NotificationService.ShowError("Scope root path not found.");
            return;
        }

        try
        {
            isScopeBusy = true;
            await InvokeAsync(StateHasChanged);

            var result = await Task.Run(() =>
            {
                var restored = 0;
                var skipped = 0;
                var failed = 0;

                var disabledFiles = EnumerateDisabledScopeFiles(scopeRootPath).ToList();
                foreach (var filePath in disabledFiles)
                {
                    var originalPath = filePath.Substring(0, filePath.Length - ScopeDisabledSuffix.Length);
                    try
                    {
                        if (File.Exists(originalPath))
                        {
                            skipped++;
                            continue;
                        }

                        File.Move(filePath, originalPath);
                        restored++;
                    }
                    catch
                    {
                        failed++;
                    }
                }

                var counts = CountScopeFiles(scopeRootPath);
                return (restored, skipped, failed, counts.active, counts.disabled, scanned: disabledFiles.Count);
            });

            scopeActiveFileCount = result.active;
            scopeDisabledFileCount = result.disabled;
            Preferences.Set(ScopeModeConstants.ScopeModePreferenceKey, ScopeModeConstants.ScopeModeEnabled);

            if (result.restored > 0)
            {
                NotificationService.ShowSuccess($"Restored {result.restored} scope file(s).");
                ActivityService.AddActivity($"Scope files restored: {result.restored}", "info");
            }
            else if (result.scanned == 0)
            {
                NotificationService.ShowInfo("No disabled scope files found.");
            }
            else
            {
                NotificationService.ShowWarning($"No files restored. Skipped: {result.skipped}, Failed: {result.failed}.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Scope restore failed: {ex.Message}");
        }
        finally
        {
            isScopeBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OpenGameSettingsFolder()
    {
        if (string.IsNullOrEmpty(gameUserSettingsPath))
        {
            NotificationService.ShowWarning("Config path not available.");
            return;
        }

        OpenFolder(Path.GetDirectoryName(gameUserSettingsPath));
    }

    private void OpenScopeFolder()
    {
        if (string.IsNullOrEmpty(scopeRootPath))
        {
            NotificationService.ShowWarning("Scope root path not available.");
            return;
        }

        OpenFolder(scopeRootPath);
    }

    private void OpenFolder(string? path)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(path) || !Directory.Exists(path))
            {
                NotificationService.ShowError("Folder does not exist.");
                return;
            }

            Process.Start(new ProcessStartInfo
            {
                FileName = "explorer.exe",
                Arguments = $"\"{path}\"",
                UseShellExecute = true
            });

            ActivityService.AddActivity($"Opened folder: {path}", "info");
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Failed to open folder: {ex.Message}");
        }
    }

    private static (int active, int disabled) CountScopeFiles(string rootPath)
    {
        var activeCount = EnumerateActiveScopeFiles(rootPath).Count();
        var disabledCount = EnumerateDisabledScopeFiles(rootPath).Count();
        return (activeCount, disabledCount);
    }

    private static IEnumerable<string> EnumerateActiveScopeFiles(string rootPath)
    {
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var pattern in ScopeFilePatterns)
        {
            IEnumerable<string> files;
            try
            {
                files = Directory.EnumerateFiles(rootPath, pattern, SearchOption.AllDirectories);
            }
            catch
            {
                continue;
            }

            foreach (var filePath in files)
            {
                if (filePath.EndsWith(ScopeDisabledSuffix, StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                if (seen.Add(filePath))
                {
                    yield return filePath;
                }
            }
        }
    }

    private static IEnumerable<string> EnumerateDisabledScopeFiles(string rootPath)
    {
        IEnumerable<string> files;
        try
        {
            files = Directory.EnumerateFiles(rootPath, $"*{ScopeDisabledSuffix}", SearchOption.AllDirectories);
        }
        catch
        {
            yield break;
        }

        foreach (var filePath in files)
        {
            var fileName = Path.GetFileName(filePath);
            if (fileName.Contains("scope", StringComparison.OrdinalIgnoreCase))
            {
                yield return filePath;
            }
        }
    }

    private bool ScopeHasDisabledFiles()
    {
        return scopeDisabledFileCount.HasValue && scopeDisabledFileCount.Value > 0;
    }

    private string GetConfigPathDisplay()
    {
        return string.IsNullOrEmpty(gameUserSettingsPath) ? DefaultGameSettingsPath : gameUserSettingsPath;
    }

    private string GetScopeRootDisplay()
    {
        return string.IsNullOrEmpty(scopeRootPath) ? DefaultScopeRootPath : scopeRootPath;
    }
}

