@page "/ini-builder"
@using System.IO
@using Microsoft.Extensions.Logging
@using Microsoft.Maui.Storage
@using RazorReaper.Services
@using RazorReaper.Services.Implementations
@using RazorReaper.Services.Localization

@inject IGameIniService GameIni
@inject INotificationService NotificationService
@inject IActivityService ActivityService
@inject ILocalizer Localizer
@inject ILogger<IniBuilder> Logger
@inject IJSRuntime JSRuntime


        <header class="page-header">
            <h1 class="page-title">@Localizer.T("inibuilder.title")</h1>
            <p class="page-subtitle">@Localizer.T("inibuilder.subtitle")</p>
        </header>

        <div class="inib-page">

            @* ============================================================
               STATUS — install detection + ARK-running warning
               ============================================================ *@
            <section class="content-card inib-status-card">
                <StatusHeader State="@StatusState" Label="@StatusLabel" Description="@StatusDescription">
                    <Actions>
                        <button class="btn btn-secondary inib-small-btn" @onclick="RefreshStatus">@Localizer.T("inibuilder.recheck")</button>
                    </Actions>
                </StatusHeader>
            </section>

            @* ============================================================
               PRESETS — one-click curated GameUserSettings presets
               ============================================================ *@
            <section class="content-card">
                <h3>@Localizer.T("inibuilder.presets.title")</h3>
                <p class="inib-card-intro">@Localizer.T("inibuilder.presets.intro")</p>

                <div class="inib-preset-grid">
                    @foreach (var preset in presets)
                    {
                        var isLastApplied = !string.IsNullOrEmpty(lastAppliedPreset) &&
                                            string.Equals(lastAppliedPreset, preset.Name, StringComparison.OrdinalIgnoreCase);
                        <div class="inib-preset-card @(isLastApplied ? "active" : "")" @key="preset.Name">
                            <div class="inib-preset-head">
                                <span class="inib-preset-name">@Localizer.T(preset.NameKey)</span>
                                <span class="inib-chip">@Localizer.T("inibuilder.preset.keys", preset.Entries.Count)</span>
                            </div>
                            <p class="inib-preset-desc">@Localizer.T(preset.DescriptionKey)</p>
                            <div class="inib-preset-foot">
                                @if (isLastApplied)
                                {
                                    <span class="inib-badge">
                                        <svg fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                        </svg>
                                        @LastAppliedLabel
                                    </span>
                                }
                                <button class="btn btn-primary inib-apply-btn"
                                        disabled="@isApplying"
                                        @onclick="() => ApplyPresetAsync(preset)">
                                    @Localizer.T("inibuilder.apply")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </section>

            @* ============================================================
               CUSTOM EDITOR — (section, key, value) rows with a persisted draft
               ============================================================ *@
            <section class="content-card">
                <h3>@Localizer.T("inibuilder.custom.title")</h3>
                <p class="inib-card-intro">@Localizer.T("inibuilder.custom.intro")</p>

                <SettingRow Title="@Localizer.T("inibuilder.target.title")"
                            Description="@Localizer.T("inibuilder.target.description")">
                    <div class="inib-seg">
                        <button type="button"
                                class="inib-seg-btn @(currentTarget == GameIniTarget.GameUserSettings ? "is-active" : "")"
                                @onclick="() => SetTargetAsync(GameIniTarget.GameUserSettings)">
                            GameUserSettings.ini
                        </button>
                        <button type="button"
                                class="inib-seg-btn @(currentTarget == GameIniTarget.Game ? "is-active" : "")"
                                @onclick="() => SetTargetAsync(GameIniTarget.Game)">
                            Game.ini
                        </button>
                    </div>
                </SettingRow>

                @if (currentTarget == GameIniTarget.Game && !gameIniExists)
                {
                    <p class="inib-note">@Localizer.T("inibuilder.gameini.note")</p>
                }

                <div class="inib-rows">
                    <div class="inib-row inib-row-head">
                        <span>@Localizer.T("inibuilder.column.section")</span>
                        <span>@Localizer.T("inibuilder.column.key")</span>
                        <span>@Localizer.T("inibuilder.column.value")</span>
                        <span></span>
                    </div>
                    @foreach (var row in draftRows)
                    {
                        <div class="inib-row" @key="row">
                            <input class="inib-input" placeholder="@Localizer.T("inibuilder.placeholder.section")"
                                   @bind="row.Section" @bind:after="SaveDraftAsync" />
                            <input class="inib-input" placeholder="@Localizer.T("inibuilder.placeholder.key")"
                                   @bind="row.Key" @bind:after="SaveDraftAsync" />
                            <input class="inib-input" placeholder="@Localizer.T("inibuilder.column.value")"
                                   @bind="row.Value" @bind:after="SaveDraftAsync" />
                            <button type="button" class="inib-row-remove" title="@Localizer.T("inibuilder.row.remove")"
                                    @onclick="() => RemoveRowAsync(row)">
                                <svg fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                                </svg>
                            </button>
                        </div>
                    }
                </div>

                <div class="inib-editor-actions">
                    <button class="btn btn-secondary" @onclick="AddRowAsync">@Localizer.T("inibuilder.addrow")</button>
                    <button class="btn btn-primary"
                            disabled="@(isApplying || !HasValidRows)"
                            @onclick="ApplyCustomAsync">
                        @Localizer.T("inibuilder.applyto", TargetFileLabel)
                    </button>
                </div>

                <p class="inib-note">@Localizer.T("inibuilder.draftnote")</p>
            </section>

            @* ============================================================
               BACKUPS — restore or delete stored snapshots
               ============================================================ *@
            <section class="content-card">
                <h3>@Localizer.T("inibuilder.backups.title")</h3>
                <p class="inib-card-intro">@Localizer.T("inibuilder.backups.intro", MaxBackupsShownNote)</p>

                @if (backups.Count == 0)
                {
                    <p class="inib-empty">@Localizer.T("inibuilder.backups.empty")</p>
                }
                else
                {
                    <div class="inib-backup-list">
                        @foreach (var backup in backups)
                        {
                            <div class="inib-backup-row" @key="backup.FullPath">
                                <div class="inib-backup-info">
                                    <span class="inib-backup-name">@backup.FileName</span>
                                    <span class="inib-backup-meta">@backup.TargetFileName &middot; @backup.Timestamp.ToString("yyyy-MM-dd HH:mm:ss") &middot; @FormatSize(backup.SizeBytes)</span>
                                </div>
                                <div class="inib-backup-actions">
                                    <button class="btn btn-secondary inib-small-btn"
                                            disabled="@isApplying"
                                            @onclick="() => RestoreBackupAsync(backup)">
                                        @Localizer.T("inibuilder.restore")
                                    </button>
                                    <button class="btn btn-danger inib-small-btn"
                                            disabled="@isApplying"
                                            @onclick="() => DeleteBackupAsync(backup)">
                                        @Localizer.T("common.delete")
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

        </div>

@code {
    [CascadingParameter(Name = "Language")]
    private string? Language { get; set; }

    private const string LastPresetKey = "inibuilder.lastpreset";
    private const string LastPresetTimeKey = "inibuilder.lastpreset.time";
    private const string MaxBackupsShownNote = "20";

    private IReadOnlyList<GameIniPreset> presets = Array.Empty<GameIniPreset>();
    private List<GameIniBackup> backups = new();
    private List<GameIniEntry> draftRows = new();
    private GameIniTarget currentTarget = GameIniTarget.GameUserSettings;
    private string lastAppliedPreset = "";
    private string lastAppliedAt = "";
    private bool arkFound = true;
    private bool arkRunning;
    private bool gameIniExists;
    private string configFolder = "";
    private bool isApplying;

    private string ProductionStatusState => !arkFound ? "error" : arkRunning ? "warning" : "online";

    private string ProductionStatusLabel => Localizer.T(!arkFound
        ? "inibuilder.status.noark"
        : arkRunning
            ? "inibuilder.status.running"
            : "inibuilder.status.ready");

    private string ProductionStatusDescription => !arkFound
        ? Localizer.T("inibuilder.status.noark.description")
        : arkRunning
            ? Localizer.T("inibuilder.status.running.description")
            : Localizer.T("inibuilder.status.ready.description", configFolder);

    private string StatusState => ProductionStatusState;
    private string StatusLabel => ProductionStatusLabel;
    private string StatusDescription => ProductionStatusDescription;

    private string LastAppliedLabel => string.IsNullOrEmpty(lastAppliedAt)
        ? Localizer.T("inibuilder.lastapplied")
        : Localizer.T("inibuilder.lastapplied.at", lastAppliedAt);

    private string TargetFileLabel => currentTarget == GameIniTarget.Game ? "Game.ini" : "GameUserSettings.ini";

    private bool HasValidRows => draftRows.Any(r =>
        !string.IsNullOrWhiteSpace(r.Section) && !string.IsNullOrWhiteSpace(r.Key));

    protected override async Task OnInitializedAsync()
    {
        presets = GameIni.GetBuiltInPresets();
        lastAppliedPreset = Preferences.Get(LastPresetKey, string.Empty);
        lastAppliedAt = Preferences.Get(LastPresetTimeKey, string.Empty);
        RefreshStatus();
        await LoadDraftAsync();
        await RefreshBackupsAsync();
    }

    private void RefreshStatus()
    {
        try
        {
            var path = GameIni.GetIniPath(GameIniTarget.GameUserSettings);
            arkFound = path != null;
            configFolder = path == null ? "" : (Path.GetDirectoryName(path) ?? "");
            arkRunning = GameIni.IsArkRunning();
            gameIniExists = GameIni.IniFileExists(GameIniTarget.Game);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing INI Builder status");
        }
    }

    private async Task LoadDraftAsync()
    {
        try
        {
            var draft = await GameIni.LoadDraftAsync();
            if (draft != null)
            {
                draftRows = draft.Rows ?? new List<GameIniEntry>();
                currentTarget = string.Equals(draft.Target, "Game", StringComparison.OrdinalIgnoreCase)
                    ? GameIniTarget.Game
                    : GameIniTarget.GameUserSettings;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading INI Builder draft");
        }

        if (draftRows.Count == 0)
        {
            draftRows.Add(new GameIniEntry());
        }
    }

    private async Task SaveDraftAsync()
    {
        try
        {
            var draft = new GameIniDraft
            {
                Target = currentTarget == GameIniTarget.Game ? "Game" : "GameUserSettings",
                Rows = draftRows
            };
            await GameIni.SaveDraftAsync(draft);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to save INI Builder draft");
        }
    }

    private async Task SetTargetAsync(GameIniTarget target)
    {
        if (currentTarget == target)
        {
            return;
        }

        currentTarget = target;
        RefreshStatus();
        await SaveDraftAsync();
    }

    private async Task AddRowAsync()
    {
        draftRows.Add(new GameIniEntry());
        await SaveDraftAsync();
    }

    private async Task RemoveRowAsync(GameIniEntry row)
    {
        draftRows.Remove(row);
        if (draftRows.Count == 0)
        {
            draftRows.Add(new GameIniEntry());
        }

        await SaveDraftAsync();
    }

    private async Task RefreshBackupsAsync()
    {
        try
        {
            backups = await Task.Run(() => GameIni.ListBackups());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading INI backups");
        }
    }

    private bool BlockWhenNotReady()
    {
        RefreshStatus();

        if (!arkFound)
        {
            NotificationService.ShowError(Localizer.T("inibuilder.toast.noark"));
            return true;
        }

        if (arkRunning)
        {
            NotificationService.ShowWarning(Localizer.T("inibuilder.toast.arkrunning"));
            return true;
        }

        return false;
    }

    private async Task ApplyPresetAsync(GameIniPreset preset)
    {
        if (isApplying || BlockWhenNotReady())
        {
            return;
        }

        isApplying = true;
        try
        {
            var result = await GameIni.ApplyPresetAsync(preset);
            if (result.Success)
            {
                lastAppliedPreset = preset.Name;
                lastAppliedAt = DateTime.Now.ToString("yyyy-MM-dd HH:mm");
                Preferences.Set(LastPresetKey, lastAppliedPreset);
                Preferences.Set(LastPresetTimeKey, lastAppliedAt);

                NotificationService.ShowSuccess(Localizer.T(
                    "inibuilder.toast.presetapplied", Localizer.T(preset.NameKey), result.KeysApplied));
                ActivityService.AddActivity(
                    Localizer.T("inibuilder.activity.presetapplied", Localizer.T(preset.NameKey)), "success");
                await RefreshBackupsAsync();
            }
            else
            {
                NotificationService.ShowError(result.Error ?? Localizer.T("inibuilder.toast.presetfailed"));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error applying INI Builder preset {Preset}", preset.Name);
            NotificationService.ShowError(Localizer.T("inibuilder.toast.applyfailed", ex.Message));
        }
        finally
        {
            isApplying = false;
        }
    }

    private async Task ApplyCustomAsync()
    {
        if (isApplying || BlockWhenNotReady())
        {
            return;
        }

        if (!HasValidRows)
        {
            NotificationService.ShowWarning(Localizer.T("inibuilder.toast.norows"));
            return;
        }

        isApplying = true;
        try
        {
            await SaveDraftAsync();

            var result = await GameIni.ApplyEntriesAsync(currentTarget, draftRows);
            if (result.Success)
            {
                NotificationService.ShowSuccess(
                    Localizer.T("inibuilder.toast.customapplied", result.KeysApplied, TargetFileLabel));
                ActivityService.AddActivity(
                    Localizer.T("inibuilder.activity.customapplied", TargetFileLabel, result.KeysApplied), "success");
                RefreshStatus();
                await RefreshBackupsAsync();
            }
            else
            {
                NotificationService.ShowError(result.Error ?? Localizer.T("inibuilder.toast.customfailed"));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error applying INI Builder custom keys");
            NotificationService.ShowError(Localizer.T("inibuilder.toast.applyfailed", ex.Message));
        }
        finally
        {
            isApplying = false;
        }
    }

    private async Task RestoreBackupAsync(GameIniBackup backup)
    {
        if (isApplying || BlockWhenNotReady())
        {
            return;
        }

        var confirm = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            Localizer.T("inibuilder.confirm.restore", backup.FileName, backup.TargetFileName));
        if (!confirm)
        {
            return;
        }

        isApplying = true;
        try
        {
            var result = await GameIni.RestoreBackupAsync(backup);
            if (result.Success)
            {
                NotificationService.ShowSuccess(Localizer.T("inibuilder.toast.restored", backup.TargetFileName));
                ActivityService.AddActivity(Localizer.T("inibuilder.activity.restored", backup.FileName), "success");
                RefreshStatus();
                await RefreshBackupsAsync();
            }
            else
            {
                NotificationService.ShowError(result.Error ?? Localizer.T("inibuilder.toast.restorefailed"));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error restoring INI backup {Backup}", backup.FileName);
            NotificationService.ShowError(Localizer.T("inibuilder.toast.restoreerror", ex.Message));
        }
        finally
        {
            isApplying = false;
        }
    }

    private async Task DeleteBackupAsync(GameIniBackup backup)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            Localizer.T("inibuilder.confirm.delete", backup.FileName));
        if (!confirm)
        {
            return;
        }

        try
        {
            var deleted = GameIni.DeleteBackup(backup);
            if (deleted)
            {
                NotificationService.ShowSuccess(Localizer.T("inibuilder.toast.backupdeleted"));
                ActivityService.AddActivity(Localizer.T("inibuilder.activity.backupdeleted", backup.FileName), "warning");
                await RefreshBackupsAsync();
            }
            else
            {
                NotificationService.ShowWarning(Localizer.T("inibuilder.toast.backupdeletefailed"));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting INI backup {Backup}", backup.FileName);
            NotificationService.ShowError(Localizer.T("inibuilder.toast.deleteerror", ex.Message));
        }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024.0:F1} KB";
        }

        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }
}
