@page "/feedback"
@using RazorReaper.Services
@inject IFeedbackService FeedbackService
@inject INotificationService NotificationService

<header class="page-header">
    <h1 class="page-title">Feedback & Support</h1>
    <p class="page-subtitle">Share an idea or an opinion, or report a problem with a system snapshot attached.</p>
    <a href="/inbox" class="btn btn-secondary">Open support inbox</a>
</header>

@* Two sections on one page, not two routes: the form is the same shape on both sides and
   only what it sends differs (kind "feedback" without diagnostics, kind "support" with the
   snapshot). /feedback?section=support opens the Support side directly — that is where
   SendDiagnosticsButton links to. Switching is an instant re-render, no animation. *@
<div class="feedback-tabs" role="tablist" aria-label="Feedback or support">
    <button type="button"
            role="tab"
            id="feedback-tab-feedback"
            class="feedback-tab @(IsSupport ? "" : "active")"
            aria-selected="@(IsSupport ? "false" : "true")"
            aria-controls="feedback-panel"
            @onclick="ShowFeedback">
        Feedback
    </button>
    <button type="button"
            role="tab"
            id="feedback-tab-support"
            class="feedback-tab @(IsSupport ? "active" : "")"
            aria-selected="@(IsSupport ? "true" : "false")"
            aria-controls="feedback-panel"
            @onclick="ShowSupport">
        Support
    </button>
</div>

<div id="feedback-panel" class="feedback-layout" role="tabpanel" aria-labelledby="@(IsSupport ? "feedback-tab-support" : "feedback-tab-feedback")">
<div class="content-card feedback-card">
    <div class="feedback-field">
        <label class="feedback-label" for="feedback-message">@(IsSupport ? "What went wrong? (required)" : "Your feedback (required)")</label>
        <textarea id="feedback-message"
                  class="feedback-textarea"
                  placeholder="@MessagePlaceholder"
                  maxlength="4000"
                  rows="7"
                  required
                  @bind="_message"
                  @bind:event="oninput"
                  disabled="@_submitting"></textarea>
        <div class="feedback-counter">@_message.Length / 4000</div>
    </div>

    <div class="feedback-field">
        <label class="feedback-label" for="feedback-contact">Contact (optional)</label>
        <input id="feedback-contact"
               class="feedback-input"
               type="text"
               placeholder="Discord or email — an additional way to reach you"
               maxlength="256"
               @bind="_contact"
               @bind:event="oninput"
               disabled="@_submitting" />
    </div>

    @if (IsSupport)
    {
        <p class="feedback-attach-note">A system and feature snapshot is attached when you send your report.</p>
    }

    <div class="feedback-actions">
        <button class="btn btn-primary" @onclick="Submit" disabled="@(_submitting || string.IsNullOrWhiteSpace(_message))">
            @if (_submitting)
            {
                <span class="feedback-spinner"></span>
                <span>Sending…</span>
            }
            else
            {
                <span>@(IsSupport ? "Send Report" : "Send Feedback")</span>
            }
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_reportId))
    {
        <div class="feedback-report-id" role="status">Report ID: @_reportId</div>
    }
</div>

@* The note used to sit under the form as a grey paragraph; as a panel it fills the
   right-hand half the form was leaving empty and reads as an answer to "what are you
   sending about me?" rather than fine print. *@
<aside class="content-card feedback-side">
    @if (IsSupport)
    {
        <h3 class="feedback-side-title">Attached automatically</h3>
        <ul class="feedback-side-list">
            <li>Machine name</li>
            <li>Install and hardware IDs</li>
            <li>License key and status</li>
            <li>App and Windows versions</li>
            <li>ARK and feature prerequisites</li>
            <li>Safe settings and recent operation outcomes</li>
        </ul>
        <p class="feedback-note">
            Sending your report attaches a read-only snapshot automatically so support can
            reproduce the issue. It never includes screenshots, clipboard text, server passwords,
            command text, raw file paths, IP addresses, or log contents.
        </p>
    }
    else
    {
        <h3 class="feedback-side-title">Good to know</h3>
        <ul class="feedback-side-list">
            <li>Ideas, opinions and feature requests all belong here</li>
            <li>Only your message, contact and app identity are sent</li>
            <li>Something broken? Use the Support section instead</li>
        </ul>
        <p class="feedback-note">
            Feedback is sent without a diagnostic snapshot. If you are reporting a problem,
            switch to Support so the system and feature details travel with it.
        </p>
    }
    <p class="feedback-note">
        Answers appear privately in your Inbox. The number beside Inbox shows unread replies;
        you don't need to leave a contact to receive an answer here.
    </p>
</aside>
</div>

@code {
    private const string SupportSectionKey = "support";

    private string _message = string.Empty;
    private string _contact = string.Empty;
    private bool _submitting = false;
    private string? _reportId;
    private bool _isSupport;
    private string? _appliedSection;

    [Parameter]
    [SupplyParameterFromQuery(Name = "source")]
    public string? Source { get; set; }

    /// <summary>"support" opens the Support section; anything else, or nothing, is Feedback.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "section")]
    public string? Section { get; set; }

    private bool IsSupport => _isSupport;

    private string MessagePlaceholder => IsSupport
        ? "Describe what happened, what you expected, and the steps that led there..."
        : "Share an idea, an opinion, or anything you'd like to see next...";

    protected override void OnParametersSet()
    {
        // Only a *changed* query value moves the section, so a deep link lands where it points
        // while a tab picked by hand survives unrelated parameter updates.
        if (string.Equals(Section, _appliedSection, StringComparison.Ordinal))
        {
            return;
        }

        _appliedSection = Section;
        SelectSection(string.Equals(Section, SupportSectionKey, StringComparison.OrdinalIgnoreCase));
    }

    private void ShowFeedback() => SelectSection(support: false);

    private void ShowSupport() => SelectSection(support: true);

    private void SelectSection(bool support)
    {
        if (_isSupport == support)
        {
            return;
        }

        _isSupport = support;
        // The id belongs to whatever the other section sent; it must not read as this one's.
        _reportId = null;
    }

    private async Task Submit()
    {
        if (_submitting || string.IsNullOrWhiteSpace(_message))
        {
            return;
        }

        _submitting = true;
        _reportId = null;
        StateHasChanged();

        // Support carries the snapshot and refuses to send without it; Feedback sends
        // the message and identity only.
        var result = IsSupport
            ? await FeedbackService.SubmitDiagnosticsAsync(_message, _contact, Source ?? "feedback")
            : await FeedbackService.SubmitAsync(_message, _contact);

        _submitting = false;

        if (result.Success)
        {
            _reportId = result.ReportId;
            NotificationService.ShowSuccess(result.ReportId is null
                ? result.Message
                : $"{result.Message} Report ID: {result.ReportId}");
            _message = string.Empty;
            _contact = string.Empty;
        }
        else
        {
            NotificationService.ShowError(result.Message);
        }

        StateHasChanged();
    }
}
