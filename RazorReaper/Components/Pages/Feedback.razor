@page "/feedback"
@using RazorReaper.Services
@using RazorReaper.Services.Localization
@inject IFeedbackService FeedbackService
@inject INotificationService NotificationService
@inject NavigationManager Navigation
@inject ILocalizer Localizer
@implements IDisposable

<header class="page-header">
    <h1 class="page-title">@Localizer.T("feedback.title")</h1>
    <p class="page-subtitle">@Localizer.T("feedback.subtitle")</p>
</header>

@* Two sections on one page, not two routes: the form is the same shape on both sides and
   only what it sends differs (kind "feedback" without diagnostics, kind "support" with the
   snapshot). /feedback?section=support opens the Support side directly — that is where
   SendDiagnosticsButton links to. Switching is an instant re-render, no animation. *@
<div class="feedback-tabs" role="tablist" aria-label="@Localizer.T("feedback.tabs.aria")">
    <button type="button"
            role="tab"
            id="feedback-tab-feedback"
            class="feedback-tab @(IsSupport ? "" : "active")"
            aria-selected="@(IsSupport ? "false" : "true")"
            aria-controls="feedback-panel"
            @onclick="ShowFeedback">
        @Localizer.T("feedback.tab.feedback")
    </button>
    <button type="button"
            role="tab"
            id="feedback-tab-support"
            class="feedback-tab @(IsSupport ? "active" : "")"
            aria-selected="@(IsSupport ? "true" : "false")"
            aria-controls="feedback-panel"
            @onclick="ShowSupport">
        @Localizer.T("feedback.tab.support")
    </button>
</div>

<div id="feedback-panel" class="feedback-layout" role="tabpanel" aria-labelledby="@(IsSupport ? "feedback-tab-support" : "feedback-tab-feedback")">
<div class="content-card feedback-card">
    <div class="feedback-field">
        <label class="feedback-label" for="feedback-message">@(IsSupport ? Localizer.T("feedback.message.support") : Localizer.T("feedback.message.feedback"))</label>
        <textarea id="feedback-message"
                  class="feedback-textarea"
                  placeholder="@MessagePlaceholder"
                  maxlength="4000"
                  rows="7"
                  required
                  @bind="_message"
                  @bind:event="oninput"
                  disabled="@_submitting"></textarea>
        <div class="feedback-counter">@_message.Length / 4000</div>
    </div>

    <div class="feedback-field">
        <label class="feedback-label" for="feedback-contact">@Localizer.T("feedback.contact.label")</label>
        <input id="feedback-contact"
               class="feedback-input"
               type="text"
               placeholder="@Localizer.T("feedback.contact.placeholder")"
               maxlength="256"
               @bind="_contact"
               @bind:event="oninput"
               disabled="@_submitting" />
    </div>

    @if (IsSupport)
    {
        <p class="feedback-attach-note">@Localizer.T("feedback.attach.note")</p>
    }

    <div class="feedback-actions">
        <button class="btn btn-primary" @onclick="Submit" disabled="@(_submitting || string.IsNullOrWhiteSpace(_message))">
            @if (_submitting)
            {
                <span class="feedback-spinner"></span>
                <span>@Localizer.T("feedback.sending")</span>
            }
            else
            {
                <span>@(IsSupport ? Localizer.T("feedback.send.support") : Localizer.T("feedback.send.feedback"))</span>
            }
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_reportId))
    {
        <div class="feedback-report-id" role="status">@Localizer.T("feedback.reportid", _reportId)</div>
    }
</div>

@* The note used to sit under the form as a grey paragraph; as a panel it fills the
   right-hand half the form was leaving empty and reads as an answer to "what are you
   sending about me?" rather than fine print. *@
<aside class="content-card feedback-side">
    @if (IsSupport)
    {
        <h3 class="feedback-side-title">@Localizer.T("feedback.side.support.title")</h3>
        <ul class="feedback-side-list">
            <li>@Localizer.T("feedback.side.support.1")</li>
            <li>@Localizer.T("feedback.side.support.2")</li>
            <li>@Localizer.T("feedback.side.support.3")</li>
            <li>@Localizer.T("feedback.side.support.4")</li>
            <li>@Localizer.T("feedback.side.support.5")</li>
            <li>@Localizer.T("feedback.side.support.6")</li>
        </ul>
        <p class="feedback-note">@Localizer.T("feedback.side.support.note")</p>
    }
    else
    {
        <h3 class="feedback-side-title">@Localizer.T("feedback.side.feedback.title")</h3>
        <ul class="feedback-side-list">
            <li>@Localizer.T("feedback.side.feedback.1")</li>
            <li>@Localizer.T("feedback.side.feedback.2")</li>
            <li>@Localizer.T("feedback.side.feedback.3")</li>
        </ul>
        <p class="feedback-note">@Localizer.T("feedback.side.feedback.note")</p>
    }
    <p class="feedback-note">@Localizer.T("feedback.side.inbox.note")</p>
</aside>
</div>

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    private const string SupportSectionKey = "support";

    private string _message = string.Empty;
    private string _contact = string.Empty;
    private bool _submitting = false;
    private string? _reportId;
    private bool _isSupport;
    private string? _appliedSection;

    [Parameter]
    [SupplyParameterFromQuery(Name = "source")]
    public string? Source { get; set; }

    /// <summary>"support" opens the Support section; anything else, or nothing, is Feedback.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "section")]
    public string? Section { get; set; }

    private bool IsSupport => _isSupport;

    private string MessagePlaceholder => IsSupport
        ? Localizer.T("feedback.placeholder.support")
        : Localizer.T("feedback.placeholder.feedback");

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    protected override void OnParametersSet()
    {
        // Only a *changed* query value moves the section, so a deep link lands where it points
        // while a tab picked by hand survives unrelated parameter updates.
        if (string.Equals(Section, _appliedSection, StringComparison.Ordinal))
        {
            return;
        }

        _appliedSection = Section;
        ApplySection(Section);
    }

    /// <summary>
    /// The sidebar's "Feedback &amp; Support" entry is the bare /feedback. Arriving there with the
    /// Support tab picked by hand used to keep Support selected: the query's section was null,
    /// the last applied one was null too, so OnParametersSet saw nothing to do. Every navigation
    /// onto this page now applies the URL's section — none means Feedback — whichever tab was
    /// chosen before. Navigations to other pages are ignored; the page is disposed for those.
    /// </summary>
    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!IsThisPage(e.Location))
        {
            return;
        }

        this.DispatchRender(() => InvokeAsync(() =>
        {
            var section = SectionFromUri(e.Location);
            _appliedSection = section;
            ApplySection(section);
            StateHasChanged();
        }));
    }

    private void ApplySection(string? section)
        => SelectSection(string.Equals(section, SupportSectionKey, StringComparison.OrdinalIgnoreCase));

    private bool IsThisPage(string location)
    {
        var relative = Navigation.ToBaseRelativePath(location);
        var cut = relative.IndexOfAny(['?', '#']);
        var path = (cut < 0 ? relative : relative[..cut]).Trim('/');
        return string.Equals(path, "feedback", StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>The "section" query value of <paramref name="location"/>, or null when there is none.</summary>
    private static string? SectionFromUri(string location)
    {
        if (!Uri.TryCreate(location, UriKind.Absolute, out var uri))
        {
            return null;
        }

        foreach (var pair in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var separator = pair.IndexOf('=');
            var key = separator < 0 ? pair : pair[..separator];
            if (!string.Equals(Uri.UnescapeDataString(key), "section", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            return separator < 0 ? string.Empty : Uri.UnescapeDataString(pair[(separator + 1)..].Replace('+', ' '));
        }

        return null;
    }

    private void ShowFeedback() => SelectSection(support: false);

    private void ShowSupport() => SelectSection(support: true);

    private void SelectSection(bool support)
    {
        if (_isSupport == support)
        {
            return;
        }

        _isSupport = support;
        // The id belongs to whatever the other section sent; it must not read as this one's.
        _reportId = null;
    }

    private async Task Submit()
    {
        if (_submitting || string.IsNullOrWhiteSpace(_message))
        {
            return;
        }

        _submitting = true;
        _reportId = null;
        StateHasChanged();

        // Support carries the snapshot and refuses to send without it; Feedback sends
        // the message and identity only.
        var result = IsSupport
            ? await FeedbackService.SubmitDiagnosticsAsync(_message, _contact, Source ?? "feedback")
            : await FeedbackService.SubmitAsync(_message, _contact);

        _submitting = false;

        if (result.Success)
        {
            _reportId = result.ReportId;
            NotificationService.ShowSuccess(result.ReportId is null
                ? result.Message
                : $"{result.Message} {Localizer.T("feedback.reportid", result.ReportId)}");
            _message = string.Empty;
            _contact = string.Empty;
        }
        else
        {
            NotificationService.ShowError(result.Message);
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        this.StopRenderDispatch();
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
