@page "/feedback"
@using RazorReaper.Services
@inject IFeedbackService FeedbackService
@inject INotificationService NotificationService

<header class="page-header">
    <h1 class="page-title">Feedback</h1>
    <p class="page-subtitle">Tell us what's working, what's broken, or what you'd like to see next.</p>
</header>

<div class="feedback-layout">
<div class="content-card feedback-card">
    <div class="feedback-field feedback-field-grow">
        <label class="feedback-label" for="feedback-message">Your feedback</label>
        <textarea id="feedback-message"
                  class="feedback-textarea"
                  placeholder="Share a bug, an idea, or anything on your mind..."
                  maxlength="4000"
                  rows="7"
                  @bind="_message"
                  @bind:event="oninput"
                  disabled="@_submitting"></textarea>
        <div class="feedback-counter">@_message.Length / 4000</div>
    </div>

    <div class="feedback-field">
        <label class="feedback-label" for="feedback-contact">Contact (optional)</label>
        <input id="feedback-contact"
               class="feedback-input"
               type="text"
               placeholder="Discord or email — if you'd like a reply"
               maxlength="256"
               @bind="_contact"
               @bind:event="oninput"
               disabled="@_submitting" />
    </div>

    <div class="feedback-actions">
        <button class="btn btn-primary" @onclick="Submit" disabled="@(_submitting || string.IsNullOrWhiteSpace(_message))">
            @if (_submitting)
            {
                <span class="feedback-spinner"></span>
                <span>Sending...</span>
            }
            else
            {
                <span>Send Feedback</span>
            }
        </button>
    </div>
</div>

@* The note used to sit under the form as a grey paragraph; as a panel it fills the
   right-hand half the form was leaving empty and reads as an answer to "what are you
   sending about me?" rather than fine print. *@
<aside class="content-card feedback-side">
    <h3 class="feedback-side-title">Attached automatically</h3>
    <ul class="feedback-side-list">
        <li>Machine name</li>
        <li>Hardware ID</li>
        <li>License status</li>
        <li>App version</li>
    </ul>
    <p class="feedback-note">
        Sent with your message so we can reproduce the issue and reply on the right account.
        Nothing else leaves the app.
    </p>
    <p class="feedback-note">
        Leave a contact if you want an answer — reports without one are still read, we just
        can't follow up.
    </p>
</aside>
</div>

@code {
    private string _message = string.Empty;
    private string _contact = string.Empty;
    private bool _submitting = false;

    private async Task Submit()
    {
        if (_submitting || string.IsNullOrWhiteSpace(_message))
        {
            return;
        }

        _submitting = true;
        StateHasChanged();

        var result = await FeedbackService.SubmitAsync(_message, _contact);

        _submitting = false;

        if (result.Success)
        {
            NotificationService.ShowSuccess(result.Message);
            _message = string.Empty;
            _contact = string.Empty;
        }
        else
        {
            NotificationService.ShowError(result.Message);
        }

        StateHasChanged();
    }
}

<style>
    /* Was a 640px card in a 1126px column — a bit over half the page, with the rest
       dead space. Two columns fill it, and the form still keeps a comfortable measure. */
    .feedback-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.9fr) minmax(220px, 1fr);
        gap: 1rem;
        align-items: start;
    }

    @@media (max-width: 940px) {
        .feedback-layout {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    .feedback-card,
    .feedback-side {
        margin-bottom: 0 !important;
    }

    .feedback-field {
        margin-bottom: 14px;
    }

    .feedback-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 8px;
    }

    .feedback-textarea,
    .feedback-input {
        width: 100%;
        background: var(--background-dark);
        border: 1px solid var(--border-hover);
        border-radius: 8px;
        padding: 12px 14px;
        color: var(--text-primary);
        font-size: 0.95rem;
        font-family: inherit;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
        box-sizing: border-box;
    }

    .feedback-textarea {
        resize: vertical;
        /* Grows into the space the page now has instead of leaving it blank below. */
        min-height: min(320px, calc(100vh - 420px));
        line-height: 1.55;
    }

    .feedback-textarea:focus,
    .feedback-input:focus {
        outline: none;
        border-color: var(--accent-purple);
        box-shadow: 0 0 0 3px rgba(var(--accent-purple-rgb), 0.2);
    }

    .feedback-counter {
        margin-top: 6px;
        text-align: right;
        font-size: 0.75rem;
        color: var(--text-secondary);
    }

    .feedback-side-title {
        margin: 0 0 0.7rem !important;
        font-size: 0.95rem !important;
    }

    .feedback-side-list {
        list-style: none;
        margin: 0 0 0.9rem;
        padding: 0;
        display: grid;
        gap: 0.3rem;
    }

    .feedback-side-list li {
        font-size: 0.82rem;
        color: var(--text-primary);
        padding: 0.35rem 0.6rem;
        border-radius: var(--radius-control);
        background: rgba(0, 0, 0, 0.22);
        border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .feedback-note {
        font-size: 0.78rem;
        color: var(--text-secondary);
        line-height: 1.5;
        margin: 0 0 0.7rem;
    }

    .feedback-note:last-child {
        margin-bottom: 0;
    }

    .feedback-actions {
        display: flex;
        justify-content: flex-end;
    }

    .feedback-spinner {
        width: 15px;
        height: 15px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        border-top-color: var(--text-primary);
        animation: feedback-spin 1s ease-in-out infinite;
    }

    @@keyframes feedback-spin {
        to { transform: rotate(360deg); }
    }
</style>
