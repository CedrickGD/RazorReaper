        public bool IsOnline { get; set; }
        public int CurrentPlayers { get; set; }
        public int MaxPlayers { get; set; } = 70;
        public string CurrentMap { get; set; } = "Unknown";
        public string Version { get; set; } = "Unknown";
    }
