@page "/server"
@using System.Net
@using System.Net.NetworkInformation
@using System.Net.Sockets
@using System.Text.Json
@using Microsoft.Win32
@using Microsoft.Extensions.Logging
@using RazorReaper.Services
@using RazorReaper.Services.ServerQuery
@using RazorReaper.Services.Steam
@inject IJSRuntime JSRuntime
@inject INotificationService NotificationService
@inject ILogger<Server> Logger
@inject IActivityService ActivityService
@inject ISteamFavoritesService SteamFavoritesService
@inject IServerQueryService ServerQuery
@implements IDisposable
@using RazorReaper.Services.Localization
@inject ILocalizer Localizer


        <header class="page-header">
            <h1 class="page-title">@Localizer.T("server.title")</h1>
            <p class="page-subtitle">@Localizer.T("nav.page.server.description")</p>
        </header>

        <div class="server-layout">
            <div class="content-card server-connection-panel">
                <h3>@Localizer.T("server.connection.title")</h3>

                <div class="connection-form">
                    <div>
                        <label class="input-label">@Localizer.T("server.field.ip")</label>
                        <input @bind="ServerInput"
                               @bind:event="oninput"
                               @onkeypress="@(async (e) => { if (e.Key == "Enter") await QueryServer(); })"
                               placeholder="141.98.157.224:27015"
                               class="server-input" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(serverInput))
                    {
                        <div>
                            <label class="input-label">@Localizer.T("server.field.steamurl")</label>
                            <div class="url-input-group">
                                <input value="@GetSteamUrl()" readonly class="server-input readonly" />
                                <button class="server-btn copy-btn" @onclick="CopySteamUrl"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg></button>
                            </div>
                        </div>
                    }

                    <div class="button-grid">
                        <button class="server-btn query" @onclick="QueryServer" disabled="@isQuerying">
                            @if (isQuerying)
                            {
                                <div class="server-spinner"></div>
                                <span>@Localizer.T("server.query")</span>
                            }
                            else
                            {
                                <span>@Localizer.T("server.query")</span>
                            }
                        </button>

                        <button class="server-btn connect" @onclick="ConnectToServer" disabled="@IsServerNull()">
                            @Localizer.T("server.connect")
                        </button>
                    </div>

                    <div class="button-grid">
                        <button class="server-btn save" @onclick="SaveServer" disabled="@IsServerNull()">
                            @Localizer.T("common.save")
                        </button>

                        <button class="server-btn favorite" @onclick="AddToSteamFavorites" disabled="@IsServerNull()">
                            @Localizer.T("server.addtosteam")
                        </button>
                    </div>

                    <button class="server-btn browser" @onclick="OpenSteamBrowser">
                        @Localizer.T("server.steambrowser")
                    </button>
                </div>
            </div>

            <div class="main-column">
                @if (currentServer != null && currentServer.IsOnline)
                {
                    <div class="content-card">
                        <h4 style="color: var(--text-primary); margin-bottom: 1rem; font-size: 1.1rem; font-weight: 600;">@currentServer.Name</h4>
                        <div class="server-details-grid">
                            <div class="detail-column">
                                <div class="detail-row">
                                    <span class="detail-label">@Localizer.T("server.detail.status")</span>
                                    <span class="text-purple detail-value">@Localizer.T("server.status.online")</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">@Localizer.T("server.detail.address")</span>
                                    <span class="detail-value">@currentServer.IpAddress:@currentServer.Port</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">@Localizer.T("server.detail.players")</span>
                                    <span class="text-purple detail-value">@currentServer.CurrentPlayers/@currentServer.MaxPlayers</span>
                                </div>
                            </div>
                            <div class="detail-column">
                                <div class="detail-row">
                                    <span class="detail-label">@Localizer.T("server.detail.map")</span>
                                    <span class="detail-value">@OrUnknown(currentServer.CurrentMap)</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">@Localizer.T("server.detail.version")</span>
                                    <span class="detail-value">@OrUnknown(currentServer.Version)</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">@Localizer.T("server.detail.queryport")</span>
                                    <span class="detail-value">@currentServer.QueryPort</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (showServerInfo && selectedServer != null)
                {
                    <div class="content-card">
                        <div class="server-info-header">
                            <h3>@selectedServer.Name</h3>
                            <button class="server-btn close-btn" @onclick="HideServerInfo"><svg width="15" height="15" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg></button>
                        </div>

                        <div class="server-details-grid">
                            <div class="detail-column">
                                <div class="detail-row">
                                    <span class="text-secondary">@Localizer.T("server.detail.status")</span>
                                    <span class="@(selectedServer.IsOnline ? "text-purple" : "text-red")">
                                        @Localizer.T(selectedServer.IsOnline ? "server.status.online" : "server.status.offline")
                                    </span>
                                </div>
                                <div class="detail-row">
                                    <span class="text-secondary">@Localizer.T("server.detail.address")</span>
                                    <span class="text-white">@selectedServer.IpAddress:@selectedServer.Port</span>
                                </div>
                                <div class="detail-row">
                                    <span class="text-secondary">@Localizer.T("server.detail.players")</span>
                                    <span class="text-purple">@selectedServer.CurrentPlayers/@selectedServer.MaxPlayers</span>
                                </div>
                            </div>
                            <div class="detail-column">
                                <div class="detail-row">
                                    <span class="text-secondary">@Localizer.T("server.detail.map")</span>
                                    <span class="text-white">@OrUnknown(selectedServer.CurrentMap)</span>
                                </div>
                                <div class="detail-row">
                                    <span class="text-secondary">@Localizer.T("server.detail.version")</span>
                                    <span class="text-white">@OrUnknown(selectedServer.Version)</span>
                                </div>
                                <div class="detail-row">
                                    <span class="text-secondary">@Localizer.T("server.detail.query")</span>
                                    <span class="text-white">@selectedServer.QueryPort</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="content-card saved-servers-section">
                    <div class="section-header">
                        <h3>@Localizer.T("server.saved.title")</h3>
                        <span class="text-secondary">@Localizer.T("server.saved.count", servers.Count)</span>
                    </div>

                    <div class="servers-grid">
                        @if (servers.Any())
                        {
                            @foreach (var server in servers)
                            {
                                <div @key="@($"{server.IpAddress}:{server.Port}")" class="server-item @(selectedServer == server ? "selected" : "")" @onclick="() => SelectServer(server)">
                                    <div class="server-item-content">
                                        <div class="server-status-dot @(server.IsOnline ? "online" : "offline")"></div>
                                        <div class="server-item-info">
                                            <div class="text-white server-name">@server.Name</div>
                                            <div class="text-secondary server-address">@server.IpAddress:@server.Port</div>
                                            @if (server.IsOnline)
                                            {
                                                <div class="server-players">@Localizer.T("server.players", server.CurrentPlayers, server.MaxPlayers)</div>
                                            }
                                        </div>
                                        <div class="server-actions">
                                            <button class="server-action-btn" @onclick:stopPropagation="true" @onclick="() => SelectServer(server)">@Localizer.T("server.info")</button>
                                            <button class="server-action-btn remove" @onclick:stopPropagation="true" @onclick="() => RemoveServer(server)">@Localizer.T("common.remove")</button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-servers-state">
                                <div class="empty-icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text-secondary);"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg></div>
                                <div>@Localizer.T("server.empty.title")</div>
                                <div class="empty-subtitle">@Localizer.T("server.empty.text")</div>
                            </div>
                        }
                    </div>
                </div>

                <div class="content-card bulk-favorites-section">
                    <StatusHeader State="@BulkStatusState"
                                  Label="@Localizer.T("server.bulk.title")"
                                  Description="@BulkStatusDescription">
                        <Actions>
                            <button class="server-btn bulk-clear-btn"
                                    @onclick="ClearBulkInput"
                                    disabled="@(isBulkApplying || (string.IsNullOrEmpty(bulkInput) && bulkResults.Count == 0))">
                                @Localizer.T("common.clear")
                            </button>
                            <button class="server-btn favorite bulk-apply-btn"
                                    @onclick="ApplyBulkFavorites"
                                    disabled="@(!CanApplyBulk)">
                                @if (isBulkApplying)
                                {
                                    <div class="server-spinner"></div>
                                    <span>@Localizer.T("server.bulk.applying")</span>
                                }
                                else
                                {
                                    <span>@Localizer.T("server.bulk.apply")@(bulkParse.Valid.Count > 0 ? $" ({bulkParse.Valid.Count})" : "")</span>
                                }
                            </button>
                        </Actions>
                    </StatusHeader>

                    <p class="bulk-help-text">
                        @Localizer.T("server.bulk.help.lead")<span class="bulk-mono">IP:QUERYPORT</span>@Localizer.T("server.bulk.help.mid")<span class="bulk-mono">steam://connect/...</span>@Localizer.T("server.bulk.help.rest")
                    </p>

                    <textarea class="bulk-input"
                              rows="7"
                              placeholder="@Localizer.T("server.bulk.placeholder")"
                              @bind="bulkInput" @bind:event="oninput" @bind:after="OnBulkInputChanged"
                              disabled="@isBulkApplying"></textarea>

                    @if (bulkParse.HasInput)
                    {
                        <div class="bulk-preview">
                            <span class="bulk-count valid">@Localizer.T("server.bulk.valid", bulkParse.Valid.Count)</span>
                            <span class="bulk-count invalid @(bulkParse.Invalid.Count == 0 ? "none" : "")">@Localizer.T("server.bulk.invalid", bulkParse.Invalid.Count)</span>
                        </div>
                    }

                    @if (bulkParse.Invalid.Count > 0)
                    {
                        <div class="bulk-line-list">
                            @foreach (var invalidLine in bulkParse.Invalid.Take(MaxBulkListRows))
                            {
                                <div @key="@invalidLine.LineNumber" class="bulk-line-item">
                                    <span class="bulk-line-number">@Localizer.T("server.bulk.line", invalidLine.LineNumber)</span>
                                    <span class="bulk-line-raw">@TruncateLine(invalidLine.RawLine)</span>
                                    <span class="bulk-line-reason">@invalidLine.Reason</span>
                                </div>
                            }
                            @if (bulkParse.Invalid.Count > MaxBulkListRows)
                            {
                                <div class="bulk-line-more">@Localizer.T("server.bulk.more", bulkParse.Invalid.Count - MaxBulkListRows)</div>
                            }
                        </div>
                    }

                    @if (bulkResults.Count > 0)
                    {
                        <div class="bulk-results">
                            @foreach (var bulkResult in bulkResults)
                            {
                                <div class="bulk-result-item @bulkResult.Status">
                                    <span class="bulk-result-dot"></span>
                                    <span class="bulk-result-endpoint">@bulkResult.Endpoint</span>
                                    <span class="bulk-result-status">@Localizer.T(bulkResult.Status == "added" ? "server.bulk.status.added" : bulkResult.Status == "skipped" ? "server.bulk.status.skipped" : "server.bulk.status.failed")</span>
                                    <span class="bulk-result-detail">@bulkResult.Detail</span>
                                </div>
                            }
                        </div>
                    }

                    <div class="bulk-note">
                        @Localizer.T("server.bulk.note.ports")
                        @Localizer.T("server.bulk.note.steam")
                    </div>
                </div>

                <div class="content-card troubleshooting-section">
                    <div class="section-header">
                        <h3>@Localizer.T("server.troubleshooting.title")</h3>
                        <button class="toggle-btn" @onclick="ToggleTroubleshooting">
                            @Localizer.T(showTroubleshooting ? "server.troubleshooting.hide" : "server.troubleshooting.show")
                        </button>
                    </div>

                    @if (showTroubleshooting)
                    {
                        <div class="troubleshooting-grid">
                            <div class="troubleshooting-item">
                                <h4>@Localizer.T("server.trouble.connection")</h4>
                                <ul>
                                    <li>@Localizer.T("server.trouble.connection.1")</li>
                                    <li>@Localizer.T("server.trouble.connection.2")</li>
                                    <li>@Localizer.T("server.trouble.connection.3")</li>
                                    <li>@Localizer.T("server.trouble.connection.4")</li>
                                </ul>
                            </div>

                            <div class="troubleshooting-item">
                                <h4>@Localizer.T("server.trouble.launch")</h4>
                                <ul>
                                    <li>@Localizer.T("server.trouble.launch.1")</li>
                                    <li>@Localizer.T("server.trouble.launch.2")</li>
                                    <li>@Localizer.T("server.trouble.launch.3")</li>
                                    <li>@Localizer.T("server.trouble.launch.4")</li>
                                </ul>
                            </div>

                            <div class="troubleshooting-item">
                                <h4>@Localizer.T("server.trouble.query")</h4>
                                <ul>
                                    <li>@Localizer.T("server.trouble.query.1")</li>
                                    <li>@Localizer.T("server.trouble.query.2")</li>
                                    <li>@Localizer.T("server.trouble.query.3")</li>
                                    <li>@Localizer.T("server.trouble.query.4")</li>
                                </ul>
                            </div>

                            <div class="troubleshooting-item">
                                <h4>@Localizer.T("server.trouble.ports")</h4>
                                <ul>
                                    <li>@Localizer.T("server.trouble.ports.1")</li>
                                    <li>@Localizer.T("server.trouble.ports.2")</li>
                                    <li>@Localizer.T("server.trouble.ports.3")</li>
                                    <li>@Localizer.T("server.trouble.ports.4")</li>
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>


@code {
    /// <summary>
    /// Repaints the page when the language changes; why the cascade rather than a subscription
    /// of this page's own is explained in MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    private const int PingTimeoutMs = 2500;

    private string serverInput = "";
    private bool isQuerying = false;
    private bool showTroubleshooting = false;
    private bool showServerInfo = false;
    private List<GameServer> servers = new();
    private GameServer? selectedServer;
    private GameServer? currentServer;
    private Timer? refreshTimer;
    private bool isPageActive = true;
    private bool _isDisposed = false;
    private bool _hasInitialized = false;
    private int _queryVersion = 0;
    private CancellationTokenSource? _queryCancellation;

    private string ServerInput
    {
        get => serverInput;
        set
        {
            var nextValue = value ?? string.Empty;
            if (serverInput == nextValue)
            {
                return;
            }

            serverInput = nextValue;

            // If the user edits the endpoint while a query is running, abandon the stale request immediately.
            if (isQuerying)
            {
                CancelActiveQuery(resetBusyState: true);
            }
        }
    }

    // Helper method for boolean attributes
    private bool IsServerNull() => currentServer == null;

    protected override Task OnInitializedAsync()
    {
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
            function fixServerInputs() {
                const inputs = document.querySelectorAll('.server-input, input');
                inputs.forEach(input => {
                    if (input.classList.contains('server-input') || input.placeholder?.includes('141.98')) {
                        input.style.pointerEvents = 'auto';
                        input.style.zIndex = '99999';
                        input.style.position = 'relative';
                        input.style.userSelect = 'text';
                        input.style.webkitUserSelect = 'text';
                        input.style.cursor = 'text';
                        input.disabled = false;
                        input.readOnly = false;

                        input.addEventListener('mousedown', function(e) {
                            e.stopPropagation();
                        });

                        input.addEventListener('click', function(e) {
                            e.stopPropagation();
                            this.focus();
                        });
                    }
                });
            }

            fixServerInputs();
            setTimeout(fixServerInputs, 100);
            setTimeout(fixServerInputs, 500);

            document.addEventListener('visibilitychange', function() {
                if (!document.hidden) {
                    setTimeout(fixServerInputs, 100);
                }
            });
        ");

            if (!_hasInitialized)
            {
                _hasInitialized = true;
                await InitializeAsync();
            }
        }
    }

    private async Task InitializeAsync()
    {
        await LoadServers();

        if (_isDisposed)
            return;

        StartAutoRefresh();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public static void OnPageHidden()
    {

    }

    [JSInvokable]
    public static void OnPageVisible()
    {

    }

    private void StartAutoRefresh()
    {
        // Auto-refresh servers every 60 seconds (reduced from 30 to minimize network lag)
        // Only refresh if page is active and there are servers
        //
        // The callback must stay `void`: TimerCallback returns void, so `async _ => ...` here is an
        // `async void` running on a thread-pool thread with no caller and no SynchronizationContext
        // to hand the fault to — it is rethrown as an UNHANDLED exception and takes the process
        // down, which does not even reach RR-E1003. RefreshVisibleServersAsync owns everything.
        // 20s, down from 60: the player count is the number this page exists for, and a
        // minute-old value on a wipe-day server is off by a lobby's worth of people.
        refreshTimer = new Timer(
            _ => RefreshVisibleServers(),
            null,
            TimeSpan.FromSeconds(20),
            TimeSpan.FromSeconds(20));
    }

    /// <summary>
    /// One tick of the auto-refresh. Everything happens on the dispatcher: <c>servers</c> is a
    /// plain List the renderer mutates at Save/Remove/LoadServers, and reading it from the timer
    /// thread is what produces "Collection was modified; enumeration operation may not execute."
    /// </summary>
    private void RefreshVisibleServers()
    {
        // A TimerCallback has no caller to hand a fault to; see the note at the construction site.
        try
        {
            RefreshVisibleServersTick();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Server auto-refresh tick failed");
        }
    }

    private void RefreshVisibleServersTick()
    {
        if (_isDisposed || !isPageActive || this.IsRenderStopped())
            return;

        this.DispatchRender(() => InvokeAsync(RefreshVisibleServersAsync), Logger);
    }

    private async Task RefreshVisibleServersAsync()
    {
        if (_isDisposed || !isPageActive || !servers.Any())
            return;

        // Limit refresh to max 10 servers to prevent lag. Snapshotted on the dispatcher.
        var serversToRefresh = servers.Take(10).ToList();

        foreach (var server in serversToRefresh)
        {
            if (_isDisposed)
                return;

            try
            {
                await UpdateServerStatus(server);
            }
            catch (Exception ex)
            {
                // Log errors during auto-refresh
                Logger.LogWarning(ex, "Error refreshing server {ServerName}", server.Name);
            }
        }

        if (!_isDisposed)
            StateHasChanged();
    }

    public void Dispose()
    {
        _isDisposed = true;
        this.StopRenderDispatch();
        CancelActiveQuery();
        refreshTimer?.Dispose();
    }

    private async Task LoadServers()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "razorReaperSavedServers");
            if (!string.IsNullOrEmpty(json))
            {
                servers = JsonSerializer.Deserialize<List<GameServer>>(json) ?? new();

                foreach (var server in servers)
                {
                    _ = UpdateServerStatus(server);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading servers from localStorage");
        }
    }

    private async Task SaveServersToStorage()
    {
        try
        {
            var json = JsonSerializer.Serialize(servers, new JsonSerializerOptions { WriteIndented = true });
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "razorReaperSavedServers", json);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving servers to localStorage");
        }
    }

    private async Task UpdateServerStatus(GameServer server)
    {
        try
        {
            var serverInfo = await ServerQuery.QueryAsync(server.IpAddress, server.QueryPort);
            if (serverInfo != null)
            {
                server.IsOnline = true;
                server.CurrentPlayers = serverInfo.Players;
                server.MaxPlayers = serverInfo.MaxPlayers;
                server.CurrentMap = serverInfo.Map;
                server.Version = serverInfo.Version;

                if (!string.IsNullOrEmpty(serverInfo.Name) && serverInfo.Name != server.Name)
                {
                    server.Name = serverInfo.Name;
                }
            }
            else
            {
                server.IsOnline = false;
                server.CurrentPlayers = 0;
            }
        }
        catch
        {
            server.IsOnline = false;
            server.CurrentPlayers = 0;
        }
    }

    private string GetSteamUrl()
    {
        if (!TryParseServerInput(serverInput, out var ip, out var queryPort, out _))
        {
            return "";
        }

        var gamePort = GetGamePort(queryPort);
        return $"steam://run/346110//+connect {ip}:{gamePort}";
    }

    private async Task CopySteamUrl()
    {
        var url = GetSteamUrl();
        if (string.IsNullOrEmpty(url)) return;

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", url);
            NotificationService.ShowSuccess(Localizer.T("server.success.urlcopied"));
        }
        catch
        {
            NotificationService.ShowError(Localizer.T("server.error.urlcopy"));
        }
    }

    private async Task QueryServer()
    {
        var attemptedInput = serverInput.Trim();
        if (string.IsNullOrWhiteSpace(attemptedInput))
        {
            return;
        }

        var requestId = ++_queryVersion;
        CancelActiveQuery();

        var queryCancellation = new CancellationTokenSource();
        _queryCancellation = queryCancellation;

        isQuerying = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (!TryParseServerInput(attemptedInput, out var ip, out var queryPort, out var validationError))
            {
                if (IsCurrentQuery(requestId))
                {
                    NotificationService.ShowError(validationError);
                }

                return;
            }

            serverInput = $"{ip}:{queryPort}";
            currentServer = CreatePendingServer(ip, queryPort);

            var serverInfo = await ServerQuery.QueryAsync(ip, queryPort, queryCancellation.Token);
            if (!IsCurrentQuery(requestId) || currentServer == null)
            {
                return;
            }

            if (serverInfo != null)
            {
                ApplyServerInfo(currentServer, serverInfo);
                NotificationService.ShowSuccess(Localizer.T("server.success.online", serverInfo.Players, serverInfo.MaxPlayers, serverInfo.Map));
            }
            else
            {
                using var ping = new Ping();
                var pingReply = await ping.SendPingAsync(ip, PingTimeoutMs);
                if (!IsCurrentQuery(requestId) || currentServer == null)
                {
                    return;
                }

                if (pingReply.Status == IPStatus.Success)
                {
                    currentServer.IsOnline = true;
                    NotificationService.ShowWarning(Localizer.T("server.warn.reachable", pingReply.RoundtripTime));
                }
                else
                {
                    NotificationService.ShowError(Localizer.T("server.error.offline"));
                }
            }
        }
        catch (OperationCanceledException) when (_isDisposed)
        {
        }
        catch (OperationCanceledException)
        {
            Logger.LogDebug("Server query canceled for {Input}", attemptedInput);
        }
        catch (Exception ex)
        {
            if (IsCurrentQuery(requestId))
            {
                NotificationService.ShowError(Localizer.T("server.error.query", ex.Message));
            }
        }
        finally
        {
            if (ReferenceEquals(_queryCancellation, queryCancellation))
            {
                queryCancellation.Dispose();
                _queryCancellation = null;
            }

            if (IsCurrentQuery(requestId))
            {
                isQuerying = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void CancelActiveQuery(bool resetBusyState = false)
    {
        if (_queryCancellation != null)
        {
            try
            {
                _queryCancellation.Cancel();
            }
            catch (ObjectDisposedException)
            {
            }

            _queryCancellation.Dispose();
            _queryCancellation = null;
        }

        if (resetBusyState)
        {
            isQuerying = false;
        }
    }

    private bool IsCurrentQuery(int requestId) => !_isDisposed && requestId == _queryVersion;

    private bool TryParseServerInput(string input, out string ip, out int queryPort, out string errorMessage)
    {
        ip = string.Empty;
        queryPort = 0;
        errorMessage = Localizer.T("server.error.format");

        var trimmedInput = input?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(trimmedInput))
        {
            errorMessage = Localizer.T("server.error.empty");
            return false;
        }

        var parts = trimmedInput.Split(':', StringSplitOptions.TrimEntries);
        if (parts.Length != 2)
        {
            return false;
        }

        if (!IPAddress.TryParse(parts[0], out var parsedAddress) || parsedAddress.AddressFamily != AddressFamily.InterNetwork)
        {
            errorMessage = Localizer.T("server.error.ip");
            return false;
        }

        if (!int.TryParse(parts[1], out queryPort) || queryPort is < 1 or > 65535)
        {
            errorMessage = Localizer.T("server.error.port");
            return false;
        }

        ip = parsedAddress.ToString();
        return true;
    }

    private static int GetGamePort(int queryPort)
    {
        var gamePort = queryPort - 12288;
        return gamePort > 0 ? gamePort : queryPort;
    }

    private GameServer CreatePendingServer(string ip, int queryPort)
    {
        var gamePort = GetGamePort(queryPort);

        return new GameServer
        {
            IpAddress = ip,
            Port = gamePort,
            QueryPort = queryPort,
            Name = $"ARK Server {ip}:{gamePort}",
            IsOnline = false,
            CurrentPlayers = 0,
            MaxPlayers = 70,
            CurrentMap = "Unknown",
            Version = "Unknown"
        };
    }

    private static void ApplyServerInfo(GameServer server, ServerQueryInfo serverInfo)
    {
        server.IsOnline = true;
        server.Name = string.IsNullOrWhiteSpace(serverInfo.Name) ? server.Name : serverInfo.Name;
        server.CurrentPlayers = serverInfo.Players;
        server.MaxPlayers = serverInfo.MaxPlayers;
        server.CurrentMap = string.IsNullOrWhiteSpace(serverInfo.Map) ? "Unknown" : serverInfo.Map;
        server.Version = string.IsNullOrWhiteSpace(serverInfo.Version) ? "Unknown" : serverInfo.Version;
    }

    private async Task SaveServer()
    {
        if (currentServer == null)
        {
            NotificationService.ShowError(Localizer.T("server.error.nosave"));
            return;
        }

        try
        {
            var existing = servers.FirstOrDefault(s => s.IpAddress == currentServer.IpAddress && s.QueryPort == currentServer.QueryPort);
            if (existing != null)
            {
                existing.Name = currentServer.Name;
                existing.IsOnline = currentServer.IsOnline;
                existing.CurrentPlayers = currentServer.CurrentPlayers;
                existing.MaxPlayers = currentServer.MaxPlayers;
                existing.CurrentMap = currentServer.CurrentMap;
                existing.Version = currentServer.Version;
                NotificationService.ShowSuccess(Localizer.T("server.success.updated", currentServer.Name));
                ActivityService.AddActivity(Localizer.T("server.activity.updated", currentServer.Name), "info", "server.activity.updated");
            }
            else
            {
                servers.Add(currentServer);
                NotificationService.ShowSuccess(Localizer.T("server.success.saved", currentServer.Name, servers.Count));
                ActivityService.AddActivity(Localizer.T("server.activity.saved", currentServer.Name), "success", "server.activity.saved");
            }

            await SaveServersToStorage();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService.ShowError(Localizer.T("server.error.save", ex.Message));
        }
    }

    private async Task RemoveServer(GameServer server)
    {
        servers.Remove(server);
        await SaveServersToStorage();
        ActivityService.AddActivity(Localizer.T("server.activity.removed", server.Name), "warning", "server.activity.removed");
        if (selectedServer == server)
        {
            selectedServer = null;
            showServerInfo = false;
        }
        StateHasChanged();
    }

    private async Task ConnectToServer()
    {
        if (currentServer == null) return;

        try
        {
            var steamUrl = $"steam://run/346110//+connect {currentServer.IpAddress}:{currentServer.Port}";
            await JSRuntime.InvokeVoidAsync("window.open", steamUrl, "_blank");
            NotificationService.ShowSuccess(Localizer.T("server.success.launching"));
            ActivityService.AddActivity(Localizer.T("server.activity.connecting", currentServer.Name, currentServer.IpAddress), "success", "server.activity.connecting");
        }
        catch (Exception ex)
        {
            NotificationService.ShowError(Localizer.T("server.error.connect", ex.Message));
        }
    }

    private async Task AddToSteamFavorites()
    {
        if (currentServer == null)
        {
            NotificationService.ShowError(Localizer.T("server.error.nofavorite"));
            return;
        }

        try
        {
            await SaveServer();

            string steamFavoriteUrl = $"steam://friends/joingame/{currentServer.IpAddress}:{currentServer.Port}";
            await JSRuntime.InvokeVoidAsync("window.open", steamFavoriteUrl, "_blank");

            NotificationService.ShowSuccess(Localizer.T("server.success.favorited", currentServer.Name));
        }
        catch (Exception ex)
        {
            NotificationService.ShowError(Localizer.T("server.error.favorite", ex.Message));
        }
    }

    private async Task OpenSteamBrowser()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("window.open", "steam://open/servers", "_blank");
            NotificationService.ShowSuccess(Localizer.T("server.success.browser"));
        }
        catch (Exception ex)
        {
            NotificationService.ShowError(Localizer.T("server.error.browser", ex.Message));
        }
    }

    private void SelectServer(GameServer server)
    {
        selectedServer = server;
        showServerInfo = true;
        serverInput = $"{server.IpAddress}:{server.QueryPort}";
        currentServer = server;

        _ = UpdateServerStatus(server);
    }

    private void HideServerInfo()
    {
        showServerInfo = false;
        selectedServer = null;
    }

    private void ToggleTroubleshooting()
    {
        showTroubleshooting = !showTroubleshooting;
    }

    // ── Bulk Add Favorites ──────────────────────────────────────────────────

    private const int MaxBulkListRows = 25;
    private const int BulkApplyDelayMs = 350;

    private string bulkInput = "";
    private BulkParseResult bulkParse = new();
    private bool isBulkApplying = false;
    private readonly List<BulkFavoriteResult> bulkResults = new();
    // The last run is kept as three counts rather than a finished sentence: the status line
    // sits on screen until the list is edited, and a sentence built once would stay in the
    // language it was built in after a switch.
    private bool bulkHasLastRun;
    private int bulkLastAdded;
    private int bulkLastSkipped;
    private int bulkLastFailed;
    private bool bulkLastRunHadFailures;

    private bool CanApplyBulk => !isBulkApplying && bulkParse.Valid.Count > 0;

    private string BulkStatusState =>
        isBulkApplying ? "warning"
        : bulkHasLastRun ? (bulkLastRunHadFailures ? "warning" : "online")
        : bulkParse.Valid.Count > 0 ? "online"
        : bulkParse.Invalid.Count > 0 ? "error"
        : "off";

    private string BulkStatusDescription =>
        isBulkApplying ? Localizer.T("server.bulk.desc.applying", bulkResults.Count, bulkParse.Valid.Count)
        : bulkHasLastRun ? Localizer.T("server.bulk.desc.lastrun", bulkLastAdded, bulkLastSkipped, bulkLastFailed)
        : bulkParse.Valid.Count > 0
            ? Localizer.T(bulkParse.Valid.Count == 1 ? "server.bulk.desc.ready.one" : "server.bulk.desc.ready.many", bulkParse.Valid.Count)
        : bulkParse.Invalid.Count > 0 ? Localizer.T("server.bulk.desc.novalid")
        : Localizer.T("server.bulk.desc.idle");

    private void OnBulkInputChanged()
    {
        bulkParse = SteamFavoritesService.ParseServerList(bulkInput);

        // Old apply results no longer match the edited list — drop them.
        bulkResults.Clear();
        bulkHasLastRun = false;
        bulkLastRunHadFailures = false;
    }

    private void ClearBulkInput()
    {
        bulkInput = "";
        bulkParse = new BulkParseResult();
        bulkResults.Clear();
        bulkHasLastRun = false;
        bulkLastRunHadFailures = false;
    }

    private async Task ApplyBulkFavorites()
    {
        if (isBulkApplying || bulkParse.Valid.Count == 0)
        {
            return;
        }

        isBulkApplying = true;
        bulkResults.Clear();
        bulkHasLastRun = false;
        bulkLastRunHadFailures = false;
        StateHasChanged();

        var added = 0;
        var skipped = 0;
        var failed = 0;

        try
        {
            var existingFavorites = await SteamFavoritesService.GetExistingFavoriteEndpointsAsync();

            foreach (var entry in bulkParse.Valid)
            {
                if (_isDisposed)
                {
                    return;
                }

                var gamePort = GetGamePort(entry.QueryPort);
                var favoriteEndpoint = $"{entry.IpAddress}:{gamePort}";

                // Steam may store the address with either port form; check both.
                if (existingFavorites.Contains(favoriteEndpoint) || existingFavorites.Contains(entry.Endpoint))
                {
                    bulkResults.Add(new BulkFavoriteResult
                    {
                        Endpoint = favoriteEndpoint,
                        Status = "skipped",
                        Detail = Localizer.T("server.bulk.detail.already")
                    });
                    skipped++;
                    StateHasChanged();
                    continue;
                }

                try
                {
                    // Exactly the same mechanism as the single-server "Add to Steam" button.
                    var steamFavoriteUrl = $"steam://friends/joingame/{favoriteEndpoint}";
                    await JSRuntime.InvokeVoidAsync("window.open", steamFavoriteUrl, "_blank");

                    existingFavorites.Add(favoriteEndpoint);
                    bulkResults.Add(new BulkFavoriteResult
                    {
                        Endpoint = favoriteEndpoint,
                        Status = "added",
                        Detail = Localizer.T("server.bulk.detail.sent")
                    });
                    added++;
                    StateHasChanged();

                    // Give Steam a moment between protocol invocations so none get dropped.
                    await Task.Delay(BulkApplyDelayMs);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Bulk favorites: failed to add {Endpoint}", favoriteEndpoint);
                    bulkResults.Add(new BulkFavoriteResult
                    {
                        Endpoint = favoriteEndpoint,
                        Status = "failed",
                        Detail = ex.Message
                    });
                    failed++;
                    StateHasChanged();
                }
            }

            bulkLastAdded = added;
            bulkLastSkipped = skipped;
            bulkLastFailed = failed;
            bulkHasLastRun = true;
            bulkLastRunHadFailures = failed > 0;

            var summary = Localizer.T("server.bulk.complete", added, skipped, failed);
            if (failed > 0)
            {
                NotificationService.ShowWarning(summary);
            }
            else if (added > 0)
            {
                NotificationService.ShowSuccess(summary);
            }
            else
            {
                NotificationService.ShowInfo(summary);
            }

            if (added > 0)
            {
                ActivityService.AddActivity(
                    Localizer.T(added == 1 ? "server.bulk.activity.one" : "server.bulk.activity.many", added),
                    "success",
                    added == 1 ? "server.bulk.activity.one" : "server.bulk.activity.many");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Bulk favorites apply failed");
            NotificationService.ShowError(Localizer.T("server.bulk.error", ex.Message));
        }
        finally
        {
            isBulkApplying = false;
            if (!_isDisposed)
            {
                StateHasChanged();
            }
        }
    }

    /// <summary>
    /// The word for a map or version the query did not report. "Unknown" is the sentinel the
    /// saved list stores, including in lists written before this page was translated, so it is
    /// read as a sentinel here and the word itself is looked up where it renders.
    /// </summary>
    private string OrUnknown(string? value)
        => string.IsNullOrWhiteSpace(value) || value == "Unknown"
            ? Localizer.T("common.unknown")
            : value;

    private static string TruncateLine(string value, int maxLength = 48)
        => value.Length <= maxLength ? value : value[..maxLength] + "...";

    private sealed class BulkFavoriteResult
    {
        public string Endpoint { get; init; } = "";

        /// <summary>"added" | "skipped" | "failed" — doubles as the result row CSS class.</summary>
        public string Status { get; init; } = "";

        /// <summary>Already worded when it is set — an exception message passes through as it is.</summary>
        public string Detail { get; init; } = "";
    }

    public class GameServer
    {
        public string Name { get; set; } = "";
        public string IpAddress { get; set; } = "";
        public int Port { get; set; }
        public int QueryPort { get; set; }
        public bool IsOnline { get; set; }
        public int CurrentPlayers { get; set; }
        public int MaxPlayers { get; set; } = 70;
        public string CurrentMap { get; set; } = "Unknown";
        public string Version { get; set; } = "Unknown";
    }
}
