@using RazorReaper.Services
@inject ICustomLabSettingsService LabSettings
@implements IDisposable

<div class="lab-readme">
    <div class="lab-card">
        <div class="lab-card-header">
            <div class="lab-icon-badge danger">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 3.5 16.5 15H3.5L10 3.5Z" />
                    <path d="M10 7.5v4" />
                    <path d="M10 13.5h.01" />
                </svg>
            </div>
            <div>
                <h3>Custom Lab — unofficial servers only</h3>
                <p>Tools in this section modify ARK game files or, eventually, the running process. Read this before enabling.</p>
            </div>
        </div>

        <div class="lab-card-content">
            <p class="lab-lead">
                These tools are aimed at unofficial servers where modding ARK on your own client is acceptable.
                They do not interact with the server itself, do not affect other players, and do not patch any
                official Wildcard service. They do, however, change files on your machine.
            </p>

            <h4>Risks you accept by using these tools</h4>
            <ul class="lab-risk-list">
                <li>
                    <strong>Anti-cheat (BattlEye / EAC)</strong> may flag any modification to ARK's files or process memory.
                    "Likely safe" is not "guaranteed safe" — the ban risk is yours.
                </li>
                <li>
                    <strong>Backups are kept</strong> for everything we patch, but a corrupted file may still need
                    Steam's <em>Verify integrity of game files</em> to recover.
                </li>
                <li>
                    <strong>Local-client only.</strong> Other players will see the original game; only you see your changes.
                </li>
                <li>
                    <strong>No warranty.</strong> RazorReaper provides these tools as-is. If they break your install,
                    a Steam verify is your safety net.
                </li>
            </ul>

            <h4>What each tool does</h4>
            <div class="lab-feature-list">
                <div class="lab-feature">
                    <div class="lab-feature-name">Sky Injector</div>
                    <p>
                        Replaces ARK's sky textures across most maps with an image of your choice (or a flat color).
                        Patches <code>.uasset</code> files on disk and keeps originals in a backup folder for easy restore.
                    </p>
                </div>
                <div class="lab-feature">
                    <div class="lab-feature-name">Memory Patcher <span class="lab-pill warning">coming soon</span></div>
                    <p>
                        Attaches to a running <code>ShooterGame.exe</code> and applies sky / texture changes in-memory so
                        edits show up without restarting ARK. Disabled until the feature is built.
                    </p>
                </div>
            </div>

            <div class="lab-accept-row">
                <label class="lab-accept-toggle">
                    <input type="checkbox" checked="@LabSettings.Current.Accepted" @onchange="OnAcceptedChanged" />
                    <span class="lab-accept-check">
                        @if (LabSettings.Current.Accepted)
                        {
                            <svg viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0z" clip-rule="evenodd" />
                            </svg>
                        }
                    </span>
                    <span class="lab-accept-text">
                        I understand the risks and want to use these tools.
                    </span>
                </label>

                @if (LabSettings.Current.Accepted && !LabSettings.Current.MasterEnabled)
                {
                    <p class="lab-accept-hint">
                        You've accepted the Read Me. Open the <strong>Settings</strong> tab and flip
                        <strong>Enable Custom Lab</strong> to unlock the feature tabs.
                    </p>
                }
                else if (LabSettings.Current.Accepted)
                {
                    <p class="lab-accept-hint success">
                        Custom Lab is unlocked. You can change your mind any time from the Settings tab.
                    </p>
                }
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        LabSettings.Changed += OnLabSettingsChanged;
    }

    private Task OnAcceptedChanged(ChangeEventArgs e) =>
        LabSettings.SetAcceptedAsync(e.Value is bool b && b);

    private void OnLabSettingsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => LabSettings.Changed -= OnLabSettingsChanged;
}
