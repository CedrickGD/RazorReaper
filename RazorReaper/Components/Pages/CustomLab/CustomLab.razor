@page "/custom-lab"
@using RazorReaper.Services

@inject ICustomLabSettingsService LabSettings
@inject IDiscordPresenceService DiscordPresence
@using RazorReaper.Services.Localization
@inject ILocalizer Localizer

<header class="page-header">
    <h1 class="page-title">@Localizer.T("nav.page.custom-lab")</h1>
    <p class="page-subtitle">@Localizer.T("customlab.subtitle")</p>
</header>

<div class="sky-changer-body">
    <SkyInjector />
</div>

<style>
    /* Bottom-to-top page entrance — the same global fadeInUp every other page uses. */
    .sky-changer-body {
        animation: fadeInUp 0.6s ease-out;
    }
</style>

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LabSettings.LoadAsync();
        DiscordPresence.SetActivityLabel("Sky Changer");
    }
}
