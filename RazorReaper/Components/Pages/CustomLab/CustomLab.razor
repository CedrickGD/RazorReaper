@page "/custom-lab"
@using RazorReaper.Services

@inject ICustomLabSettingsService LabSettings
@inject IDiscordPresenceService DiscordPresence

<header class="page-header">
    <h1 class="page-title">Sky Changer</h1>
    <p class="page-subtitle">Replace the in-game sky with an image or solid color — patches your local sky files, safe on any server.</p>
</header>

<SkyInjector />

@code {
    protected override async Task OnInitializedAsync()
    {
        await LabSettings.LoadAsync();
        DiscordPresence.SetActivityLabel("Sky Changer");
    }
}
