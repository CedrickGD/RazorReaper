@page "/custom-lab"
@using Microsoft.Extensions.Logging
@using RazorReaper.Services
@using RazorReaper.Models

@inject ICustomLabSettingsService LabSettings
@inject INotificationService Notifications
@inject ILogger<CustomLab> Logger
@inject IDiscordPresenceService DiscordPresence
@implements IDisposable

<header class="page-header">
    <h1 class="page-title">Custom Lab</h1>
    <p class="page-subtitle">Unofficial-server-only tools that modify ARK files or memory</p>
</header>

<div class="lab-tab-strip" role="tablist">
    <button type="button"
            role="tab"
            class="lab-tab @(activeTab == LabTab.ReadMe ? "active" : "")"
            aria-selected="@(activeTab == LabTab.ReadMe)"
            @onclick="() => SetTab(LabTab.ReadMe)">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 3.5h8l2.5 2.5v10.5H5z" />
            <path d="M13 3.5V6h2.5" />
            <path d="M7.5 10h5" />
            <path d="M7.5 13h5" />
        </svg>
        <span>Read Me</span>
    </button>

    <button type="button"
            role="tab"
            class="lab-tab @(activeTab == LabTab.Settings ? "active" : "")"
            aria-selected="@(activeTab == LabTab.Settings)"
            @onclick="() => SetTab(LabTab.Settings)">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="10" cy="10" r="2.5" />
            <path d="M10 3v2M10 15v2M3 10h2M15 10h2M5 5l1.4 1.4M13.6 13.6 15 15M5 15l1.4-1.4M13.6 6.4 15 5" />
        </svg>
        <span>Settings</span>
    </button>

    <button type="button"
            role="tab"
            class="lab-tab @(activeTab == LabTab.SkyInjector ? "active" : "") @(SkyUnlocked ? "" : "locked")"
            aria-selected="@(activeTab == LabTab.SkyInjector)"
            aria-disabled="@(!SkyUnlocked)"
            title="@(SkyUnlocked ? null : "Accept the Read Me and enable Custom Lab in Settings to unlock")"
            @onclick="() => SetTab(LabTab.SkyInjector)">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 13a3 3 0 0 1 3-3 4 4 0 0 1 7.8-1A3.2 3.2 0 0 1 17 12.2 2.8 2.8 0 0 1 14.2 15H5.5A2.5 2.5 0 0 1 3 13Z" />
        </svg>
        <span>Sky Injector</span>
        @if (!SkyUnlocked)
        {
            <svg class="lab-tab-lock" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="5" y="9" width="10" height="7" rx="1.5" />
                <path d="M7.5 9V7a2.5 2.5 0 0 1 5 0v2" />
            </svg>
        }
    </button>

    <button type="button"
            role="tab"
            class="lab-tab @(activeTab == LabTab.MemoryPatcher ? "active" : "") @(MemoryUnlocked ? "" : "locked")"
            aria-selected="@(activeTab == LabTab.MemoryPatcher)"
            aria-disabled="@(!MemoryUnlocked)"
            title="@(MemoryUnlocked ? null : "Accept the Read Me and enable memory injection in Settings to unlock")"
            @onclick="() => SetTab(LabTab.MemoryPatcher)">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="5" width="12" height="10" rx="1.5" />
            <path d="M7 5V3M10 5V3M13 5V3M7 17v-2M10 17v-2M13 17v-2M4 8H2M4 12H2M18 8h-2M18 12h-2" />
            <rect x="7.5" y="8.5" width="5" height="3" rx="0.5" />
        </svg>
        <span>Memory Patcher</span>
        @if (!MemoryUnlocked)
        {
            <svg class="lab-tab-lock" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="5" y="9" width="10" height="7" rx="1.5" />
                <path d="M7.5 9V7a2.5 2.5 0 0 1 5 0v2" />
            </svg>
        }
    </button>
</div>

<div class="lab-tab-panel" role="tabpanel">
    @switch (activeTab)
    {
        case LabTab.ReadMe:
            <ReadMe />
            break;
        case LabTab.Settings:
            <Settings OnJumpToReadMe="() => SetTab(LabTab.ReadMe)" />
            break;
        case LabTab.SkyInjector:
            <SkyInjector OnJumpToReadMe="() => SetTab(LabTab.ReadMe)" OnJumpToSettings="() => SetTab(LabTab.Settings)" />
            break;
        case LabTab.MemoryPatcher:
            <MemoryPatcher />
            break;
    }
</div>

<style>
    .lab-tab-strip {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        overflow-x: auto;
        scrollbar-width: thin;
    }

    .lab-tab {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.6rem 1rem;
        background: transparent;
        border: 1px solid transparent;
        border-radius: 8px;
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.92rem;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease;
        white-space: nowrap;
    }

    .lab-tab svg {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
    }

    .lab-tab:hover:not(:disabled):not(.active) {
        background: rgba(255, 255, 255, 0.06);
        color: rgba(255, 255, 255, 0.92);
    }

    .lab-tab.active {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.14);
        color: #fff;
    }

    .lab-tab.locked,
    .lab-tab[aria-disabled="true"] {
        opacity: 0.45;
        cursor: not-allowed;
    }

    .lab-tab.locked:hover {
        background: transparent;
        color: rgba(255, 255, 255, 0.7);
    }

    .lab-tab-lock {
        width: 13px !important;
        height: 13px !important;
        opacity: 0.85;
        margin-left: 0.1rem;
    }

    .lab-tab-panel {
        animation: labFadeIn 0.25s ease-out;
    }

    @@keyframes labFadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to   { opacity: 1; transform: translateY(0); }
    }
</style>

@code {
    private LabTab activeTab = LabTab.ReadMe;

    private bool SkyUnlocked => LabSettings.Current.Accepted && LabSettings.Current.MasterEnabled;
    private bool MemoryUnlocked => SkyUnlocked && LabSettings.Current.MemoryInjectEnabled;

    protected override async Task OnInitializedAsync()
    {
        LabSettings.Changed += OnLabSettingsChanged;
        await LabSettings.LoadAsync();
        UpdatePresence();
    }

    private void SetTab(LabTab tab)
    {
        if (tab == LabTab.SkyInjector && !SkyUnlocked)
        {
            Notifications.ShowWarning(LabSettings.Current.Accepted
                ? "Enable Custom Lab in Settings to unlock the Sky Injector."
                : "Accept the Read Me to unlock the Sky Injector.");
            return;
        }
        if (tab == LabTab.MemoryPatcher && !MemoryUnlocked)
        {
            Notifications.ShowWarning(LabSettings.Current.Accepted && LabSettings.Current.MasterEnabled
                ? "Enable runtime memory injection in Settings to unlock the Memory Patcher."
                : "Accept the Read Me and enable Custom Lab to unlock the Memory Patcher.");
            return;
        }
        activeTab = tab;
        UpdatePresence();
    }

    private void OnLabSettingsChanged()
    {
        _ = InvokeAsync(() =>
        {
            // If the user just locked themselves out, route to the place where they can fix it.
            // - Sky Injector locks when Accepted or MasterEnabled flips off → Settings is where both live.
            // - Memory Patcher locks when MemoryInjectEnabled flips off → Settings is where it's toggled.
            if (activeTab == LabTab.SkyInjector && !SkyUnlocked) activeTab = LabTab.Settings;
            if (activeTab == LabTab.MemoryPatcher && !MemoryUnlocked) activeTab = LabTab.Settings;
            UpdatePresence();
            StateHasChanged();
        });
    }

    // Report the active sub-tool to Discord so Sky Injector and Memory Patcher show as their own
    // activities instead of a generic "Custom Lab". MainLayout's navigation hook overrides this
    // again when the user leaves the page.
    private void UpdatePresence() => DiscordPresence.SetActivityLabel(PresenceLabelFor(activeTab));

    private static string PresenceLabelFor(LabTab tab) => tab switch
    {
        LabTab.SkyInjector => "Sky Injector",
        LabTab.MemoryPatcher => "Memory Patcher",
        _ => "Custom Lab",
    };

    public void Dispose()
    {
        LabSettings.Changed -= OnLabSettingsChanged;
    }
}
