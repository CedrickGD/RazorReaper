@using Microsoft.Extensions.Logging
@using RazorReaper.Components.Shared
@using RazorReaper.Models
@using RazorReaper.Services

@inject ISkyInjectorService Injector
@inject ISkyInjectorSessionState Session
@inject ICustomLabSettingsService LabSettings
@inject INotificationService Notifications
@inject IProcessService ProcessService
@inject IUsageGateService UsageGate
@inject ILogger<SkyInjector> Logger
@implements IDisposable
@using RazorReaper.Services.Localization
@inject ILocalizer Localizer

<div class="lab-injector">
    @* ── Status badge ─────────────────────────────────────────────── *@
    <div class="injector-status @StatusClass">
        <div class="injector-status-icon">
            @if (StatusKind == "injected")
            {
                <svg viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm-1 11.4-3.7-3.7 1.4-1.4L9 10.6l4.3-4.3 1.4 1.4L9 13.4Z" />
                </svg>
            }
            else if (StatusKind == "restored")
            {
                <svg viewBox="0 0 20 20" fill="currentColor">
                    <path d="M4 4v5h5L7.6 7.6A6 6 0 1 1 4 13l-1.8.6A8 8 0 1 0 6.2 6.2L4 4Z" />
                </svg>
            }
            else
            {
                <svg viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm0 3a1 1 0 0 1 1 1v4a1 1 0 1 1-2 0V6a1 1 0 0 1 1-1Zm0 9.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" />
                </svg>
            }
        </div>
        <div class="injector-status-text">
            <div class="injector-status-title">@StatusTitle</div>
            <div class="injector-status-sub">@StatusSubtitle</div>
        </div>
    </div>

    <div class="injector-grid">
        @* ── Source card ─────────────────────────────────────────── *@
        <div class="lab-card injector-source-card">
            <div class="lab-card-header">
                <div class="lab-icon-badge accent">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="14" height="12" rx="2" />
                        <path d="m6.2 12.5 2.5-2.8 2.4 2.4 2.7-3.3 1.9 3.7" />
                        <circle cx="7" cy="7.5" r="1" />
                    </svg>
                </div>
                <div>
                    <h3>@Localizer.T("sky.source.title")</h3>
                    <p>@Localizer.T("sky.source.subtitle")</p>
                </div>
            </div>

            <div class="lab-card-content">
                <div class="injector-mode">
                    <button type="button"
                            class="injector-mode-btn @(_opts.Mode == SkyInjectionMode.Image ? "active" : "")"
                            @onclick="() => SetMode(SkyInjectionMode.Image)">
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="14" height="12" rx="2" />
                            <path d="m6.2 12.5 2.5-2.8 2.4 2.4 2.7-3.3 1.9 3.7" />
                        </svg>
                        @Localizer.T("sky.mode.image")
                    </button>
                    <button type="button"
                            class="injector-mode-btn @(_opts.Mode == SkyInjectionMode.SolidColor ? "active" : "")"
                            @onclick="() => SetMode(SkyInjectionMode.SolidColor)">
                        <svg viewBox="0 0 20 20" fill="currentColor">
                            <circle cx="10" cy="10" r="6.5" />
                        </svg>
                        @Localizer.T("sky.mode.color")
                    </button>
                </div>

                @if (_opts.Mode == SkyInjectionMode.Image)
                {
                    <div class="injector-file-row">
                        <button type="button" class="lab-btn primary" @onclick="PickImage" disabled="@_busy">
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="5" width="14" height="11" rx="2" />
                                <path d="M3 9h14" />
                                <path d="M10 12v4" />
                                <path d="M8 14h4" />
                            </svg>
                            @Localizer.T("sky.browse")
                        </button>
                        <div class="injector-file-path" title="@(_opts.ImagePath ?? "")">
                            @if (string.IsNullOrEmpty(_opts.ImagePath))
                            {
                                <span class="injector-file-empty">@Localizer.T("sky.noimage")</span>
                            }
                            else
                            {
                                <span>@System.IO.Path.GetFileName(_opts.ImagePath)</span>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_previewUri))
                    {
                        <img src="@_previewUri" alt="@Localizer.T("sky.preview.alt")" style="margin-top:.75rem;max-width:100%;max-height:180px;border-radius:var(--radius-control);border:1px solid rgba(255,255,255,.12);display:block;" />
                    }
                }
                else
                {
                    <div class="injector-color-row">
                        <ColorField @bind-Value="_opts.HexColor" />
                        <span class="injector-color-label">@Localizer.T("sky.color.label")</span>
                    </div>
                }
            </div>
        </div>

        @* ── Options card ────────────────────────────────────────── *@
        <div class="lab-card injector-options-card">
            <div class="lab-card-header">
                <div class="lab-icon-badge">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 6h8" /><path d="M4 10h12" /><path d="M4 14h6" />
                        <circle cx="14" cy="6" r="1.4" />
                        <circle cx="6" cy="14" r="1.4" />
                    </svg>
                </div>
                <div>
                    <h3>@Localizer.T("sky.options.title")</h3>
                    <p>@Localizer.T("sky.options.subtitle")</p>
                </div>
            </div>

            <div class="lab-card-content">
                <div class="lab-settings-row">
                    <div class="lab-settings-label">
                        <div class="lab-settings-title">@Localizer.T("sky.flip")</div>
                        <p class="lab-settings-desc">
                            Use if your image has the sky at the top and ground at the bottom — ARK's coordinate
                            system flips it otherwise.
                        </p>
                    </div>
                    <Switch Value="@_opts.FlipVertically"
                            ValueChanged="@((bool v) => _opts.FlipVertically = v)"
                            Disabled="@(_opts.Mode != SkyInjectionMode.Image || _busy)" />
                </div>

                <div class="lab-settings-row">
                    <div class="lab-settings-label">
                        <div class="lab-settings-title">@Localizer.T("sky.tile")</div>
                        <p class="lab-settings-desc">
                            1× shows the full image as the sky. 2× through 4× repeat the image to make
                            it look smaller / more zoomed in.
                        </p>
                    </div>
                    <Dropdown Value="@_opts.TileSize.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                              ValueChanged="OnTileChanged"
                              Options="TileOptions"
                              Disabled="@(_opts.Mode != SkyInjectionMode.Image || _busy)" />
                </div>
            </div>
        </div>
    </div>

    @* ── Actions ─────────────────────────────────────────────────── *@
    <div class="injector-actions">
        <UsageChip Feature="@UsageFeatures.SkyChanger" />
        <button type="button"
                class="injector-action-btn primary"
                @onclick="InjectAsync"
                disabled="@(!CanInject)">
            @if (_busy && _lastAction == "inject")
            {
                <span class="injector-spinner"></span>
                <span>@Localizer.T("sky.injecting")</span>
            }
            else
            {
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 10h12" />
                    <path d="M10 4l6 6-6 6" />
                </svg>
                <span>@Localizer.T("sky.inject")</span>
            }
        </button>

        <button type="button"
                class="injector-action-btn danger"
                @onclick="RestoreAsync"
                disabled="@(!CanRestore)">
            @if (_busy && _lastAction == "restore")
            {
                <span class="injector-spinner"></span>
                <span>@Localizer.T("sky.restoring")</span>
            }
            else
            {
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 6V3" /><path d="M4 6h3" />
                    <path d="M4 6a7 7 0 1 1-2 4.9" />
                </svg>
                <span>@Localizer.T("sky.restore")</span>
            }
        </button>
    </div>

    @* ── Status log ──────────────────────────────────────────────── *@
    <div class="injector-log">
        <div class="injector-log-header">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3.5" y="3.5" width="13" height="13" rx="1.5" />
                <path d="M6.5 7.5h7M6.5 10h7M6.5 12.5h4" />
            </svg>
            <span>@Localizer.T("sky.log.title")</span>
            @if (_logLines.Count > 0)
            {
                <button type="button" class="injector-log-clear" @onclick="ClearLog">@Localizer.T("common.clear")</button>
            }
        </div>
        <div class="injector-log-body">
            @if (_logLines.Count == 0)
            {
                <div class="injector-log-empty">@Localizer.T("sky.log.empty.lead")<strong>@Localizer.T("sky.inject")</strong>@Localizer.T("sky.log.empty.rest")</div>
            }
            else
            {
                @foreach (var line in _logLines)
                {
                    <div class="injector-log-line @line.Kind">
                        @line.Text
                        @if (line.ActionLabel is not null && line.ActionUrl is not null)
                        {
                            <button type="button" class="injector-log-action" @onclick="() => OpenUrl(line.ActionUrl!)">@line.ActionLabel</button>
                        }
                    </div>
                }
            }
        </div>
    </div>

    @* ── Coverage ────────────────────────────────────────────────── *@
    <div class="injector-coverage">
        <div class="injector-coverage-header">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 16s4.8-4.8 4.8-8A4.8 4.8 0 1 0 5.2 8c0 3.2 4.8 8 4.8 8Z" />
                <circle cx="10" cy="8" r="1.8" />
            </svg>
            <strong>@Localizer.T("sky.coverage.title")</strong>
        </div>
        <p class="injector-coverage-list">
            The Island · Scorched Earth · Aberration · Extinction · Genesis · Genesis 2
            · The Center · Ragnarok · Valguero · Crystal Isles · Lost Island · Fjördur
        </p>
        <p class="injector-coverage-caveat">@Localizer.T("sky.coverage.caveat.1")</p>
        <p class="injector-coverage-caveat">@Localizer.T("sky.coverage.caveat.2")</p>
    </div>
</div>

<style>
    /* Page-specific styles live here; shared chrome (.lab-card / .lab-btn / ...) is in custom-lab-styles.css */

    .lab-injector { display: grid; gap: 1.25rem; }

    .injector-status {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.25rem;
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--glass-hover);
        border-left: 4px solid var(--text-secondary);
        border-radius: var(--radius-control);
    }

    .injector-status.injected {
        border-left-color: var(--accent-purple);
        background: rgba(var(--accent-purple-rgb), 0.06);
    }

    .injector-status.restored {
        border-left-color: var(--accent-green-soft);
        background: rgba(var(--accent-green-rgb), 0.04);
    }

    .injector-status-icon {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .injector-status-icon svg { width: 28px; height: 28px; }

    .injector-status.injected .injector-status-icon { color: var(--accent-purple-light); }
    .injector-status.restored .injector-status-icon { color: var(--accent-green-soft); }

    .injector-status-title {
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 0.15rem;
    }

    .injector-status-sub {
        font-size: 0.86rem;
        color: var(--text-secondary);
    }

    .injector-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
        gap: 1rem;
    }

    .injector-mode {
        display: flex;
        gap: 0.4rem;
        margin-bottom: 1rem;
        padding: 0.25rem;
        background: var(--glass-bg);
        border-radius: var(--radius-control);
    }

    .injector-mode-btn {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.55rem 0.75rem;
        background: transparent;
        border: none;
        border-radius: var(--radius-chip);
        color: var(--text-secondary);
        font-size: 0.9rem;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
    }

    .injector-mode-btn svg { width: 16px; height: 16px; }

    .injector-mode-btn:hover { color: var(--text-primary); }

    .injector-mode-btn.active {
        background: var(--glass-hover);
        color: var(--text-primary);
    }

    .injector-file-row {
        display: flex;
        align-items: center;
        gap: 0.7rem;
    }

    .injector-file-path {
        flex: 1;
        min-width: 0;
        padding: 0.5rem 0.75rem;
        background: var(--glass-bg);
        border: 1px solid var(--glass-hover);
        border-radius: var(--radius-chip);
        font-size: 0.88rem;
        color: var(--text-primary);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .injector-file-empty { color: var(--text-secondary); font-style: italic; }

    .injector-color-row {
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .injector-color-label {
        font-size: 0.88rem;
        color: var(--text-secondary);
    }

    /* The tile picker keeps the width floor the native select had, so the row stays put. */
    .injector-options-card .rr-dd { min-width: 200px; }

    /* Its row is the card's last one, and .lab-card is overflow:hidden — the open option
       list would be cut off at the card edge. Only this card gives that up. */
    .lab-card.injector-options-card { overflow: visible; }

    .injector-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .injector-action-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.85rem 1.4rem;
        border: 1px solid transparent;
        border-radius: var(--radius-control);
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .injector-action-btn svg { width: 17px; height: 17px; }

    .injector-action-btn.primary {
        background: var(--gradient-primary);
        color: var(--text-primary);
        border-color: rgba(var(--accent-purple-rgb), 0.4);
    }

    .injector-action-btn.primary:hover:not(:disabled) {
        filter: brightness(1.1);
        transform: translateY(-1px);
    }

    .injector-action-btn.danger {
        background: rgba(var(--accent-red-rgb), 0.12);
        border-color: rgba(var(--accent-red-rgb), 0.35);
        color: var(--accent-red-soft);
    }

    .injector-action-btn.danger:hover:not(:disabled) {
        background: rgba(var(--accent-red-rgb), 0.2);
    }

    .injector-action-btn:disabled {
        opacity: 0.45;
        cursor: not-allowed;
    }

    .injector-spinner {
        width: 14px;
        height: 14px;
        border: 2px solid currentColor;
        border-top-color: transparent;
        border-radius: 50%;
        animation: injectorSpin 0.7s linear infinite;
    }

    @@keyframes injectorSpin { to { transform: rotate(360deg); } }

    .injector-log {
        background: var(--background-dark);
        border: 1px solid var(--glass-hover);
        border-radius: var(--radius-control);
        overflow: hidden;
    }

    .injector-log-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 0.9rem;
        background: rgba(255, 255, 255, 0.03);
        border-bottom: 1px solid var(--glass-hover);
        font-size: 0.85rem;
        color: var(--text-secondary);
    }

    .injector-log-header svg { width: 14px; height: 14px; }

    .injector-log-clear {
        margin-left: auto;
        background: transparent;
        border: none;
        color: var(--text-secondary);
        font-size: 0.8rem;
        cursor: pointer;
        padding: 0.15rem 0.45rem;
        border-radius: var(--radius-sm);
    }

    .injector-log-clear:hover { color: var(--text-primary); background: var(--glass-bg); }

    .injector-log-body {
        max-height: 240px;
        overflow-y: auto;
        padding: 0.7rem 0.9rem;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        line-height: 1.55;
    }

    .injector-log-empty {
        color: var(--text-secondary);
        font-family: var(--font-primary);
        font-style: italic;
    }

    .injector-log-line {
        white-space: pre-wrap;
        color: var(--text-secondary);
    }

    .injector-log-line.success { color: var(--accent-green-soft); }
    .injector-log-line.error { color: var(--accent-red-soft); }
    .injector-log-line.warn { color: var(--accent-orange-soft); }
    .injector-log-line.info { color: var(--accent-purple-light); }

    .injector-coverage {
        padding: 0.85rem 1rem;
        background: rgba(0, 0, 0, 0.15);
        border: 1px solid var(--glass-hover);
        border-radius: var(--radius-control);
        font-size: 0.86rem;
        color: var(--text-secondary);
    }

    .injector-coverage-header {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin-bottom: 0.4rem;
        color: var(--text-primary);
    }

    .injector-coverage-header svg { width: 16px; height: 16px; }

    .injector-coverage-list { margin: 0 0 0.5rem 0; line-height: 1.5; }
    .injector-coverage-caveat { margin: 0 0 0.5rem 0; line-height: 1.5; }
    .injector-coverage-caveat strong { color: var(--text-primary); }

    .injector-coverage-jump {
        margin: 0.6rem 0 0 0;
        padding-top: 0.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        font-size: 0.83rem;
        color: var(--text-secondary);
    }

    .injector-link {
        background: transparent;
        border: none;
        color: var(--accent-purple-light);
        font-size: inherit;
        cursor: pointer;
        padding: 0;
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .injector-link:hover { color: var(--text-primary); }

    .injector-log-action {
        margin-left: 0.5rem;
        padding: 0.1rem 0.5rem;
        background: rgba(var(--accent-purple-rgb), 0.18);
        border: 1px solid rgba(var(--accent-purple-rgb), 0.4);
        color: var(--accent-purple-light);
        border-radius: var(--radius-sm);
        font-family: var(--font-primary);
        font-size: 0.78rem;
        cursor: pointer;
        transition: background 0.15s ease;
    }

    .injector-log-action:hover { background: rgba(var(--accent-purple-rgb), 0.32); }
</style>

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    private const string ConvertXUrl = "https://github.com/CedrickGD/Convert-X";
    private static readonly HashSet<string> SupportedImageExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".png", ".jpg", ".jpeg", ".bmp", ".tga", ".webp", ".gif"
    };

    // Pulled from a singleton so the picked image, mode, flip and tile size stick across
    // tab switches and page navigations within the same app session. Cleared on app restart.
    private SkyInjectionOptions _opts => Session.Options;
    private readonly List<LogLine> _logLines = new();
    private bool _hasBackup;
    private bool _busy;
    private string? _lastAction;

    private bool CanInject =>
        !_busy
        && (_opts.Mode == SkyInjectionMode.SolidColor || !string.IsNullOrWhiteSpace(_opts.ImagePath));

    private bool CanRestore => !_busy && _hasBackup;

    private string StatusKind
    {
        get
        {
            if (!_hasBackup) return "original";
            var injected = LabSettings.Current.LastSkyInjectAt;
            var restored = LabSettings.Current.LastSkyRestoreAt;
            // Missing timestamps + backups present → treat as injected (pre-Phase-5b behavior).
            if (injected is null && restored is null) return "injected";
            if (restored is not null && (injected is null || restored > injected)) return "restored";
            return "injected";
        }
    }

    private string StatusClass => StatusKind switch
    {
        "injected" => "injected",
        "restored" => "restored",
        _ => ""
    };

    private string StatusTitle => StatusKind switch
    {
        "injected" => Localizer.T("sky.status.injected"),
        "restored" => Localizer.T("sky.status.restored"),
        _ => Localizer.T("sky.status.original")
    };

    private string StatusSubtitle => StatusKind switch
    {
        "injected" => Localizer.T("sky.status.injected.text"),
        "restored" => Localizer.T("sky.status.restored.text"),
        _ => Localizer.T("sky.status.original.text")
    };

    private string? _previewUri;

    protected override void OnInitialized()
    {
        _hasBackup = Injector.HasBackup();
        LabSettings.Changed += OnLabSettingsChanged;
        // Restore the last-picked sky image across app restarts (session keeps it within a run).
        if (string.IsNullOrEmpty(_opts.ImagePath))
        {
            try { var saved = Preferences.Get("SkyInjectorImagePath", ""); if (!string.IsNullOrEmpty(saved) && System.IO.File.Exists(saved)) _opts.ImagePath = saved; } catch { }
        }
        _ = UpdatePreview();
    }

    private async Task UpdatePreview()
    {
        _previewUri = null;
        var path = _opts.ImagePath;
        if (_opts.Mode == SkyInjectionMode.Image && !string.IsNullOrEmpty(path) && System.IO.File.Exists(path))
        {
            try
            {
                _previewUri = await Task.Run(() =>
                {
                    using var bmp = SkiaSharp.SKBitmap.Decode(path);
                    if (bmp is null) return (string?)null;
                    int tw = 220; int th = Math.Max(1, (int)(bmp.Height * (220.0 / bmp.Width)));
                    using var thumb = bmp.Resize(new SkiaSharp.SKImageInfo(tw, th), new SkiaSharp.SKSamplingOptions(SkiaSharp.SKFilterMode.Linear, SkiaSharp.SKMipmapMode.Linear));
                    var src = thumb ?? bmp;
                    using var img = SkiaSharp.SKImage.FromBitmap(src);
                    using var data = img.Encode(SkiaSharp.SKEncodedImageFormat.Png, 80);
                    return "data:image/png;base64," + Convert.ToBase64String(data.ToArray());
                });
            }
            catch (Exception ex) { Logger.LogDebug(ex, "Sky preview failed"); }
        }
        // Two of the three call sites are `_ = UpdatePreview()`, so an awaited dispatch faulting
        // here would have no observer.
        this.DispatchRender(() => InvokeAsync(StateHasChanged), Logger);
    }

    private void OnLabSettingsChanged() => this.DispatchRender(() => InvokeAsync(StateHasChanged), Logger);

    private void SetMode(SkyInjectionMode mode)
    {
        _opts.Mode = mode;
        _ = UpdatePreview();
    }

    private IReadOnlyList<Dropdown.Option> TileOptions => new List<Dropdown.Option>
    {
        new("1", Localizer.T("sky.tile.1")),
        new("2", Localizer.T("sky.tile.2")),
        new("3", Localizer.T("sky.tile.3")),
        new("4", Localizer.T("sky.tile.4"))
    };

    private void OnTileChanged(string value)
    {
        if (int.TryParse(value, System.Globalization.NumberStyles.Integer,
                         System.Globalization.CultureInfo.InvariantCulture, out var v))
        {
            _opts.TileSize = Math.Clamp(v, 1, 4);
        }
    }

    private async Task PickImage()
    {
        try
        {
            var fileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
            {
                { DevicePlatform.WinUI, new[] { ".png", ".jpg", ".jpeg", ".bmp", ".tga", ".webp" } }
            });
            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = Localizer.T("sky.picker.title"),
                FileTypes = fileTypes
            });
            if (result is not null)
            {
                _opts.ImagePath = result.FullPath;
                try { Preferences.Set("SkyInjectorImagePath", _opts.ImagePath); } catch { }
                await UpdatePreview();
                AppendLog(Localizer.T("sky.log.imageselected", Path.GetFileName(_opts.ImagePath)), "info");

                var ext = Path.GetExtension(_opts.ImagePath);
                if (!SupportedImageExtensions.Contains(ext))
                {
                    AppendConvertXHint(Localizer.T("sky.log.undecodable", ext));
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Sky image picker failed");
            Notifications.ShowError(Localizer.T("sky.toast.pickerfailed"));
        }
    }

    private void AppendConvertXHint(string preamble)
    {
        AppendLog(preamble, "warn");
        _logLines.Add(new LogLine(
            Localizer.T("sky.log.convertx"),
            "info",
            ActionLabel: Localizer.T("sky.log.convertx.action"),
            ActionUrl: ConvertXUrl));
    }

    private void OpenUrl(string url)
    {
        try
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
            {
                FileName = url,
                UseShellExecute = true
            });
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to open URL {Url}", url);
            Notifications.ShowError(Localizer.T("sky.toast.urlfailed", url));
        }
    }

    private async Task InjectAsync()
    {
        if (!CanInject) return;

        // _busy goes up before the gate's HTTP round-trip — CanInject checks it, so a
        // double-click can't slip in a second consume during the await.
        _busy = true;
        _lastAction = "inject";

        // Restores are never gated — only the inject counts against the free monthly quota.
        var gate = await UsageGate.TryConsumeAsync(UsageFeatures.SkyChanger);
        if (!gate.Allowed)
        {
            _busy = false;
            _lastAction = null;
            Notifications.ShowWarning(Localizer.T("sky.limit", gate.Limit));
            return;
        }
        AppendLog(_opts.Mode == SkyInjectionMode.Image
            ? Localizer.T("sky.log.swapping.image", Path.GetFileName(_opts.ImagePath), _opts.TileSize, _opts.FlipVertically)
            : Localizer.T("sky.log.swapping.color", _opts.HexColor), "info");
        try
        {
            // Patches the sky textures by name on disk; the game loads them on the next map load
            // (rejoin / relaunch / next in-game day). No proxy, no injection — safe on any server.
            var result = await Injector.InjectAsync(_opts);
            AppendResult(result, verbAct: Localizer.T("sky.log.patched"), verbErr: Localizer.T("sky.log.injecterrors"));
            _hasBackup = Injector.HasBackup();
            if (result.Errors.Count == 0 && result.Patched > 0)
            {
                AppendLog(Localizer.T("sky.log.rejoin"), "info");
                Notifications.ShowSuccess(Localizer.T("sky.toast.applied", result.Patched));
            }
            else if (result.Errors.Count > 0)
            {
                Notifications.ShowError(Localizer.T("sky.toast.injecterrors", result.Errors.Count));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Live sky swap failed");
            AppendLog(Localizer.T("sky.log.swapfailed", ex.Message), "error");
            Notifications.ShowError(Localizer.T("sky.toast.swapfailed"));
        }
        finally
        {
            _busy = false;
            _lastAction = null;
        }
    }

    private async Task RestoreAsync()
    {
        if (!CanRestore) return;

        if (LabSettings.Current.GuardArkProcess && ProcessService.IsProcessRunning("ShooterGame"))
        {
            AppendLog(Localizer.T("sky.log.arkrunning"), "warn");
        }

        _busy = true;
        _lastAction = "restore";
        AppendLog(Localizer.T("sky.log.restoring"), "info");
        try
        {
            var result = await Injector.RestoreAsync();
            AppendResult(result, verbAct: Localizer.T("sky.log.restored"), verbErr: Localizer.T("sky.log.restoreerrors"));
            _hasBackup = Injector.HasBackup();
            // Restoring the original sky returns the tool to a clean slate — drop the custom image + its preview.
            _opts.ImagePath = null;
            _previewUri = null;
            try { Preferences.Set("SkyInjectorImagePath", ""); } catch { }
            if (result.Errors.Count == 0 && result.Patched > 0)
            {
                Notifications.ShowSuccess(Localizer.T("sky.toast.restored", result.Patched));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Restore failed");
            AppendLog(Localizer.T("sky.log.restorefailed", ex.Message), "error");
            Notifications.ShowError(Localizer.T("sky.toast.restorefailed"));
        }
        finally
        {
            _busy = false;
            _lastAction = null;
        }
    }

    private void AppendResult(SkyInjectionResult result, string verbAct, string verbErr)
    {
        AppendLog(Localizer.T("sky.log.result", verbAct, result.Patched, result.Skipped), result.Errors.Count == 0 ? "success" : "warn");
        var sawDecodeFailure = false;
        foreach (var err in result.Errors)
        {
            AppendLog($"  {err}", "error");
            if (!sawDecodeFailure && (err.Contains("could not be decoded", StringComparison.OrdinalIgnoreCase)
                                   || err.Contains("Unsupported format", StringComparison.OrdinalIgnoreCase)))
            {
                sawDecodeFailure = true;
            }
        }
        if (result.Errors.Count > 0)
        {
            AppendLog(Localizer.T("sky.log.errorcount", result.Errors.Count, verbErr), "warn");
        }
        if (sawDecodeFailure)
        {
            AppendConvertXHint(Localizer.T("sky.log.formatfailed"));
        }
    }

    private void AppendLog(string text, string kind)
    {
        var stamp = DateTime.Now.ToString("HH:mm:ss");
        _logLines.Add(new LogLine($"[{stamp}] {text}", kind));
        const int cap = 200;
        if (_logLines.Count > cap)
        {
            _logLines.RemoveRange(0, _logLines.Count - cap);
        }
    }



    private void ClearLog() => _logLines.Clear();

    public void Dispose() { this.StopRenderDispatch(); LabSettings.Changed -= OnLabSettingsChanged; }

    private record LogLine(string Text, string Kind, string? ActionLabel = null, string? ActionUrl = null);
}
