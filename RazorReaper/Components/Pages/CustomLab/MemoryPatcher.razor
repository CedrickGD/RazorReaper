@using RazorReaper.Services
@inject ICustomLabSettingsService LabSettings
@implements IDisposable

<div class="lab-memory">
    <div class="lab-card">
        <div class="lab-card-header">
            <div class="lab-icon-badge accent">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="5" width="12" height="10" rx="1.5" />
                    <path d="M7 5V3M10 5V3M13 5V3M7 17v-2M10 17v-2M13 17v-2M4 8H2M4 12H2M18 8h-2M18 12h-2" />
                    <rect x="7.5" y="8.5" width="5" height="3" rx="0.5" />
                </svg>
            </div>
            <div>
                <h3>
                    Memory Patcher
                    <span class="lab-pill warning">coming soon</span>
                </h3>
                <p>Live-patch ARK's running process so sky and texture edits apply without a game restart.</p>
            </div>
        </div>

        <div class="lab-card-content">
            <p class="lab-lead">
                The Memory Patcher attaches to <code>ShooterGame.exe</code> while you're in-game and rewrites
                texture resources in memory. Pair it with the file-based <strong>Sky Injector</strong> as your
                durable baseline; this tool is the "apply changes without quitting" layer on top.
            </p>

            <h4>What it will do</h4>
            <ul class="lab-feature-bullets">
                <li>Detect and attach to a running <code>ShooterGame.exe</code> process</li>
                <li>Reload sky textures in memory so the new sky shows immediately</li>
                <li>Auto-detach on game exit; manual detach via Attach button when running</li>
                <li>Optional future: hot-reload other patched textures (paintings, pixel glitch)</li>
            </ul>

            <h4>Prerequisites once shipped</h4>
            <ul class="lab-prereq-list">
                <li class="@(LabSettings.Current.Accepted ? "met" : "")">
                    <span class="lab-prereq-marker">
                        @if (LabSettings.Current.Accepted)
                        {
                            <svg viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0z" clip-rule="evenodd" />
                            </svg>
                        }
                    </span>
                    Read Me accepted
                </li>
                <li class="@(LabSettings.Current.MasterEnabled ? "met" : "")">
                    <span class="lab-prereq-marker">
                        @if (LabSettings.Current.MasterEnabled)
                        {
                            <svg viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0z" clip-rule="evenodd" />
                            </svg>
                        }
                    </span>
                    Custom Lab enabled in Settings
                </li>
                <li class="@(LabSettings.Current.MemoryInjectEnabled ? "met" : "")">
                    <span class="lab-prereq-marker">
                        @if (LabSettings.Current.MemoryInjectEnabled)
                        {
                            <svg viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0z" clip-rule="evenodd" />
                            </svg>
                        }
                    </span>
                    Runtime memory injection enabled in Settings
                </li>
                <li>
                    <span class="lab-prereq-marker"></span>
                    <code>ShooterGame.exe</code> is running
                </li>
            </ul>

            <div class="lab-attach-row">
                <button type="button"
                        class="lab-btn primary"
                        disabled
                        title="The Memory Patcher hasn't shipped yet — this button is a preview of where Attach will live.">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 10h12" />
                        <path d="M10 4l6 6-6 6" />
                    </svg>
                    Attach
                </button>
                <span class="lab-attach-note">The Attach button activates once the Memory Patcher implementation ships.</span>
            </div>
        </div>
    </div>
</div>

<style>
    .lab-memory { max-width: 880px; }

    .lab-card {
        background: rgba(0, 0, 0, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        overflow: hidden;
    }

    .lab-card-header {
        display: flex;
        align-items: flex-start;
        gap: 0.85rem;
        padding: 1.1rem 1.25rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .lab-card-header h3 {
        margin: 0 0 0.2rem 0;
        font-size: 1.05rem;
        font-weight: 600;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 0.55rem;
    }

    .lab-card-header p {
        margin: 0;
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.65);
    }

    .lab-icon-badge {
        flex-shrink: 0;
        width: 38px;
        height: 38px;
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.06);
        color: rgba(255, 255, 255, 0.85);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .lab-icon-badge.accent {
        background: rgba(139, 92, 246, 0.18);
        color: #b69cff;
    }

    .lab-icon-badge svg { width: 20px; height: 20px; }

    .lab-card-content { padding: 1.25rem; }

    .lab-card-content h4 {
        margin: 1.25rem 0 0.6rem 0;
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.88);
    }

    .lab-card-content h4:first-of-type { margin-top: 0.5rem; }

    .lab-lead {
        margin: 0;
        color: rgba(255, 255, 255, 0.75);
        line-height: 1.55;
    }

    .lab-lead strong { color: #fff; }

    .lab-pill {
        font-size: 0.65rem;
        font-weight: 600;
        padding: 0.15rem 0.45rem;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .lab-pill.warning {
        background: rgba(255, 200, 80, 0.15);
        color: #ffd479;
    }

    .lab-feature-bullets {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 0.4rem;
    }

    .lab-feature-bullets li {
        position: relative;
        padding-left: 1.1rem;
        font-size: 0.88rem;
        color: rgba(255, 255, 255, 0.72);
        line-height: 1.5;
    }

    .lab-feature-bullets li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.6rem;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: rgba(182, 156, 255, 0.7);
    }

    .lab-prereq-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 0.4rem;
    }

    .lab-prereq-list li {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.88rem;
        color: rgba(255, 255, 255, 0.5);
    }

    .lab-prereq-list li.met {
        color: rgba(255, 255, 255, 0.85);
    }

    .lab-prereq-marker {
        flex-shrink: 0;
        width: 18px;
        height: 18px;
        border-radius: 4px;
        border: 1.5px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.03);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6ee06e;
    }

    .lab-prereq-marker svg { width: 12px; height: 12px; }

    .lab-prereq-list li.met .lab-prereq-marker {
        background: rgba(110, 224, 110, 0.15);
        border-color: rgba(110, 224, 110, 0.55);
    }

    .lab-attach-row {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin-top: 1.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        flex-wrap: wrap;
    }

    .lab-attach-note {
        font-size: 0.83rem;
        color: rgba(255, 255, 255, 0.55);
    }

    .lab-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.55rem 1.1rem;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #fff;
        border-radius: 6px;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .lab-btn svg { width: 15px; height: 15px; }

    .lab-btn.primary {
        background: rgba(139, 92, 246, 0.18);
        border-color: rgba(139, 92, 246, 0.4);
        color: #b69cff;
    }

    .lab-btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    code {
        background: rgba(255, 255, 255, 0.06);
        padding: 0.05rem 0.3rem;
        border-radius: 3px;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.85em;
    }
</style>

@code {
    protected override void OnInitialized()
    {
        LabSettings.Changed += OnLabSettingsChanged;
    }

    private void OnLabSettingsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => LabSettings.Changed -= OnLabSettingsChanged;
}
