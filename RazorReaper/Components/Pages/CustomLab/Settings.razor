@using RazorReaper.Services
@inject ICustomLabSettingsService LabSettings
@implements IDisposable

<div class="lab-settings">
    <div class="lab-card">
        <div class="lab-card-header">
            <div class="lab-icon-badge">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="10" cy="10" r="2.5" />
                    <path d="M10 3v2M10 15v2M3 10h2M15 10h2M5 5l1.4 1.4M13.6 13.6 15 15M5 15l1.4-1.4M13.6 6.4 15 5" />
                </svg>
            </div>
            <div>
                <h3>Custom Lab settings</h3>
                <p>Scope-wide toggles for the Custom Lab section. Persisted to <code>%LocalAppData%\RazorReaper\custom-lab.json</code>.</p>
            </div>
        </div>

        <div class="lab-card-content">
            <div class="lab-settings-row">
                <div class="lab-settings-label">
                    <div class="lab-settings-title">Enable Custom Lab</div>
                    <p class="lab-settings-desc">
                        Master switch for the whole section. When off, all feature tabs are locked.
                    </p>
                </div>
                <label class="lab-switch">
                    <input type="checkbox"
                           checked="@LabSettings.Current.MasterEnabled"
                           disabled="@(!LabSettings.Current.Accepted)"
                           @onchange="OnMasterChanged" />
                    <span class="lab-switch-slider"></span>
                </label>
            </div>

            <div class="lab-settings-row">
                <div class="lab-settings-label">
                    <div class="lab-settings-title">Acceptance</div>
                    <p class="lab-settings-desc">
                        @if (LabSettings.Current.Accepted)
                        {
                            <span>You've accepted the Read Me. Reset to lock the feature tabs again and ask for acknowledgement next time.</span>
                        }
                        else
                        {
                            <span>You have not accepted the Read Me yet. Switch to the Read Me tab and tick the checkbox.</span>
                        }
                    </p>
                </div>
                <div class="lab-settings-actions">
                    @if (LabSettings.Current.Accepted)
                    {
                        <button class="lab-btn danger" @onclick="ResetAcknowledgement">Reset acknowledgement</button>
                    }
                    else
                    {
                        <button class="lab-btn" @onclick="JumpToReadMe">Open Read Me</button>
                    }
                </div>
            </div>

            <div class="lab-settings-row">
                <div class="lab-settings-label">
                    <div class="lab-settings-title">
                        Enable runtime memory injection
                        <span class="lab-pill">future feature</span>
                    </div>
                    <p class="lab-settings-desc">
                        Unlocks the Memory Patcher tab once that feature ships. Has no effect today.
                    </p>
                </div>
                <label class="lab-switch">
                    <input type="checkbox"
                           checked="@LabSettings.Current.MemoryInjectEnabled"
                           disabled="@(!LabSettings.Current.Accepted || !LabSettings.Current.MasterEnabled)"
                           @onchange="OnMemoryInjectChanged" />
                    <span class="lab-switch-slider"></span>
                </label>
            </div>

            <div class="lab-settings-row">
                <div class="lab-settings-label">
                    <div class="lab-settings-title">Warn when ARK is running</div>
                    <p class="lab-settings-desc">
                        Show a confirmation dialog before any file-modifying action if <code>ShooterGame.exe</code> is detected.
                        Recommended on — locked files may otherwise cause writes to fail silently.
                    </p>
                </div>
                <label class="lab-switch">
                    <input type="checkbox"
                           checked="@LabSettings.Current.GuardArkProcess"
                           disabled="@(!LabSettings.Current.Accepted || !LabSettings.Current.MasterEnabled)"
                           @onchange="OnGuardChanged" />
                    <span class="lab-switch-slider"></span>
                </label>
            </div>
        </div>
    </div>
</div>

<style>
    .lab-settings { max-width: 880px; }

    .lab-card {
        background: rgba(0, 0, 0, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        overflow: hidden;
    }

    .lab-card-header {
        display: flex;
        align-items: flex-start;
        gap: 0.85rem;
        padding: 1.1rem 1.25rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .lab-card-header h3 {
        margin: 0 0 0.2rem 0;
        font-size: 1.05rem;
        font-weight: 600;
        color: #fff;
    }

    .lab-card-header p {
        margin: 0;
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.65);
    }

    .lab-icon-badge {
        flex-shrink: 0;
        width: 38px;
        height: 38px;
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.06);
        color: rgba(255, 255, 255, 0.85);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .lab-icon-badge svg { width: 20px; height: 20px; }

    .lab-card-content { padding: 0.6rem 1.25rem; }

    .lab-settings-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        padding: 1rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .lab-settings-row:last-child { border-bottom: none; }

    .lab-settings-label { flex: 1 1 auto; min-width: 0; }

    .lab-settings-title {
        font-weight: 600;
        color: #fff;
        font-size: 0.95rem;
        margin-bottom: 0.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .lab-settings-desc {
        margin: 0;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.65);
        line-height: 1.5;
    }

    .lab-pill {
        font-size: 0.65rem;
        font-weight: 600;
        padding: 0.1rem 0.45rem;
        border-radius: 4px;
        background: rgba(120, 180, 255, 0.15);
        color: #9ec6ff;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .lab-switch {
        position: relative;
        display: inline-block;
        width: 42px;
        height: 24px;
        flex-shrink: 0;
    }

    .lab-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .lab-switch-slider {
        position: absolute;
        inset: 0;
        cursor: pointer;
        background: rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        transition: background 0.2s ease;
    }

    .lab-switch-slider::before {
        content: "";
        position: absolute;
        height: 18px;
        width: 18px;
        left: 3px;
        top: 3px;
        background: #fff;
        border-radius: 50%;
        transition: transform 0.2s ease;
    }

    .lab-switch input:checked + .lab-switch-slider {
        background: rgba(110, 224, 110, 0.55);
    }

    .lab-switch input:checked + .lab-switch-slider::before {
        transform: translateX(18px);
    }

    .lab-switch input:disabled + .lab-switch-slider {
        opacity: 0.4;
        cursor: not-allowed;
    }

    .lab-settings-actions { flex-shrink: 0; }

    .lab-btn {
        padding: 0.5rem 1rem;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #fff;
        border-radius: 6px;
        font-size: 0.88rem;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .lab-btn:hover { background: rgba(255, 255, 255, 0.1); }

    .lab-btn.danger {
        background: rgba(231, 84, 84, 0.12);
        border-color: rgba(231, 84, 84, 0.3);
        color: #ff9a9a;
    }

    .lab-btn.danger:hover {
        background: rgba(231, 84, 84, 0.2);
    }

    code {
        background: rgba(255, 255, 255, 0.06);
        padding: 0.05rem 0.3rem;
        border-radius: 3px;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.85em;
    }
</style>

@code {
    [Parameter] public EventCallback OnJumpToReadMe { get; set; }

    protected override void OnInitialized()
    {
        LabSettings.Changed += OnLabSettingsChanged;
    }

    private Task OnMasterChanged(ChangeEventArgs e) =>
        LabSettings.SetMasterEnabledAsync(e.Value is bool b && b);

    private Task OnMemoryInjectChanged(ChangeEventArgs e) =>
        LabSettings.SetMemoryInjectEnabledAsync(e.Value is bool b && b);

    private Task OnGuardChanged(ChangeEventArgs e) =>
        LabSettings.SetGuardArkProcessAsync(e.Value is bool b && b);

    private Task ResetAcknowledgement() => LabSettings.ResetAcknowledgementAsync();

    private Task JumpToReadMe() => OnJumpToReadMe.InvokeAsync();

    private void OnLabSettingsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => LabSettings.Changed -= OnLabSettingsChanged;
}
