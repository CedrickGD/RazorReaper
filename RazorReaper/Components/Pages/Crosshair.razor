@page "/crosshair"
@using System.Diagnostics
@using System.IO
@using System.Timers
@using Microsoft.Extensions.Logging
@using RazorReaper.Services
@using RazorReaper.Models
@using RazorReaper.Components.Shared
@implements IDisposable

@inject ICrosshairService CrosshairSvc
@inject INotificationService Notifications
@inject ILogger<Crosshair> Logger
@using RazorReaper.Services.Localization
@inject ILocalizer Localizer

<header class="page-header crosshair-page-header">
    <h1 class="page-title">@Localizer.T("nav.page.crosshair")</h1>
    <p class="page-subtitle">@Localizer.T("crosshair.subtitle")</p>
</header>

<div class="crosshair-layout">
    <div class="control-panel">
        <div class="content-card overlay-status-card @(CrosshairSvc.IsOverlayActive ? "is-active" : "")">
            <div class="overlay-status-row">
                <div class="overlay-status-info">
                    <span class="overlay-pulse @(CrosshairSvc.IsOverlayActive ? "on" : "off")"></span>
                    <div>
                        <div class="overlay-status-title">@Localizer.T(CrosshairSvc.IsOverlayActive ? "crosshair.overlay.active" : "crosshair.overlay.off")</div>
                        <div class="overlay-status-sub">@StatusSubLine</div>
                    </div>
                </div>
                <button class="rr-pill-btn @(CrosshairSvc.IsOverlayActive ? "danger" : "primary")" @onclick="ToggleOverlay">
                    @Localizer.T(CrosshairSvc.IsOverlayActive ? "crosshair.overlay.stop" : "crosshair.overlay.start")
                </button>
            </div>
        </div>

        <div class="content-card">
            <div class="card-title-row">
                <h3>@Localizer.T("crosshair.shape")</h3>
            </div>
            <div class="seg-control type-seg">
                @foreach (var t in AllTypes)
                {
                    <button class="seg-btn @(profile.Type == t ? "active" : "")" @onclick="@(() => SetType(t))">
                        <span class="seg-glyph">@TypeGlyph(t)</span>
                        <span>@TypeLabel(t)</span>
                    </button>
                }
            </div>

            @if (profile.Type == CrosshairType.Image)
            {
                <div class="field">
                    <label class="field-label">@Localizer.T("crosshair.field.image")</label>
                    <div class="row-flex gap-sm align-center">
                        <button class="rr-pill-btn ghost" @onclick="PickImage">
                            @Localizer.T(string.IsNullOrEmpty(profile.ImagePath) ? "crosshair.image.choose" : "crosshair.image.replace")
                        </button>
                        @if (!string.IsNullOrEmpty(profile.ImagePath))
                        {
                            <span class="image-name">@System.IO.Path.GetFileName(profile.ImagePath)</span>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="content-card">
            <h3>@Localizer.T(profile.Type == CrosshairType.Image ? "crosshair.sizing" : "crosshair.colors")</h3>
            @if (profile.Type != CrosshairType.Image)
            {
                <div class="row-2">
                    <div class="field">
                        <label class="field-label">@Localizer.T("crosshair.body")</label>
                        <ColorField Value="@profile.Color" ValueChanged="@(v => { profile.Color = v; Push(); })" />
                    </div>
                    <div class="field">
                        <label class="field-label">@Localizer.T("crosshair.outline")</label>
                        <div class="row-flex gap-sm">
                            <ColorField Value="@profile.OutlineColor" ValueChanged="@(v => { profile.OutlineColor = v; Push(); })" />
                            <div class="num-stepper">
                                <input type="number" class="num-input tight" min="0" max="8" value="@profile.OutlineThickness"
                                       @oninput="@((e) => UpdateInt(v => profile.OutlineThickness = v, e.Value, 0, 8))" />
                                <span class="num-suffix">px</span>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (profile.Type == CrosshairType.Image)
            {
                <div class="field">
                    <label class="field-label">@Localizer.T("crosshair.label.size") <strong>@profile.ImageScale%</strong></label>
                    <input type="range" class="rr-slider" min="1" max="500" step="1" value="@profile.ImageScale"
                           @oninput="@((e) => UpdateInt(v => profile.ImageScale = v, e.Value, 1, 500))" />
                </div>
            }
            else if (profile.Type != CrosshairType.Pixel)
            {
                <div class="row-2">
                    <div class="field">
                        <label class="field-label">@Localizer.T("crosshair.label.size") <strong>@profile.Size</strong></label>
                        <input type="range" class="rr-slider" min="1" max="150" step="1" value="@profile.Size"
                               @oninput="@((e) => UpdateInt(v => profile.Size = v, e.Value, 1, 150))" />
                    </div>
                    @if (profile.Type != CrosshairType.Dot)
                    {
                        <div class="field">
                            <label class="field-label">@Localizer.T("crosshair.label.thickness") <strong>@profile.Thickness</strong></label>
                            <input type="range" class="rr-slider" min="1" max="20" step="1" value="@profile.Thickness"
                                   @oninput="@((e) => UpdateInt(v => profile.Thickness = v, e.Value, 1, 20))" />
                        </div>
                    }
                </div>

                @if (profile.Type is CrosshairType.Cross or CrosshairType.TStyle)
                {
                    <div class="field">
                        <label class="field-label">@Localizer.T("crosshair.label.gap") <strong>@profile.Gap</strong></label>
                        <input type="range" class="rr-slider" min="-10" max="60" step="1" value="@profile.Gap"
                               @oninput="@((e) => UpdateInt(v => profile.Gap = v, e.Value, -10, 60))" />
                    </div>
                }
            }

            <div class="field">
                <label class="field-label">@Localizer.T("crosshair.label.opacity") <strong>@profile.Opacity%</strong></label>
                <input type="range" class="rr-slider" min="0" max="100" step="1" value="@profile.Opacity"
                       @oninput="@((e) => UpdateInt(v => profile.Opacity = v, e.Value, 0, 100))" />
            </div>
        </div>

        @if (profile.Type is CrosshairType.Cross or CrosshairType.Circle or CrosshairType.Dot)
        {
            <div class="content-card">
                <h3>@Localizer.T("crosshair.centerdot")</h3>
                <div class="row-flex gap-md align-center">
                    <Switch Value="@profile.ShowDot" ValueChanged="@(v => { profile.ShowDot = v; Push(); })"
                            Label="@Localizer.T(profile.Type == CrosshairType.Dot ? "crosshair.dot.alwayson" : "crosshair.dot.enabled")"
                            Disabled="@(profile.Type == CrosshairType.Dot)" />
                    @if (profile.ShowDot || profile.Type == CrosshairType.Dot)
                    {
                        <div class="field flex-1">
                            <label class="field-label">@Localizer.T("crosshair.label.dotsize") <strong>@profile.DotSize</strong></label>
                            <input type="range" class="rr-slider" min="1" max="30" step="1" value="@profile.DotSize"
                                   @oninput="@((e) => UpdateInt(v => profile.DotSize = v, e.Value, 1, 30))" />
                        </div>
                    }
                </div>
            </div>
        }

        @if (profile.Type == CrosshairType.Pixel)
        {
            <div class="content-card">
                <h3>@Localizer.T("crosshair.pixelart")</h3>
                <div class="pixel-toolbar">
                    <div class="row-flex gap-sm align-center">
                        <label class="field-label m-0">@Localizer.T("crosshair.grid")</label>
                        @foreach (var gs in PixelGridChoices)
                        {
                            var size = gs;
                            <button class="rr-pill-btn sm @(profile.PixelGridSize == size ? "primary" : "ghost")"
                                    @onclick="@(() => SetPixelGridSize(size))">@size×@size</button>
                        }
                    </div>
                    <div class="row-flex gap-sm align-center">
                        <button class="rr-pill-btn ghost sm" @onclick="ClearPixelArt" title="@Localizer.T("crosshair.pixel.eraseall")">@Localizer.T("common.clear")</button>
                        <button class="rr-pill-btn ghost sm" @onclick="InvertPixelArt" title="@Localizer.T("crosshair.pixel.flipall")">@Localizer.T("crosshair.invert")</button>
                        <button class="rr-pill-btn ghost sm" @onclick="LoadPixelPlus" title="@Localizer.T("crosshair.pixel.plus")">＋</button>
                        <button class="rr-pill-btn ghost sm" @onclick="LoadPixelDot" title="@Localizer.T("crosshair.pixel.dot")">·</button>
                    </div>
                </div>

                <div class="field">
                    <label class="field-label">@Localizer.T("crosshair.label.pixelsize") <strong>@profile.DotSize</strong></label>
                    <input type="range" class="rr-slider" min="1" max="30" step="1" value="@profile.DotSize"
                           @oninput="@((e) => UpdateInt(v => profile.DotSize = v, e.Value, 1, 30))" />
                </div>

                <div class="pixel-grid-wrap">
                    <div class="pixel-grid"
                         style="--grid: @profile.PixelGridSize"
                         @onmouseup="StopPixelPaint"
                         @onmouseleave="StopPixelPaint">
                        @for (int r = 0; r < profile.PixelGridSize; r++)
                        {
                            for (int c = 0; c < profile.PixelGridSize; c++)
                            {
                                var idx = r * profile.PixelGridSize + c;
                                var on = idx < profile.PixelArtData.Length && profile.PixelArtData[idx] == '1';
                                var isCenter = r == profile.PixelGridSize / 2 && c == profile.PixelGridSize / 2;
                                <div class="pixel-cell @(on ? "on" : "") @(isCenter ? "center" : "")"
                                     style="@(on ? $"background:{profile.Color}" : "")"
                                     @onmousedown="@(() => StartPixelPaint(idx, !on))"
                                     @onmouseenter="@(() => PaintPixelIfDragging(idx))"></div>
                            }
                        }
                    </div>
                </div>
                <p class="muted-line">@Localizer.T("crosshair.pixel.hint")</p>
            </div>
        }

        @if (profile.Type is CrosshairType.Cross)
        {
            <div class="content-card">
                <h3>@Localizer.T("crosshair.lines")</h3>
                <div class="line-toggles">
                    <Switch Compact="true" Value="@profile.ShowTopLine"    ValueChanged="@(v => { profile.ShowTopLine = v; Push(); })"    Label="@Localizer.T("crosshair.line.top")" />
                    <Switch Compact="true" Value="@profile.ShowBottomLine" ValueChanged="@(v => { profile.ShowBottomLine = v; Push(); })" Label="@Localizer.T("crosshair.line.bottom")" />
                    <Switch Compact="true" Value="@profile.ShowLeftLine"   ValueChanged="@(v => { profile.ShowLeftLine = v; Push(); })"   Label="@Localizer.T("crosshair.line.left")" />
                    <Switch Compact="true" Value="@profile.ShowRightLine"  ValueChanged="@(v => { profile.ShowRightLine = v; Push(); })"  Label="@Localizer.T("crosshair.line.right")" />
                </div>
            </div>
        }

        <div class="content-card">
            <h3>@Localizer.T("crosshair.position")</h3>
            <div class="field">
                <label class="field-label">@Localizer.T("crosshair.monitor")</label>
                <Dropdown Value="@profile.MonitorDeviceName"
                          ValueChanged="SelectMonitor"
                          Options="MonitorOptions" />
            </div>
            <div class="row-2">
                <div class="field">
                    <label class="field-label">@Localizer.T("crosshair.offsetx")</label>
                    <div class="num-stepper">
                        <input type="number" class="num-input" min="-3000" max="3000" step="1" value="@profile.OffsetX"
                               @oninput="@((e) => UpdateInt(v => profile.OffsetX = v, e.Value, -3000, 3000))" />
                        <span class="num-suffix">px</span>
                    </div>
                </div>
                <div class="field">
                    <label class="field-label">@Localizer.T("crosshair.offsety")</label>
                    <div class="num-stepper">
                        <input type="number" class="num-input" min="-3000" max="3000" step="1" value="@profile.OffsetY"
                               @oninput="@((e) => UpdateInt(v => profile.OffsetY = v, e.Value, -3000, 3000))" />
                        <span class="num-suffix">px</span>
                    </div>
                </div>
            </div>
            <p class="muted-line">@Localizer.T("crosshair.offset.hint")</p>
            <div class="position-actions">
                <button class="rr-pill-btn ghost sm" @onclick="CenterOffsets">@Localizer.T("crosshair.recenter")</button>
            </div>

            <div class="field">
                <label class="field-label">@Localizer.T("crosshair.label.rotation") <strong>@profile.Rotation°</strong></label>
                <input type="range" class="rr-slider" min="0" max="359" step="1" value="@profile.Rotation"
                       @oninput="@((e) => UpdateInt(v => profile.Rotation = v, e.Value, 0, 359))" />
            </div>
        </div>

        <div class="content-card">
            <h3>@Localizer.T("crosshair.motion")</h3>
            <div class="seg-control">
                @foreach (var a in AllAnimations)
                {
                    <button class="seg-btn @(profile.Animation == a ? "active" : "")" @onclick="@(() => SetAnimation(a))">
                        @AnimationLabel(a)
                    </button>
                }
            </div>
            @if (profile.Animation != CrosshairAnimation.None || profile.Rainbow)
            {
                <div class="field">
                    <label class="field-label">@Localizer.T("crosshair.label.speed") <strong>@profile.AnimationSpeed</strong></label>
                    <input type="range" class="rr-slider" min="1" max="10" step="1" value="@profile.AnimationSpeed"
                           @oninput="@((e) => UpdateInt(v => profile.AnimationSpeed = v, e.Value, 1, 10))" />
                </div>
            }
            <Switch Value="@profile.Rainbow" ValueChanged="@(v => { profile.Rainbow = v; Push(); })" Label="@Localizer.T("crosshair.rainbow")" />
        </div>

    </div>

    <div class="status-panel">
        <div class="content-card preview-card">
            <div class="card-title-row">
                <h3>@Localizer.T("crosshair.preview")</h3>
                <span class="preview-meta">@PreviewMetaLine</span>
            </div>
            <div class="preview-frame">
                <div class="preview-stage">
                    @if (!string.IsNullOrEmpty(previewSrc))
                    {
                        <img src="@previewSrc" class="preview-image" alt="@Localizer.T("crosshair.preview.alt")" />
                    }
                </div>
            </div>
        </div>

        <div class="content-card">
            <h3>@Localizer.T("crosshair.presets")</h3>
            <div class="preset-grid">
                @foreach (var preset in builtIns)
                {
                    <button class="preset-card" @onclick="@(() => ApplyProfile(preset))">
                        <div class="preset-name">@preset.Name</div>
                        <div class="preset-meta">@TypeLabel(preset.Type) @(preset.Animation != CrosshairAnimation.None ? "· " + AnimationLabel(preset.Animation) : "") @(preset.Rainbow ? "· " + Localizer.T("crosshair.rainbow.short") : "")</div>
                    </button>
                }
            </div>
        </div>

        <div class="content-card">
            <h3>@Localizer.T("crosshair.profiles")</h3>
            @if (saved.Count == 0)
            {
                <p class="muted-line">@Localizer.T("crosshair.profiles.empty")</p>
            }
            else
            {
                <div class="saved-list">
                    @foreach (var sp in saved)
                    {
                        <div class="saved-row">
                            <button class="saved-load" @onclick="@(() => ApplyProfile(sp))">
                                <span class="saved-name">@sp.Name</span>
                                <span class="saved-meta">@TypeLabel(sp.Type)</span>
                            </button>
                            <button class="rr-pill-btn ghost sm danger" @onclick="@(() => DeleteSaved(sp.Id))">@Localizer.T("common.delete")</button>
                        </div>
                    }
                </div>
            }

            <div class="save-row">
                <input type="text" placeholder="@Localizer.T("crosshair.profile.placeholder")" @bind="newProfileName" class="rr-input" />
                <button class="rr-pill-btn primary" @onclick="SaveCurrent" disabled="@string.IsNullOrWhiteSpace(newProfileName)">@Localizer.T("common.save")</button>
            </div>
        </div>

        <div class="content-card">
            <div class="card-title-row">
                <h3>@Localizer.T("crosshair.library")</h3>
                <div class="row-flex gap-sm">
                    <button class="rr-pill-btn ghost sm" @onclick="OpenImportsFolder" title="@Localizer.T("crosshair.library.openfolder.tooltip")">@Localizer.T("crosshair.library.openfolder")</button>
                    <button class="rr-pill-btn ghost sm" @onclick="CopyImportsPath" title="@Localizer.T("crosshair.library.copypath.tooltip")">@Localizer.T("crosshair.library.copypath")</button>
                </div>
            </div>
            @if (library.Count == 0)
            {
                <p class="muted-line">@Localizer.T("crosshair.library.empty")</p>
            }
            else
            {
                <div class="library-grid">
                    @foreach (var img in library)
                    {
                        var thumb = LibraryThumb(img);
                        var isActive = string.Equals(profile.ImagePath, img, StringComparison.OrdinalIgnoreCase) && profile.Type == CrosshairType.Image;
                        <div class="library-item @(isActive ? "selected" : "")">
                            <button class="library-pick" @onclick="@(() => UseLibraryImage(img))" title="@System.IO.Path.GetFileName(img)">
                                @if (!string.IsNullOrEmpty(thumb))
                                {
                                    <img src="@thumb" />
                                }
                                else
                                {
                                    <span class="library-no-thumb">?</span>
                                }
                            </button>
                            <button class="library-delete" @onclick="@(() => DeleteLibraryImage(img))" title="@Localizer.T("common.delete")">×</button>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="content-card">
            <h3>@Localizer.T("crosshair.import")</h3>
            <div class="import-grid">
                <button class="rr-pill-btn ghost" @onclick="ImportImageFile">
                    @Localizer.T("crosshair.import.image")
                </button>
                <button class="rr-pill-btn ghost" @onclick="ImportWorkshopFile">
                    @Localizer.T("crosshair.import.workshopfile")
                </button>
                <button class="rr-pill-btn ghost" @onclick="ImportWorkshopFolder">
                    @Localizer.T("crosshair.import.workshopfolder")
                </button>
            </div>

            <div class="code-import">
                <label class="field-label code-import-label">@Localizer.T("crosshair.code.label")</label>
                <div class="row-flex gap-sm align-center">
                    <input type="text" class="rr-input code-input"
                           placeholder="@Localizer.T("crosshair.code.placeholder")"
                           @bind="codeInput" @bind:event="oninput"
                           @onkeydown="OnCodeKeyDown" />
                    <button class="rr-pill-btn primary" @onclick="ImportCode" disabled="@string.IsNullOrWhiteSpace(codeInput)">@Localizer.T("crosshair.import")</button>
                </div>
                <p class="muted-line">
                    @Localizer.T("crosshair.code.hint")
                </p>
            </div>

            <button class="guide-toggle" @onclick="@(() => guideOpen = !guideOpen)">
                <span class="chev @(guideOpen ? "open" : "")">▸</span>
                <span>@Localizer.T("crosshair.guide.toggle")</span>
            </button>
            @if (guideOpen)
            {
                <div class="guide-body">
                    <div class="guide-item">
                        <div class="guide-title">@Localizer.T("crosshair.guide.image.title")</div>
                        <div class="guide-text">@Localizer.T("crosshair.guide.image.text")</div>
                    </div>
                    <div class="guide-item">
                        <div class="guide-title">@Localizer.T("crosshair.guide.workshop.title")</div>
                        <div class="guide-text">
                            @Localizer.T("crosshair.guide.workshop.text")
                        </div>
                    </div>
                    <div class="guide-item">
                        <div class="guide-title">@Localizer.T("crosshair.guide.valorant.title")</div>
                        <div class="guide-text">
                            @Localizer.T("crosshair.guide.valorant.text")
                        </div>
                    </div>
                    <div class="guide-item">
                        <div class="guide-title">@Localizer.T("crosshair.guide.cs2.title")</div>
                        <div class="guide-text">
                            @Localizer.T("crosshair.guide.cs2.text")
                        </div>
                    </div>
                    <div class="guide-item">
                        <div class="guide-title">@Localizer.T("crosshair.guide.rust.title")</div>
                        <div class="guide-text">
                            @Localizer.T("crosshair.guide.rust.text")
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="content-card">
            <h3>@Localizer.T("crosshair.hotkey")</h3>
            <div class="row-flex gap-sm align-center">
                <span class="field-label flex-1 m-0">@Localizer.T("crosshair.hotkey.toggle")</span>
                <HotkeyLink Value="@hotkeyLabel" />
            </div>
            <p class="muted-line">@Localizer.T("crosshair.hotkey.hint")</p>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Repaints the page when the language changes; why the cascade rather than a subscription
    /// of this page's own is explained in MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    private CrosshairProfile profile = new();
    private IReadOnlyList<CrosshairProfile> builtIns = Array.Empty<CrosshairProfile>();
    private IReadOnlyList<CrosshairProfile> saved = Array.Empty<CrosshairProfile>();
    private IReadOnlyList<MonitorInfo> monitors = Array.Empty<MonitorInfo>();
    private string previewSrc = "";
    private string newProfileName = "";
    private string hotkeyLabel = "F8";
    private string codeInput = "";
    private bool guideOpen;
    private List<string> library = new();
    private readonly Dictionary<string, string> thumbCache = new(StringComparer.OrdinalIgnoreCase);
    // Paths whose thumbnail decode already failed (e.g., a file with .png extension but
    // WEBP bytes inside). Without this, every Blazor re-render re-calls RenderThumbnailPng
    // on the broken file and hammers System.Drawing → System.Drawing logs an exception →
    // re-render → repeat. Once a path is in this set we just render the "?" placeholder
    // without ever touching disk again.
    private readonly HashSet<string> thumbFailed = new(StringComparer.OrdinalIgnoreCase);

    private System.Timers.Timer? _animTimer;
    private DateTime _animStart = DateTime.UtcNow;

    private static readonly CrosshairType[] AllTypes = (CrosshairType[])Enum.GetValues(typeof(CrosshairType));
    private static readonly CrosshairAnimation[] AllAnimations = (CrosshairAnimation[])Enum.GetValues(typeof(CrosshairAnimation));

    private string StatusSubLine => CrosshairSvc.IsOverlayActive
        ? Localizer.T(
            "crosshair.status.active",
            TypeLabel(profile.Type),
            profile.Color.ToUpper(),
            Localizer.T(profile.Animation == CrosshairAnimation.None && !profile.Rainbow
                ? "crosshair.status.static"
                : "crosshair.status.animated"))
        : Localizer.T(
            "crosshair.status.press",
            string.IsNullOrEmpty(hotkeyLabel) ? Localizer.T("crosshair.overlay.start") : hotkeyLabel);

    private string PreviewMetaLine
    {
        get
        {
            var parts = new List<string> { TypeLabel(profile.Type) };
            if (profile.Type != CrosshairType.Image)
            {
                if (profile.Type is CrosshairType.Dot or CrosshairType.Pixel) parts.Add($"{profile.DotSize}px");
                else parts.Add($"{profile.Size}px × {profile.Thickness}");
                if (profile.Type is CrosshairType.Cross or CrosshairType.TStyle) parts.Add(Localizer.T("crosshair.meta.gap", profile.Gap));
            }
            if (profile.Opacity != 100) parts.Add($"{profile.Opacity}%");
            if (profile.Animation != CrosshairAnimation.None) parts.Add(AnimationLabel(profile.Animation));
            if (profile.Rainbow) parts.Add(Localizer.T("crosshair.rainbow.short"));
            return string.Join(" · ", parts);
        }
    }

    protected override void OnInitialized()
    {
        CrosshairSvc.Changed += OnServiceChanged;
        CrosshairSvc.LibraryChanged += OnLibraryChanged;
        ReadFromService();
        RefreshLibrary();
        RefreshPreview();
        EnsureAnimTimer();
    }

    private void OnServiceChanged()
    {
        this.DispatchRender(() => InvokeAsync(() =>
        {
            ReadFromService();
            RefreshPreview();
            EnsureAnimTimer();
            StateHasChanged();
        }), Logger);
    }

    private void OnLibraryChanged()
    {
        // Library updates are independent of profile changes — refresh just the list, no
        // preview re-render or timer churn.
        this.DispatchRender(() => InvokeAsync(() =>
        {
            RefreshLibrary();
            StateHasChanged();
        }), Logger);
    }

    private void ReadFromService()
    {
        profile = CrosshairSvc.ActiveProfile.Clone();
        profile.Id = CrosshairSvc.ActiveProfile.Id;
        profile.IsBuiltIn = false;
        builtIns = CrosshairSvc.GetBuiltInPresets();
        saved = CrosshairSvc.GetSavedProfiles();
        monitors = CrosshairSvc.GetMonitors();
        if (string.IsNullOrEmpty(profile.MonitorDeviceName) && monitors.Count > 0)
        {
            var primary = monitors.FirstOrDefault(m => m.IsPrimary) ?? monitors[0];
            profile.MonitorDeviceName = primary.DeviceName;
        }
        var hk = CrosshairSvc.GetHotkey();
        hotkeyLabel = hk.Label;
    }

    private void RefreshLibrary()
    {
        library = CrosshairSvc.GetImportedImagePaths().ToList();
        // Drop thumb cache + failure-set entries that no longer have a backing file
        // (after delete) — keeps both maps bounded.
        var present = new HashSet<string>(library, StringComparer.OrdinalIgnoreCase);
        foreach (var k in thumbCache.Keys.Where(k => !present.Contains(k)).ToList()) thumbCache.Remove(k);
        foreach (var k in thumbFailed.Where(k => !present.Contains(k)).ToList()) thumbFailed.Remove(k);
    }

    private string LibraryThumb(string path)
    {
        if (thumbCache.TryGetValue(path, out var cached)) return cached;
        if (thumbFailed.Contains(path)) return "";
        var bytes = CrosshairSvc.RenderThumbnailPng(path);
        if (bytes == null)
        {
            thumbFailed.Add(path);
            return "";
        }
        var url = "data:image/png;base64," + Convert.ToBase64String(bytes);
        thumbCache[path] = url;
        return url;
    }

    private void UseLibraryImage(string path)
    {
        CrosshairSvc.UseImportedImage(path);
        ReadFromService();
        RefreshPreview();
        EnsureAnimTimer();
    }

    private void DeleteLibraryImage(string path)
    {
        if (CrosshairSvc.DeleteImportedImage(path))
        {
            // Drop our per-page caches for this path.
            thumbCache.Remove(path);
            thumbFailed.Remove(path);
            // The service also raises LibraryChanged which would refresh us asynchronously
            // via InvokeAsync — but we call RefreshLibrary + StateHasChanged inline here as
            // a safety net so the thumbnail disappears the instant the user clicks the X,
            // even if the event dispatch is delayed by another in-flight render.
            RefreshLibrary();
            StateHasChanged();
            Notifications.ShowInfo(Localizer.T("crosshair.toast.deleted"));
        }
    }

    private void OpenImportsFolder()
    {
        // Same pattern as Paintings.OpenMyPaintingsFolder — proven to work elsewhere in this app.
        try
        {
            var folderPath = Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
                "RazorReaper", "Crosshairs", "Images");

            if (!Directory.Exists(folderPath))
