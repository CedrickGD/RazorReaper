    private static async Task<string?> PickFolderAsync()
    {
        var picker = new Windows.Storage.Pickers.FolderPicker();
        picker.FileTypeFilter.Add("*");

        var windows = Microsoft.Maui.Controls.Application.Current?.Windows;
        if (windows == null || windows.Count == 0) return null;

        var window = windows[0].Handler?.PlatformView as Microsoft.UI.Xaml.Window;
        if (window == null) return null;

        WinRT.Interop.InitializeWithWindow.Initialize(picker, WinRT.Interop.WindowNative.GetWindowHandle(window));
        var folder = await picker.PickSingleFolderAsync();
        return folder?.Path;
    }

    private void StartRecordHotkey() => recordingHotkey = true;

    private void ClearHotkey()
    {
        CrosshairSvc.SetHotkey("", 0, false, false, false);
        hotkeyLabel = "";
    }

    private void CaptureHotkey(KeyboardEventArgs e)
    {
        if (!recordingHotkey) return;
        if (string.IsNullOrEmpty(e.Key) || e.Key is "Control" or "Shift" or "Alt" or "Meta") return;

        var vk = TranslateKeyToVk(e.Key, e.Code);
        if (vk == 0) return;

        var label = BuildHotkeyLabel(e.Key, e.CtrlKey, e.AltKey, e.ShiftKey);
        CrosshairSvc.SetHotkey(label, vk, e.CtrlKey, e.AltKey, e.ShiftKey);
        hotkeyLabel = label;
        recordingHotkey = false;
        StateHasChanged();
    }

    private static string BuildHotkeyLabel(string key, bool ctrl, bool alt, bool shift)
    {
        var parts = new List<string>();
        if (ctrl) parts.Add("Ctrl");
        if (alt) parts.Add("Alt");
        if (shift) parts.Add("Shift");
        parts.Add(NormalizeKeyName(key));
        return string.Join(" + ", parts);
    }

    private static string NormalizeKeyName(string key) => key.Length == 1 ? key.ToUpperInvariant() : key;

    private static int TranslateKeyToVk(string key, string code)
    {
        if (key.StartsWith("F", StringComparison.OrdinalIgnoreCase) && int.TryParse(key.AsSpan(1), out var fn) && fn is >= 1 and <= 24)
            return 0x6F + fn;

        if (key.Length == 1)
        {
            var c = char.ToUpperInvariant(key[0]);
            if (c >= 'A' && c <= 'Z') return c;
            if (c >= '0' && c <= '9') return c;
        }

        return key switch
        {
            "ArrowUp" => 0x26, "ArrowDown" => 0x28, "ArrowLeft" => 0x25, "ArrowRight" => 0x27,
            "Insert" => 0x2D, "Delete" => 0x2E, "Home" => 0x24, "End" => 0x23,
            "PageUp" => 0x21, "PageDown" => 0x22, " " => 0x20, "Tab" => 0x09, "Enter" => 0x0D,
            _ => 0
        };
    }

    private static string TypeLabel(CrosshairType t) => t switch
    {
        CrosshairType.Cross => "Cross",
        CrosshairType.Dot => "Dot",
        CrosshairType.Circle => "Circle",
        CrosshairType.TStyle => "T-Style",
        CrosshairType.Image => "Image",
        _ => t.ToString()
    };

    private static string TypeGlyph(CrosshairType t) => t switch
    {
        CrosshairType.Cross => "+",
        CrosshairType.Dot => "·",
        CrosshairType.Circle => "○",
        CrosshairType.TStyle => "⊥",
        CrosshairType.Image => "🖼",
        _ => "+"
    };

    public void Dispose()
    {
        CrosshairSvc.Changed -= OnServiceChanged;
        CrosshairSvc.LibraryChanged -= OnLibraryChanged;
        _animTimer?.Stop();
        _animTimer?.Dispose();
        _animTimer = null;
    }
