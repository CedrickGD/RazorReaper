    private void Push()
    {
        CrosshairSvc.UpdateActive(profile);
        RefreshPreview();
        EnsureAnimTimer();
    }

    private double GetPhase()
    {
        if (profile.Animation == CrosshairAnimation.None && !profile.Rainbow) return 0.25;
        var speed = Math.Clamp(profile.AnimationSpeed, 1, 10);
        var period = 5.0 / speed;
        var seconds = (DateTime.UtcNow - _animStart).TotalSeconds;
        return (seconds / period) % 1.0;
    }

    private void RefreshPreview()
    {
        try
        {
            var bytes = CrosshairSvc.RenderPreviewPng(GetPhase());
            previewSrc = "data:image/png;base64," + Convert.ToBase64String(bytes);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Crosshair preview render failed");
        }
    }

    // Drive the preview animation when a shape animation/rainbow is active OR when the active
    // image source is multi-frame (animated GIF / video frame sequence). For the multi-frame
    // case the renderer picks the right frame per tick; we just need to keep re-rendering so
    // the editor pane shows live playback instead of a static first frame.
    private void EnsureAnimTimer()
    {
        var needsShapeAnim = profile.Type != CrosshairType.Image
            && (profile.Animation != CrosshairAnimation.None || profile.Rainbow);
        var needsImageAnim = profile.Type == CrosshairType.Image
            && CrosshairSvc.HasAnimatedActiveImage;
        if (needsShapeAnim || needsImageAnim)
        {
            if (_animTimer != null) return;
            // 50 ms (20 Hz) preview tick — barely-perceptibly slower than the previous 40 ms
            // (25 Hz) but trims the per-tick PNG-encode + base64 work by ~20% when the editor
            // pane is the only thing watching. Live overlay still runs at its own 30 Hz.
            _animTimer = new System.Timers.Timer(50) { AutoReset = true };
            _animTimer.Elapsed += AnimTick;
            _animTimer.Start();
        }
        else
        {
            _animTimer?.Stop();
            _animTimer?.Dispose();
            _animTimer = null;
        }
    }

    private void AnimTick(object? sender, ElapsedEventArgs e)
    {
        // 20 Hz is the fastest render loop in the app, so a renderer that has gone away here is
        // the most expensive one to keep feeding — stop the timer instead of skipping the tick.
        if (this.IsRenderStopped())
        {
            _animTimer?.Stop();
            return;
        }

        this.DispatchRender(() => InvokeAsync(() =>
        {
            RefreshPreview();
            StateHasChanged();
        }), Logger);
    }

    private void SetType(CrosshairType t)
    {
        profile.Type = t;
        // Dot and Pixel are "the dot IS the shape" types — force ShowDot so they actually render.
        if (t is CrosshairType.Dot or CrosshairType.Pixel) profile.ShowDot = true;
        Push();
    }

    // ─── Pixel-art editor ───────────────────────────────────────────────────
    private static readonly int[] PixelGridChoices = new[] { 8, 16, 24, 32 };
    private bool _pixelPainting;
    private bool _pixelPaintValue;

    private void SetPixelGridSize(int size)
    {
        if (size == profile.PixelGridSize) return;
        // Resize the pixel grid by sampling old cells into the new grid coordinates so the
        // drawing is preserved as best as possible across resolution changes.
        var oldSize = Math.Max(1, profile.PixelGridSize);
        var newSize = Math.Max(1, size);
        var newData = new char[newSize * newSize];
        for (int i = 0; i < newData.Length; i++) newData[i] = '0';
        var oldData = profile.PixelArtData ?? "";
        for (int r = 0; r < newSize; r++)
        {
            for (int c = 0; c < newSize; c++)
            {
                var or_ = (int)Math.Floor(r * (double)oldSize / newSize);
                var oc = (int)Math.Floor(c * (double)oldSize / newSize);
                var oIdx = or_ * oldSize + oc;
                if (oIdx >= 0 && oIdx < oldData.Length && oldData[oIdx] == '1')
                    newData[r * newSize + c] = '1';
            }
        }
        profile.PixelGridSize = newSize;
        profile.PixelArtData = new string(newData);
        Push();
    }

    private void ClearPixelArt()
    {
        var len = profile.PixelGridSize * profile.PixelGridSize;
        profile.PixelArtData = new string('0', len);
        Push();
    }

    private void InvertPixelArt()
    {
        var len = profile.PixelGridSize * profile.PixelGridSize;
        var src = profile.PixelArtData ?? "";
        var buf = new char[len];
        for (int i = 0; i < len; i++)
        {
            var c = i < src.Length ? src[i] : '0';
            buf[i] = c == '1' ? '0' : '1';
        }
        profile.PixelArtData = new string(buf);
        Push();
    }

    private void LoadPixelDot()
    {
        var size = profile.PixelGridSize;
        var len = size * size;
        var buf = new char[len];
        for (int i = 0; i < len; i++) buf[i] = '0';
        var centre = (size / 2) * size + (size / 2);
        if (centre < len) buf[centre] = '1';
        profile.PixelArtData = new string(buf);
        Push();
    }

    private void LoadPixelPlus()
    {
        var size = profile.PixelGridSize;
        var len = size * size;
        var buf = new char[len];
        for (int i = 0; i < len; i++) buf[i] = '0';
        var mid = size / 2;
        // Cardinals + centre — a tidy 5-pixel plus sign.
        void Set(int r, int c)
        {
            if (r >= 0 && r < size && c >= 0 && c < size) buf[r * size + c] = '1';
        }
        Set(mid, mid);
        Set(mid - 1, mid);
        Set(mid + 1, mid);
        Set(mid, mid - 1);
        Set(mid, mid + 1);
        profile.PixelArtData = new string(buf);
        Push();
    }

    private void StartPixelPaint(int idx, bool toState)
    {
        _pixelPainting = true;
        _pixelPaintValue = toState;
        SetPixelCell(idx, toState);
        Push();
    }

    private void PaintPixelIfDragging(int idx)
    {
        if (!_pixelPainting) return;
        if (SetPixelCell(idx, _pixelPaintValue))
        {
            // Push during drag so the preview / overlay reflect the brush stroke live.
            // The overlay update is cheap (pure GDI+ fill) and we redraw the small grid div.
            Push();
        }
    }

    private void StopPixelPaint() => _pixelPainting = false;

    /// <summary>Set one cell in the PixelArtData string. Returns true if the cell actually changed.</summary>
    private bool SetPixelCell(int idx, bool on)
    {
        var len = profile.PixelGridSize * profile.PixelGridSize;
        if (idx < 0 || idx >= len) return false;
        var src = profile.PixelArtData ?? "";
        // Grow the data string to grid length if it's been left short (initial state).
        if (src.Length < len)
        {
            var pad = new char[len];
            for (int i = 0; i < len; i++) pad[i] = i < src.Length ? src[i] : '0';
            src = new string(pad);
        }
        var want = on ? '1' : '0';
        if (src[idx] == want) return false;
        var chars = src.ToCharArray();
        chars[idx] = want;
        profile.PixelArtData = new string(chars);
        return true;
    }

