    /// <summary>
    /// What a pasted code turned into. It used to be built by CrosshairCodeParsers, which is a
    /// pure decoder with no localizer and no other caller — the line is only ever read in a
    /// toast on this page, so it is worded here.
    /// </summary>
    private string DescribeImported(CrosshairProfile p)
    {
        var line = Localizer.T(
            "crosshair.describe",
            TypeLabel(p.Type), p.Color, p.Size, p.Thickness, p.Gap, p.OutlineThickness, p.Opacity);

        return p.ShowDot ? line + " " + Localizer.T("crosshair.describe.dot", p.DotSize) : line;
    }

    // Inline SVGs render cleanly at every font size and theme. The previous mix of
    // text glyphs ("+", "·", "○", "⊥") + an emoji ("🖼") rendered inconsistently —
    // emoji fonts vary by OS and made the Image button look like a tiny black square.
    private static MarkupString TypeGlyph(CrosshairType t) => new MarkupString(t switch
    {
        CrosshairType.Cross =>
            "<svg viewBox='0 0 16 16' width='16' height='16' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round'><path d='M8 2v12M2 8h12'/></svg>",
        CrosshairType.Dot =>
            "<svg viewBox='0 0 16 16' width='16' height='16' fill='currentColor'><circle cx='8' cy='8' r='2.2'/></svg>",
        CrosshairType.Circle =>
            "<svg viewBox='0 0 16 16' width='16' height='16' fill='none' stroke='currentColor' stroke-width='1.6'><circle cx='8' cy='8' r='5.4'/></svg>",
        CrosshairType.TStyle =>
            "<svg viewBox='0 0 16 16' width='16' height='16' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round'><path d='M2 4h12M8 4v10'/></svg>",
        CrosshairType.Image =>
            "<svg viewBox='0 0 16 16' width='16' height='16' fill='none' stroke='currentColor' stroke-width='1.3' stroke-linejoin='round'><rect x='2' y='3.2' width='12' height='9.6' rx='1.4'/><circle cx='5.6' cy='6.6' r='1.1' fill='currentColor' stroke='none'/><path d='M2.5 11l3-2.5 2.7 2.3 2-1.6 3.3 2.4'/></svg>",
        CrosshairType.Pixel =>
            "<svg viewBox='0 0 16 16' width='16' height='16' fill='currentColor' shape-rendering='crispEdges'><rect x='6' y='6' width='4' height='4'/></svg>",
        _ =>
            "<svg viewBox='0 0 16 16' width='16' height='16' fill='none' stroke='currentColor' stroke-width='1.6'><path d='M8 2v12M2 8h12'/></svg>"
    });

    public void Dispose()
    {
        this.StopRenderDispatch();
        CrosshairSvc.Changed -= OnServiceChanged;
        CrosshairSvc.LibraryChanged -= OnLibraryChanged;
        _animTimer?.Stop();
        _animTimer?.Dispose();
        _animTimer = null;
    }
