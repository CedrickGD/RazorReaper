@page "/hotkeys"
@using RazorReaper.Services.Automation
@inject IHotkeyRegistry Registry
@inject IEnumerable<AutomationScriptBase> AllScripts
@inject RazorReaper.Services.ICrosshairService Crosshair
@implements IDisposable
@using RazorReaper.Services.Localization
@inject ILocalizer Localizer

@*
    The single place system-wide hotkeys are set. Feature pages show their binding
    read-only and link here, so a hotkey is never configurable in two places.

    Keys a macro sends *into ARK* are not hotkeys and stay on their own page — see
    HotkeyRegistry for where that line is drawn.
*@

<header class="page-header">
    <h1 class="page-title">@Localizer.T("nav.page.hotkeys")</h1>
    <p class="page-subtitle">@Localizer.T("hotkeys.subtitle")</p>
</header>

@foreach (var group in Bindings.GroupBy(b => b.GroupKey))
{
    <div class="content-card hk-card" @key="group.Key">
        <h3 class="hk-group-title">@Localizer.T(group.Key)</h3>

        <div class="hk-list">
            @foreach (var binding in group)
            {
                <div class="hk-row" @key="binding.Id">
                    <span class="hk-dot @(binding.IsActive?.Invoke() == true ? "on" : "")"></span>

                    <span class="hk-text">
                        <span class="hk-name">@binding.LocalName(Localizer)</span>
                        <span class="hk-desc">@Localizer.T(binding.DescriptionKey)</span>
                    </span>

                    @if (binding.ReadOnlyHere)
                    {
                        @* Registration for these still lives in page-local state, so the
                           only honest thing is to point at where it can actually be set. *@
                        <a class="hk-link" href="@binding.OwnerRoute">@Localizer.T("hotkeys.setonpage")</a>
                    }
                    else
                    {
                        <span class="hk-field">
                            @* A key Windows refused stays in the field and stays dead, and the
                               toast that said so is gone in three seconds. This is what is left
                               behind — derived from the live registration, so a restart still
                               shows it. *@
                            @if (binding.HasFailed?.Invoke() == true)
                            {
                                <HotkeyWarn Owner="@binding.FailureOwner?.Invoke()" />
                            }
                            <HotkeyField Value="@binding.Get()"
                                         ValueChanged="@(v => Apply(binding, v))"
                                         Placeholder="@Localizer.T("hotkeys.presscombo")" />
                        </span>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    private IReadOnlyList<HotkeyBinding> Bindings = Array.Empty<HotkeyBinding>();
    private List<AutomationScriptBase> _scripts = new();

    protected override void OnInitialized()
    {
        Bindings = Registry.GetBindings();

        // Scripts flip their own running state from the hotkeys themselves, so the
        // status dots need to follow along without a navigation.
        _scripts = AllScripts.ToList();
        foreach (var script in _scripts) script.Changed += OnOwnerChanged;

        // The crosshair hears back from Windows a moment after a rebind, not during Apply.
        Crosshair.Changed += OnOwnerChanged;
    }

    private void OnOwnerChanged() => this.DispatchRender(() => InvokeAsync(StateHasChanged));

    private void Apply(HotkeyBinding binding, string value)
    {
        binding.Set(value);
        // Owners reject combos they can't register, so re-read rather than trusting the
        // input — the field then snaps back to whatever actually took effect.
        Bindings = Registry.GetBindings();
        StateHasChanged();
    }

    public void Dispose()
    {
        this.StopRenderDispatch();
        foreach (var script in _scripts) script.Changed -= OnOwnerChanged;
        Crosshair.Changed -= OnOwnerChanged;
    }
}
