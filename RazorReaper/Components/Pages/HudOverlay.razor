@page "/hud-overlay"
@using System.Linq
@using Microsoft.Extensions.Logging
@using RazorReaper.Models
@using RazorReaper.Services.Overlay
@using RazorReaper.Services.Localization
@inject IHudOverlayService Hud
@inject ILocalizer Localizer
@inject IJSRuntime JS
@inject ILogger<HudOverlay> Logger
@implements IDisposable

<header class="page-header">
    <h1 class="page-title">@Localizer.T("nav.page.hud-overlay")</h1>
    <p class="page-subtitle">@Localizer.T("hud.subtitle")</p>
</header>

<div class="hud-page">

    <StatusHeader State="@StatusState" Label="@StatusLabel" Description="@StatusDescription">
        <Actions>
            @if (Hud.IsRunning)
            {
                <button class="btn btn-danger" @onclick="() => Hud.Toggle()">@Localizer.T("common.disable")</button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="() => Hud.Toggle()">@Localizer.T("common.enable")</button>
            }
            <button class="btn @(Hud.IsMoveMode ? "btn-primary" : "btn-secondary")"
                    disabled="@(!Hud.IsRunning)" @onclick="ToggleMoveMode">
                @Localizer.T(Hud.IsMoveMode ? "hud.movemode.on" : "hud.movemode")
            </button>
            <button class="btn btn-secondary" disabled="@(!Hud.IsRunning)" @onclick="() => Hud.TestAlert()">
                @Localizer.T("hud.testalert")
            </button>
        </Actions>
    </StatusHeader>

    <div class="hud-grid">

        @* ── Modules ─────────────────────────────────────────────────────── *@
        <div class="content-card hud-card">
            <h3 class="hud-card-title">@Localizer.T("hud.modules.title")</h3>
            <p class="hud-card-desc">@Localizer.T("hud.modules.description")</p>

            <div class="hud-rows">
                @{
                    var ordered = _settings.Modules.OrderBy(m => m.Order).ToList();
                }
                @for (var i = 0; i < ordered.Count; i++)
                {
                    var module = ordered[i];
                    var isFirst = i == 0;
                    var isLast = i == ordered.Count - 1;

                    <SettingRow Title="@Localizer.T(HudSettings.TitleKey(module.Id))" Description="@ModuleDescription(module.Id)">
                        <div class="hud-mod-controls">
                            <button class="hud-reorder" title="@Localizer.T("hud.module.moveup")" disabled="@isFirst"
                                    @onclick="() => MoveModule(module.Id, -1)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 15l-6-6-6 6" /></svg>
                            </button>
                            <button class="hud-reorder" title="@Localizer.T("hud.module.movedown")" disabled="@isLast"
                                    @onclick="() => MoveModule(module.Id, 1)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
                            </button>
                            <Switch Compact="true" Value="@module.Enabled"
                                    ValueChanged="@(v => SetModuleEnabled(module.Id, v))" />
                        </div>
                    </SettingRow>
                }
            </div>
        </div>

        @* ── Placement ───────────────────────────────────────────────────── *@
        <div class="content-card hud-card">
            <h3 class="hud-card-title">@Localizer.T("hud.placement.title")</h3>
            <p class="hud-card-desc">@Localizer.T("hud.placement.description")</p>

            <div class="hud-rows">

                <SettingRow Title="@Localizer.T("stretchedres.monitor.label")" Description="@Localizer.T("hud.monitor.description")">
                    <Dropdown Value="@_settings.MonitorDeviceName"
                              ValueChanged="OnMonitorChanged"
                              Options="MonitorOptions" />
                </SettingRow>

                <SettingRow Title="@Localizer.T("hud.anchor.title")" Description="@Localizer.T("hud.anchor.description")">
                    <div class="hud-corner-seg">
                        @foreach (var c in Placements)
                        {
                            <button class="hud-seg-btn @(_settings.Anchor == c ? "active" : "")"
                                    @onclick="() => SetAnchor(c)">@Localizer.T(HudSettings.AnchorKey(c))</button>
                        }
                        @if (_settings.Anchor == HudAnchor.Custom)
                        {
                            <button class="hud-seg-btn custom active" disabled>@Localizer.T("hud.anchor.dragged")</button>
                        }
                    </div>
                </SettingRow>

                @* Alerts get the same nine placements as the panel plus their own free position:
                   pinned to a corner they only ever grew inwards, so a centred alert ran off the
                   screen and you saw half of it. *@
                <SettingRow Title="@Localizer.T("hud.alertplacement.title")" Description="@Localizer.T("hud.alertplacement.description")">
                    <div class="hud-corner-seg">
                        @foreach (var c in Placements)
                        {
                            <button class="hud-seg-btn @(_settings.AlertCorner == c ? "active" : "")"
                                    @onclick="() => SetAlertCorner(c)">@Localizer.T(HudSettings.AnchorKey(c))</button>
                        }
                        <button class="hud-seg-btn custom @(_settings.AlertCorner == HudAnchor.Custom ? "active" : "")"
                                @onclick="() => SetAlertCorner(HudAnchor.Custom)">@Localizer.T("hud.anchor.free")</button>
                    </div>
                </SettingRow>

                @if (_settings.AlertCorner == HudAnchor.Custom)
                {
                    <SettingRow Title="@Localizer.T("hud.alertposition.title")" Description="@Localizer.T("hud.alertposition.description")">
                        <input type="number" class="hud-num" min="0" max="10000" step="1"
                               @bind="_settings.AlertX" @bind:after="Apply" />
                        <span class="hud-unit">x</span>
                        <input type="number" class="hud-num" min="0" max="10000" step="1"
                               @bind="_settings.AlertY" @bind:after="Apply" />
                        <span class="hud-unit">y</span>
                    </SettingRow>
                }
                else
                {
                    <SettingRow Title="@Localizer.T("hud.alertmargin.title")" Description="@Localizer.T("hud.alertmargin.description")">
                        <input type="number" class="hud-num" min="0" max="2000" step="1"
                               @bind="_settings.AlertOffsetX" @bind:after="Apply" />
                        <span class="hud-unit">x</span>
                        <input type="number" class="hud-num" min="0" max="2000" step="1"
                               @bind="_settings.AlertOffsetY" @bind:after="Apply" />
                        <span class="hud-unit">y</span>
                    </SettingRow>
                }

                <SettingRow Title="@Localizer.T("hud.offsetx.title")" Description="@Localizer.T("hud.offsetx.description")" Disabled="@IsCustom">
                    <input type="number" class="hud-num" min="0" max="2000" step="1"
                           @bind="_settings.OffsetX" @bind:after="Apply" disabled="@IsCustom" />
                    <span class="hud-unit">px</span>
                </SettingRow>

                <SettingRow Title="@Localizer.T("hud.offsety.title")" Description="@Localizer.T("hud.offsety.description")" Disabled="@IsCustom">
                    <input type="number" class="hud-num" min="0" max="2000" step="1"
                           @bind="_settings.OffsetY" @bind:after="Apply" disabled="@IsCustom" />
                    <span class="hud-unit">px</span>
                </SettingRow>

                <SettingRow Title="@Localizer.T("hud.opacity.title")" Description="@Localizer.T("hud.opacity.description")">
                    <div class="hud-slider-wrap">
                        <input type="range" class="hud-slider" min="20" max="100" step="1"
                               @bind="OpacityPercent" @bind:after="Apply" />
                        <span class="hud-unit">@OpacityPercent%</span>
                    </div>
                </SettingRow>

                <SettingRow Title="@Localizer.T("hud.scale.title")" Description="@Localizer.T("hud.scale.description")">
                    <div class="hud-slider-wrap">
                        <input type="range" class="hud-slider" min="50" max="200" step="1"
                               @bind="ScalePercent" @bind:after="Apply" />
                        <span class="hud-unit">@ScalePercent%</span>
                    </div>
                </SettingRow>

                <SettingRow Title="@Localizer.T("hud.compact.title")" Description="@Localizer.T("hud.compact.description")">
                    <Switch Value="@_settings.Compact" ValueChanged="OnCompactChanged" />
                </SettingRow>

            </div>
        </div>

    </div>

    <div class="hud-note">
        <p>@Localizer.T("hud.note")</p>
    </div>

</div>

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    private HudSettings _settings = new();
    private IReadOnlyList<MonitorInfo> _monitors = Array.Empty<MonitorInfo>();

    // Reading order, three per row: the segmented control wraps, so this lays out as the
    // nine positions of the screen rather than as a list of names.
    private static readonly HudAnchor[] Placements =
    {
        HudAnchor.TopLeft, HudAnchor.TopCenter, HudAnchor.TopRight,
        HudAnchor.MiddleLeft, HudAnchor.Center, HudAnchor.MiddleRight,
        HudAnchor.BottomLeft, HudAnchor.BottomCenter, HudAnchor.BottomRight,
    };

    protected override void OnInitialized()
    {
        _settings = Hud.Settings;
        _monitors = Hud.GetMonitors();
        Hud.Changed += OnServiceChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Push the user's live theme accent to the overlay so its highlights match the app.
        if (firstRender) await PushAccentAsync();
    }

    private void OnServiceChanged() => this.DispatchRender(() => InvokeAsync(() =>
    {
        _settings = Hud.Settings; // re-sync (covers move-mode drag persisting a Custom position)
        StateHasChanged();
    }), Logger);

    // ── Status header ──────────────────────────────────────────────────────

    private string StatusState => Hud.IsRunning ? "online" : "off";

    private string StatusLabel => Localizer.T(Hud.IsRunning ? "common.on" : "common.off");

    private string StatusDescription
    {
        get
        {
            if (!Hud.IsRunning) return Localizer.T("hud.status.off");
            var total = _settings.Modules.Count;
            var enabled = _settings.Modules.Count(m => m.Enabled);
            var text = Localizer.T("hud.status.enabled", enabled, total);
            return Hud.IsMoveMode ? text + Localizer.T("hud.status.movemode") : text;
        }
    }

    // ── Actions ────────────────────────────────────────────────────────────

    private void ToggleMoveMode() => Hud.SetMoveMode(!Hud.IsMoveMode);

    // ── Modules ────────────────────────────────────────────────────────────

    private string ModuleDescription(HudModuleKind id) => id switch
    {
        HudModuleKind.Clock => Localizer.T("hud.module.clock.description"),
        HudModuleKind.SessionTimer => Localizer.T("hud.module.session.description"),
        HudModuleKind.ServerInfo => Localizer.T("hud.module.server.description"),
        HudModuleKind.ToolStatus => Localizer.T("hud.module.tool.description"),
        HudModuleKind.ActiveScripts => Localizer.T("hud.module.scripts.description"),
        HudModuleKind.Notifier => Localizer.T("hud.module.alerts.description"),
        _ => Localizer.T("hud.module.desync.description")
    };

    private void SetModuleEnabled(HudModuleKind id, bool enabled)
    {
        var list = _settings.Modules.ToList();
        var i = list.FindIndex(m => m.Id == id);
        if (i < 0 || list[i].Enabled == enabled) return;
        list[i] = list[i] with { Enabled = enabled };
        _settings.Modules = list;
        Apply();
    }

    private void MoveModule(HudModuleKind id, int direction)
    {
        var list = _settings.Modules.OrderBy(m => m.Order).ToList();
        var i = list.FindIndex(m => m.Id == id);
        var j = i + direction;
        if (i < 0 || j < 0 || j >= list.Count) return;

        (list[i], list[j]) = (list[j], list[i]);
        for (var k = 0; k < list.Count; k++)
            list[k] = list[k] with { Order = k };

        _settings.Modules = list;
        Apply();
    }

    // ── Placement ──────────────────────────────────────────────────────────

    private bool IsCustom => _settings.Anchor == HudAnchor.Custom;

    private void SetAnchor(HudAnchor anchor)
    {
        if (_settings.Anchor == anchor) return;
        _settings.Anchor = anchor;
        Apply();
    }

    private void SetAlertCorner(HudAnchor anchor)
    {
        if (_settings.AlertCorner == anchor) return;
        _settings.AlertCorner = anchor;
        Apply();
    }

    // Empty device name means "whatever Windows calls the primary right now", so it stays
    // correct when displays are re-arranged.
    private IReadOnlyList<Dropdown.Option> MonitorOptions =>
        new[] { new Dropdown.Option("", Localizer.T("hud.monitor.primary")) }
            .Concat(_monitors.Select(m => new Dropdown.Option(
                m.DeviceName, m.FriendlyName + (m.IsPrimary ? Localizer.T("hud.monitor.primary.suffix") : ""))))
            .ToList();

    private void OnMonitorChanged(string deviceName)
    {
        _settings.MonitorDeviceName = deviceName;
        Apply();
    }

    private void OnCompactChanged(bool value)
    {
        _settings.Compact = value;
        Apply();
    }

    private int OpacityPercent
    {
        get => (int)Math.Round(_settings.Opacity * 100);
        set => _settings.Opacity = Math.Clamp(value, 20, 100) / 100.0;
    }

    private int ScalePercent
    {
        get => (int)Math.Round(_settings.Scale * 100);
        set => _settings.Scale = Math.Clamp(value, 50, 200) / 100.0;
    }

    // ── Service plumbing ───────────────────────────────────────────────────

    private void Apply() => Hud.UpdateSettings(_settings);

    private async Task PushAccentAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string>(
                "eval",
                "getComputedStyle(document.documentElement).getPropertyValue('--accent-purple-rgb')");
            if (TryParseRgb(raw, out var r, out var g, out var b)) Hud.SetAccent(r, g, b);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to read theme accent for HUD overlay");
        }
    }

    private static bool TryParseRgb(string? raw, out byte r, out byte g, out byte b)
    {
        r = g = b = 0;
        if (string.IsNullOrWhiteSpace(raw)) return false;
        var parts = raw.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 3) return false;
        if (int.TryParse(parts[0], out var ri) &&
            int.TryParse(parts[1], out var gi) &&
            int.TryParse(parts[2], out var bi))
        {
            r = (byte)Math.Clamp(ri, 0, 255);
            g = (byte)Math.Clamp(gi, 0, 255);
            b = (byte)Math.Clamp(bi, 0, 255);
            return true;
        }
        return false;
    }

    // Singleton service keeps running when we leave; only restore click-through so
    // an editing session in move mode never traps the cursor over the game.
    public void Dispose()
    {
        this.StopRenderDispatch();
        Hud.Changed -= OnServiceChanged;
        if (Hud.IsMoveMode) Hud.SetMoveMode(false);
    }
}
