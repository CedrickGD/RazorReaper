@page "/guides/dino-level"
@using RazorReaper.Services.Localization
@inject ILocalizer Localizer

@*
    The one page in the app that is behind a real paywall, and the only caller of
    PremiumLock's hard gate. Everything inside that gate is withheld — not blurred — from
    anyone who is not on the perpetual licence, so the method itself must stay inside it:
    the header above the gate says what the page is about and nothing about how it is done.

    That rule reaches the dictionary too. A key is rendered wherever it is written, so a key
    named after a step would put the method in the page's markup above the gate — the steps are
    numbered instead, and the two keys the header does render are checked against all four
    dictionaries. ARK's own nouns stay as the game spells them in every language: a creature
    whose name has been translated is an instruction nobody can follow.
*@

<header class="page-header">
    <h1 class="page-title">@Localizer.T("dinolevel.title")</h1>
    <p class="page-subtitle">@Localizer.T("dinolevel.subtitle")</p>
</header>

<PremiumLock RequiresLifetime="true">

    <div class="dlg-layout">

        <section class="content-card dlg-intro">
            <h2 class="dlg-card-title">@Localizer.T("dinolevel.what.title")</h2>
            <p>@Localizer.T("dinolevel.what.1")</p>
            <p>@Localizer.T("dinolevel.what.2")</p>
        </section>

        <section class="content-card dlg-steps-card">
            <h2 class="dlg-card-title">@Localizer.T("dinolevel.steps.title")</h2>
            <ol class="dlg-steps">
                @for (var step = 1; step <= StepCount; step++)
                {
                    <li>
                        <span class="dlg-step-head">@Localizer.T($"dinolevel.step.{step}.head")</span>
                        <span class="dlg-step-detail">@Localizer.T($"dinolevel.step.{step}.detail")</span>
                    </li>
                }
            </ol>
        </section>

        <div class="dlg-boxes">

            <section class="content-card dlg-box">
                <h2 class="dlg-card-title">@Localizer.T("dinolevel.requirements.title")</h2>
                <ul class="dlg-list">
                    <li>@Localizer.T("dinolevel.requirement.1")</li>
                    <li>@Localizer.T("dinolevel.requirement.2")</li>
                    <li>@Localizer.T("dinolevel.requirement.3")</li>
                </ul>
            </section>

            <section class="content-card dlg-box">
                <h2 class="dlg-card-title">@Localizer.T("dinolevel.tips.title")</h2>
                <ul class="dlg-list">
                    <li>@Localizer.T("dinolevel.tip.1")</li>
                    <li>@Localizer.T("dinolevel.tip.2")</li>
                    <li>@Localizer.T("dinolevel.tip.3")</li>
                </ul>
            </section>

        </div>

        <p class="dlg-footer">
            @Localizer.T("dinolevel.footer.lead")<a href="/feedback">@Localizer.T("nav.page.feedback")</a>@Localizer.T("dinolevel.footer.rest")
        </p>

    </div>

</PremiumLock>

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    /// <summary>
    /// The owner's notes are eight steps and the order is the trick, so the count is written
    /// once here and the keys are numbered. DinoLevelGuideTests reads the same eight out of the
    /// English dictionary and checks they still say what they said.
    /// </summary>
    public const int StepCount = 8;
}
