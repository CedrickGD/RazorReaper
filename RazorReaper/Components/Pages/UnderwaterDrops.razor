@page "/underwater-drops"
@using System.Globalization
@using RazorReaper.Services.Localization
@inject ILocalizer Localizer

<div class="uw-page">
    <header class="page-header">
        <h1 class="page-title">@Localizer.T("nav.page.underwater-drops")</h1>
        <p class="page-subtitle">@Localizer.T("uw.subtitle")</p>
    </header>

    <div class="uw-layout">
        <section class="content-card uw-controls">
            <div class="uw-toolbar">
                <div class="uw-search-block">
                    <label class="uw-label">@Localizer.T("common.search")</label>
                    <div class="uw-search-wrapper">
                        <svg class="uw-search-icon" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                        </svg>
                        <input type="text"
                               class="uw-search-input"
                               placeholder="@Localizer.T("uw.search.placeholder")"
                               @bind="searchQuery"
                               @bind:event="oninput" />
                    </div>
                </div>
                <div class="uw-count">
                    <span>@Localizer.T("dinoprices.showing")</span>
                    <span class="uw-count-value">@filteredCount / @UnderwaterDropsData.Drops.Count</span>
                </div>
            </div>

            <div class="uw-filter-row">
                <div class="uw-filter-group">
                    <span class="uw-label">@Localizer.T("common.map")</span>
                    <div class="uw-chip-row">
                        <button type="button"
                                class="uw-chip @(selectedMap is null ? "active" : "")"
                                @onclick="() => SelectMap(null)">@Localizer.T("common.allmaps")</button>
                        @foreach (var map in UnderwaterDropsData.Maps)
                        {
                            var mapName = map;
                            <button type="button"
                                    class="uw-chip @(selectedMap == mapName ? "active" : "")"
                                    @onclick="() => SelectMap(mapName)">@mapName</button>
                        }
                    </div>
                </div>
                <div class="uw-filter-group">
                    <span class="uw-label">@Localizer.T("uw.cratetype")</span>
                    <div class="uw-chip-row">
                        <button type="button"
                                class="uw-chip @(selectedTier is null ? "active" : "")"
                                @onclick="() => SelectTier(null)">@Localizer.T("uw.alltypes")</button>
                        <button type="button"
                                class="uw-chip @(selectedTier == UnderwaterDropTier.DeepSea ? "active" : "")"
                                @onclick="() => SelectTier(UnderwaterDropTier.DeepSea)">
                            <span class="uw-dot uw-dot-deepsea"></span>@Localizer.T("uw.tier.deepsea")
                        </button>
                        <button type="button"
                                class="uw-chip @(selectedTier == UnderwaterDropTier.CaveCrate ? "active" : "")"
                                @onclick="() => SelectTier(UnderwaterDropTier.CaveCrate)">
                            <span class="uw-dot uw-dot-cave"></span>@Localizer.T("uw.tier.cave")
                        </button>
                        <button type="button"
                                class="uw-chip @(selectedTier == UnderwaterDropTier.Shipwreck ? "active" : "")"
                                @onclick="() => SelectTier(UnderwaterDropTier.Shipwreck)">
                            <span class="uw-dot uw-dot-wreck"></span>@Localizer.T("uw.tier.shipwreck")
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <section class="content-card uw-info-card">
            <p>@Localizer.T("uw.note")</p>
        </section>

        @if (filteredGroups.Count > 0)
        {
            @foreach (var group in filteredGroups)
            {
                <section class="content-card uw-map-card">
                    <div class="uw-map-header">
                        <h2>@group.MapName</h2>
                        <span class="uw-map-count">@Localizer.T(group.Entries.Count == 1 ? "uw.count.one" : "uw.count.many", group.Entries.Count)</span>
                    </div>
                    <div class="uw-table">
                        <div class="uw-table-header">
                            <div>@Localizer.T("uw.column.type")</div>
                            <div>@Localizer.T("uw.column.area")</div>
                            <div>@Localizer.T("common.lat")</div>
                            <div>@Localizer.T("common.lon")</div>
                            <div>@Localizer.T("uw.column.access")</div>
                        </div>
                        <div class="uw-table-body">
                            @foreach (var drop in group.Entries)
                            {
                                <div class="uw-row" @key="drop">
                                    <div class="uw-cell-tier">
                                        <span class="uw-dot @TierDotClass(drop.Tier)"></span>
                                        <span class="uw-tier-name">@TierLabel(drop.Tier)</span>
                                    </div>
                                    <div class="uw-cell-area">@drop.Area</div>
                                    <div class="uw-cell-coord">@FormatCoord(drop.Lat)</div>
                                    <div class="uw-cell-coord">@FormatCoord(drop.Lon)</div>
                                    <div class="uw-cell-note">@drop.Note</div>
                                </div>
                            }
                        </div>
                    </div>
                </section>
            }
        }
        else
        {
            <section class="content-card uw-empty-card">
                <div class="uw-empty">
                    <svg fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                    </svg>
                    <h3>@Localizer.T("uw.empty.title")</h3>
                    <p>@Localizer.T("uw.empty.text")</p>
                </div>
            </section>
        }
    </div>
</div>

@code {
    /// <summary>
    /// Never read: declaring it is what makes a language switch repaint this component. The
    /// cascade, and why the layout re-rendering is not enough on its own, is explained in
    /// MainLayout.
    /// </summary>
    [CascadingParameter(Name = "Language")]
    public string? Language { get; set; }

    private sealed class MapGroup
    {
        public string MapName { get; init; } = "";
        public List<UnderwaterDrop> Entries { get; init; } = new();
    }

    private string _searchQuery = "";
    private string searchQuery
    {
        get => _searchQuery;
        set { _searchQuery = value; UpdateFiltered(); }
    }

    private string? selectedMap;
    private UnderwaterDropTier? selectedTier;

    private List<MapGroup> filteredGroups = new();
    private int filteredCount;

    // ---- Palette deep links (/underwater-drops?map=Ragnarok&q=Deep%20ocean) ----
    // Set in OnParametersSet, not OnInitialized: Blazor reuses this instance when only
    // the query string changes, so jumping between two palette results must re-apply.

    [Parameter, SupplyParameterFromQuery(Name = "map")]
    public string? MapParam { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "q")]
    public string? QueryParam { get; set; }

    protected override void OnParametersSet()
    {
        // A map we don't know is ignored, so a stale link still renders the full list.
        if (!string.IsNullOrWhiteSpace(MapParam) && UnderwaterDropsData.Maps.Contains(MapParam))
        {
            selectedMap = MapParam;
        }

        if (!string.IsNullOrWhiteSpace(QueryParam))
        {
            _searchQuery = QueryParam;
        }

        UpdateFiltered();
    }

    private void SelectMap(string? map)
    {
        selectedMap = map;
        UpdateFiltered();
    }

    private void SelectTier(UnderwaterDropTier? tier)
    {
        selectedTier = tier;
        UpdateFiltered();
    }

    private void UpdateFiltered()
    {
        IEnumerable<UnderwaterDrop> query = UnderwaterDropsData.Drops;

        if (selectedMap is not null)
        {
            query = query.Where(d => d.Map == selectedMap);
        }

        if (selectedTier is not null)
        {
            query = query.Where(d => d.Tier == selectedTier);
        }

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var term = _searchQuery.Trim();
            query = query.Where(d =>
                d.Area.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                d.Map.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                d.Note.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                TierLabel(d.Tier).Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        var matches = query.ToList();
        filteredCount = matches.Count;
        filteredGroups = UnderwaterDropsData.Maps
            .Select(map => new MapGroup
            {
                MapName = map,
                Entries = matches.Where(d => d.Map == map).ToList()
            })
            .Where(g => g.Entries.Count > 0)
            .ToList();
    }

    private string TierLabel(UnderwaterDropTier tier) => tier switch
    {
        UnderwaterDropTier.DeepSea => Localizer.T("uw.tier.deepsea"),
        UnderwaterDropTier.CaveCrate => Localizer.T("uw.tier.cave"),
        UnderwaterDropTier.Shipwreck => Localizer.T("uw.tier.shipwreck"),
        _ => Localizer.T("common.unknown")
    };

    private static string TierDotClass(UnderwaterDropTier tier) => tier switch
    {
        UnderwaterDropTier.DeepSea => "uw-dot-deepsea",
        UnderwaterDropTier.CaveCrate => "uw-dot-cave",
        UnderwaterDropTier.Shipwreck => "uw-dot-wreck",
        _ => ""
    };

    private static string FormatCoord(double value)
        => value.ToString("0.0", CultureInfo.InvariantCulture);
}
